<Component>
<Description>
Default Diode
</Description>
<qucs_sch>
Default_Diode [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate]
</qucs_sch>
<qucs_symbol>
	<Text -10 0 10 #000080 0 "Default">
	<Line 10 -10 0 20 #000080 2 1>
	<Line -10 0 20 10 #000080 2 1>
	<Line -10 0 20 -10 #000080 2 1>
	<Line -10 -10 0 20 #000080 2 1>
	<Line 30 0 -20 0 #000080 2 1>
	<Line -30 0 20 0 #000080 2 1>
	<.PortSym 30 0 [A] 0> // Anode (positive Connection)
	<Text -30 0 10 #000080 0 "A">
	<.PortSym -30 0 [K] 0>// Kathode (negative Connection)
	<Text -30 0 10 #000080 0 "K">
</qucs_symbol>
<eeschema_sch>
	L Diode:Default
	F0 "[name]"
	F1 "[value]"
	F2 "[footprint]"
	F3 "[datasheet]"
	</eeschema_sch>
	<eeschema_symbol>
	DRAW
	P 2 0 1 10 -50 50 -50 -50 N
	P 2 0 1 0 50 0 -50 0 N
	P 4 0 1 8 50 50 50 -50 -50 0 50 50 N
	T 0 0 0 1 1 1 DEFAULT
	X A 2 150 0 100 L 50 50 1 1 P
	X K 1 -150 0 100 R 50 50 1 1 P
	ENDDRAW
</eeschema_symbol>
<Spice>
	.model DIODE_DEFAULT D
	D_[name] [A] [K] DIODE_DEFAULT
</Spice>
</Component>

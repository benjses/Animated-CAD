//      also you may of course contact us.

<Component>
    <Description>
        A standard oscillator. Creates a rectangular voltage. Frequency in Herz as given in the parameter [value].
        The HIGH-voltage is specified by the VCC-pin, the LOW-voltage is specified by the GND-pin (which may be, but does not have to be connected to ground node)
    </Description>
    <eeschema_sch>
        L Oscillator:KT2520K-T
        ALIAS Oscillator:ACO-xxxMHz Oscillator:DGOF5S3 Oscillator:GTXO-S14T Oscillator:TCXO-14
		IF [model] CONTAINS KT2520K THEN 
			DEFINE [datasheet] https://www.mouser.de/datasheet/2/909/kt2520_e-1388822.pdf
		ENDIF
    </eeschema_sch>
	<eeschema_symbol>
	  (rectangle (start -5.08 5.08) (end 5.08 -5.08)
        (stroke (width 0.254) (type default) (color 0 0 0 0))
        (fill (type background))
      )
      (polyline
        (pts
          (xy -4.572 -0.508)
          (xy -3.81 -0.508)
          (xy -3.81 0.762)
          (xy -3.048 0.762)
          (xy -3.048 -0.508)
          (xy -2.286 -0.508)
          (xy -2.286 0.762)
          (xy -1.524 0.762)
          (xy -1.524 -0.508)
        )
        (stroke (width 0) (type default) (color 0 0 0 0))
        (fill (type none))
      )
    
	  (pin power_in line (at 0 -7.62 90) (length 2.54)
        (name "GND" (effects (font (size 1.27 1.27))))
        (number "1" (effects (font (size 1.27 1.27))))
      )
      (pin output line (at 7.62 0 180) (length 2.54)
        (name "OUT" (effects (font (size 1.27 1.27))))
        (number "4" (effects (font (size 1.27 1.27))))
      )
      (pin power_in line (at 0 7.62 270) (length 2.54)
        (name "VCC" (effects (font (size 1.27 1.27))))
        (number "6" (effects (font (size 1.27 1.27))))
      )
	</eeschema_symbol>

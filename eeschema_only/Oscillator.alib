				<title>KT2520K-T Oscillator</title>
				<detail>KT2520K-T Oscillator at Mouser Electronic </detail>
			</link>
	</purchase>
    <Spice>
        IF [value] IS_NUMBER THENELSE <WARNING>The oscillator component "[name]" at ([xpos]|[ypos]) does not have a numeric frequency value.</WARNING>ENDIF
        .subckt oscillator_standard_[individual] pos neg out
        .model switch_high sw vt=0.0 ron=1.0 roff=1E8
        .model switch_low  sw vt=0.0 ron=1E8 roff=1.0
        s_high pos out signal 0 switch_high
        s_low  neg out signal 0 switch_low
        V1 signal 0 SIN(0 1 [value])
        .ends
        //Component 
        X_[individual] [VCC] [GND] [OUT] oscillator_standard_[individual]
	</Spice>
</Component>

<Component>
    <Description>
        An oscillator with pre-defined frequency. Creates a rectangular voltage. 
        The HIGH-voltage is specified by the VCC-pin, the LOW-voltage is specified by the GND-pin (which may be, but does not have to be connected to ground node)
    </Description>
    <eeschema_sch>
        L Oscillator:MAX7375AXR805
        ALIAS Oscillator:MAX7375AXR405 Oscillator:MAX7375AXR365 Oscillator:MAX7375AXR185 Oscillator:MAX7375AXR425 Oscillator:MAX7375AXR375 Oscillator:MAX7375AXR105
    </eeschema_sch>

			<link>
				<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fquarz-oszillatoren-1207071.html</url>
				<title>IF[language]EQUAL_TO de THENUebersicht Quarzoszillatoren ELSE Overview quartz oscillatorsENDIF</title>
				<detail>IF[language]EQUAL_TO de THENAuswahl an Quarzoszillatoren bei Conrad Electronic. Darunter ein Ratgeber zu Quarzoszillatoren. ELSE A collection of quartz oscillators at conrad electronic.ENDIF</detail>
			</link>
	</purchase>
    <Spice>
        IF [value] IS_NUMBER THEN<WARNING>The oscillator component "[name]" at ([xpos]|[ypos]) has a pre-defined frequency value. So the given value [value] is ignored.</WARNING>ENDIF
        .subckt oscillator_standard_[individual] pos neg out
        .param frequency=IF[model]EQUAL_TO Oscillator:MAX7375AXR805 THEN 8Meg ELSEIF[model]EQUAL_TO Oscillator:MAX7375AXR405 THEN 4Meg ELSEIF[model]EQUAL_TO Oscillator:MAX7375AXR365 3.57Meg ELSEIF[model]EQUAL_TO Oscillator:MAX7375AXR185 THEN 1.84Meg ELSEIF[model]EQUAL_TO Oscillator:MAX7375AXR425 THEN 4.19Meg ELSEIF[model]EQUAL_TO Oscillator:MAX7375AXR375 THEN 3.69Meg ELSEIF [model]EQUAL_TO Oscillator:MAX7375AXR105 THEN 1Meg ELSE <ERROR>The frequency for oscillator model [model] is not defined. So the component [name] at ([xpos]|[ypos]) can not be simulated</ERROR>ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF
        .model switch_high sw vt=0.0 ron=1.0 roff=1E8
        .model switch_low  sw vt=0.0 ron=1E8 roff=1.0
        s_high pos out signal 0 switch_high
        s_low  neg out signal 0 switch_low
        V1 signal 0 SIN(0 1 frequency)
        .ends
        //Component 
        X_[individual] [Vpos] [GND] [OUT] oscillator_standard_[individual]
    </Spice>
</Component>
<Component>
    <Description>
        An oscillator with an enable pin, called "EN" or "OE", which enables the output. The output is enabled, when the voltage at the enable pin is larger than vthresh+V_GND, where V_GND is the voltage at the GND-pin and vthresh is a parameter which can be set in parameter v_enable in the spice-section below.
        
        Creates a rectangular voltage at the output. Frequency in Herz as given in the parameter [value].
        When disabled, then the output is high-ohmic, but does NOT stop creating the frequency.
        (So the easiest way to define the behaviour of the output voltage when oscillator is disabled is to to use a pull-up or pull-down resistor at the output with a resistance smaller than the parameter "dis_rout".) 
        
        The HIGH-voltage is specified by the VCC-pin, the LOW-voltage is specified by the GND-pin (which may be, but does not have to be connected to ground node)
    </Description>
    <eeschema_sch>
        L Oscillator:ASE-xxxMHz
        ALIAS Oscillator:ASV-xxxMHz Oscillator:CXO_DIP8 Oscillator:CXO_DIP14 Oscillator:GTXO-14T Oscillator:TFT660 Oscillator:TFT680 Oscillator:TXC-7C Oscillator:XO32 Oscillator:XO53 Oscillator:XO91 
        ALIAS Oscillator:SG-51 Oscillator:SG-210SCD Oscillator:SG-210SDD Oscillator:SG-210SED Oscillator:SG-531 Oscillator:SG-615 Oscillator:SG-8002CA Oscillator:SG-8002CE Oscillator:SG-8002DB Oscillator:SG-8002DC Oscillator:SG-8002JA Oscillator:SG-8002JC Oscillator:SG-8002LB
    </eeschema_sch>
		<purchase>
			<link>
				<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fquarz-oszillatoren-1207071.html</url>
				<title>IF[language]EQUAL_TO de THENUebersicht Quarzoszillatoren ELSE Overview quartz oscillatorsENDIF</title>
				<detail>IF[language]EQUAL_TO de THENAuswahl an Quarzoszillatoren bei Conrad Electronic. Darunter ein Ratgeber zu Quarzoszillatoren. ELSE A collection of quartz oscillators at conrad electronic.ENDIF</detail>
			</link>
	</purchase>
    <Spice>
        IF [value] IS_NUMBER THENELSE <WARNING>The oscillator component "[name]" at ([xpos]|[ypos]) does not have a numeric frequency value.</WARNING>ENDIF
        .subckt oscillator_enable_[individual] enable pos neg out
        .param v_enable=1.0 //voltage [V] to enable oscillator
        .param dis_rout=1E9 //resistance [Ohm] of output when disabled
        .model switch_high sw vt=0.0 ron=1.0 roff=1E8
        .model switch_low  sw vt=0.0 ron=1E8 roff=1.0
        .model switch_out csw it=0.0 ron=1.0 roff=dis_rout
        s_high pos mid signal 0 switch_high
        s_low  neg mid signal 0 switch_low
        w_out  mid out Vmes switch_out
        Vsig signal 0 SIN(0 1 [value])
        Vmes enable rv DC 0
        Rmes rv neg 1E9
        .ends
        //Component with different names for pins:
        X_[individual] [EN] [Vdd] [GND] [OUT] oscillator_enable_[individual]
    </Spice>
    <eeschema_symbol>
    

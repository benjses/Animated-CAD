//      Someone who has a more realistic model which also works reliably in ngspice is very welcome to add it to the library
//      also you may of course contact us.

<Component>
    <Description>
		IF [Spice_Primitive] THEN // that is when an old KiCad version is used. Older versions have different variable names.
			DEFINE  [sim.device] [Spice_Primitive]
			<Dialog type="warning" title="not recommended source type">
				You are using a source that is not recommended to use with this old KiCad version:
				You are using model [model] for source [name].
				But you with KiCad versions older than 7, you should use pspice:Vsource instead.
			</Dialog>
		ENDIF	
	    DC voltage source for KiCad 7 and newer. 
		(If you are using an older Version, such as 5 or 6, you should use pspice:Vsource instead) 
    </Description>
    <eeschema_sch>
        L Simulation_SPICE:VDC
		ALIAS Simulation_SPICE:IDC
    </eeschema_sch>
	<eeschema_symbol>
		IF [sim.device] STARTS_WITH I THEN DEFINE [unit] A ELSE DEFINE [unit] V ENDIF
		DEFINE [number] AS_NUMBER OF:[value]
		IF [number] THENELSE
			<Dialog type="warning" title="dc source value not defined correctly">
				the dc source is not defined correctly. It might fail to simulate correctly.
				It should be a numeric value, but the value given is:
				[value]
			</Dialog>
		ENDIF

		// general symbol part:
		<.PortSym 0 200 [pin2] 0>
		<.PortSym 0 -200 [pin1] 0>
		<Ellipse -100 -100 200 200 #0000F0 2 1  #c0c0c0 1 0>
		<Line 0 -200 0 100 #0000F0 2 1>
		<Line 0 200 0 -100 #0000F0 2 1>
		IF [sim.device] STARTS_WITH I THEN
			<Line 0 -100 0 35 #0000F0 2 1>
			<Line 0 -65 15 -15 #0000F0 2 1>
			<Line 0 -65 -15 -15 #0000F0 2 1>
			<Line -100 0 200 0 #A0A0A0 2 1>
		ELSE
			<Text 50 -120 80 #FF0000 0 "+">
			<Text 50 120 80 #0000FF 0 "-">
			<Line 0 -100 0 200 #A0A0A0 2 1>
		ENDIF
		
		// form specific symbol part:
		//<Text 0  0 80 #A0A0A0 0 "[number][unit]">
		<Line -50 -25 100 0 #0000F0 2 1>
		<Line -35  25 70 0 #0000F0 2 1>
	</eeschema_symbol>
    <Spice>
	IF [sim.device] THEN // recommended use with KiCad 7 +
		[sim.device]_[individual] [pin1] [pin2] [sim.type] [value]
	ELSE // not recommended with older KiCad versions
        [Spice_Primitive]_[individual] [pin1] [pin2] [spice_model]
	ENDIF
    </Spice>
</Component>

<Component>
    <Description>
		IF [Spice_Primitive] THEN // that is when an old KiCad version is used. Older versions have different variable names.
			DEFINE  [sim.device] [Spice_Primitive]
			<Dialog type="warning" title="not recommended source type">
				You are using a source that is not recommended to use with this old KiCad version:
				You are using model [model] for source [name].
				But you with KiCad versions older than 7, you should use pspice:Vsource instead.
			</Dialog>
		ENDIF
		Pulsed voltage source for KiCad 7 and newer. 
		(If you are using an older Version, such as 5 or 6, you should use pspice:Vsource instead) 
    </Description>
    <eeschema_sch>
        L Simulation_SPICE:VPULSE
		ALIAS Simulation_SPICE:IPULSE
    </eeschema_sch>
	<eeschema_symbol>

		// general symbol part:
		<.PortSym 0 200 [pin2] 0>
		<.PortSym 0 -200 [pin1] 0>
		<Ellipse -100 -100 200 200 #0000F0 2 1  #c0c0c0 1 0>
		<Line 0 -200 0 100 #0000F0 2 1>
		<Line 0 200 0 -100 #0000F0 2 1>
		IF [sim.device] STARTS_WITH I THEN
			<Line 0 -100 0 35 #0000F0 2 1>
			<Line 0 -65 15 -15 #0000F0 2 1>
			<Line 0 -65 -15 -15 #0000F0 2 1>
			<Line -100 0 200 0 #A0A0A0 2 1>
		ELSE
			<Text 50 -120 80 #FF0000 0 "+">
			<Text 50 120 80 #0000FF 0 "-">
			<Line 0 -100 0 200 #A0A0A0 2 1>
		ENDIF
		
		// form specific symbol part:
		<Line -75 25  25  0    #0000F0 2 1>
		<Line -50 25  0   -50 #0000F0 2 1>
		<Line -50 -25 50 0    #0000F0 2 1>
		<Line 0    -25 0   50  #0000F0 2 1>
		<Line 0    25  50 0    #0000F0 2 1>
		<Line 50  25  0  -50  #0000F0 2 1>
		<Line 50  -25 25 0     #0000F0 2 1>
		
	</eeschema_symbol>
    <Spice>
	IF [sim.device] THEN // recommended use with KiCad 7 +
		DEFINE [V1] AS_WORD_RIGHT OF:y1 IN:[sim.params] // initial value
		DEFINE [V2] AS_WORD_RIGHT OF:y2 IN:[sim.params] // pulsed value
		DEFINE [TD] AS_WORD_RIGHT OF:td IN:[sim.params] // Delay time. Default=0 
		DEFINE [TR] AS_WORD_RIGHT OF:tr IN:[sim.params] // Rise time. Default=TStep.
		DEFINE [TF] AS_WORD_RIGHT OF:tf IN:[sim.params] // fall time. Default=TStep.
		DEFINE [PW] AS_WORD_RIGHT OF:tw IN:[sim.params] // high time=pulse width. Default=TStop. 
		DEFINE [PER] AS_WORD_RIGHT OF:per IN:[sim.params] // period time. Default=TStop. 
		DEFINE [NP] AS_WORD_RIGHT OF:NP IN:[sim.params] // number of pulses. Default=unlimited
		[sim.device]_[individual] [pin1] [pin2] [sim.type] ([V1] [V2] IF[TD]THEN[TD]ENDIF IF[TR]THEN[TR]ENDIF IF[TF]THEN[TF]ENDIF IF[PW]THEN[PW]ENDIF IF[PER]THEN[PER]ENDIF IF[NP]THEN[NP]ENDIF)
	ELSE // not recommended with older KiCad versions
        [Spice_Primitive]_[individual] [pin1] [pin2] [spice_model]
	ENDIF
    </Spice>
</Component>

<Component>
    <Description>
		IF [Spice_Primitive] THEN // that is when an old KiCad version is used. Older versions have different variable names.
			DEFINE  [sim.device] [Spice_Primitive]
			<Dialog type="warning" title="not recommended source type">
				You are using a source that is not recommended to use with this old KiCad version:
				You are using model [model] for source [name].
				But you with KiCad versions older than 7, you should use pspice:Vsource instead.
			</Dialog>
		ENDIF	
	    sine wave voltage source for KiCad 7 and newer. 
		Described in chapter 4.1.2 of https://ngspice.sourceforge.io/docs/ngspice-39-manual.pdf 
		(If you are using an older Version, such as 5 or 6, you should use pspice:Vsource instead) 
    </Description>
    <eeschema_sch>
        L Simulation_SPICE:VSIN
		ALIAS Simulation_SPICE:ISIN
    </eeschema_sch>
	<eeschema_symbol>
		// general symbol part:
		<.PortSym 0 200 [pin2] 0>
		<.PortSym 0 -200 [pin1] 0>
		<Ellipse -100 -100 200 200 #0000F0 2 1  #c0c0c0 1 0>
		<Line 0 -200 0 100 #0000F0 2 1>
		<Line 0 200 0 -100 #0000F0 2 1>
		IF [sim.device] STARTS_WITH I THEN
			<Line 0 -100 0 35 #0000F0 2 1>
			<Line 0 -65 15 -15 #0000F0 2 1>
			<Line 0 -65 -15 -15 #0000F0 2 1>
			<Line -100 0 200 0 #A0A0A0 2 1>
		ELSE
			<Text 50 -120 80 #FF0000 0 "+">
			<Text 50 120 80 #0000FF 0 "-">
			<Line 0 -100 0 200 #A0A0A0 2 1>
		ENDIF
		
		// form specific symbol part:
        A -40 0 40 1800 0 0 1 0 N 100 100 100 100
        A  40 0 40 0 -1800 0 1 0 N 100 -100 100 100
		//<Earc -60 0 180  180 60 35 #0000F0 2 1 2 1 0>
		//<Earc 0    0 180 -180 60 35 #0000F0 2 1 2 1 0>
		
	</eeschema_symbol>
    <Spice>
	IF [sim.device] THEN // recommended use with KiCad 7 +
		DEFINE [vo] AS_WORD_RIGHT OF:dc   IN:[sim.params] 
		DEFINE [va] AS_WORD_RIGHT OF:ampl IN:[sim.params] 
		DEFINE [freq] AS_WORD_RIGHT OF:f    IN:[sim.params]  
		DEFINE [td] AS_WORD_RIGHT OF:td   IN:[sim.params] 
		DEFINE [theta] AS_WORD_RIGHT OF:theta IN:[sim.params]
		//DEFINE [AC] AS_WORD_RIGHT OF:ac   IN:[sim.params] //ignored, can not be set in chapter 4.1.2 
		DEFINE [phase] AS_WORD_RIGHT OF:ph IN:[sim.params]  	
		[sim.device]_[individual] [pin1] [pin2] [sim.type] ([vo] [va] IF[freq]THEN[freq]ENDIF IF[td]THEN[td]ENDIF IF[theta]THEN[theta]ENDIF IF[phase]THEN[phase]ENDIF)
	ELSE // not recommended with older KiCad versions
        [Spice_Primitive]_[individual] [pin1] [pin2] [spice_model]
	ENDIF
    </Spice>
</Component>

<Component>
    <Description>
		IF [Spice_Primitive] THEN // that is when an old KiCad version is used. Older versions have different variable names.
			DEFINE  [sim.device] [Spice_Primitive]
			<Dialog type="warning" title="not recommended source type">
				You are using a source that is not recommended to use with this old KiCad version:
				You are using model [model] for source [name].
				But you with KiCad versions older than 7, you should use pspice:Vsource instead.
			</Dialog>
		ENDIF	
	    exponential voltage source for KiCad 7 and newer. 
		Described in chapter 4.1.3 of https://ngspice.sourceforge.io/docs/ngspice-39-manual.pdf 
		(If you are using an older Version, such as 5 or 6, you should use pspice:Vsource instead) 
    </Description>
    <eeschema_sch>
        L Simulation_SPICE:VEXP
		L Simulation_SPICE:IEXP
    </eeschema_sch>
		<eeschema_symbol>
		// general symbol part:
		<.PortSym 0 200 [pin2] 0>
		<.PortSym 0 -200 [pin1] 0>
		<Ellipse -100 -100 200 200 #0000F0 2 1  #c0c0c0 1 0>
		<Line 0 -200 0 100 #0000F0 2 1>
		<Line 0 200 0 -100 #0000F0 2 1>
		IF [sim.device] STARTS_WITH I THEN
			<Line 0 -100 0 35 #0000F0 2 1>
			<Line 0 -65 15 -15 #0000F0 2 1>
			<Line 0 -65 -15 -15 #0000F0 2 1>
			<Line -100 0 200 0 #A0A0A0 2 1>
		ELSE
			<Text 50 -120 80 #FF0000 0 "+">
			<Text 50 120 80 #0000FF 0 "-">
			<Line 0 -100 0 200 #A0A0A0 2 1>
		ENDIF
		
		// form specific symbol part:
		
		<Text -40 0 80 #A0A0A0 0 "exp">
		
	</eeschema_symbol>
    <Spice>
	IF [sim.device] THEN // recommended use with KiCad 7 +
		DEFINE [v1] AS_WORD_RIGHT OF:y1 IN:[sim.params] 
		DEFINE [v2] AS_WORD_RIGHT OF:y2 IN:[sim.params] 
		DEFINE [td1] AS_WORD_RIGHT OF:td1 IN:[sim.params]  
		DEFINE [tau1] AS_WORD_RIGHT OF:tau1 IN:[sim.params] 
		DEFINE [td2] AS_WORD_RIGHT OF:td2 IN:[sim.params]
		DEFINE [tau2] AS_WORD_RIGHT OF:tau2 IN:[sim.params]  	
		[sim.device]_[individual] [pin1] [pin2] [sim.type] ([v1] [v2] IF[td1]THEN[td1]ENDIF IF[tau1]THEN[tau1]ENDIF IF[td2]THEN[td2]ENDIF IF[tau2]THEN[tau2]ENDIF)
	ELSE // not recommended with older KiCad versions
        [Spice_Primitive]_[individual] [pin1] [pin2] [spice_model]
	ENDIF
    </Spice>
</Component>

<Component>
    <Description>
		IF [Spice_Primitive] THEN // that is when an old KiCad version is used. Older versions have different variable names.
			DEFINE  [sim.device] [Spice_Primitive]
			<Dialog type="warning" title="not recommended source type">
				You are using a source that is not recommended to use with this old KiCad version:
				You are using model [model] for source [name].
				But you with KiCad versions older than 7, you should use pspice:Vsource instead.
			</Dialog>
		ENDIF	
	    Piece wise voltage source for KiCad 7 and newer. 
		Described in chapter 4.1.3 of https://ngspice.sourceforge.io/docs/ngspice-39-manual.pdf 
		(If you are using an older Version, such as 5 or 6, you should use pspice:Vsource instead) 
    </Description>
    <eeschema_sch>
        L Simulation_SPICE:VPWL 
		ALIAS Simulation_SPICE:IPWL
    </eeschema_sch>
		<eeschema_symbol>
		// general symbol part:
		<.PortSym 0 200 [pin2] 0>
		<.PortSym 0 -200 [pin1] 0>
		<Ellipse -100 -100 200 200 #0000F0 2 1  #c0c0c0 1 0>
		<Line 0 -200 0 100 #0000F0 2 1>
		<Line 0 200 0 -100 #0000F0 2 1>
		IF [sim.device] STARTS_WITH I THEN
			<Line 0 -100 0 35 #0000F0 2 1>
			<Line 0 -65 15 -15 #0000F0 2 1>
			<Line 0 -65 -15 -15 #0000F0 2 1>
			<Line -100 0 200 0 #A0A0A0 2 1>
		ELSE
			<Text 50 -120 80 #FF0000 0 "+">
			<Text 50 120 80 #0000FF 0 "-">
			<Line 0 -100 0 200 #A0A0A0 2 1>
		ENDIF
		
		// form specific symbol part:
		<Line -50 20 20 -70 #0000F0 2 1>
		<Line -30 -50 20 30 #0000F0 2 1>
		<Line -10 -20 40 0 #0000F0 2 1>
		<Line 30 -20 20 -30 #0000F0 2 1>
		
	</eeschema_symbol>
    <Spice>
	IF [sim.device] THEN // recommended use with KiCad 7 +
		IF [sim.params] CONTAINS \ THEN 
			<Dialog type="Error" title="sim.params contains not allowed character">
				The component [name] contains an apostrophe or other unusual character.
				This disturbs the capturing process of the component, probably the simulation will fail.
				Please remove that special character out of the value of the simulation parameters of this component.
				
				It probably contains something like: pwl="0 -1 1m 2 ..."
				But should be written correctly as:  pwl=0 -1 1m 2 ... 
			</Dialog>
		ENDIF
		DEFINE [vi_ti] AS_SUBTEXT AFTER:pwl=OF:[sim.params]
		[sim.device]_[individual] [pin1] [pin2] [sim.type] ([vi_ti])
	ELSE // not recommended with older KiCad versions
        [Spice_Primitive]_[individual] [pin1] [pin2] [spice_model]
	ENDIF
    </Spice>
</Component>

<Component>
    <Description>
		IF [Spice_Primitive] THEN // that is when an old KiCad version is used. Older versions have different variable names.
			DEFINE  [sim.device] [Spice_Primitive]
			<Dialog type="warning" title="not recommended source type">
				You are using a source that is not recommended to use with this old KiCad version:
				You are using model [model] for source [name].
				But you with KiCad versions older than 7, you should use pspice:Vsource instead.
			</Dialog>
		ENDIF	
	    Transient noise voltage source for KiCad 7 and newer. 
		Described in chapter 4.1.7 of https://ngspice.sourceforge.io/docs/ngspice-39-manual.pdf 
		(If you are using an older Version, such as 5 or 6, you should use pspice:Vsource instead)

		Parameters NALPHA, NAMP,RTSAM,RTSCAPT and RTSEMT are ignored.
		Therefor this noise is simulated as white noise.
    </Description>
    <eeschema_sch>
        L Simulation_SPICE:VTRNOISE 
		ALIAS Simulation_SPICE:ITRNOISE
    </eeschema_sch>
	    
		<eeschema_symbol>
		// general symbol part:
		<.PortSym 0 200 [pin2] 0>
		<.PortSym 0 -200 [pin1] 0>
		<Ellipse -100 -100 200 200 #0000F0 2 1  #c0c0c0 1 0>
		<Line 0 -200 0 100 #0000F0 2 1>
		<Line 0 200 0 -100 #0000F0 2 1>
		IF [sim.device] STARTS_WITH I THEN
			<Line 0 -100 0 35 #0000F0 2 1>
			<Line 0 -65 15 -15 #0000F0 2 1>
			<Line 0 -65 -15 -15 #0000F0 2 1>
			<Line -100 0 200 0 #A0A0A0 2 1>
		ELSE
			<Text 50 -120 80 #FF0000 0 "+">
			<Text 50 120 80 #0000FF 0 "-">
			<Line 0 -100 0 200 #A0A0A0 2 1>
		ENDIF
		
		// form specific symbol part:
		<Line -70 -10  20 60 #0000FF 2 1>
		<Line -50 50  20 -100 #0000FF 2 1>
		<Line -30 -50 20 70 #0000FF 2 1>
		<Line -10 20  20 -30 #0000FF 2 1>
		<Line  10 -10 20 80 #0000FF 2 1>
		<Line  30 70  20 -20 #0000FF 2 1>
		<Line  50 50  20 -80 #0000FF 2 1>
	</eeschema_symbol>
    <Spice>
	IF [sim.device] THEN // recommended use with KiCad 7 +
		IF [sim.params] CONTAINS \ THEN 
			<Dialog type="Error" title="sim.params contains not allowed character">
				The component [name] contains an apostrophe or other unusual character.
				This disturbs the capturing process of the component, probably the simulation will fail.
				Please remove that special character out of the value of the simulation parameters of this component.
				
				It probably contains something like: rms="1 dt=1u ..."
				But should be written correctly as:  rms=1 dt=1u ... 
			</Dialog>
		ENDIF
		DEFINE [NA] AS_WORD_RIGHT OF:rms IN:[sim.params] // Rms noise amplitude (Gaussian)
		DEFINE [NT] AS_WORD_RIGHT OF:dt  IN:[sim.params] // time step
		[sim.device]_[individual] [pin1] [pin2] TRNOISE ([NA] [NT])
	ELSE // not recommended with older KiCad versions
        [Spice_Primitive]_[individual] [pin1] [pin2] [spice_model]
	ENDIF
    </Spice>
</Component>

<Component>
    <Description>
        A Diode. 
        Similar diode is L pspice:DIODE in components.alib - library
    </Description>
    <eeschema_sch>
        L Simulation_SPICE:DIODE
        F4 [Spice_Netlist_Enabled] //ignored
        F5 [Spice_Primitive] //ignored
    </eeschema_sch>
    <Spice>
        .model DIODE_[individual] D
        //IF [value] THENIF [value] EQUAL_TO "DIODE" THENELSE+ [value]ENDIFENDIF 
        D_[name] [A] [K] DIODE_[individual]
	</Spice>
</Component>

<Component>
    <Description>
        Operation Amplifier. 
        Highly idealized model, even has galvanic separation.
    </Description>
        <eeschema_sch>
        L Simulation_SPICE:OPAMP
        F4 [Spice_Netlist_Enabled] //ignored
        F5 [Spice_Primitive] //ignored
    </eeschema_sch>
    <eeschema_sch>
        L pspice:OPAMP
    </eeschema_sch>
    <eeschema_symbol>
    DRAW
        P 4 0 1 10 200 0 -200 200 -200 -200 200 0 f
        X in+ 1 -300 100 100 R 50 50 1 1 I
        T 0     -180 100 60 1 0 +
        X in- 2 -300 -100 100 R 50 50 1 1 I
        T 0     -180 -100 60 1 0 -
        X out 3 300 0 100 L 50 50 1 1 O
        X V+ 4 -100 300 150 D 50 50 1 1 W
        T 0    -100 100 50 1 0 v+
        X V- 5 -100 -300 150 U 50 50 1 1 W
        T 0    -100 -100 50 1 0 v-
    ENDDRAW
    </eeschema_symbol>
    <Spice>
        // ---- model ----
        .subckt spice_opamp_[individual] inpos inneg out vpos vneg
            //in
            Rin inpos inmid 75k
            Vmeas inmid inneg DC 0
            //out
            .model mdl_cswpos csw  ron=1    roff=1E9  it=0.0
            .model mdl_cswneg csw  ron=1E9  roff=1    it=0.0
            Wpos vpos out Vmeas mdl_cswpos
            Wneg vneg out Vmeas mdl_cswneg
        .ends
        // ---- component ----
        X_spice_opamp_[individual] [in+] [in-] [out] [V+] [V-] spice_opamp_[individual] 
    </Spice>
</Component>

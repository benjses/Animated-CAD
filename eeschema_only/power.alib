        (pts
          (xy 0 2.54)
          (xy 0.762 1.27)
        )
        (stroke (width 0) (type default))
        (fill (type none))
      )
    

      (pin power_in line (at 0 0 90) (length 0) hide
        (name "+10V" (effects (font (size 1.27 1.27))))

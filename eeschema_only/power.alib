// All texts are presented AS IS and the provider of this library is not liable for any consequences resulting from using it in any way.

//The following Power Flags create a global label on their connected node. Therefor they should be used only with caution,
//especially if there is one or more subsheets in the schematic.
//Also be aware that there are several types of flags that connect to ground. Even if these look different and have a different name, they are connected to each other on the ground node.
// -> So for the users: It is a good style not to use different types of ground nodes, but instead stick to only one type of GND. There is also the pspice:0 which is defined in the standard library Components.alib


// Ground flags:
<Component>
	<Description>
        A Flag that connects the node to ground. ATTENTION: There is only one ground. So even if you use different types of ground symbols, they are always connected to each other via ground
	</Description>
	<eeschema_sch>
		L power:Earth
		ALIAS power:Earth_Clean power:Earth_Protective power:GND power:GNDA power:GNDD power:GNDPWR power:GNDREF power:GNDS
		ALIAS power:GND1 power:GND2 power:GND3 
	</eeschema_sch>
	<Spice>
        DEFINE [name] AS_INVISIBLE
        DEFINE [value] AS_INVISIBLE
        //Connect pin to ground. Pinnames defined in the cache-lib-file of eeschema are as second part of the model, at least for these components. So we do not need to use [model]EQUAL_TO power:some_model , but can directly use the pin-names:
		0 connect IF[Earth]THEN[Earth]ELSEIF[Earth_Clean]THEN[Earth_Clean]ELSEIF[Earth_Protective]THEN[Earth_Protective]ELSEIF[GND]THEN[GND]ELSEIF[GNDA]THEN[GNDA]ELSEIF[GNDD]THEN[GNDD]ELSEIF[GNDPWR]THEN[GNDPWR]ELSEIF[GNDREF]THEN[GNDREF]ELSEIF[GNDS]THEN[GNDS]ELSE<Dialog type="error">Unknown pin name for ground flag model [model],used in component [name] at ([xpos] | [ypos])</Dialog> ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF 
	</Spice>
	<purchase>
        <link>
		    <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Ferdungsbaender-6140350.html</url>
			<title>IF [language] EQUAL_TO "de" THENUebersicht ErdungELSEOverview of earthingENDIF</title>
			<detail>IF [language] EQUAL_TO "de" THENVerschiedene Massnahmen zur Erdung, wie Erdungsbaender oder Erdungsstangen bei Conrad ElectronicELSEVarious measures for grounding, such as flat bands or grounding rodsENDIF</detail>
		</link>
		<link>
			<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fp%2Fflachband-erder-4571137-lapp-inhalt-1-st-603498.html</url>
			<title>IF [language] EQUAL_TO "de" THENFlachband-ErderELSEflat band for groundingENDIF</title>
			<detail>flat band at Vonrad Electronic</detail>
		</link>
	</purchase>
    <eeschema_symbol>
	   IF [model] ENDS_WITH GNDD THEN
		DRAW
			S -50 -60 50 -80 0 1 10 F
			P 2 0 1 0 0 0 0 -60 N
			X GND 1 0 0 0 D 50 50 1 1 W N
		ENDDRAW
       ELSE
		IF [model] ENDS_WITH GND THEN // GND model = triangle 
		   DRAW
			P 6 0 1 0 0 0 0 -50 50 -50 0 -100 -50 -50 0 -50 N
			X GND 1 0 0 0 D 50 50 1 1 W N
			ENDDRAW
		 ELSE // default ground/earth model = three horizontal lines
		    (polyline
      (pts
        (xy -0.635 -1.905)
        (xy 0.635 -1.905)
      )
      (stroke (width 0) (type default))
      (fill (type none))
    )
    (polyline
      (pts
        (xy -0.127 -2.54)
        (xy 0.127 -2.54)
      )
      (stroke (width 0) (type default))
      (fill (type none))
    )
    (polyline
      (pts
        (xy 0 -1.27)
        (xy 0 0)
      )
      (stroke (width 0) (type default))
      (fill (type none))
    )
    (polyline
      (pts
        (xy 1.27 -1.27)
        (xy -1.27 -1.27)
      )
      (stroke (width 0) (type default))
      (fill (type none))
    )
  

    (pin power_in line (at 0 0 270) (length 0) hide
      (name "GND" (effects (font (size 1.27 1.27))))
      (number "1" (effects (font (size 1.27 1.27))))
    )
		 ENDIF		
		ENDIF	
    </eeschema_symbol>
</Component>

// Non-ground flags:
<Component>
    <Description>
        A flag named +10V with exactly one pin named +10V which sets the connected node to the global flag named PLUS10V
    </Description>
    <eeschema_sch>
        L power:+10V
    </eeschema_sch>
    <Spice>
        [+10V] connect PLUS10V
    </Spice>
    <eeschema_symbol>


<Component>
<Description>
A Voltage Source in Kicad Eeschema.
(When [spice_primitive] is I, then it is a Current Source)
</Description>
<eeschema_sch>
L pspice:VSOURCE
F0 "[name]"
F1 "[value]" // Attention: When value is set to a number, then sets this source as dc source with that value, and ignores the spice-model!
F2 "[footprint]"
F3 "[datasheet]"
F4 "[spice_primitive]"
F5 "[spice_model]"
F6 "[spice_netlist_enabled]"
</eeschema_sch>
<eeschema_symbol>
    IF [Spice_Model] THEN
        DEFINE [spice_model] [Spice_Model]
        DEFINE [spice_model] AS_VISIBLE
        DEFINE [Spice_Model] AS_NULL
    ENDIF

	DEFINE [v_dc] AS_NUMBER OF:[value]
	
	
	DRAW
	IF [value] CONTAINS squaresymbol THEN
        S -200 -200 200 200 0 1 0 N
    ELSE
        <Text 50 -220 80 #FF0000 0 "+">
        <Text 50  220 80 #0000FF 0 "-">
        C 0 0 200 0 1 0 N
        IF [spice_primitive] EQUAL_TO I THEN
            <Line -200 0 400 0 #A0A0A0 2 1>
        ELSE
            <Line 0 -200 0 400 #A0A0A0 2 1>
        ENDIF
    ENDIF
        X npos 1 0 300 100 D 50 50 1 1 I
        X nneg 2 0 -300 100 U 50 50 1 1 I
    
	IF [v_dc] THEN 
		<Text 0  0 80 #A0A0A0 0 "[v_dc]IF[spice_primitive]THEN[spice_primitive]ELSEVENDIF">
		<Line -100 -50 200 0 #0000F0 2 1>
		<Line -70   50 140 0 #0000F0 2 1>
	ELSE IF [spice_model] STARTS_WITH pulse THEN
		<Line -150 50  50  0    #0000F0 2 1>
		<Line -100 50  0   -100 #0000F0 2 1>
		<Line -100 -50 100 0    #0000F0 2 1>
		<Line 0    -50 0   100  #0000F0 2 1>
		<Line 0    50  100 0    #0000F0 2 1>
		<Line 100  50  0  -100  #0000F0 2 1>
		<Line 100  -50 50 0     #0000F0 2 1>
	ELSE IF [spice_model] STARTS_WITHsinTHEN
        A -60 0 60 1800 0 0 1 0 N 100 100 100 100
        A  60 0 60 0 -1800 0 1 0 N 100 -100 100 100
		//<Earc -120 0 180  180 120 70 #0000F0 2 1 2 1 0>
		//<Earc 0    0 180 -180 120 70 #0000F0 2 1 2 1 0>
	ENDIF ENDIF ENDIF
    ENDDRAW
    

</eeschema_symbol>
<Spice>

    IF [spice_primitive] EQUAL_TO I THEN I_[name]  [npos] [nneg]ELSE V_[name] [npos] [nneg]ENDIF IF [v_dc] THEN dc [v_dc] ELSE IF[spice_model]THEN[spice_model]ELSE[value]ENDIF ENDIF
</Spice>
	<purchase>
			<link>
				<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Ffunktionsgeneratoren-1100100.html</url>
				<title>IF[language] EQUAL_TO de THEN Uebersicht Funktionsgeneratoren ELSE Overview function generatorsENDIF</title>
				<detail>IF[language] EQUAL_TO de THEN Eine Auswahl an Funktionsgeneratoren bei Conrad Electronic. Darunter eine Beschreibung. ELSE A collection of function generators at Conrad Electronic.ENDIF</detail>
			</link>
			<link>
				<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fc%2Fnetzgeraete-und-netzteile-37349.html</url>
				<title>IF[language] EQUAL_TO de THEN Uebersicht Netzteile ELSE Voltage supplyENDIF</title>
				<detail>IF[language] EQUAL_TO de THEN Eine Auswahl an Netzteilen bei Conrad Electronic. Darunter eine Beschreibung. ELSE A collection of voltage supply components of various types at Conrad Electronic.ENDIF</detail>
			</link>
			IF [v_dc] THEN
				<link>
					<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fp%2Fbasetech-bt-305-labornetzgeraet-einstellbar-0-30-v-dc-0-5-a-150-w-anzahl-ausgaenge-1-x-513812.html</url>
					<title>IF [language] EQUAL_TO de THEN Labornetzgeraet 0-30V ELSE Variable voltage supply 0-30VENDIF</title>
					<detail>IF [language] EQUAL_TO de THEN Ein einstellbares Gleichspannungs-Netzteil mit einer Ausgangsspannung von 0 bis 30 V bei Conrad Electronic. ELSE A voltage supply with a settable output voltage between 0 and 30V.ENDIF</detail>
				</link>
			ENDIF
	</purchase>
</Component>

<Component>
<Description>
A Current Source in Kicad Eeschema. 
(When spice_primitive is V, then it is a Voltage Source)
</Description>
<eeschema_sch>
L pspice:ISOURCE
F0 "[name]"
F1 "[value]" // Attention: When value is set to a number, then sets this source as dc source with that value, and ignores the spice-model!
F2 "[footprint]"
F3 "[datasheet]"
F4 "[spice_primitive]"
F5 "[spice_model]"
F6 "[spice_netlist_enabled]"
</eeschema_sch>
<eeschema_symbol>
    IF [Spice_Model] THEN
        DEFINE [spice_model] [Spice_Model]
        DEFINE [spice_model] AS_VISIBLE
        DEFINE [Spice_Model] AS_NULL
    ENDIF
    
    DEFINE [i_dc] AS_NUMBER OF:[value]
	<Line 0 -400 0 200 #0000F0 2 1>
	<Line 0 400 0 -200 #0000F0 2 1>
	
	IF [value] CONTAINS squaresymbol THEN
        <Rectangle -200 -200 400 400 #0000F0 2 1  #c0c0c0 1 0>
	ELSE
        <Text 50 -220 80 #FF0000 0 "+">
        <Text 50 220 80 #0000FF 0 "-">
        <Ellipse -200 -200 400 400 #0000F0 2 1  #c0c0c0 1 0>
    ENDIF
	
	<.PortSym 0 400 [npos] 0>
	<.PortSym 0 -400 [nneg] 0>
	
	IF [spice_primitive] EQUAL_TO V THEN
		<Line 0 -200 0 400 #A0A0A0 2 1>
	ELSE
		<Line -200 0 400 0 #A0A0A0 2 1>
	ENDIF
	IF [i_dc] THEN 
		<Text 0  0 80 #A0A0A0 0 "[i_dc]IF[spice_primitive]THEN[spice_primitive]ELSEAENDIF">
		<Line -100 -50 200 0 #0000F0 2 1>
		<Line -70   50 140 0 #0000F0 2 1>
	ELSE IF [spice_model] STARTS_WITH pulse THEN
		<Line -150 50  50  0    #0000F0 2 1>
		<Line -100 50  0   -100 #0000F0 2 1>
		<Line -100 -50 100 0    #0000F0 2 1>
		<Line 0    -50 0   100  #0000F0 2 1>
		<Line 0    50  100 0    #0000F0 2 1>
		<Line 100  50  0  -100  #0000F0 2 1>
		<Line 100  -50 50 0     #0000F0 2 1>
	ELSE IF [spice_model] STARTS_WITH sin THEN
		<Earc -120 0 180  180 120 70 #0000F0 2 1 2 1 0>
		<Earc 0    0 180 -180 120 70 #0000F0 2 1 2 1 0>
	ENDIF ENDIF ENDIF
</eeschema_symbol>
<Spice>
IF [spice_primitive] EQUAL_TO V THEN V_[name] [npos] [nneg]ELSE I_[name]  [npos] [nneg]ENDIF IF [i_dc] THEN dc [i_dc] ELSE IF[spice_model]THEN[spice_model]ELSE[value]ENDIF ENDIF
</Spice>

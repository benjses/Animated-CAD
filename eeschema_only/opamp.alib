        rc2   4 12 5.305E3
        re1  13 10 1.845E3
        re2  14 10 1.845E3
        ree  10 99 13.25E6
        ro1   8  5 50
        ro2   7 99 25
        rp    3  4 9.082E3
        vb    9  0 dc 0

        L Relay:FINDER-36.11-4301
		DEFINE [datasheet] www.finder-relais.net/en/finder-relays-series-36.pdf
		DEFINE [conrad_de] finder-36-11-9-012-4011-printrelais-12-v-dc-10-a-1-wechsler-1-st-503078.html
        IF[value]MATCHESFINDER-36\.11\.9\.((003)|(005)|(006)|(009)|(012)|(024)|(048))[\.0-9]*THEN
            DEFINE [nr_switches] 1
            DEFINE [switch_type] CO
            DEFINE [I_destroy_switch] 15
            DEFINE [U_n] AS_SUBSTRING FROM:15 TO:18 OF:[value]
            DEFINE [U_destroy_coil] ([U_n]*1.5)
            DEFINE [U_set] ([U_n]*0.75)
            DEFINE [U_reset] ([U_n]*0.2)
            DEFINE [R_coil] (2.778*[U_n]*[U_n])
            // no [coil_direction]
        ELSE
            <Dialog type="error">
                You have chosen the component at ([xpos]|[ypos]) to be a relay of the series [model]
                Please select one of the available models of that series. You can do so by setting the value to:
            
                FINDER-36.11.9.nnn
                
                where:
                FINDER-36.11.9. is the model series to be written literally, (!also with the dots!),
                nnn is the nominal voltage in three digits, one of the values 005 006 009 012 024 048 060
                
                For example, FINDER-36.11.9.012 is a valid value. But the value given, [value] is not.
                You can find the datasheet with this part description at [datasheet].
            </Dialog>
        ENDIF

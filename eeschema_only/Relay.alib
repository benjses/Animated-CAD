        P 2 0 1 8 175 0 200 0 N
        P 2 0 1 8 225 0 250 0 N
        P 2 0 1 8 275 0 300 0 N
        P 2 0 1 0 300 100 300 200 N
        P 2 0 1 8 325 0 350 0 N
        P 2 0 1 20 400 -100 325 150 N
        P 2 0 1 0 400 -100 400 -200 N
        P 2 0 1 0 500 100 500 200 N
        P 3 0 1 0 -100 100 -75 125 -100 150 F
        P 3 0 1 0 100 100 75 125 100 150 N
        P 3 0 1 0 300 100 325 125 300 150 F
        P 3 0 1 0 500 100 475 125 500 150 N
        X coil_S_pos 1 -500 300 100 D 50 50 1 1 P
        X coil_R_pos 10 -500 -300 100 U 50 50 1 1 P
        X sw1_toB 2 -100 300 100 D 50 50 1 1 P
        X sw1_from 3 0 -300 100 U 50 50 1 1 P
        X sw1_toA 4 100 300 100 D 50 50 1 1 P

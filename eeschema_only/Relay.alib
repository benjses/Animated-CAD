        X sw2_toA 7 500 300 100 D 50 50 1 1 P
        X sw2_from 8 400 -300 100 U 50 50 1 1 P
        X sw2_toB 9 300 300 100 D 50 50 1 1 P
      ENDDRAW
    </eeschema_symbol>
    <Spice>
        // ---- model ----
        .subckt relay_[individual] coil_S_pos coil_R_pos coil_S_neg coil_R_neg sw1_from sw1_toA sw1_toB sw2_from sw2_toA sw2_toB
        //independent parameters: TODO adapt for P2
        .param ohm_coil=IF[value]EQUAL_TO3THEN90.0ELSEIF[value]EQUAL_TO5THEN250ELSEIF[value]EQUAL_TO6THEN360ELSEIF[value]EQUAL_TO9THEN810ELSEIF[value]EQUAL_TO12THEN1440ELSEIF[value]EQUAL_TO24THEN3840ELSE100<WARNING>Please select one of the following values for the relay [name] at ([xpos]|[ypos]):
        3 (to choose AZ850P1-3)
        5 (to choose AZ850P1-5)
        6 (to choose AZ850P1-6)
        9 (to choose AZ850P1-9)
        12 (to choose AZ850P1-12)
        24 (to choose AZ850P1-24)
       You can see models available in this model serie in the datasheet at azettler.com/pdfs/az850.pdf 
        The value entered, [value] ,does not define a model of this model series.
        (Please write these numbers exactly as shown, do not write something like "12.0" or "AZ850P2-12": you just need to write "12")
            
        In case you do not select one of these values, some idealized but not realistic simulation parameters for this relay component are automatically selected.
        </WARNING>ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF
        
        .param henry_coil=1p //henry value is not specified in the datasheet. TODO ask the guys at azettler.        
        .param v_min=IF[value]EQUAL_TO3THEN2.3 ELSEIF[value]EQUAL_TO5THEN3.8 ELSEIF[value]EQUAL_TO6THEN4.5 ELSEIF[value]EQUAL_TO9THEN6.8 ELSEIF[value]EQUAL_TO12 THEN9.0 ELSEIF[value]EQUAL_TO24THEN18.0 ELSE1 ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF //see "must operate" - voltage in datasheet
        .param v_max=IF[value]EQUAL_TO3THEN8.7 ELSEIF[value]EQUAL_TO5THEN14.5 ELSEIF[value]EQUAL_TO6THEN17.4  ELSEIF[value]EQUAL_TO9THEN26.1 ELSEIF[value]EQUAL_TO12THEN34.8 ELSEIF[value]EQUAL_TO24THEN57.6 ELSE1E9 ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF
       //dependent parameters:
        .param ampere_on=v_min/ohm_coil //current on S-coil to set   (in direction from pos to neg)
        .param ampere_off=ampere_on     //current on R-coil to reset (in direction from pos to neg)
        .param ampere_destroy=v_max/ohm_coil 
        
        //Set-coil:
        v_coil_S_meas coil_S_pos coil_S_vl DC 0
        l_coil_S      coil_S_vl  coil_S_lf henry_coil
        //Reset-coil:
        v_coil_R_meas coil_R_pos coil_R_vl DC 0
        l_coil_R      coil_R_vl  coil_R_lf henry_coil
        //fuses in coils:
        s_fuse_S coil_S_lf coil_S_neg broken_fuse_S 0 fuse
        s_fuse_R coil_R_lf coil_R_neg broken_fuse_R 0 fuse
        .model fuse sw ron=1E9 roff=ohm_coil vt=0.5
        //set and hold:            |<--------------- set --------------->| || |<---- hold ------>|
        B_fuse_S broken_fuse_S 0 V=abs(I(v_coil_S_meas)) > ampere_destroy  || V(broken_fuse_S) > 0.5 ? 1 : 0
        B_fuse_R broken_fuse_R 0 V=abs(I(v_coil_R_meas)) > ampere_destroy  || V(broken_fuse_R) > 0.5 ? 1 : 0
        //set and hold:        (|<-------- set ----------->|) || (|<---- hold --->| && |<---- not reset ---------->|)
        B_set_on  coil_set 0 V=(I(v_coil_S_meas) > ampere_on) || (V(coil_set) > 0.5 && I(v_coil_R_meas) < ampere_off) ? 1 : 0
        //switches:
        .model model_sXa sw vt=0.5 ron=1 roff=1E9
        .model model_sXb sw vt=0.5 ron=1E9 roff=1
        s1a sw1_from sw1_toA coil_set 0 model_sXa
        s1b sw1_from sw1_toB coil_set 0 model_sXb
        s2a sw2_from sw2_toA coil_set 0 model_sXa
        s2b sw2_from sw2_toB coil_set 0 model_sXb
        .ends
        // ---- component ----
        X_relay_[individual] [coil_S_pos] [coil_R_pos] [coil_S_neg] [coil_R_neg] [sw1_from] [sw1_toA] [sw1_toB] [sw2_from] [sw2_toA] [sw2_toB] relay_[individual]
    </Spice>
</Component>

        L Relay:FINDER-40.11
        ALIAS Relay:FINDER-40.11-2016 Relay:FINDER-40.31 Relay:FINDER-40.41 Relay:FINDER-40.51 Relay:FINDER-40.52
        DEFINE [nr_switches] AS_SUBSTRING FROM:17 TO:18 OF:[model]
        DEFINE [switch_type] CO
        
        IF[value]MATCHESFINDER-40\.(1|3|5|6)(1|2)\.(7|8|9)\.((005)|(006)|(007)|(009)|(012)|(014)(018)|(021)|(024)|(028)|(036)|(048)|(060)|(090)|(110)|(120)|(125)|(230)|(240))[\.0-9]*THEN
            DEFINE [U_n] AS_SUBSTRING FROM:15 TO:18 OF:[value]
            DEFINE [coil_direction] AS_SUBSTRING FROM:13 TO:14 OF:[value]
            IF[coil_direction]EQUAL_TO 9 THEN //standart 0.65W
                DEFINE [coil_direction] BottomNeg_PosTop
                DEFINE [U_destroy_coil] ([U_n]*1.5)
                DEFINE [U_set] ([U_n]*0.73)
                DEFINE [R_coil] (1.52*[U_n]*[U_n])
            ELSEIF[coil_direction]EQUAL_TO 7 THEN //sensitive 0.5W
                DEFINE [coil_direction] BottomNeg_PosTop
                DEFINE [U_destroy_coil] ([U_n]*1.5)
                DEFINE [U_set] ([U_n]*0.73)
                DEFINE [R_coil] (2.0*[U_n]*[U_n])
            ELSEIF[coil_direction]EQUAL_TO 8 THEN
                DEFINE [coil_direction] AC // AC coil model
                DEFINE [f_n] 55 //50-60 Hertz
                DEFINE [U_destroy_coil] (1.1*[U_n]*1.732) //factor 1.732=sqrt(3) because effective value, not peak
                DEFINE [U_set] (0.8*[U_n]*1.732) //factor 1.732=sqrt(3) because effective value, not peak
                DEFINE [R_coil] (0.57*[U_n]*[U_n])
                IF [U_n] EQUAL_TO 120 THEN DEFINE [R_coil] 9k ENDIF
                IF [U_n] EQUAL_TO 230 THEN DEFINE [R_coil] 28k ENDIF
                IF [U_n] EQUAL_TO 240 THEN DEFINE [R_coil] 31500 ENDIF
            ELSE
                <Dialog type="error"> coil code [coil_direction] not defined for model [model] , component [name] , [value]</Dialog>
            ENDIF ENDIF ENDIF
            DEFINE [U_reset] ([U_n]*0.2)    
        ELSE
            <Dialog type="error">
                You have chosen the component at ([xpos]|[ypos]) to be a relay of the series [model]
                Please select one of the available models of that series. You can do so by setting the value to:
                
                FINDER-40.tp.c.nnn
                
                where:
                FINDER-40. is the model series to be written literally, (also with the dot and the bar and no spaces)
                t is the pinning type in one digit, one of the values 1 3 5 6
                p is the number of poles, in one digit, 1 or 2
                c is the coil version in one digit: 7 or 9 for DC-coil, or 8 for AC-coil
                
                nnn is the nominal voltage in three digits, one of the values 005 006 007 009 012 014018 021 024 028 036 048 060 090 110 120 125 230 240
                
                For example, FINDER-40.11.9.012 is a valid value. But the value given, [value] is not.
                You can find the datasheet with this part description at [datasheet].
            </Dialog>
        ENDIF
     </eeschema_sch>   
    <eeschema_sch>
        L Relay:FINDER-41.52
		DEFINE [datasheet] www.finder-relais.net/en/finder-relays-series-41.pdf
		DEFINE [conrad_de] finder-41-52-9-012-0010-printrelais-12-v-dc-8-a-2-wechsler-1-st-503105.html
        DEFINE [nr_switches] 2
        DEFINE [switch_type] CO
        DEFINE [U_destroy_switch] 400
        IF[value]MATCHESFINDER-41\.52\.(6|8|9)\.[0-9][0-9][0-9](\.[0-9]*)?THEN
            DEFINE [coil_direction] AS_SUBSTRING FROM:13 TO:14 OF:[value]//thats coil type, not [U_n], but overwritten below:
            IF [coil_direction] EQUAL_TO 6 THEN
                <Dialog type="error">Two-coil model of Series Finder 41 is not supported, because the symbol in eeschema has different
                pins. So before we can use this model, it needs to be added to eeschema and to Relay.alib</Dialog>
            ELSE IF[coil_direction] EQUAL_TO 8 THEN 
                DEFINE [coil_direction] AC // AC model
                DEFINE [U_n] AS_SUBSTRING FROM:15 TO:18 OF:[value]
                IF[U_n] EQUAL_TO 024 THEN
                    DEFINE [U_set] (19.2*1.732)//factor 1.732=sqrt(3) because effective value, not peak
                    DEFINE [U_reset] (0.45*[U_n])
                    DEFINE [U_destroy_coil] (26.4*1.732) //factor 1.732=sqrt(3) because effective value, not peak
                    DEFINE [R_coil] 350
                ELSEIF [U_n] EQUAL_TO 230 THEN
                    DEFINE [U_set] (184*1.732)//factor 1.732=sqrt(3) because effective value, not peak
                    DEFINE [U_reset] (0.2*[U_n])
                    DEFINE [U_destroy_coil] (253*1.732)//factor 1.732=sqrt(3) because effective value, not peak
                    DEFINE [R_coil] 32500
                    
                ELSE<Dialog type="error"> [U_n]V  is not an allowed nominal voltage for AC-type of model [model], see [datasheet]</Dialog>
                ENDIF ENDIF
            ELSE IF[coil_direction] EQUAL_TO 9 THEN 
                DEFINE [coil_direction] AS_NULL //no direction: DC model with indifference of direction
                DEFINE [U_n] AS_SUBSTRING FROM:15 TO:18 OF:[value]
                
                DEFINE [U_set] ([U_n]*0.7)
                DEFINE [U_reset] ([U_n]*1.5)
                IF [U_n] EQUAL_TO 110 THEN
                    DEFINE [R_coil] 24200
                ELSE
                    DEFINE [R_coil] ([U_n]*[U_n]*2.5) //5²*2.5=ca62 6²*2.5=90 12²*2.5=360 ...
                ENDIF
                
            ELSE <Dialog type="error">Unknown coil type for nr [U_n] in model [model]</Dialog>
            ENDIF ENDIF ENDIF

        ELSE
        <Dialog type="error">
                You have chosen the component at ([xpos]|[ypos]) to be a relay of the series [model]
                Please select one of the available models of that series. You can do so by setting the value to:
                
                FINDER-41.52.c.nnn
                
                where:
                FINDER-40. is the model series to be written literally, (also with the dot and the bar and no spaces)
                c is the coil version in one digit: 9 for DC-coil, or 8 for AC-coil (6 for DC-bistable is not supported)
                
                nnn is the nominal voltage in three digits, one of the values:
                    005 006 012 024 048 060 110 if the coil code c is 9
                    024 230 if the coil code c is 8
                
                For example, FINDER-41.52.9.012 is a valid value. But the value given, [value] is not.
                You can find the datasheet with this part description at [datasheet].
            </Dialog>
        ENDIF
    </eeschema_sch>
   <eeschema_symbol>
    DRAW 
       IF[nr_switches]EQUAL_TO1THEN//relay with one switch
        IF [switch_type]EQUAL_TO CO THEN
            S -400 200 400 -200 0 1 10 f
        ELSE
            IF [switch_type] EQUAL_TO NC || [switch_type] EQUAL_TO NO THEN
                S -400 200 350 -200 0 1 10 f
            ELSE
                <Dialog type="error">types of switches for component [name] [value] not defined</Dialog>//TODO make message more specific!
            ENDIF
        ENDIF
        S -325 75 -75 -75 0 1 10 N
        P 2 0 1 10 -300 -75 -100 75 N
        P 2 0 1 0 -200 -200 -200 -75 N
        P 2 0 1 0 -200 200 -200 75 N
        P 2 0 1 10 -75 0 -50 0 N
        P 2 0 1 10 -25 0 0 0 N
        P 2 0 1 10 25 0 50 0 N
        P 2 0 1 10 25 0 50 0 N
        P 2 0 1 10 75 0 100 0 N
        P 2 0 1 10 125 0 150 0 N
        P 2 0 1 0 200 -100 200 -200 N
        //coil pins:
        IF[coil_direction]THEN
            IF[coil_direction]EQUAL_TO TopNeg_PosBottom THEN
                X coil_pos 2 -200 -300 100 U 50 50 1 1 P
                X coil_neg 6 -200 300 100 D 50 50 1 1 P
                P 2 0 1 0 -240 -250 -220 -250 N
                P 2 0 1 0 -230 -260 -230 -240 N
                P 2 0 1 0 -240 250 -220 250 N
            ELSE IF[coil_direction]EQUAL_TO BottomNeg_PosTop THEN
                X coil_neg 2 -200 -300 100 U 50 50 1 1 P
                X coil_pos 6 -200 300 100 D 50 50 1 1 P
                P 2 0 1 0 -240 250 -220 250 N
                P 2 0 1 0 -230 260 -230 240 N
                P 2 0 1 0 -240 -250 -220 -250 N
            ELSE IF[coil_direction] EQUAL_TO AC THEN
                X coil_neg 2 -200 -300 100 U 50 50 1 1 P
                X coil_pos 6 -200 300 100 D 50 50 1 1 P
                 A -240 250 30 0 1800    0 0 0 0 -220 250 -220 250
                A -290 250 30 1800 3600 0 0 0 0 -270 250 -210 250
                A -240 -250 30 1800 3600 0 0 0 0 -220 -250 -220 -250
                A -290 -250 30 0 1800    0 0 0 0 -210 -250 -210 -250
            ELSE <Dialog type="error">the coil direction value, [coil_direction], is not a valid one for relay model [model]
            name [name] ,value [value] at ([xpos]|[ypos])</Dialog>
            ENDIF ENDIF ENDIF
        ELSE // no directed coils (still have coil_pos and coil_neg, but the direction of current is no more important)
            X coil_pos 2 -200 -300 100 U 50 50 1 1 P
            X coil_neg 6 -200 300 100 D 50 50 1 1 P
        ENDIF
        // 1 switch
        X sw1_from 1 200 -300 100 U 50 50 1 1 P
        IF[switch_type]EQUAL_TO NO THEN
            IF[sw1AX200]THEN
                X sw1_toA 7 200 300 200 D 0 50 1 1 P
            ELSE
                X sw1_toA 7 300 300 200 D 0 50 1 1 P
            ENDIF
            //P 4 0 0 0 200 150 200 100 175 125 200 150 N
            P 2 0 1 20 200 -100 125 150 N
            //P 2 0 0 0 200 150 200 200 N //connection line (single)
        ELSEIF[switch_type]EQUAL_TO NC THEN
            X sw1_toB 7 200 300 100 D 50 50 1 1 P
            P 4 0 0 0 200 150 200 100 175 125 200 150 F
            P 2 0 1 20 200 -100 175 150 N
             P 2 0 0 0 200 150 200 200 N //connection line (single)
        ELSEIF[switch_type]EQUAL_TO CO THEN
            X sw1_toB 1 100 300 100 D 50 50 1 1 P
            X sw1_toA 14 300 300 100 D 50 50 1 1 P
            P 4 0 0 0 300 150 300 100 275 125 300 150 N
            P 3 0 1 0 100 100 125 125 100 150 F
            P 2 0 1 20 200 -100 125 150 N
            P 2 0 0 0 100 150 100 200 N //connection line (left)
            P 2 0 0 0 300 150 300 200 N //connection line (right)
        ELSE<Dialog type="error">drawing for types of switches for component [name] [value] not defined</Dialog>//TODO make message more specific!
        ENDIF ENDIF ENDIF
    
      ELSEIF[nr_switches]EQUAL_TO2THEN
        IF[switch_type] EQUAL_TO CO THEN
            S -600 200 600 -200 0 1 10 f
            S -525 75 -275 -75 0 1 10 N
            P 2 0 1 10 -500 -75 -300 75 N
            P 2 0 1 0 -400 -200 -400 -75 N
            P 2 0 1 0 -400 200 -400 75 N
            P 2 0 1 10 -275 0 -250 0 N
            P 2 0 1 10 -225 0 -200 0 N
            P 2 0 1 10 -175 0 -150 0 N
            P 2 0 1 10 -125 0 -100 0 N
            P 2 0 1 0 -100 100 -100 200 N
            P 2 0 1 10 -75 0 -50 0 N
            P 2 0 1 10 -25 0 0 0 N
            P 2 0 1 20 0 -100 -75 150 N
            P 2 0 1 0 0 -100 0 -200 N
            P 2 0 1 10 25 0 50 0 N
            P 2 0 1 10 75 0 100 0 N
            P 2 0 1 0 100 100 100 200 N
            P 2 0 1 10 125 0 150 0 N
            P 2 0 1 10 175 0 200 0 N
            P 2 0 1 10 225 0 250 0 N
            P 2 0 1 10 275 0 300 0 N
            P 2 0 1 0 300 100 300 200 N
            P 2 0 1 10 325 0 350 0 N
            P 2 0 1 20 400 -100 325 150 N
            P 2 0 1 0 400 -100 400 -200 N
            P 2 0 1 0 500 100 500 200 N
            P 3 0 1 0 -100 100 -75 125 -100 150 F
            P 3 0 1 0 100 100 75 125 100 150 N
            P 3 0 1 0 300 100 325 125 300 150 F
            P 3 0 1 0 500 100 475 125 500 150 N
            IF[coil_direction]THEN
                IF[coil_direction]EQUAL_TO TopNeg_PosBottom THEN
                    X coil_pos 2 -400 -300 100 U 50 50 1 1 P
                    X coil_neg 6 -400 300 100 D 50 50 1 1 P
                    P 2 0 1 0 -440 -250 -420 -250 N
                    P 2 0 1 0 -430 -260 -430 -240 N
                    P 2 0 1 0 -440 250 -420 250 N
                ELSE IF[coil_direction]EQUAL_TO BottomNeg_PosTop THEN
                    X coil_neg 2 -400 -300 100 U 50 50 1 1 P
                    X coil_pos 6 -400 300 100 D 50 50 1 1 P
                    P 2 0 1 0 -440 250 -420 250 N
                    P 2 0 1 0 -430 260 -430 240 N
                    P 2 0 1 0 -440 -250 -420 -250 N
                ELSE IF[coil_direction] EQUAL_TO AC THEN
                    X coil_neg 2 -400 -300 100 U 50 50 1 1 P
                    X coil_pos 6 -400 300 100 D 50 50 1 1 P
                    A -440 250 30 0 1800    0 0 0 0 -420 250 -420 250
                    A -490 250 30 1800 3600 0 0 0 0 -470 250 -410 250
                    A -440 -250 30 1800 3600 0 0 0 0 -420 -250 -420 -250
                    A -490 -250 30 0 1800    0 0 0 0 -470 -250 -410 -250
                ELSE 
                    <Dialog type="error">the coil direction value, [coil_direction], is not a valid one for relay model [model]                name [name] ,value [value] at ([xpos]|[ypos])</Dialog>
                ENDIF ENDIF ENDIF
            ELSE // no directed coils (still have coil_pos and coil_neg, but the direction of current is no more important)
                X coil_pos 4 -400 -300 100 U 50 50 1 1 P
                X coil_neg 5 -400 300 100 D 50 50 1 1 P
            ENDIF
            X sw1_from 1    0 -300 100 U 50 50 1 1 P
            X sw2_from 14 400 -300 100 U 50 50 1 1 P
            X sw1_toB 7 -100 300 100 D 50 50 1 1 P
            X sw1_toA 6 100 300 100 D 50 50 1 1 P
            X sw2_toB 8 300 300 100 D 50 50 1 1 P
            X sw2_toA 9 500 300 100 D 50 50 1 1 P
        ELSE // switch_type NC or NO
            S -500 200 450 -200 0 1 10 f
            P 2 0 1 0 -300 -200 -300 -75 N
            P 2 0 1 0 -300 200 -300 75 N
            S -425 75 -175 -75 0 1 10 N
            P 2 0 0 0 100 150 100 200 N
            P 2 0 0 0 400 150 400 200 N
            P 2 0 1 10 -400 -75 -200 75 N
            P 2 0 1 10 -175 0 -150 0 N
            P 2 0 1 10 -125 0 -100 0 N
            P 2 0 1 10 -75 0 -50 0 N
            P 2 0 1 10 -75 0 -50 0 N
            P 2 0 1 10 -25 0 0 0 N
            P 2 0 1 10 25 0 50 0 N
            P 2 0 1 10 75 0 100 0 N
            P 2 0 1 0 100 -100 100 -200 N
            P 2 0 1 10 125 0 150 0 N
            P 2 0 1 10 175 0 200 0 N
            P 2 0 1 10 225 0 250 0 N
            P 2 0 1 10 275 0 300 0 N
            P 2 0 1 10 325 0 350 0 N
            P 2 0 1 0 400 -100 400 -200 N
            IF[coil_direction]THEN
                IF[coil_direction]EQUAL_TO TopNeg_PosBottom THEN
                    X coil_pos 2 -300 -300 100 U 50 50 1 1 P
                    X coil_neg 6 -300 300 100 D 50 50 1 1 P
                    P 2 0 1 0 -340 -250 -320 -250 N
                    P 2 0 1 0 -330 -260 -330 -240 N
                    P 2 0 1 0 -340 250 -320 250 N
                ELSE IF[coil_direction]EQUAL_TO BottomNeg_PosTop THEN
                    X coil_neg 2 -300 -300 100 U 50 50 1 1 P
                    X coil_pos 6 -300 300 100 D 50 50 1 1 P
                    P 2 0 1 0 -340 250 -320 250 N
                    P 2 0 1 0 -330 260 -330 240 N
                    P 2 0 1 0 -340 -250 -320 -250 N
                ELSE 
                    <Dialog type="error">the coil direction value, [coil_direction], is not a valid one for relay model [model]                name [name] ,value [value] at ([xpos]|[ypos])</Dialog>
                ENDIF ENDIF
            ELSE // no directed coils (still have coil_pos and coil_neg, but the direction of current is no more important)
                X coil_pos 4 -400 -300 100 U 50 50 1 1 P
                X coil_neg 5 -400 300 100 D 50 50 1 1 P
            ENDIF            
            X sw1_from 1 100 -300 100 U 50 50 1 1 P
            X sw2_from 14 400 -300 100 U 50 50 1 1 P
            IF[switch_type]EQUAL_TO NO THEN
                X sw1_toA 7 100 300 100 D 50 50 1 1 P
                X sw2_toA 8 400 300 100 D 50 50 1 1 P
                P 4 0 0 0 100 150 100 100 75 125 100 150 N
                P 4 0 0 0 400 150 400 100 375 125 400 150 N
                P 2 0 1 20 400 -100 325 150 N
                P 2 0 1 20 100 -100 25 150 N
            ELSEIF[switch_type]EQUAL_TO NC THEN
                X sw1_toB 7 100 300 100 D 50 50 1 1 P
                X sw2_toB 8 400 300 100 D 50 50 1 1 P
                P 4 0 0 0 100 150 100 100 75 125 100 150 F
                P 4 0 0 0 400 150 400 100 375 125 400 150 F
                P 2 0 1 20 400 -100 375 150 N
                P 2 0 1 20 100 -100 75 150 N
            ENDIF ENDIF 
        ENDIF
        ELSE<Dialog type="error">Relay type [model] named [name] at ([xpos]|[ypos]) has [nr_switches] switches, but the symbol 
            drawing for relays only is specified for 1 or 2 switches.</Dialog>
      ENDIF ENDIF //[nr_switches]
    ENDDRAW
    </eeschema_symbol>
    <purchase>
		<link>
		<url>cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fc%2Frelais-17391.html</url>
		<title>IF [language] EQUAL_TO de THEN Uebersicht Relais ELSE Overview relaysENDIF</title>
		<detail>IF [language] EQUAL_TO de THEN Eine Auswahl an Relais bei Conrad Electronic. Darunter eine Beschreibung. ELSE A collection of relays of various types at conrad electronic.ENDIF</detail>
		</link>
		IF [conrad_de] THEN
		<link>
		    <url>cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fp%2F[conrad_de]</url>
			<title>component of [model] series</title>
			<detail>a relais of the [model] series at conrad electronic. Please make sure that you select a matching relais, e.g. make sure that the nominal voltage is correct for your purpose.</detail>
		</link>
		ENDIF
	</purchase>
    <Spice>
        // --- explaination of variables ----
        // [R_coil] is the resistance of the coil
        
        // [U_set] is the voltage at which the coil sets
        // [U_reset] is the voltage at which the coil resets
        // [nr_switches] is the number of switches: 1 or 2
        // [switch_type] is the type of the switch(es): NO=nomally open, NC=nomally contacted, CO=Changeover

        // optional parameters:
        // [L_coil] is the inductance of the coil.
            // When not given, then so small that it is irrelevant (1pH).
        // [coil_direction] is the direction of the coil: 
             // TopNeg_PosBottom and BottomNeg_PosTop are for directed coils,
             // AC is for alternating currents,
             // and if that variable does not exist, then the direction of the current is irrelevant,so the coil works in both directions.
        // [f_n] is the nominal frequency for AC coils. (when [f_n] exists, but [coil_direction] is not AC then [f_n] is ignored.)
            //  when not given, then default frequency is 50Hertz.
        // [U_destroy_coil] is the voltage at which the coil burns through.
            // When not given, then so large, that it's irrelevant (1MegaVolt)
        // [I_destroy_switch] is the current at which the contacted switch burns through.
            // When not given, then so large, that it's irrelevant (1MegaVolt)
        
        //---- Pre-compiler ----
        IF [U_destroy_coil]   THENELSE DEFINE [U_destroy_coil]   1E9 ENDIF
        IF [U_destroy_switch] THENELSE DEFINE [U_destroy_switch] 1E9 ENDIF
        
        // ---- model ----
        .subckt relay_[individual] coil_pos coil_neg sw1_from IF[switch_type]EQUAL_TO NO THEN sw1_toA  ELSEIF [switch_type]EQUAL_TONCTHEN sw1_toB ELSEIF[switch_type]EQUAL_TO CO THEN sw1_toA sw1_toB ELSE <Dialog type="error">types of switches for component [name] [value] not defined</Dialog> ENDIF ENDIF ENDIF IF[nr_switches]HIGHER_THAN1THEN sw2_from IF[switch_type]EQUAL_TO NO THEN sw2_toA  ELSEIF [switch_type]EQUAL_TONCTHEN sw2_toB ELSEIF[switch_type]EQUAL_TO CO THEN sw2_toA sw2_toB ELSE <Dialog type="error">types of switches for component [name] [value] not defined</Dialog> ENDIF ENDIF ENDIF ENDIF
       //model parameters:
       .param ampere_on=[U_set]/[R_coil]
       .param ampere_off=[U_reset]/[R_coil]
       .param ampere_destroy_coil=[U_destroy_coil]/[R_coil]
       IF[I_destroy_switch]THEN
           .param ampere_destroy_switch=[I_destroy_switch]
       ELSE
           .param ampere_destroy_switch=[U_destroy_switch]/ohm_contact
        ENDIF
        IF[R_coil]THEN
            .param ohm_coil=[R_coil]
        ELSE
            <Dialog type="error">The coil resistance, [R_coil] is not defined for component:
                    named [name]
                    value [value]
                    model [model]
                    at ([xpos]|[ypos])
            </Dialog>
        ENDIF
       IF [coil_direction]EQUAL_TO AC THEN
            IF [f_n] THEN
                .param tau_n=1/[f_n]
            ELSE
                .param tau_n=1/50
            ENDIF
        ENDIF
       IF[L_coil]THEN
            .param henry_coil=[L_coil]
       ELSE
            .param henry_coil=1p   //not specified in the datasheet. TODO ask the Producers of the components.
       ENDIF
       .param ohm_contact=10m/2 //divided by two because used in fuse and in switch. not specified in the datasheet. TODO ask the Producers of the components.
        
        //coil:
        l_coil coil_pos coil_lf henry_coil
        //fuse in coil (contains [R_coil]):
        s_fuse_coil coil_lf coil_neg broken_fuse_coil 0 fuse_coil
        //fuses in switches:
        IF [switch_type] EQUAL_TO NO THEN s_fuse_sw1A sw1_midA sw1_toA broken_fuse_sw1A 0 fuse_switch ELSE
        IF [switch_type] EQUAL_TO NC THEN s_fuse_sw1B sw1_midB sw1_toB broken_fuse_sw1B 0 fuse_switch ELSE
        IF [switch_type] EQUAL_TO CO THEN s_fuse_sw1A sw1_midA sw1_toA broken_fuse_sw1A 0 fuse_switch
                                          s_fuse_sw1B sw1_midB sw1_toB broken_fuse_sw1B 0 fuse_switch
        ELSE <Dialog type="error"> types of switches for component [name] [value] not defined</Dialog>//TODO make message more specific!
        ENDIF ENDIF ENDIF 
        IF[nr_switches]HIGHER_THAN1THEN
            IF [switch_type] EQUAL_TO NO THEN s_fuse_sw2A sw2_midA sw2_toA broken_fuse_sw2A 0 fuse_switch ELSE
            IF [switch_type] EQUAL_TO NC THEN s_fuse_sw2B sw2_midB sw2_toB broken_fuse_sw2B 0 fuse_switch ELSE
            IF [switch_type] EQUAL_TO CO THEN s_fuse_sw2A sw2_midA sw2_toA broken_fuse_sw2A 0 fuse_switch
                                              s_fuse_sw2B sw2_midB sw2_toB broken_fuse_sw2B 0 fuse_switch
            ELSE <Dialog type="error"> types of switches for component [name] [value] not defined<Dialog type="error">//TODO make message more specific!
            ENDIF ENDIF ENDIF 
        ENDIF
        //TODO: these fuse models interrupt without any time delay. It would be more realistic to interrupt after a few ms.
        //set and hold fuses:            |<------------ set --------------->| || |<------- hold -------->|
        B_fuse_coil broken_fuse_coil 0 V=abs(I(l_coil)) > ampere_destroy_coil || V(broken_fuse_coil) > 0.5 ? 1 : 0
        B_fuse_sw1A broken_fuse_sw1A 0 V=abs(I(s1a)) > ampere_destroy_switch  || V(broken_fuse_sw1A) > 0.5 ? 1 : 0
        B_fuse_sw1B broken_fuse_sw1B 0 V=abs(I(s1b)) > ampere_destroy_switch  || V(broken_fuse_sw1B) > 0.5 ? 1 : 0
        IF[nr_switches]HIGHER_THAN1THEN
            //set and hold fuses:            |<------------ set --------------->| || |<------- hold -------->|
            B_fuse_sw2A broken_fuse_sw2A 0 V=abs(I(s2a)) > ampere_destroy_switch  || V(broken_fuse_sw2A) > 0.5 ? 1 : 0
            B_fuse_sw2B broken_fuse_sw2B 0 V=abs(I(s2b)) > ampere_destroy_switch  || V(broken_fuse_sw2B) > 0.5 ? 1 : 0
            IF[nr_switches]HIGHER_THAN2THEN
                <Dialog type="error">Relay type [model] named [name] at ([xpos]|[ypos]) has [nr_switches] switches, but the simulation for relays only is specified for up to 2 switches.
                </Dialog>
            ENDIF
        ENDIF
        //fuse models:
        .model fuse_coil   sw ron=1E9 roff=ohm_coil    vt=0.5
        .model fuse_switch sw ron=1E9 roff=ohm_contact vt=0.5
        IF[coil_direction]THEN
            IF[coil_direction] CONTAINS Neg_Pos THEN //current only from pin [coil_pos] to pin [coil_neg]
                //set and hold switches(|<-------- set -------->|) || (|<---- hold --->| && |<------ not reset ----->|)
                B_set_on  coil_set 0 V=(  I(l_coil)   > ampere_on) || (V(coil_set) > 0.5 &&     I(l_coil) > ampere_off) ? 1 : 0
            ELSEIF[coil_direction]EQUAL_TO AC THEN
                //set and hold switches(|<-------- set -------->|) || (|<---- hold --->| && |<------ not reset ----->|)
                B_set_on  mid_set  0 V=(abs(I(l_coil))> ampere_on) || (V(coil_set) > 0.5 && abs(I(l_coil))> ampere_off) ? 2 : 0
                R_set_on mid_set coil_set 1 //
                C_set_on coil_set 0 tau_n
            ELSE
                <Dialog type="error">coil direction value "[coil_direction]" is not an allowed value</Dialog>
            
            ENDIF ENDIF
            ELSE //no [coil_direction] means, that current in any direction sets:
                //set and hold switches(|<-------- set -------->|) || (|<---- hold --->| && |<------ not reset ----->|)
                B_set_on  coil_set 0 V=(abs(I(l_coil))> ampere_on) || (V(coil_set) > 0.5 && abs(I(l_coil))> ampere_off) ? 1 : 0
        ENDIF
        //switches:
        .model model_sXa sw vt=0.5 ron=ohm_contact roff=1E6
        .model model_sXb sw vt=0.5 ron=1E6 roff=ohm_contact
        s1a sw1_from sw1_midA coil_set 0 model_sXa
        s1b sw1_from sw1_midB coil_set 0 model_sXb
        IF[nr_switches]HIGHER_THAN1THEN
        s2a sw2_from sw2_midA coil_set 0 model_sXa
        s2b sw2_from sw2_midB coil_set 0 model_sXb
        ENDIF
        .ends
        // ---- component ----
        X_relay_[individual] [coil_pos] [coil_neg] [sw1_from] IF[switch_type]EQUAL_TO NO THEN[sw1_toA] ELSEIF[switch_type]EQUAL_TO NC THEN [sw1_toB] ELSEIF [switch_type]EQUAL_TO CO THEN[sw1_toA] [sw1_toB] ELSE  <Dialog type="error">types of switches for component [name] [value] not defined</Dialog> ENDIF ENDIF ENDIF IF[nr_switches]HIGHER_THAN1THEN [sw2_from] IF[switch_type]EQUAL_TO NO THEN [sw2_toA] ELSEIF[switch_type]EQUAL_TO NC THEN [sw2_toB]ELSEIF [switch_type]EQUAL_TO CO THEN [sw2_toA] [sw2_toB] ELSE<Dialog type="error">types of switches for component [name] [value] not defined</Dialog>ENDIF ENDIF ENDIF ENDIF relay_[individual]
    </Spice>
</Component>

<Component>
    <Description>
        A bistable relay with two coils: one to set and one to reset. 
        Also with two switches.
        
        This model contains a fuse to simulate the fact that the coil can get destroyed by exceeding the maximal rating.
        The coil is considered "destroyed" as soon current of ampere_destroy is reached, see Spice section below.9
    </Description>
    <eeschema_sch>
        L Relay:AZ850P2-x // datasheet at azettler.com/pdfs/az850.pdf 
    </eeschema_sch>
    <eeschema_symbol>

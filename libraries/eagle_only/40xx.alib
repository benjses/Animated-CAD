<Component>
    <Description>
        Dual AND gate, model 4081
        IF [gate] EQUAL_TO P THEN
         This is the power block for all components of that model.
        ELSE
         This model needs a Power Block in order to define positive and negative power supply connections.
         If you have multiple components from these models, then one power block is enough for all.
        ENDIF
    </Description>
    <eagle_sch>
        L 4081 
        DEFINE [logic_type] and2
    </eagle_sch>
    <eagle_sch>
        L 4071
        DEFINE [logic_type] or2
    </eagle_sch>
    <eagle_symbol>
        IF [gate] EQUAL_TO P THEN // Power block
            <pin name="VSS" x="0" y="-7.62" visible="pad" length="middle" direction="pwr" rot="R90"/>
            <pin name="VDD" x="0" y="7.62" visible="pad" length="middle" direction="pwr" rot="R270"/>
            <SET_CONNECTION [vss_logic_minus] 0 -7.62> 
            <SET_CONNECTION [vdd_logic_plus] 0 7.62>
            // + sign:
                <wire x1="1" y1="4.5" x2="2" y2="4.5" >
                <wire x1="1.5" y1="5" x2="1.5" y2="4">
            // - sign:
                <wire x1="1" y1="-4.5" x2="2" y2="-4.5" >
            // rest:
            <wire x1="-2.54" y1="-0.889" x2="2.54" y2="-0.889" width="0.254" layer="94"/>
            <wire x1="2.54" y1="0.889" x2="-2.54" y2="0.889" width="0.254" layer="94"/>
            <wire x1="2.54" y1="-0.889" x2="2.54" y2="0.889" width="0.254" layer="94"/>
            <wire x1="-2.54" y1="-0.889" x2="-2.54" y2="0.889" width="0.254" layer="94"/>
        ELSEIF [model] ENDS_WITH 4081 THEN // two input AND gate:
            <pin GET_CONNECTION [vss_logic_minus]/>
            <pin GET_CONNECTION [vdd_logic_plus]/>
            <wire x1="-2.54" y1="5.08" x2="-2.54" y2="-5.08" width="0.4064" layer="94"/>
            <wire x1="-2.54" y1="5.08" x2="-2.54" y2="-5.08" width="0.4064" layer="94" curve="-180"/>
            <pin name="IN0" x="-7.62" y="2.54" visible="pad" length="middle" direction="in" swaplevel="1"/>
            <pin name="IN1" x="-7.62" y="-2.54" visible="pad" length="middle" direction="in" swaplevel="1"/>
            <pin name="OUT" x="7.62" y="0" visible="pad" length="middle" direction="out" rot="R180"/>
        ELSEIF [model] ENDS_WITH 4071 THEN // two input OR gate:
            <pin GET_CONNECTION [vss_logic_minus]/>
            <pin GET_CONNECTION [vdd_logic_plus]/>
            <wire x1="-2.54" y1="5.08" x2="-2.54" y2="-5.08" width="0.4064" layer="94" curve="-180"/>
            <wire x1="1.778" y1="2.54" x2="-2.54" y2="2.54" width="0.1524" layer="94"/>
            <wire x1="1.778" y1="-2.54" x2="-2.54" y2="-2.54" width="0.1524" layer="94"/>
            <wire x1="-2.54" y1="5.08" x2="-2.54" y2="-5.08" width="0.4064" layer="94"/>
            <text x="2.54" y="3.175" size="1.778" layer="95">&gt;NAME</text>
            <text x="2.54" y="-5.08" size="1.778" layer="96">&gt;VALUE</text>
            <pin name="IN0" x="-7.62" y="2.54" visible="pad" length="middle" direction="in" swaplevel="1"/>
            <pin name="IN1" x="-7.62" y="-2.54" visible="pad" length="middle" direction="in" swaplevel="1"/>
            <pin name="OUT" x="7.62" y="0" visible="pad" length="middle" direction="out" rot="R180"/>
        ENDIF ENDIF ENDIF
    </eagle_symbol>
    <Spice>
        IF [gate] EQUAL_TO P THEN // Power block
            R_[individual] [VSS] [VDD] 1E9
        ELSE // normal and gate
            //------------- Model --------------------------
            .subckt mdl_4081 inA inB vpos vneg out
            //---------- input: analog to digital ----------   
            //digital model with xspice. converts input into digital value, calculates, and converts output to analog value.
            .model mdl_a_to_d adc_bridge
            .model mdl_d_to_a dac_bridge
            
            A_adc_inA %vd[inA vneg] [dig_inA] mdl_a_to_d
            A_adc_inB %vd[inB vneg] [dig_inB] mdl_a_to_d

            // ----------- processing ------------------------
            // processes the digital signal values.
           IF [logic_type] CONTAINS and2 THEN
                .model and2 d_and
                a_and [dig_inA dig_inB] dig_out and2
            ELSE IF [logic_type] CONTAINS or2 THEN
                .model or2 d_or
                a_or [dig_inA dig_inB] dig_out or2
            ELSE
               <Dialog dimension="400x200" type="error" title="missing or wrong logic type '[logic_type]'">
                    The logic type is either not defined, or [logic_type] does not have a processing description in the spice section. Please check your component library for model [model].
                </Dialog>
            ENDIF ENDIF
            // -------- output: digital to analog ---------
            .param rout = 1.0 //output resistance, when enabled
            .model mdl_swpos sw  ron=1    roff=1E9  vt=0.5
            .model mdl_swneg sw  ron=1E9  roff=1    vt=0.5
                        
            //        dig_in    out    model
            A_dac_out [dig_out] [out1v] mdl_d_to_a
            S_pos_qout vpos outpre out1v 0 mdl_swpos
            S_neg_qout vneg outpre out1v 0 mdl_swneg
            
            R_out out outpre rout
            .ends
            // component
            X_[individual] [IN0] [IN1] [vdd_logic_plus] [vss_logic_minus] [OUT] mdl_4081
            
        ENDIF
    </Spice>
</Component>

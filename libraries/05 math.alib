// component library for "components" that do NOT imitate electrical devices, but mathematical operations.
// A practical use of such mathematical "components" is to create and test electic-equivalent-circuits

// Bauteilbibliothek für "Komponenten" welche NICHT elektrische Geräte imitieren, sondern mathematische Operationen.
// Eine praktische Anwendung solcher mathematischer "Komponenten" ist, elektrische Ersatz-Schaltbilder (ESB) zu erstellen und testen.

<Component>
	<Description>
		IF [language] EQUAL_TO de THEN
			Grundrechenarten Addition, Subtraktion, Multiplikation und Division:
			a steht für add, s für sub, m für mul und d für div.
			
			Verarbeitet spannungen, zum Beispiel:
			Wenn der Wert aa ist, dann werden zwei Spannungen addiert.
			Wenn der Wert as ist, dann werden sie von einander subtrahiert,
			Wenn der Wert ss ist, dann werden beide Werte subtrahiert (d.h. ihre jeweils negativen Spannungswerte addiert)
			Wenn der Wert mm ist, dann werden beide Werte miteinander multipliziert.
			Wenn der Wert md ist, dann werden die Werte durcheinander dividiert (am d-Eingang darf niemals 0 Volt anliegen, sonst Fehler!)
			Wenn der Wert dd ist, dann wird 1V durch beide Werte geteilt (die beide in diesem Fall nie 0V haben dürfen)
		ELSE
			Basic calculations addition, subtraction, multiplication and division.
			a for add, s for sub, m for mul, and d for div.
			
			Processes voltages, for example:
			When the value is aa then both voltages are added.
			When the value is as then they are subtracted from each other.
			When the value is ss then both are subtracted (that is their negative voltage values are added).
			When the value is mm then both values are multiplied with each other.
			When the value is md then the values are divided by each other (the d-input may never have 0 Volt, otherwise Error!).
			When the value is dd then 1V is divided by both values (wich both may never have 0V in this case).
		ENDIF
	</Description>
	<Default_Values>
		aa// adds two voltages
		as// subtracts one voltage from the other
		mm// multiplies two voltages
		md// divides one voltage from the other (make sure the d pin is never zero!)
	</Default_Values>
	<eeschema_sch>
		L anicad:add_sub_mul_div
	</eeschema_sch>
	<eeschema_symbol>
		// find out the two input symbols:
		DEFINE [val_lc] AS_LOWERCASE OF:[value]
		DEFINE [val_lc] AS_REPLACEMENT FROM:xTO:mOF:[val_lc] // convert x to m, so that x also is a multiplier.
		DEFINE [val_lc] AS_REPLACEMENT FROM:*TO:mOF:[val_lc] // convert * to m, so that * also is a multiplier.
		DEFINE [val_lc] AS_REPLACEMENT FROM:+TO:aOF:[val_lc] // + to a, so that plus also is addition
		DEFINE [val_lc] AS_REPLACEMENT FROM:-TO:sOF:[val_lc] // - to s, so that minus also is subtraction
		DEFINE [val_lc] AS_REPLACEMENT FROM:/TO:dOF:[val_lc] // / to d, so that / also is division
		
		IF [val_lc]MATCHES[mdas][mdas]THEN
			// operands in equation
			DEFINE [operand1] AS_SUBSTRING FROM:0 TO:1 OF:[val_lc]
			IF [operand1] EQUAL_TO a THEN DEFINE [operand1] + ENDIF
			IF [operand1] EQUAL_TO s THEN DEFINE [operand1] - ENDIF
			IF [operand1] EQUAL_TO m THEN DEFINE [operand1] * ENDIF
			IF [operand1] EQUAL_TO d THEN DEFINE [operand1] / ENDIF
			DEFINE [operand2] AS_SUBSTRING FROM:1 TO:2 OF:[val_lc]
			IF [operand2] EQUAL_TO a THEN DEFINE [operand2] + ENDIF
			IF [operand2] EQUAL_TO s THEN DEFINE [operand2] - ENDIF
			IF [operand2] EQUAL_TO m THEN DEFINE [operand2] * ENDIF
			IF [operand2] EQUAL_TO d THEN DEFINE [operand2] / ENDIF
		ELSE
			<Dialog type="error" title="wrong input for math basic component">
				The component for basic math operations only allows + - x d symbols and needs exactly two symbols given.
				The given value, "[value]" is not valid.
				(Also make sure you do not have other characters in the value, not even any spaces)
			</Dialog>
		ENDIF
		// symbol body - circle:
		(circle (center 0 0) (radius 5.08)
		  (stroke (width 0) (type default))
		  (fill (type none))
		)
	  
	  // input 1 with + or - or x or / symbol:
		(pin input line (at -7.62 0 0) (length 2.54)
		  (name "in1" (effects (font (size 1.27 1.27))))
		  (number "1" (effects (font (size 1.27 1.27))))
		)
		IF [operand1] EQUAL_TO + || [operand1] EQUAL_TO -  THEN
			(polyline // horizontal line creates a minus - sybmol
			  (pts
				(xy -4.0 0)
				(xy -2.0 0)
			  )
			  (stroke (width 0) (type default))
			  (fill (type none))
			)
			IF [operand1] EQUAL_TO + THEN // vertical line turns - to + symbol
				(polyline 
				  (pts
					(xy -3.0 -1.0)
					(xy -3.0 1.0)
				  )
				  (stroke (width 0) (type default))
				  (fill (type none))
				)
			ENDIF
			
		ENDIF
		IF [operand1] EQUAL_TO / THEN // two points make a division symbol			
			(circle (center -3.0 -0.5) (radius 0.2)
			  (stroke (width 0) (type default))
			  (fill (type none))
			)
			(circle (center -3.0 0.5) (radius 0.2)
			  (stroke (width 0) (type default))
			  (fill (type none))
			)

			ENDIF
		
		IF [operand1] EQUAL_TO *   THEN
			(polyline	// x symbol for multiplication
			  (pts
				(xy -4.0 -1.0)
				(xy -2.0 1.0)
			  )
			  (stroke (width 0) (type default))
			  (fill (type none))
			)
		  (polyline
			  (pts
				(xy -2.0 -1.0)
				(xy -4.0 1.0)
			  )
			  (stroke (width 0) (type default))
			  (fill (type none))
			) 
		ENDIF
		
		// input 2 with + or - or x or / symbol:
		(pin input line (at 0 -7.62 90) (length 2.54)
		  (name "in2" (effects (font (size 1.27 1.27))))
		  (number "2" (effects (font (size 1.27 1.27))))
		)
		IF [operand2] EQUAL_TO + || [operand2] EQUAL_TO -  THEN
			// horizontal line for -
			(polyline
			  (pts
				(xy -1.0 -3.0)
				(xy 1.0 -3.0)
			  )
			  (stroke (width 0) (type default))
			  (fill (type none))
			)
			IF [operand2] EQUAL_TO + THEN // vertical line makes - to +
				(polyline
				  (pts
					(xy 0 -2.0)
					(xy 0 -4.0)
				  )
				  (stroke (width 0) (type default))
				  (fill (type none))
				)
			ENDIF
		ENDIF
		
		IF [operand2] EQUAL_TO / THEN
				
			(circle (center 0.0 -2.5) (radius 0.2)
			  (stroke (width 0) (type default))
			  (fill (type none))
			)
			(circle (center 0.0 -3.5) (radius 0.2)
			  (stroke (width 0) (type default))
			  (fill (type none))
			)
			ENDIF
		
		
		IF [operand2] EQUAL_TO * THEN
			// two diagonal lines making an x for multiplication
			(polyline
			  (pts
				(xy -1.0 -4.0)
				(xy 1.0 -2.0)
			  )
			  (stroke (width 0) (type default))
			  (fill (type none))
			)
			(polyline
			  (pts
				(xy 1.0 -4.0)
				(xy -1.0 -2.0)
			  )
			  (stroke (width 0) (type default))
			  (fill (type none))
			)
		ENDIF
		
		// output with = symbol: 
		(pin output line (at 7.62 0 180) (length 2.54)
		  (name "out" (effects (font (size 1.27 1.27))))
		  (number "3" (effects (font (size 1.27 1.27))))
		)
		(polyline
		  (pts
			(xy 2.0 -0.5)
			(xy 4.0 -0.5)
		  )
		  (stroke (width 0) (type default))
		  (fill (type none))
		)
		(polyline
		  (pts
			(xy 2.0 0.5)
			(xy 4.0 0.5)
		  )
		  (stroke (width 0) (type default))
		  (fill (type none))
		)  
	</eeschema_symbol>
	<Spice>
		.subckt calculations_[individual] in1 in2 out
			// process [operand1]: make intermediary result and store it in voltage at eq1:
			IF[operand1] EQUAL_TO + || [operand1] EQUAL_TO - THEN // eq1=0+V(in1) or eq1=0-V(in1)
				E1 eq1 0 value={0[operand1]V(in1)} 
			ELSE // symbol is x for mul or d for div
				E1 eq1 0 value={1[operand1]V(in1)} //eq1=1*V(in1) or eq1=1/V(in1)
			ENDIF
			// process [operand2]
			E2 out 0 value={V(eq1)[operand2]V(in2)}
		.ends
			
		X_math_[individual] [in1] [in2] [out] calculations_[individual]
	</Spice>
</Component>

<Component>
	<Description>
		A free usable function, which gives out voltages or currents.
		It has one to three in pins, called inA inB and inC.
		inA is always there, inB and or inC only when called in the function.
		the functional expression must be entered into the value field.
		
		It is advised to read the ngspice user manual chapter 5.1 "Nonlinear dependent source" to find out which expressions are valid values 
		Also, please put a semicolon ";" at the end of the expression to avoid parsing errors.
	</Description>
	<eeschema_sch>
		L math:function
	</eeschema_sch>
	<Default_Values>
		V=V(inA)*V(inA); // gives out the squared value of input A.
		V=sin(V(inA))+cos(V(inB)); // adds the sine of voltage of inputA and cosine of input voltage B
		V=V(inA)>9?9:V(inA)<-5?-5:V(inA); // Limits the voltage at max +9V and min -5Volt. 
	</Default_Values>
	<eeschema_symbol>
		// body:
		(rectangle (start -3.81 3.81) (end 0 -3.81)
		  (stroke (width 0) (type default))
		  (fill (type none))
		)
		(polyline
		  (pts
			(xy 0 -3.81)
			(xy 6.35 0)
		  )
		  (stroke (width 0) (type default))
		  (fill (type none))
		)
		(polyline
		  (pts
			(xy 6.35 0)
			(xy 0 3.81)
		  )
		  (stroke (width 0) (type default))
		  (fill (type none))
		)
		(text "fcn" (at 2.54 0 0)
			(effects (font (size 1.27 1.27)))
		)
		// input A (always there)
		(pin input line (at -6.35 2.54 0) (length 2.54)
		  (name "inA" (effects (font (size 1.27 1.27))))
		  (number "1" (effects (font (size 1.27 1.27))))
		)
		(text "A" (at -2.54 2.54 0)
			(effects (font (size 1.27 1.27)))
		)
		IF [value] CONTAINS inB THEN
			(pin input line (at -6.35 0 0) (length 2.54)
			  (name "inB" (effects (font (size 1.27 1.27))))
			  (number "3" (effects (font (size 1.27 1.27))))
			)
			(text "B" (at -2.54 0 0)
				(effects (font (size 1.27 1.27)))
			)		
		ENDIF
		IF [value] CONTAINS inC THEN
			(pin input line (at -6.35 -2.54 0) (length 2.54)
			  (name "inC" (effects (font (size 1.27 1.27))))
			  (number "4" (effects (font (size 1.27 1.27))))
			)
			(text "C" (at -2.54 -2.54 0)
				(effects (font (size 1.27 1.27)))
			)		
		ENDIF
		
		// output pin:
		(pin output line (at 8.89 0 180) (length 2.54)
		  (name "out" (effects (font (size 1.27 1.27))))
		  (number "2" (effects (font (size 1.27 1.27))))
		)
		
	</eeschema_symbol>
	<Spice>
		// model:
		      // - model ident -||inA||---------- inB ---------------------| |------------- inC ------------------||out|
		.subckt fcn_[individual] inA IF [value] CONTAINS inB THEN inB ENDIF IF [value] CONTAINS inC THEN inC ENDIF out
			Bout out 0 [value] // behavioural source
		.ends
		
		// component:
		// --component--||-inA-||------------ inB ---------------------| |-------------- inC -------------------| |out| |- model ident -|
		X_fcn_[individual] [inA] IF [value] CONTAINS inB THEN [inB] ENDIF IF [value] CONTAINS inC THEN [inC] ENDIF [out] fcn_[individual]
	</Spice>
</Component>

<Component>
	<Description>
		A resistor with a function to calculate the ohmic value.
		It has one to three inputs, called inA inB and inC.
		inA is alwaiys there, inB and/or inC only when called in the function.
		the functional expression must be entered into the value field, in the form R=(...);
		where ... is the mathematical expression depending on v(inA) and/or v(inB) and/or v(inC).
		
		It is advised to read the ngspice user manual chapter 3.3.4 "Resistors, dependent on expressions (behavioral resistor)" to find out which expressions are valid values 
		Also, please put the expression in brackets "(" and ")" and add a semicolon ";" at the end of the expression to avoid parsing errors.
		It usually doesn't work well or makes wrong calculations without the brackets or semicolon - I also would like to know why.
	</Description>
	<eeschema_sch>
		L math:function_resistor
	</eeschema_sch>
	<Default_Values>
		R=(0.5)*(v(inA)+v(inB)); // takes the average of two input voltages and makes the ohmic value
		R=(v(inA)>0 ? 0.1 : 100k); // that makes some kind of voltage controlled switch (on when input A has more than 0Volt, off otherwise)
	</Default_Values>
	// when the animation switch (left side of the window) is on,
	// then this displays the ohmic value:
	<animation>
		DEFINE [v_res] AS_MATH_SUB OF:V[out1] AND:V[out2]
		DEFINE [i_res] I[out1]
		DEFINE [r_res] AS_MATH_DIV OF:[v_res] AND:[i_res]
		IF [r_res] IS_NUMBER THEN
			<Text 300 0 60 #000080 0 "[r_res] Ohm">
		ENDIF
	</animation>
	<eeschema_symbol>
	// outer form:	
		(rectangle (start -5.08 3.81) (end 5.08 -3.81)
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type background))
		)
	 // rectangular resistor symbol:
		(rectangle (start 1.27 2.54) (end 3.81 -2.54)
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type none))
		)
	  
	  // output pins of resistor:
		(pin output line (at 2.54 5.08 270) (length 2.54)
		  (name "out1" (effects (font (size 1.27 1.27))))
		  (number "1" (effects (font (size 1.27 1.27))))
		)
		(pin output line (at 2.54 -5.08 90) (length 2.54)
		  (name "out2" (effects (font (size 1.27 1.27))))
		  (number "2" (effects (font (size 1.27 1.27))))
		)
		
		// input pins:
		(pin output line (at -7.62 2.54 0) (length 2.54)
		  (name "inA" (effects (font (size 1.27 1.27))))
		  (number "3" (effects (font (size 1.27 1.27))))
		)
		(text "A" (at -2.54 2.54 0)
			(effects (font (size 1.27 1.27)))
		)
		IF [value] CONTAINS inB THEN
			(pin output line (at -7.62 0 0) (length 2.54)
			  (name "inB" (effects (font (size 1.27 1.27))))
			  (number "4" (effects (font (size 1.27 1.27))))
			)
			(text "B" (at -2.54 0 0)
				(effects (font (size 1.27 1.27)))
			)	
		ENDIF
		IF [value] CONTAINS inC THEN
			(pin output line (at -7.62 -2.54 0) (length 2.54)
			  (name "inC" (effects (font (size 1.27 1.27))))
			  (number "5" (effects (font (size 1.27 1.27))))
			)
			(text "C" (at -2.54 -2.54 0)
				(effects (font (size 1.27 1.27)))
			)
		ENDIF
	</eeschema_symbol>
	<Spice>
		// model:
		      // -- model ident --||inA||---------- inB ---------------------| |------------- inC ------------------||--out---|
		.subckt fcnRes_[individual] inA IF [value] CONTAINS inB THEN inB ENDIF IF [value] CONTAINS inC THEN inC ENDIF out1 out2
			Rout out1 out2 [value] // behavioural source
		.ends
		
		// component:
		// ----component----||-inA-||------------ inB ---------------------| |-------------- inC -------------------| |----out----| |- model ident -|
		X_fcnRes_[individual] [inA] IF [value] CONTAINS inB THEN [inB] ENDIF IF [value] CONTAINS inC THEN [inC] ENDIF [out1] [out2] fcnRes_[individual]
	</Spice>
</Component>

<Component>
	<Description>
		IF [language] EQUAL_TO de THEN
			INCLUDE descr_int_diff_deutsch
		ELSE
			INCLUDE descr_int_diff_english
		ENDIF
	</Description>
	<eeschema_sch>
		L math:integrator
	</eeschema_sch>
	<Default_Values>
		input=v output=v // input voltage to integrated output voltage. Simply integrates the voltage, with zero as reference.
		input=vd output=vd // input and output differential voltages. No reference - make sure that a dc path connects to zero!
		input=i output=i // input current to integrated output current. Simply integrates the current. No reference!
		input=v output=v factor=123.4 // a factor is optional.
	</Default_Values>
	<eeschema_symbol>
	INCLUDE smbl_i_v_vd	
	</eeschema_symbol>
	<Spice>		
	DEFINE [factor] AS_WORD_RIGHT OF:factor IN:[value]
	DEFINE [factor] AS_NUMBER OF:[factor]
	IF [factor] IS_NUMBER && [factor] HIGHER_THAN 0 THENELSE DEFINE [factor] 1 ENDIF

	// subckt consists of an input source which fills up a capacitor (capacitor integrates the input current to voltage)
	// then an output source gives out the demanded value without effecting the capacitor in between.
	.subckt integrator_[individual] in out IF ![input] EQUAL_TO v THEN inNeg ENDIF IF![output] EQUAL_TO v THEN outNeg ENDIF
		.param capacity = 1/[factor]
		// part 1 - input source creating current into capacitor:
		IF [input] EQUAL_TO vd THEN // differential input voltage
			B_in 0 1 I=v(in)-v(inNeg) 
		ELSE IF [input] EQUAL_TO i THEN
			B_in 0 1 I=i(in) 
		ELSE // [input] is v, normal input voltage
			B_in 0 1 I=v(in) 
		ENDIF ENDIF
		
		C1  0 1 capacity // part 2 - capacitor integrates the input current.
		
		// part 3 - output source gives out volt or ampere according to wished value.
		IF [output] EQUAL_TO vd THEN
			B_out out outNeg V=v(1) 
		ELSE IF [output] EQUAL_TO i THEN
			B_out outNeg out I=v(1)
		ELSE // [output] is v, normal output voltage
			B_out out 0 V=v(1) 
		ENDIF ENDIF	
	.ends
	//
	X_integrator_[individual] [in] [out] IF ![input] EQUAL_TO v THEN [inNeg] ENDIF IF![output] EQUAL_TO v THEN [outNeg] ENDIF integrator_[individual]
	</Spice>
</Component>

<Component>
	<Description>
	IF [language] EQUAL_TO de THEN
			INCLUDE descr_int_diff_deutsch
		ELSE
			INCLUDE descr_int_diff_english
		ENDIF
	</Description>
	<eeschema_sch>
		L math:differentiator
	</eeschema_sch>
	<eeschema_symbol>
		INCLUDE smbl_i_v_vd
	</eeschema_symbol>
	<Default_Values>
		input=v output=v // input voltage to differentiated output voltage. Simply differentiates the voltage, with zero as reference.
		input=vd output=vd // input and output differential voltages. No reference - make sure that a dc path connects to zero!
		input=i output=i // input current to differential output current. Simply differentiatess the current. No reference!
		input=v output=v factor=123.4 // a factor is optional.
	</Default_Values>
	<Spice>	
	DEFINE [factor] AS_WORD_RIGHT OF:factor IN:[value]
	DEFINE [factor] AS_NUMBER OF:[factor]
	IF [factor] IS_NUMBER && [factor] HIGHER_THAN 0 THENELSE DEFINE [factor] 1 ENDIF
		
	// subckt consists of an input source which fills up an inductor (inductor differentiates the input current to voltage)
	// then an output source gives out the demanded value without effecting the inductor in between.
		.subckt differentiator_[individual] in out IF ![input] EQUAL_TO v THEN inNeg ENDIF IF![output] EQUAL_TO v THEN outNeg ENDIF
		.param inductivity = [factor]
		// part 1 - input source creating current into inductor:
		IF [input] EQUAL_TO vd THEN // differential input voltage
			B_in 0 1 I=v(in)-v(inNeg)
		ELSE IF [input] EQUAL_TO i THEN // input current
			B_in 0 1 I=i(in) 
			V_in in inNeg dc 0 
		ELSE // [input] is v, normal input voltage
			B_in 0 1 I=v(in) 
		ENDIF ENDIF
		
		L1  0 1 inductivity // part 2 - inductor differentiates the input current.
		
		// part 3 - output source gives out volt or ampere according to wished value.
		IF [output] EQUAL_TO vd THEN
			B_out out outNeg V=v(1) 
		ELSE IF [output] EQUAL_TO i THEN
			B_out outNeg out I=v(1)
		ELSE // [output] is v, normal output voltage
			B_out out 0 V=v(1) 
		ENDIF ENDIF	
	.ends
	// component calling the model:
	X_differentiator_[individual] [in] [out] IF ![input] EQUAL_TO v THEN [inNeg] ENDIF IF![output] EQUAL_TO v THEN [outNeg] ENDIF differentiator_[individual]
	
	</Spice>
</Component>

<Component>
	<Description>
		A limiter limits the given in value between min and max.
		
		(Usually min should be lower than max, for user understandability. But if not, then this limiter still works,
		because min and max are just names of the limits. The in value is still limited between them. you may think of them just being limit1 and limit2 instead of min and max.)
	</Description>
	<Default_Values>
		(no value) // no value needed. Min and max values defined by pin voltages.
		min=-5V max=5V //limits given in value - this removes the min and max pins.
		min=-5V // minimum limit as value, maximum limit as pin
		max=5V // minimum limit as pin, maximum limit as value
	</Default_Values>
	<eeschema_sch>
		L math:limiter
	</eeschema_sch>
	<eeschema_symbol>
		DEFINE [minimum] AS_WORD_RIGHT OF:min IN:[value]
		DEFINE [minimum] AS_NUMBER OF:[minimum]
		
		DEFINE [maximum] AS_WORD_RIGHT OF:max IN:[value]
		DEFINE [maximum] AS_NUMBER OF:[maximum]
		
		// body:
		(rectangle (start -3.81 3.81) (end 0 -3.81)
		  (stroke (width 0) (type default))
		  (fill (type none))
		)
		(polyline
		  (pts
			(xy 0 -3.81)
			(xy 6.35 0)
		  )
		  (stroke (width 0) (type default))
		  (fill (type none))
		)
		(polyline
		  (pts
			(xy 6.35 0)
			(xy 0 3.81)
		  )
		  (stroke (width 0) (type default))
		  (fill (type none))
		)
		(text "limit" (at 2.54 0 0)
			(effects (font (size 1.27 1.27)))
		)
		
		
		IF ! IS_NUMBER [minimum] THEN
			// min pin
			(pin input line (at -6.35 2.54 0) (length 2.54)
			  (name "min" (effects (font (size 1.27 1.27))))
			  (number "1" (effects (font (size 1.27 1.27))))
			)
			(text "min" (at -2.54 2.54 0)
				(effects (font (size 1.27 1.27)))
			)
		ENDIF
		// input pin
		(pin input line (at -6.35 0 0) (length 2.54)
		  (name "input" (effects (font (size 1.27 1.27))))
		  (number "3" (effects (font (size 1.27 1.27))))
		)
		(text "in" (at -2.54 0 0)
			(effects (font (size 1.27 1.27)))
		)		
		
		IF ! IS_NUMBER [maximum] THEN
			// max pin
			(pin input line (at -6.35 -2.54 0) (length 2.54)
			  (name "max" (effects (font (size 1.27 1.27))))
			  (number "4" (effects (font (size 1.27 1.27))))
			)
			(text "max" (at -2.54 -2.54 0)
				(effects (font (size 1.27 1.27)))
			)		
		ENDIF
	
		// output pin:
		(pin output line (at 8.89 0 180) (length 2.54)
		  (name "output" (effects (font (size 1.27 1.27))))
		  (number "2" (effects (font (size 1.27 1.27))))
		)
	</eeschema_symbol>
	<Spice>
		.subckt limiter_[individual] 	IF ! IS_NUMBER [minimum] THEN min ENDIF input IF ! IS_NUMBER [maximum] THEN max ENDIF output
		
		// 
		IF  IS_NUMBER [minimum] THEN
			B_min min 0 V=[minimum]
		ENDIF
		IF  IS_NUMBER [maximum] THEN
			B_max max 0 V=[maximum]
		ENDIF
		// calculate limits
		B_low lower_limit 0 V=v(min)<v(max)?v(min):v(max)
		B_up upper_limit 0  V=v(max)>v(min)?v(max):v(min)
		
		// calculate output:
		B_out output 0 V=v(input)<v(lower_limit)?v(lower_limit):v(input)>v(upper_limit)?v(upper_limit):v(input)
		
		
		.ends
		
		X_limiter_[individual] 	IF ! IS_NUMBER [minimum] THEN [min] ENDIF [input] IF ! IS_NUMBER [maximum] THEN [max] ENDIF [output] limiter_[individual]
	</Spice>
</Component>


<Component>
	<Description>
		IF [language] EQUAL_TO de THEN
			Eine Komponente, welche Stom zu Spannung umwandelt. Oder umgekehrt - Spannung zu Strom.
			Je nach eingegebenem Wert.
			Verfügbare input und output Werte sind:
			v für absolute Spannung (ein Anschluss - Spannung gegen Massereferenz)
			vd für differenz Spannung (zwei Anschlüsse - Spannung gegeneinander)
			i für Strom (zwei verbundene Anschlüsse, wo Strom rein und raus fliesst.)
		ELSE
			A component that converts current to voltage. Or vice versa - voltage to current.
			That depends on the given value.
			Available values for input and output are:
			v for absolute voltage (one pin - voltage against ground node)
			vd for differential voltage (two pins - voltage against each other)
			i for current (two connected pins, where current flows in and out)
		ENDIF
	</Description>
	<eeschema_sch>
		L math:volt_amp_converter
	</eeschema_sch>
	<Default_Values>
		input=v output=i // converts voltages to currents: 1 Volt -> 1 Ampere
		input=i output=v // converts currents to voltages: 1 Ampere -> 1 Volt
		input=i output=vd // converts currents to differential voltages
		input=v output=i factor=0.2 // converts voltages to currents with a factor f: 1 Volt -> f Ampere
		input=i output=v factor=0.2 // converts currents to voltages with a factor f: 1 Ampere -> f Volt
	</Default_Values>
	<eeschema_symbol>
		INCLUDE smbl_i_v_vd // universal symbol for multiple components
	</eeschema_symbol>
	<Spice>
		DEFINE [factor] AS_WORD_RIGHT OF:factor IN:[value]
		DEFINE [factor] AS_NUMBER OF:[factor]
		IF [factor] IS_NUMBER && [factor] HIGHER_THAN 0 THENELSE DEFINE [factor] 1 ENDIF

		.subckt converter_ui_[individual] in out IF ![input] EQUAL_TO v THEN inNeg ENDIF IF![output] EQUAL_TO v THEN outNeg ENDIF
			
			.param resistance = [factor]
			// part 1 - input source creating current into resistor:
			IF [input] EQUAL_TO vd THEN // differential input voltage
				B_in 0 1 I=v(in)-v(inNeg)
			ELSE IF [input] EQUAL_TO i THEN
				B_in 0 1 I=i(in) 
				V_in in inNeg dc 0
			ELSE // [input] is v, normal input voltage
				B_in 0 1 I=v(in) 
			ENDIF ENDIF
			
			R1  0 1 resistance // part 2 - resistor multiplies with current to voltage at node 1.
			
			// part 3 - output source gives out volt or ampere according to wished value.
			IF [output] EQUAL_TO vd THEN
				B_out out outNeg V=v(1) 
			ELSE IF [output] EQUAL_TO i THEN
				B_out outNeg out I=v(1)
			ELSE // [output] is v, normal output voltage
				B_out out 0 V=v(1) 
			ENDIF ENDIF	
		.ends
		// component
		X_converter_ui_[individual] [in] [out] IF ![input] EQUAL_TO v THEN [inNeg] ENDIF IF![output] EQUAL_TO v THEN [outNeg] ENDIF converter_ui_[individual]
	</Spice>
</Component>


<Component>
	<Description>
		A piece-wise linear interpolation.
		Needs an input array "x_array" and an output array "y_array" of the same length.
		Gives out the y voltage value for the actual x input voltage, calculated according to these two parameter arrays.
		
		More details see in the ngspice user manual chapter 12.2.7 "PWL Controlled Source".
		
		x-input and y-output must be absolute voltages: currents or differential voltages are not allowed, and will lead to wrong results!
		(You can place an u-i converter next to this component though)
		That's why there is no input=... output=... in the example values.
		
		Please state the fraction parameter at last. 
	</Description>
	<eeschema_sch>
		L math:piece_wise_linear
	</eeschema_sch>
	<Default_Values>
		x_array=[-2.0 -1.0 2.0 4.0 5.0] y_array=[-0.2 -0.2 0.1 2.0 10.0] fraction=TRUE // arrays with 5 elements
		x_array=[-2.0 -1.0 2.0 4.0 5.0] y_array=[-0.2 -0.2 0.1 2.0 10.0] fraction=FALSE // arrays with 5 elements
	</Default_Values>
	<eeschema_symbol>
		INCLUDE smbl_i_v_vd
	</eeschema_symbol>
	<Spice>
		DEFINE [x_array] AS_SUBTEXT AFTER:x_arrayFROM:[TO:]OF:[value]
		DEFINE [y_array] AS_SUBTEXT AFTER:y_arrayFROM:[TO:]OF:[value]
		DEFINE [in_domain] AS_WORD_RIGHT OF:in_domain IN:[value]
		DEFINE [in_domain] AS_NUMBER OF:[in_domain]
		
		DEFINE [fraction] AS_WORD_RIGHT OF:fraction IN:[value]
		
	//subcircuit / model:
	.model pwl_[individual] pwl( x_array=[x_array] y_array=[y_array] IF[in_domain]IS_NUMBER THEN in_domain=[in_domain] ENDIF fraction=[fraction])
	
	// component
	 a_[individual] [in] [out] pwl_[individual]
	</Spice>
</Component>

<Component>
	<Description>
		A hysteresis function.
		The parameters are defining the hysteresis curve:
			in_low and in_high define the range of the input (default 0.0 and 1.0)
			out_lower_limit and out_upper_limit define the range of the output (default 0.0 and 1.0)
			hyst defines the size of the hysteresis gap (default 0.1)
			in_domain defines the input smoothing domain (default 0.01, in ngspice manual called input_domain)
			fraction is a TRUE/FALSE parameter defining wehther smoothing fraction or absolute value is used (default is TRUE)
		
			More details see in the ngspice user manual chapter 12.2.13 "Hysteresis Block". Also the default values are exactly as
			in that ngspice user manual
			
			x-input and y-output must be absolute voltages: currents or differential voltages are not allowed, and will lead to wrong results!
			(You can place an u-i converter next to this component though)	
	</Description>
	<eeschema_sch>
		L math:hysteresis
	</eeschema_sch>
	<Default_Values>
		(no value) // no values given - use default parameters.
		in_low=-10.0 in_high=10.0 out_lower_limit=-100.0 out_upper_limit=100.0 hyst=50.0 in_domain=0.01 fraction=TRUE // a symmetric hysteresis function that spans from x [-10;10] to y [-100 ; 100]
	</Default_Values>
	<eeschema_symbol>
		INCLUDE smbl_i_v_vd
	</eeschema_symbol>
	<Spice>
		INCLUDE hysteresis_parameters
		
		//subcircuit / model:
		.model hyst_[individual] hyst (in_low=[in_low] in_high=[in_high] hyst=[hyst] out_lower_limit=[out_lower_limit] out_upper_limit=[out_upper_limit] in_domain=[in_domain] fraction=[fraction])
		
		// component:
		a_[individual] [in] [out] hyst_[individual]
	</Spice>	
</Component>

<Component>
	<Description>
		A soft hysteresis, in S-shaped form, as in the function B(H) in a magnetic core of a transformer.
	</Description>
	<eeschema_sch>
		L math:hysteresis_shape
	</eeschema_sch>
	<eeschema_symbol>
		INCLUDE smbl_i_v_vd
	</eeschema_symbol>
	<Default_Values>
		in_low=-6.0 in_high=6.0 out_lower_limit=-1.7 out_upper_limit=1.7 hyst=0.5  // shape as B(H) fcn of esteel transformer
	</Default_Values>
	<Spice>
		INCLUDE hysteresis_parameters
		
		// subcircuit/model:
		.subckt sub_hyst_shape_[individual] in out
			.model hystcore core ( mode=2 in_low=[in_low] in_high=[in_high] out_lower_limit=[out_lower_limit] out_upper_limit=[out_upper_limit] hyst=[hyst] area=1 length=1 H_array=[-1000 1000] B_array=[-1 1] )
			a_hystcore (in out) hystcore
		.ends 
		// component:
			X_[individual] [in] [out] sub_hyst_shape_[individual]
	</Spice>
</Component>

// parameter definitions for the hysteresis functions above
<hysteresis_parameters>
	DEFINE [in_low] AS_WORD_RIGHT OF: in_low IN:[value]
	DEFINE [in_low] AS_NUMBER OF:[in_low]
	IF ! [in_low] IS_NUMBER THEN DEFINE [in_low] 0.0 ENDIF
	
	DEFINE [in_high] AS_WORD_RIGHT OF: in_high IN:[value]
	DEFINE [in_high] AS_NUMBER OF:[in_high]
	IF ! [in_high] IS_NUMBER THEN DEFINE [in_high] 1.0 ENDIF
	
	DEFINE [hyst] AS_WORD_RIGHT OF: hyst IN:[value]
	DEFINE [hyst] AS_NUMBER OF:[hyst]
	IF ! [hyst] IS_NUMBER THEN DEFINE [hyst] 0.1 ENDIF
	
	DEFINE [out_lower_limit] AS_WORD_RIGHT OF: out_lower_limit IN:[value]
	DEFINE [out_lower_limit] AS_NUMBER OF:[out_lower_limit]
	IF ! [out_lower_limit] IS_NUMBER THEN DEFINE [out_lower_limit] 0.0 ENDIF
			
	DEFINE [out_upper_limit] AS_WORD_RIGHT OF: out_upper_limit IN:[value]
	DEFINE [out_upper_limit] AS_NUMBER OF:[out_upper_limit]
	IF ! [out_upper_limit] IS_NUMBER THEN DEFINE [out_upper_limit] 1.0 ENDIF
	
	DEFINE [in_domain] AS_WORD_RIGHT OF: in_domain IN:[value]
	DEFINE [in_domain] AS_NUMBER OF:[in_domain]
	IF ! [in_domain] IS_NUMBER THEN DEFINE [in_domain] 0.01 ENDIF
	
	DEFINE [fraction] AS_WORD_RIGHT OF: out_upper_limit IN:[value]
	IF [fraction] EQUAL_TO FALSE || [fraction] EQUAL_TO false THENELSE DEFINE [fraction] TRUE ENDIF	
</hysteresis_parameters>


// -----------------------------------------
// ---- support sections - called above ----
// -----------------------------------------

// descriptions of integrator and differentiator component:
<descr_int_diff_deutsch>
	IF [model] CONTAINS inte THEN Ein Integrierer. Er integriert über die Zeit.
ENDIF IF [model] CONTAINS diff THEN Ein Differenzierer. Er differenziert über die Zeit.

Er hat eine Eingangs und eine Ausgangs-Grösse. Sie kann entweder v oder vd oder i sein.
  v bedeutet Spannung (also Spannung gegen die Null-Referenz, gegenüber Masse)
  vd bedeutet differential-Spannung (Also zwei Spannungswerte gegeneinander)
  i bedeutet Strom 

(Bei vd und i bitte darauf achten, dass Sie irgendeine Verbindung zur Null-Referenz haben, sonst kann der 
Simulator keine Spannung berechnen und wirft eine Fehlermeldung!)

</descr_int_diff_deutsch>
<descr_int_diff_english>
	IF [model] CONTAINS inte THEN An integrator. It integrates over time.
ENDIF IF [model] CONTAINS diff THEN A differentiator. It differentiates over time.
ENDIF
It has an input and an output. Each can either be v or vd or i.
  v means voltage (that is voltage against the zero reference, against ground)
  vd means differential voltage (that is voltage against each other)
  i means current

When using vd or i please make sure that you have some connection to ground node, 
otherwise the simulator can not calculate the voltages and will throw an error.
</descr_int_diff_english>>

<smbl_i_v_vd> // symbol of multiple component models, that convert currents and voltages. (e.g. integrator and differentiator.)
	// can look like this (or combinations of that). S is a symbol in the center depending on model.
	//     ----                     ----
	//     |   \              in---|    \--out
	// in--| S  > ---out           |  S  | 
	//     |    /           inNeg--|    /--outNeg
	//     ----                     ----

	DEFINE [input] AS_WORD_RIGHT OF:input IN:[value]
		IF ! [input] THEN DEFINE [input] v ENDIF
		DEFINE [input] AS_LOWERCASE OF:[input]
		
		DEFINE [output] AS_WORD_RIGHT OF:output IN:[value]
		IF ! [output] THEN DEFINE [output] v ENDIF
		DEFINE [output] AS_LOWERCASE OF:[output]
		
		// check that input and output is either i or v or vd:
		IF[input]MATCHES(i|v|vd)&&[output]MATCHES(i|v|vd)THENELSE
			<Dialog "type=error" title="not allowed parameter value">
				The component of model=[model] has a not allowed value:
				Allowed values are: v or i or vd
				But here input is [input] , and output is [output].
			</Dialog>
		ENDIF
		
		// background form:
		IF [output] EQUAL_TO v THEN
			(polyline
			  (pts
				(xy -2.54 3.81)
				(xy 0 3.81)
				(xy 6.35 0)
				(xy 0 -3.81)
				(xy -2.54 -3.81)
				(xy -2.54 3.81)
			  )
			  (stroke (width 0) (type default) (color 0 0 0 0))
			  (fill (type background))
			)
	   ELSE
			(polyline
			  (pts
				(xy -2.54 3.81)
				(xy 0 3.81)
				(xy 5.08 1.27)
				(xy 5.08 -1.27)
				(xy 0 -3.81)
				(xy -2.54 -3.81)
				(xy -2.54 3.81)
			  )
			  (stroke (width 0) (type default) (color 0 0 0 0))
			  (fill (type background))
			)
	   ENDIF
	   IF [input] EQUAL_TO v && [output] EQUAL_TO v THENELSE
		// + symbol:			
		(polyline
		  (pts
			(xy -1 3)
			(xy -2 3)
		  )
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type none))
		)
		(polyline
		  (pts
			(xy -1.5 3.5)
			(xy -1.5 2.5)
		  )
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type none))
		)
		// - symbol
		(polyline
		  (pts
			(xy -1 -3)
			(xy -2 -3)
		  )
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type none))
		)
		ENDIF
	   
	   // Symbols S according to Model:
		// integration symbol 
	  IF [model] CONTAINS inte THEN // symbol indicating integrator
	   (polyline
		  (pts
			(xy 1.27 2.54)
			(xy 0 1.27)
			(xy 0 -1.27)
			(xy -1.27 -2.54)
		  )
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type none))
		)
		ENDIF
		IF [model] CONTAINS diff THEN // symbol indicating differentiator
			(polyline
			  (pts
				(xy -2.54 -1.27)
				(xy 1.27 -1.27)
			  )
			  (stroke (width 0) (type default) (color 0 0 0 0))
			  (fill (type none))
			)
			(polyline
			  (pts
				(xy -2.54 -1.27)
				(xy 1.27 1.27)
			  )
			  (stroke (width 0) (type default) (color 0 0 0 0))
			  (fill (type none))
			)
			(polyline
			  (pts
				(xy 0 -1.27)
				(xy 0 0)
			  )
			  (stroke (width 0) (type default) (color 0 0 0 0))
			  (fill (type none))
			)

		ENDIF
		// "dt" text to make clear it integrates or differentiates over time: 
		IF [model] CONTAINS inte || [model] CONTAINS diff THEN 
		(text "dt" (at 2.0 0 0)
			(effects (font (size 2.0 2.0)))
		)
		ENDIF
		
		IF [model] CONTAINS volt_amp THEN
			//arrow:
				(polyline
				  (pts
					(xy 2.54 0)
					(xy 1.27 -1.27)
				  )
				  (stroke (width 0) (type default) (color 0 0 0 0))
				  (fill (type none))
				)
				(polyline
				  (pts
					(xy 0 0)
					(xy 2.54 0)
					(xy 1.27 1.27)
				  )
				  (stroke (width 0) (type default) (color 0 0 0 0))
				  (fill (type none))
				)			
			// input and output text:
			(text "[input]" (at -1.5 0 0)
				(effects (font (size 2.0 2.0)))
			)
			(text "[output]" (at 3.5 0 0)
				(effects (font (size 2.0 2.0)))
			)
		ENDIF
		
		IF [model] CONTAINS piece_wise_lin THEN
			(text "PWL" (at -0.0 0 0)
				(effects (font (size 3.0 3.0)))
			)
		ENDIF
		IF [model] ENDS_WITH hysteresis THEN
			// ToDo: a hysteresis symbol would look better than just text 
		(text "HYST" (at -0.0 0 0)
				(effects (font (size 3.0 3.0)))
			)
		ENDIF
		IF [model] ENDS_WITH hysteresis_shape THEN
			(text "Hshp" (at -0.0 0 0)
				(effects (font (size 3.0 3.0)))
			)
		ENDIF
		// end of Symbols
		
		// pins:
		IF [input] EQUAL_TO v THEN
		  (pin input line (at -5.08 0 0) (length 2.54)
			  (name "in" (effects (font (size 1.27 1.27))))
			  (number "1" (effects (font (size 1.27 1.27))))
		  )
		ELSE
		(pin input line (at -5.08 2.54 0) (length 2.54)
		  (name "in" (effects (font (size 1.27 1.27))))
		  (number "1" (effects (font (size 1.27 1.27))))
		)
		(pin input line (at -5.08 -2.54 0) (length 2.54)
		  (name "inNeg" (effects (font (size 1.27 1.27))))
		  (number "3" (effects (font (size 1.27 1.27))))
		)
		ENDIF
		
		IF [output] EQUAL_TO v THEN
			(pin output line (at 8.89 0 180) (length 2.54)
			  (name "out" (effects (font (size 1.27 1.27))))
			  (number "2" (effects (font (size 1.27 1.27))))
			)
		ELSE
			(pin output line (at 7.62 1.27 180) (length 2.54)
			  (name "out" (effects (font (size 1.27 1.27))))
			  (number "2" (effects (font (size 1.27 1.27))))
			)
			(pin output line (at 7.62 -1.27 180) (length 2.54)
			  (name "outNeg" (effects (font (size 1.27 1.27))))
			  (number "4" (effects (font (size 1.27 1.27))))
			) 
		ENDIF
</smbl_i_v_vd>

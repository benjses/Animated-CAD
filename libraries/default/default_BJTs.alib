//All texts are presented AS IS and the provider of this library does not provide any liability for any consequences resulting from using it in any way.
<Component>
	<Description>
		Default PNP Bipolar Transistor
	</Description>
	<qucs_sch>
		Default_PNP [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate]
	</qucs_sch>
	<qucs_symbol>
		<Text -10 0 10 #000080 0 "Default PNP">
		<Line -30 0 20 0 #000080 2 1>
		<Line -10 -15 0 30 #000080 2 1>
		<Line 0 -30 0 15  #000080 2 1>
		<Line 0 -15 -10 10 #000080 2 1>
		<Line -10 5 10 10 #000080 2 1>
		<Line 0 15 0 15 #000080 2 1>
		<.PortSym -30 0 [B] 0>
		<.PortSym 0 -30 [C] 270>
		<.PortSym 0 30 [E] 90>
	</qucs_symbol>
	<eeschema_sch>
		L Transistor:PNP
		F 0 "[name]"
		F 1 "[type]"
		F 2 "[package]"
		F 3 "[datasheet]"
	</eeschema_sch>
	<Spice>
		.model Q_PNP_DEFAULT PNP
		Q_[name] [C] [B] [E] Q_PNP_DEFAULT
	</Spice>
	<eeschema_symbol>
		DRAW
		C 50 0 111 0 1 10 N
		P 2 0 1 0 25 25 100 100 N
		P 3 0 1 0 25 -25 100 -100 100 -100 N
		P 3 0 1 20 25 75 25 -75 25 -75 N
		P 5 0 1 0 90 -70 70 -90 50 -50 90 -70 90 -70 F
		T 0 -10 0 0 1 1 DEFAULT PNP
		X B 1 -200 0 225 R 50 50 1 1 I
		X E 2 100 -200 100 U 50 50 1 1 P
		X C 3 100 200 100 D 50 50 1 1 P
		ENDDRAW
	</eeschema_symbol>
</Component>

<Component>
	<Description>
		Default NPN Bipolar Transistor
	</Description>
	<qucs_sch>
		Default_NPN [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate]
	</qucs_sch>
	<qucs_symbol>
		<Text -10 0 10 #000080 0 "Default NPN">
		<Line -30 0 20 0 #000080 2 1>
		<Line -10 -15 0 30 #000080 2 1>
		<Line 0 -30 0 15  #000080 2 1>
		<Line 0 -15 -10 10 #000080 2 1>
		<Line -10 5 10 10 #000080 2 1>
		<Line 0 15 0 15 #000080 2 1>
		<Line 0 15 -5 0 #000080 2 1>
		<Line 0 15 0 -5 #000080 2 1>
		<.PortSym -30 0 [B] 0>
		<.PortSym 0 -30 [C] 270>
		<.PortSym 0 30 [E] 90>
	</qucs_symbol>
	<eeschema_sch>
		L Transistor:NPN
		F 0 "[name]"
		F 1 "[type]"
		F 2 "[package]"
		F 3 "[datasheet]"
	</eeschema_sch>
	<Spice>
		.model Q_NPN_DEFAULT_[name] NPN(BF=200 CJC=20pf CJE=20pf IS=1E-16)
		Q_[name] [C] [B] [E] Q_NPN_DEFAULT_[name]
	</Spice>
	<eeschema_symbol>
		DRAW
		C 50 0 111 0 1 10 N
		P 2 0 1 0 0 0 25 0 N
		P 2 0 1 0 25 25 100 100 N
		P 3 0 1 0 25 -25 100 -100 100 -100 N
		P 3 0 1 20 25 75 25 -75 25 -75 N
		P 5 0 1 0 50 -70 70 -50 90 -90 50 -70 50 -70 F
		T 0 -10 0 50 1 1 DEFAULT NPN
		X C 1 100 200 100 D 50 50 1 1 P
		X B 2 -200 0 200 R 50 50 1 1 I
		X E 3 100 -200 100 U 50 50 1 1 P
		ENDDRAW
	</eeschema_symbol>
</Component>



<Component>
<Description>
A rectangle Current Source
[ah] = pulse current in Ampere
</Description>
<qucs_sch>
Irect [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [ah] [ah_v] 
[th] [th_v] [tl] [tl_v] [tr] [tr_v] [tf] [tf_v] [td] [td_v]
</qucs_sch>
<qucs_symbol>
<Ellipse -12 -12 24 24 #000080 2 1  #c0c0c0 1 0>
<Line 0 -11 0 22 #A0A0A0 2 1>
<Text 18 5 15 #FF0000 0 "+">
<Text -18 5 15 #000000 0 "-"> 
<Line -30 0 18 0 #000080 2 1>
<Line 30 0 -18 0 #000080 2 1>
<Line 5 7 0 -2  #000080 2 1>
<Line 5 5 -10 0 #000080 2 1>
<Line -5 5 0 -5 #000080 2 1>
<Line -5 0 10 0 #000080 2 1>
<Line 5 0 0 -5 #000080 2 1>
<Line 5 -5 -10 0 #000080 2 1>
<Line -5 -5 0 -3 #000080 2 1>
<.PortSym -30 0 [npos] 0>
<.PortSym 30 0 [nneg] 0>
</qucs_symbol>
<Spice>
DEFINE [ah] AS_NUMBER OF:[ah]
DEFINE [td] AS_NUMBER OF:[td]
DEFINE [tl] AS_NUMBER OF:[tl]
DEFINE [tr] AS_NUMBER OF:[tr]
DEFINE [tf] AS_NUMBER OF:[tf]
DEFINE [th] AS_NUMBER OF:[th]
IF [ah] && [tl] && [tr] && [tf] && [th] THEN
    .param period_[name]=[th]+[tl]+[tr]+[tf]
    I_[name] [npos] [nneg] PULSE(0 [ah] [td] [tr] [tf] [th] period_[name] 0)
ELSE
    <Dialog title="source parameters not correct numbers" type="error" dimension="400x300">
        IF [language] EQUAL_TO "de" THEN
            Die Stromquelle namens [name] an position ([xpos] | [ypos]) hat einen Wert, der leider keine korrekte Zahl ist. Bitte geben Sie der Quelle korrekte parameter für:IF ![ah] THEN 
            den Stromwert in Ampere "ah"ENDIF IF ![tl] THEN 
            die Zeitspanne in s im low-Pegel "tl" ENDIF IF ![tr] THEN
            die Zeitspanne in s im high-Pegel "th" ENDIF IF ![tf] THEN
            die Zeitspanne in s für den Fall von high nach low "tf" ENDIF IF![th] THEN
            die Zeitspanne in s für den Anstieg von low nach high "tr" ENDIF 
        ELSE
            The voltage source named [name] at position ([xpos] | [ypos]) has a value, which is not a correct number.
            Please give the source correct parameters for: IF ![ah] THEN 
            the current value in Ampere "ah"ENDIF IF ![tl] THEN 
            the time span in s in low "tl" ENDIF IF ![tr] THEN
            the time span in high "th" ENDIF IF ![tf] THEN
            the time span for the fall from high to low "tf" ENDIF IF![th] THEN
            the time span for the rise from low to high "tr" ENDIF
        ENDIF
    </Dialog>
ENDIF
</Spice>
</Component>

<Component>
<Description>
An ideal dc Voltage source
[value] is Voltage in Volts
</Description>
<qucs_sch>
Vdc [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [value] [value_v]
</qucs_sch>
<Spice>
DEFINE [volts] AS_NUMBER OF:[value]
IF [volts] THEN
    DEFINE [value] AS_NULL
    V_[name] [npos] [nneg] DC [volts]
ELSE 
    <Dialog title="source parameters not correct numbers" type="error" dimension="400x300">
        IF [language] EQUAL_TO "de" THEN
            Die Spannungsquelle namens [name] an position ([xpos] | [ypos]) hat den Wert [value], der leider keine korrekte Zahl ist. Bitte geben Sie der Quelle einen Zahlenwert.
        ELSE
            The voltage source named [name] at position ([xpos] | [ypos]) has a value [value], which is not a correct number. Please correct the value.
        ENDIF
    </Dialog>
ENDIF
</Spice>
<qucs_symbol>
	<Line 4 -15 0 30 #000080 2 1>
	<Line -4 -10 0 20 #000080 2 1>
	<Line -30 0 26 0 #000080 2 1>
	<Line 30 0 -26 0 #000080 2 1>
	<.PortSym 30 0 [npos] 0>
	<.PortSym -30 0 [nneg] 0>
</qucs_symbol>
</Component>

<Component>
<Description>
A rectangle Voltage source. 
	[vh] = pulsed value in Volts = on value in Volts
	[td] = delay time in seconds
	[tr] = rise time in seconds
	[tf] = fall time in seconds
	[th] = pulse width in seconds = on time in seconds
	[tl] = off time in seconds
	period=[th]+[tl]+[tr]+[tf] (Parameters see ngspice manual chapter 2.8.1 , that chapter is called ".param line")
	[Phase] = here 0 degrees
</Description>
<qucs_sch>
Vrect [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [vh] [vh_v] [th] [th_v] [tl] [tl_v] [tr] [tr_v] [tf] [tf_v] [td] [td_v]
</qucs_sch>
<Spice>
DEFINE [td] AS_NUMBER OF:[td]
DEFINE [th] AS_NUMBER OF:[th]
DEFINE [tl] AS_NUMBER OF:[tl]
DEFINE [tr] AS_NUMBER OF:[tr]
DEFINE [tf] AS_NUMBER OF:[tf]
DEFINE [vh] AS_NUMBER OF:[vh]
IF [th] && [tl] && [tr] && [tf] && [vh] THENELSE 
    <Dialog title="source parameters not correct numbers" type="error" dimension="400x300">
        IF [language] EQUAL_TO "de" THEN
            Die Spannungsquelle namens [name] an position ([xpos] | [ypos]) hat parameter, welche leider keine korrekte Zahl sind. Bitte geben Sie der Quelle korrekte parameter fürIF ![vh] THEN 
            den Spannungswert in Volt "vh"ENDIF IF ![tl] THEN 
            die Zeitspanne in s im low-Pegel "tl" ENDIF IF ![tr] THEN
            die Zeitspanne in s im high-Pegel "th" ENDIF IF ![tf] THEN
            die Zeitspanne in s für den Fall von high nach low "tf" ENDIF IF![th] THEN
            die Zeitspanne in s für den Anstieg von low nach high "tr" ENDIF 
        ELSE
            The voltage source named [name] at position ([xpos] | [ypos]) has parameters, which are not correct numbers.
            Please correct the parameters:IF ![vh] THEN 
            the voltage value in volt "vh"ENDIF IF ![tl] THEN 
            the time span in s in low "tl" ENDIF IF ![tr] THEN
            the time span in high "th" ENDIF IF ![tf] THEN
            the time span for the fall from high to low "tf" ENDIF IF![th] THEN
            the time span for the rise from low to high "tr" ENDIF
        ENDIF
    </Dialog>
ENDIF
.param period_[name]=[th]+[tl]+[tr]+[tf]
V_[name] [npos] [nneg] PULSE(0 [vh] [td] [tr] [tf] [th] period_[name] 0)
</Spice>
<qucs_symbol>
	<Ellipse -12 -12 24 24 #000080 2 1  #c0c0c0 1 0>
	<Line -11 0 22 0 #A0A0A0 2 1>
	<Text 18 5 15 #FF0000 0 "+">
	<Text -18 5 15 #000000 0 "-"> 
	<Line -30 0 18 0 #000080 2 1>
	<Line 30 0 -18 0 #000080 2 1>
	<Line 5 7 0 -2  #000080 2 1>
	<Line 5 5 -10 0 #000080 2 1>
	<Line -5 5 0 -5 #000080 2 1>
	<Line -5 0 10 0 #000080 2 1>
	<Line 5 0 0 -5 #000080 2 1>
	<Line 5 -5 -10 0 #000080 2 1>
	<Line -5 -5 0 -3 #000080 2 1>
	<.PortSym 30 0 [npos] 0>
	<.PortSym -30 0 [nneg] 0>
</qucs_symbol>
</Component>

<Component Vac>
<Description>
A sine-wave voltage source
[va] = Voltage amplitude in V
[f] = frequency in Hz
[phase] = phase in degrees
[theta] = Damping factor in 1/s
</Description>
<qucs_sch>
Vac [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [va] [va_v] [f] [f_v] [phase] [phase_v] [theta] [theta_v]
</qucs_sch>
<Spice>
DEFINE [va] AS_NUMBER OF:[va]
DEFINE [f] AS_NUMBER OF:[f]
DEFINE [theta] AS_NUMBER OF:[theta]
DEFINE [phase] AS_NUMBER OF:[phase]
IF [va] && [f] && [theta] && [phase] THENELSE 
    <Dialog title="source parameters not correct numbers" type="error" dimension="400x300">
        IF [language] EQUAL_TO "de" THEN
            Die Spannungsquelle namens [name] an position ([xpos] | [ypos]) hat parameter, welche leider keine korrekte Zahl sind. Bitte geben Sie der Quelle korrekte parameter. Diese werte sind:
            Amplitude in Volt= [va] IF [va] THEN ok ELSE FALSCH! ENDIF
            Frequenz in Hertz = [f] IF [f] THEN ok ELSE  FALSCH! ENDIF
            Phase = [phase] IF [phase] THEN ok ELSE  FALSCH! ENDIF
            Theta = [theta] IF [theta] THEN ok ELSE  FALSCH! ENDIF
        ELSE
            The voltage source named [name] at position ([xpos] | [ypos]) has parameters, which are not correct numbers.
            Please correct the parameters. These values are:
            amplitude in Volt= [va] IF [va] THEN ok ELSE WRONG! ENDIF
            Frequenz in Hertz = [f] IF [f] THEN ok ELSE  WRONG! ENDIF
            Phase = [phase] IF [phase] THEN ok ELSE WRONG! ENDIF
            Theta = [theta] IF [theta] THEN ok ELSE WRONG! ENDIF
        ENDIF
    </Dialog>
ENDIF

V_[name] [npos] [nneg] SIN(0 [va] [f] 0 [theta] [phase])
</Spice>
<qucs_symbol>
	<Ellipse -12 -12 24 24 #000080 2 1  #c0c0c0 1 0>
	<Line -11 0 22 0 #A0A0A0 2 1>
	<Text 18 5 15 #FF0000 0 "+">
	<Text -18 5 15 #0000FF 0 "-"> 
	<Line -30 0 18 0 #000080 2 1>
	<Line 30 0 -18 0 #000080 2 1>
	<arc -4 -8 90 180 8 8 #000000 2 1 #000000 1 0>
	<arc -4 0 270 180 8 8 #000000 2 1 #000000 1 0>
	<.PortSym 30 0 [npos] 0>
	<.PortSym -30 0 [nneg] 0>
</qucs_symbol>
</Component>

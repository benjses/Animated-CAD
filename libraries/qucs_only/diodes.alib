<Component>
	<Description>
		A Diode. Component created according to ngspice Users Manual Version "30 plus" chapter 7 "Diodes"
		[Is]	= Saturation current in A
		[N]		= Emission Coefficient
		[Cj0] 	= Zero-bias junction (...) capacitance in F
		[M] 	= also called Mj: Area junction grading coefficient
		[Vj]	= Junction potential in V
		[Fc]	= Coefficient for forward-bias depletion (...) capacitance formula
		[Cp]	= 
		[Isr]	= Recombination Saturation current in A 
		[Nr]	= Recombination current emission coefficient
		[Rs]	= Ohmic resistance in Ohm
		[Tt]	= Transit time in s
		[Ikf]	= Forward knee current
		[Kf]	= Flicker noise coefficient
		[Af]	= Flicker noise exponent
		[Ffe]	= 
		[Bv]	= Reverse breaktdown voltage in V
		[Ibv]	= Current at breakdown voltage in A
		[Temp]	= (not used)
		[Xti]	= Saturation current temperature exponent
		[Eg]	= Activation energy in eV
		[Tbv]	= 
		[Trs]	= 
		[Ttt1]	= 1st order temperature coefficient for Rs in 1/degC
		[Ttt2]	= 2nd order temperature coefficient for Rs in 1/degC^2
		[Tm1]	= 1st order temperature coefficient for Mj in 1/degC
		[Tm2]	= 2nd order temperature coefficient for Mj in 1/degC^2
		[Tnom]	= Parameter measurement temperature in degC
		[Area]	=
		[Symbol]=
	</Description>
	<qucs_sch>
		Diode [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [Is] [Is_v] [N] [N_v] [Cj0] [Cj0_v] [M] [M_v] [Vj] [Vj_v]
		[Fc] [Fc_v] [Cp] [Cp_v] [Isr] [Isr_v] [Nr] [Nr_v] [Rs] [Rs_v] [Tt] [Tt_v] [Ikf] [Ikf_v] [Kf] [Kf_v] [Af] [Af_v] [Ffe] [Ffe_v] [Bv] [Bv_v]
		[Ibv] [Ibv_v] [Temp] [Temp_v] [Xti] [Xti_v] [Eg] [Eg_v] [Tbv] [Tbv_v] [Trs] [Trs_v] [Ttt1] [Ttt1_v] [Ttt2] [Ttt2_v] [Tm1] [Tm1_v] [Tm2] [Tm2_v] 
		[Tnom] [Tnom_v] [Area] [Area_v] [Symbol] [Symbol_v]  
	</qucs_sch>
	<Spice>
		D_[name] [A] [K] D_MDL_[name] area=[Area] // m=[M] pj=[] ic=[] temp=[] dtemp=[]
		.model D_MDL_[name] D (is=[Is] n=[N] rs=[Rs] bv=[Bv] ibv=[Ibv] ikf=[Ikf] isr=[Isr] nr=[Nr] cjo=[Cj0] fc=[Fc]  
		+ m=[M] vj=[Vj] tt=[Tt] eg=[Eg] tm1=[Tm1] tm2=[Tm2] tnom=[Tnom] ttt1=[Ttt1] ttt2=[Ttt2] xti=[Xti] kf=[Kf] af=[Af])
	</Spice>
<qucs_symbol>
	<Line 10 -10 0 20 #000080 2 1>
	<Line -10 0 20 10 #000080 2 1>
	<Line -10 0 20 -10 #000080 2 1>
	<Line -10 -10 0 20 #000080 2 1>
	<Line 30 0 -20 0 #000080 2 1>
	<Line -30 0 20 0 #000080 2 1>
	<.PortSym 30 0 [A] 0> // Anode (positive Connection)
	<.PortSym -30 0 [K] 0> // Kathode (negative Connection)
</qucs_symbol>
</Component>
 

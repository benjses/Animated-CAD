<Subckt_LM675>
        // ---- model / subckt ----
        * connections: non-inverting input
        *              | inverting input
        *              | | positive power supply
        *              | | | negative power supply
        *              | | | | output
        *              | | | | |
	IF [model] ENDS_WITH 3pin THEN
		 .subckt LM675 1 2     5 // reduced 3pin connections without power supply
			Vpos 3 0 DC [volt_pos]
			Vneg 4 0 DC [volt_neg]
	ELSE
		 .subckt LM675 1 2 3 4 5 // standard 5pin connections with power supply
	ENDIF      
        //

// ---- Part 3: operational amplifiers ---- 
// Developer info: If you want to add another opAmp model to the following section, please enter it into
 the Default_Values and in the spice section.

For the Default values, just enter a line with the type=... statement.

For the spice section you need to add the subcircuit and also the component X_ line calling that subcircuit.
Ideally the subcircuit should be called via INCLUDE-statement so that the Spice section does not become too long.
And the X_ line needs to call the subcircuit's name and its connections. The connections must be in the same order as the subcircuit.

<Component>
	<Description>
		An operational amplifier.
	</Description>
	<eeschema_sch>
		L anicad:opAmp
	</eeschema_sch>
	<Default_Values>
		type=LM741 // 
		type=AD820
		type=AD822
		type=TL08x // the TL08x series contains the TL081 TL082 and TL084 opAmps. 
		//+<br> (They have the same electric behaviour, the difference is whether there are 1, 2 or 4 OpAmps in one IC housing.)
		type=TLV2371 // rail-to-rail OpAmp
		type=LM358
		type=LM675 // power OpAmp 

	</Default_Values>
	<eeschema_symbol>
		DEFINE [symbol] AS_WORD_RIGHT OF:symbol IN:[value]
		IF [symbol] STARTS_WITH sq THEN // square symbol with "+" at the output
			<Line -200 -200 0 400 #000080 2 1>
			<Line -200 -200 400 0 #000080 2 1>
			<Line 200 200 0 -400  #000080 2 1>
			<Line 200 200 -400 0  #000080 2 1>
			<Line 110 -0 60 0 #800000 2 1>
			<Line 140 -30 0 60 #800000 2 1>
			
		ELSE // triangle symbol
			<Line -200 -200 0 400 #000080 2 1>
			<Line -200 200 400 -200 #000080 2 1>
			<Line 200 0 -400 -200 #000080 2 1>
		ENDIF
	    // non-inverting, positive input:
	    <.PortSym -300 -100 [in_pos] 0> 
	    <Line -300 -100 100 0 #000080 2 1>
	    <Line -170 -100 60 0 #800000 2 1>
	    <Line -140 -130 0 60 #800000 2 1>
	    // inverting, negative input:
	    <.PortSym -300 100 [in_neg] 0> 
	    <Line -300 100 100 0 #000080 2 1>
	    <Line -170 100 60 0 #0000FF 2 1>
	    // positive power supply:
	    <.PortSym -100 -300 [src_pos] 270>
	    <Line -100 -300 0 150 #000080 2 1>
	    // negative power supply:
	    <.PortSym -100 300 [src_neg] 90>  
	    <Line -100 300 0 -150 #000080 2 1>
	    //output
	    <.PortSym 300 0 [out] 180>
	    <Line 300 0 -100 0 #000080 2 1> 
  	</eeschema_symbol>
	<Spice>
		DEFINE [type] AS_WORD_RIGHT OF:type IN:[value]
	
	    //  include subcircuit model, and call it in a X_ line:
		IF [type] EQUAL_TO LM741 THEN
			INCLUDE Subckt_LM741
			X_[individual] [in_pos] [in_neg] [src_pos] [src_neg] [out] LM741
		ENDIF
		
		IF [type] EQUAL_TO AD820 THEN
			INCLUDE Subckt_AD820
			X_[individual] [in_pos] [in_neg] [src_pos] [src_neg] [out] AD820A
		ENDIF
		
		IF [type] EQUAL_TO AD822 THEN
			INCLUDE Subckt_AD822
			// here is an -v- unusual connection, as the AD822 subcircuit also has a ground node stated in its connections list.
			X_[individual] 0 [in_pos] [in_neg] [src_pos] [src_neg] [out] AD822
		ENDIF
		
		IF [type] STARTS_WITH TL08 THEN // TL08x series consisting of TL081 TL082 and TL084
			INCLUDE Subckt_TL08x
			X_[individual] [in_pos] [in_neg] [src_pos] [src_neg] [out] TL08x
		ENDIF
		
		IF [type] EQUAL_TO TLV2371 THEN
			INCLUDE Subckt_TLV2371
			X_[individual] [in_pos] [in_neg] [src_pos] [src_neg] [out] TLV2371
		ENDIF
		
		IF [type] EQUAL_TO LM358 THEN
			INCLUDE Subckt_LM358
			X_[individual] [in_pos] [in_neg] [src_pos] [src_neg] [out] LM358
		ENDIF	
		
		IF [type] EQUAL_TO LM675 THEN
			INCLUDE Subckt_LM675
			X_[individual] [in_pos] [in_neg] [src_pos] [src_neg] [out] LM675
		ENDIF
	</Spice>
</Component>

// same as before but without the src pins:
<Component>
	<Description>
		An operational amplifier,
		The power supply pins are removed. Their voltage is given as parameters volt_pos and volt_neg.
		If volt_neg is omitted, then it is assumed to be the negative value of volt_pos, (mathematically that is volt_neg=0-volt_pos)
	</Description>
	<eeschema_sch>
		L anicad:opAmp_3pin
	</eeschema_sch>
	<Default_Values>
		type=LM741 volt_pos=9 volt_neg=-9 // LM741 operational amplifier with positive power supply of 9 volt and negative of minus 9 volt.
		type=AD820 volt_pos=9 //AD820 operational amplifier with positive power supply of 9 Volt and implicitly defined negative of minus 9V.
		type=AD822 volt_pos=12.5 volt_neg=-12.5
		type=TL08x volt_pos=12.5 volt_neg=-12.5// the TL08x series contains the TL081 TL082 and TL084 opAmps. 
		//+<br> (They have the same electric behaviour, the difference is whether there are 1, 2 or 4 OpAmps in one IC housing.)
		type=TLV2371 volt_pos=12.5 volt_neg=-12.5  // rail-to-rail OpAmp
		type=LM358 volt_pos=12.5 volt_neg=-12.5
		type=LM675 volt_pos=15.0 volt_neg=-15.0// power OpAmp 

		
		
	</Default_Values>
	<eeschema_symbol>
		DEFINE [symbol] AS_WORD_RIGHT OF:symbol IN:[value]
		IF [symbol] STARTS_WITH sq THEN // square symbol with "+" at the output
			<Line -200 -200 0 400 #000080 2 1>
			<Line -200 -200 400 0 #000080 2 1>
			<Line 200 200 0 -400  #000080 2 1>
			<Line 200 200 -400 0  #000080 2 1>
			<Line 110 -0 60 0 #800000 2 1>
			<Line 140 -30 0 60 #800000 2 1>
			
		ELSE // triangle symbol
			<Line -200 -200 0 400 #000080 2 1>
			<Line -200 200 400 -200 #000080 2 1>
			<Line 200 0 -400 -200 #000080 2 1>
		ENDIF
	    // non-inverting, positive input:
	    <.PortSym -300 -100 [in_pos] 0> 
	    <Line -300 -100 100 0 #000080 2 1>
	    <Line -170 -100 60 0 #800000 2 1>
	    <Line -140 -130 0 60 #800000 2 1>
	    // inverting, negative input:
	    <.PortSym -300 100 [in_neg] 0> 
	    <Line -300 100 100 0 #000080 2 1>
	    <Line -170 100 60 0 #0000FF 2 1>
	    // positive power supply:
	//    <.PortSym -100 -300 [src_pos] 270>
	//    <Line -100 -300 0 150 #000080 2 1>
	    // negative power supply:
	//    <.PortSym -100 300 [src_neg] 90>  
	//    <Line -100 300 0 -150 #000080 2 1>
	    //output
	    <.PortSym 300 0 [out] 180>
	    <Line 300 0 -100 0 #000080 2 1> 
  	</eeschema_symbol>
	<Spice>
		// preparation get type and volt_pos and volt_neg:
		DEFINE [type] AS_WORD_RIGHT OF:type IN:[value]
		
		DEFINE [volt_pos] AS_WORD_RIGHT OF:volt_pos IN:[value]
		DEFINE [volt_pos] AS_NUMBER OF:[volt_pos]
		
		DEFINE [volt_neg] AS_WORD_RIGHT OF:volt_neg IN:[value]
		DEFINE [volt_neg] AS_NUMBER OF:[volt_neg]
		IF ! [volt_neg] THEN
			DEFINE [volt_neg] AS_MATH_SUB OF:0.0 AND:[volt_pos]
		ENDIF
		
		
	    //  include subcircuit model, and call it in a X_ line:
		IF [type] EQUAL_TO LM741 THEN
			INCLUDE Subckt_LM741
			X_[individual] [in_pos] [in_neg]      [out] LM741
		ENDIF
		
		IF [type] EQUAL_TO AD820 THEN
			INCLUDE Subckt_AD820
			X_[individual] [in_pos] [in_neg]      [out] AD820A
		ENDIF
		
		IF [type] EQUAL_TO AD822 THEN
			INCLUDE Subckt_AD822
			// here is an -v- unusual connection, as the AD822 subcircuit also has a ground node stated in its connections list.
			X_[individual] 0 [in_pos] [in_neg]     [out] AD822
		ENDIF
		
		IF [type] STARTS_WITH TL08 THEN // TL08x series consisting of TL081 TL082 and TL084
			INCLUDE Subckt_TL08x
			X_[individual] [in_pos] [in_neg]     [out] TL08x
		ENDIF
		
		IF [type] EQUAL_TO TLV2371 THEN
			INCLUDE Subckt_TLV2371
			X_[individual] [in_pos] [in_neg]      [out] TLV2371
		ENDIF
		
		IF [type] EQUAL_TO LM358 THEN
			INCLUDE Subckt_LM358
			X_[individual] [in_pos] [in_neg]      [out] LM358
		ENDIF	
		
		IF [type] EQUAL_TO LM675 THEN
			INCLUDE Subckt_LM675
			X_[individual] [in_pos] [in_neg]     [out] LM675
		ENDIF
		
		// post check: value given?
		IF ! [volt_neg] THEN
			<Dialog type="error" title="voltage supply not defined correctly">
				IF [language] EQUAL_TO de THEN
					Der Operationsverstaerker namens [name] hat keine korrekt eingegebene Versorgungsspannung.
					Bitte geben Sie dem Bauteil korrekten Wert fuer volt_pos und volt_neg.
				ELSE
					The operational amplifier called [name] does not have a correct value for the power supply voltage.
					Please give a correct value for volt_pos and volt_neg of that component.
				ENDIF
			</Dialog>
		ENDIF
	</Spice>
</Component>


<Subckt_LM741> // adapted to match 3pin and 5pin model
		*LM741 OP-AMP MACRO-MODEL
		*             connections: non-inverting input
		*             | inverting input
		*             | | positive power supply
		*             | | |  negative power supply
		*             | | |  |  output
		*             | | |  |  |
		*             | | |  |  |
	IF [model] ENDS_WITH 3pin THEN
		.SUBCKT LM741 1 2       28 // reduced 3pin connections without power supply
		Vpos 99 0 DC [volt_pos]
		Vneg 50 0 DC [volt_neg]

// -- 4c: Schottky diodes --
<Component>
<Description>
		A schottky diode.
	
		Please select one of the available diode types.
		Alternatively, expert users can set the parameters. (See in Ngspice user manual 7.2 "Diode model")

	</Description>
	<eeschema_sch>
		L anicad:schottky_diode
	</eeschema_sch>
	<eeschema_symbol>
		DRAW
			P 2 0 1 0 50 0 -50 0 N
			P 4 0 1 8 50 50 50 -50 -50 0 50 50 N
			P 6 0 1 8 -75 25 -75 50 -50 50 -50 -50 -25 -50 -25 -25 N
			X K 1 -150 0 100 R 50 50 1 1 P
			X A 2 150 0 100 L 50 50 1 1 P
		ENDDRAW
	</eeschema_symbol>
	<purchase>
		<link>
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fdioden-standard-hf-leistung-6203020.html</url>
            <title>"standard diodes"</title>
            <detail>"overview of standard diodes at conrad electronic"</detail>
			IF [conrad_de] THEN
		</link>
			<title>"standard diode model [type]"</title>
            <detail>"standard diode type [type] at conrad electronic"</detail>
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2F[conrad_de]</url>    
		<link>
			ENDIF
		</link>
	</purchase>
	<Default_Values>
		type=1N5817 // A general-purpose Schottky diode with a maximum reverse voltage of 20V and a forward current rating of 1A.
		type=1N5818 // A Schottky diode with a maximum reverse voltage of 30V and a forward current rating of 1A.
		type=1N5819 // A Schottky diode with a maximum reverse voltage of 40V and a forward current rating of 1A.
		type=1N5820 // A high power schottky diode for large currents of up to 9.4 A peak and 3A permanent
		type=1N5821 // A high power schottky diode for large currents of up to 9.4 A peak and 3A permanent
		parameters=(bv=50 is=1e-13 n=1.05) // diode model with parameters defined. 
	</Default_Values>
	<Spice>
		DEFINE [type] AS_WORD_RIGHT OF:type IN:[value]
		DEFINE [type] AS_UPPERCASE OF:[type]

		IF [type] EQUAL_TO 1N5817 THEN
			DEFINE [max_rev_volt] 20 // maximal voltage in reverse direction
			DEFINE [max_ampere] 3.0 // maximal ampere in forward direction
			DEFINE [footprint] DO-15 // package
			DEFINE [conrad_de] diotec-schottky-diode-1n5817-do-15-20-v-2808946.html 
			DEFINE [parameters] (IS=870u RS=81.3m BV=20.0 IBV=1.00m CJO=203p M=0.333 N=1.81 TT=4.32u)
		ENDIF		
		IF [type] EQUAL_TO 1N5818 THEN 
			DEFINE [max_rev_volt] 30 // maximal voltage in reverse direction
			DEFINE [max_ampere] 3.0 // maximal ampere in forward direction
			DEFINE [footprint] DO-15 // package
			DEFINE [conrad_de] diotec-schottky-diode-1n5818-do-15-30-v-2808947.html 
			DEFINE [parameters] (IS=263u RS=73.1m BV=30.0 IBV=1.00m CJO=203p M=0.333 N=1.90 TT=4.32u)
		ENDIF
		IF [type] EQUAL_TO 1N5819 THEN
			DEFINE [max_rev_volt] 40 // maximal voltage in reverse direction
			DEFINE [max_ampere] 3.0 // maximal ampere in forward direction
			DEFINE [footprint] DO-15 // package
			DEFINE [parameters] IS=390n RS=0.115 BV=40.0 IBV=1.00m CJO=203p M=0.333 N=1.70 TT=4.32u 
			DEFINE [conrad_de] diotec-schottky-diode-1n5819-do-15-40-v-2808948.html 
		ENDIF
		IF [type] EQUAL_TO 1N5820 THEN
			DEFINE [max_rev_volt] 20
			DEFINE [max_ampere] 3.0
			DEFINE [footprint] DO-201
			DEFINE [conrad_de] diotec-schottky-diode-1n5820-do-201-20-v-2808949.html
			DEFINE [parameters] (IS=1m RS=30m BV=40.0 IBV=1.00m CJO=120p M=0.333 N=1.81 TT=5.00u)
		ENDIF
		IF [type] EQUAL_TO 1N5821 THEN
			DEFINE [max_rev_volt] 30
			DEFINE [max_ampere] 3.0
			DEFINE [footprint] DO-201
			DEFINE [conrad_de] 	diotec-schottky-diode-1n5821-do-201-30-v-2808950.html
			DEFINE [parameters] (IS=1m RS=25m BV=60.0 IBV=1.00m CJO=100p M=0.333 N=1.81 TT=6.00u)
		ENDIF
		
		IF ![parameters] THEN
			<Dialog type="warning" title="schottky diode not defined correctly">
				The schottky diode does not have a correct value. 
				The default diode model is selected instead.
				Please select a valid diode type.
			</Dialog>
		ENDIF
		
		.model D_[individual]_MDL D IF[parameters]THEN[parameters]ENDIF 
		D_[individual] [A] [K] D_[individual]_MDL
	</Spice>
	<purchase>
		<link>
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fschottky-dioden-6203050.html</url>
            <title>"schottky diodes"</title>
            <detail>"overview of schottky diodes at conrad electronic"</detail>	
		</link>
		IF [conrad_de] THEN
			<link>
				<title>"schottky diode model [type]"</title>
				<detail>"schottky diode type [type] at conrad electronic"</detail>
				<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2F[conrad_de]</url>    
			</link>
		ENDIF
	</purchase>
	
</Component>


<Component>
    <Description>
        Light emitting diode, short "LED".
        You can define the color of the LED by entering a color code into the value. The color has the format #RrGgBb, for example #FF0000 for red, #00FF00 for green, #0000FF for blue, #FFFF00 for yellow.
        If you do not define any color, then the default color is yellow.
        
        For example, you can define a purple LED with default simulation parameters, by simply entering the color value:
        #9230b9
        
		The default forward current for maximal "shining" of the LED is 20mA, but you can specify any other value, by stating for example I_F=3mA 
		
        But advanced users can also define the diode simulation parameters, called param. To use this option,it is advised to read the ngspice user manual chapter 7.2 "Diode Model". The parameters must be in brackets "(" and ")". For example, enter the value:
        color=#00FF00 param=(bv=50 is=1e-13 n=1.05)
    </Description>
     <eeschema_sch>
        L anicad:LED
    </eeschema_sch>
	<Default_Values>
		color=green // a simple LED with a standard colour (standard colours are red,green, yellow, blue)
		I_F=3mA color=#9230b9 // an LED with nominal forward current of 3 milli Ampere and the shining color #9230b9 (that is purple)
		color=#00FF00 param=(bv=50 is=1e-13 n=1.05) // green LED. With specific diode parameters, as in the ngspice user manual chapter 7.2 "Diode Model".
	</Default_Values>
    <Spice>

        DEFINE [param] AS_SUBTEXT AFTER:(BEFORE:)OF:[value] // without the brackets
	    IF [param] THEN DEFINE [param] ([param]) ENDIF      // with brackets again
       	   

	   // ---- shining color of the led -----
        DEFINE [color] AS_WORD_RIGHT OF:color IN:[value]
        IF [color] THEN
			IF [color] STARTS_WITH # THEN
				//do nothing here	
			ELSEIF [color] STARTS_WITH r   THEN DEFINE [color] #FF0000 //red
				ELSEIF [color] STARTS_WITH g  THEN DEFINE [color] #00FF00  //green
					ELSEIF [color] STARTS_WITH b   THEN DEFINE [color] #0000FF // blue
							ELSE DEFINE [color] #FFFF00 //yellow
						ENDIF
					ENDIF
				ENDIF
			ENDIF
        ELSE
            DEFINE [color] #FFFF00 //default color yellow
		ENDIF
		
		// ---- standard parameters for coloured leds ----
		IF [param] THEN 
			DEFINE [given_param] yes
		ELSE 
			DEFINE [given_param] no
			IF 		[color] EQUAL_TO #FF0000 THEN DEFINE [param] is=1e-18 n=2 rs=10 //red:  	Vf=ca 1.9V
			ELSE IF [color] EQUAL_TO #00FF00 THEN DEFINE [param] is=1e-20 n=2 rs=10 //green:	Vf=ca 2.3V
			ELSE IF [color] EQUAL_TO #0000FF THEN DEFINE [param] is=5e-23 n=2 rs=10 //blue: 	Vf=ca 3.2V
			ELSE 								  DEFINE [param] is=1e-19 n=2 rs=10 //yellow: 	Vf=ca 2.1V
		    ENDIF ENDIF ENDIF
			DEFINE [param] ([param])
		ENDIF
		
		
        // ----- nominal forward current -----
	    DEFINE [i_fwd] AS_WORD_RIGHT OF:I_F IN:[value]
	    DEFINE [i_fwd] AS_NUMBER OF:[i_fwd]
	    IF ![i_fwd] THEN
			DEFINE [i_fwd] 0.02
		ENDIF // default led forward current=20mA.
	    .model D_[individual]_MDL_LED D IF[param]THEN[param]ENDIF
        D_[individual] [A] [K] D_[individual]_MDL_LED
		
		
    </Spice>    
    <animation>
        DEFINE [curr] I[A] // actual current is the I value at the Anode...
        DEFINE [curr] AS_MATH_ABS OF:[curr] // ... but as positive number.
		DEFINE [curr_share] AS_MATH_DIV OF:[curr] AND: [i_fwd] // current share=actual current/nominal current, where I_F is the nominal forward current of the LED 

        IF [curr_share] HIGHER_THAN 0.1 THEN // more than 10% of nominal current - make a colored circle with various size dependent on the current
            DEFINE [start] AS_MATH_MUL OF:[curr_share] AND:500
            DEFINE [start] AS_MATH_MAX OF:[start] AND:100
            DEFINE [start] AS_MATH_MIN OF:[start] AND:500
            DEFINE [start] AS_MATH_ROUND OF:[start]
            DEFINE [shine] AS_MATH_MUL OF:[start] AND:2
            <Ellipse -[start] -[start] [shine] [shine] [color] 2 1 [color] 1 0.5> //  circle of various size shows shining led
        ELSE
            <Ellipse -100 -100 200 200 #222222 2 1 #222222 1 0.5> // grey circle around the LED indicates that it is off (less than 10% of nominal current).
        ENDIF
    </animation>
    <eeschema_symbol>
			DRAW
			P 2 0 1 8 -50 -50 -50 50 N
			P 2 0 1 0 -50 0 50 0 N
			P 4 0 1 8 50 -50 50 50 -50 0 50 -50 N
			P 5 0 1 0 -120 -30 -180 -90 -150 -90 -180 -90 -180 -60 N
			P 5 0 1 0 -70 -30 -130 -90 -100 -90 -130 -90 -130 -60 N
			X K 1 -150 0 100 R 50 50 1 1 P
			X A 2 150 0 100 L 50 50 1 1 P
			ENDDRAW
    </eeschema_symbol>
	<purchase>
        <link>
                <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fleds-bedrahtet-0212029.html</url>
                <title>"LEDs"</title>
                <detail>"overview of LEDs at conrad electronic"</detail>
        </link>
    </purchase>
</Component>

	
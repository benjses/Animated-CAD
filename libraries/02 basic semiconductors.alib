// ---- Part 4: Diodes -----

// -- 4a: standard diodes --
<Component>
	<Description>
		A standard diode.
	
		Please select one of the available diode types.
		Alternatively, expert users can set the parameters. (See in Ngspice user manual 7.2 "Diode model")

	</Description>
	<eeschema_sch>
		L anicad:diode
	</eeschema_sch>
	<eeschema_symbol>
		DRAW
			P 2 0 1 0 50 0 -50 0 N
			P 4 0 1 8 50 50 50 -50 -50 0 50 50 N
			P 2 0 1 0 -40 50 -40 -50 N
			X K 1 -150 0 100 R 50 50 1 1 P
			X A 2 150 0 100 L 50 50 1 1 P
		ENDDRAW
	</eeschema_symbol>
	<purchase>
		<link>
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fdioden-standard-hf-leistung-6203020.html</url>
            <title>"standard diodes"</title>
            <detail>"overview of standard diodes at conrad electronic"</detail>
			IF [conrad_de] THEN
		</link>
			<title>"standard diode model [type]"</title>
            <detail>"standard diode type [type] at conrad electronic"</detail>
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2F[conrad_de]</url>    
		<link>
			ENDIF
		</link>
	</purchase>
	<Default_Values>
		type=1N5401 // standard diode of the 1N540x - series.
		type=1N5402 // standard diode of the 1N540x - series.
		type=1N5404 // standard diode of the 1N540x - series.
		type=1N5406 // standard diode of the 1N540x - series.
		type=1N5407 // standard diode of the 1N540x - series.
		type=1N5408 // standard diode of the 1N540x - series.
		parameters=(bv=50 is=1e-13 n=1.05) // diode model with parameters defined. 
	</Default_Values>
	<Spice>
		// ideal model, with parameters defined directly by the user: 
		DEFINE [parameters] AS_SUBTEXT AFTER:(BEFORE:)OF:[value] // without the brackets
	    IF [parameters] THEN 
			DEFINE [parameters] ([parameters])                   //  with brackets again
		
			.model D_[individual]_MDL D IF[parameters]THEN[parameters]ENDIF 
			D_[individual] [A] [K] D_[individual]_MDL
		
		ELSE  // real models, with parameters defined by the developer of the diode:
		
			DEFINE [type] AS_WORD_RIGHT OF:type IN:[value]
			DEFINE [type] AS_UPPERCASE OF:[type]
		
			IF [type] EQUAL_TO 1N5401 THEN
				DEFINE [parameters] Vrrm=100 Vrsm=100 Ir=5u Irsm=5u Vf=1.2 Ifav=3 Rs=.011 trr=1500n Cj=30p Eg=1.11 Xti=3
				DEFINE [datasheet] www.diotec.com/en/product/1N5401.html
				DEFINE [conrad_de] www.conrad.de%2Fde%2Fp%2Fdiotec-si-gleichrichterdiode-1n5401-do-201-100-v-3-a-162370.html
			ENDIF
			IF [type] EQUAL_TO 1N5402 THEN
				DEFINE [parameters] Vrrm=200 Vrsm=200 Ir=5u Irsm=5u Vf=1.2 Ifav=3 Rs=.011 trr=1500n Cj=30p Eg=1.11 Xti=3
				DEFINE [datasheet] www.diotec.com/en/product/1N5402.html
				DEFINE [conrad_de] www.conrad.de%2Fde%2Fp%2Ftru-components-si-gleichrichterdiode-tc-1n5402-do-201-200-v-3-a-1581849.html
			ENDIF
			IF [type] EQUAL_TO 1N5404 THEN
				DEFINE [parameters] Vrrm=400 Vrsm=400 Ir=5u Irsm=5u Vf=1.2 Ifav=3 Rs=.011 trr=1500n Cj=30p Eg=1.11 Xti=3
				DEFINE [datasheet] www.diotec.com/en/product/1N5404.html
				DEFINE [conrad_de] www.conrad.de%2Fde%2Fp%2Fdiotec-si-gleichrichterdiode-1n5404-do-201-400-v-3-a-162400.html
			ENDIF
			IF [type] EQUAL_TO 1N5406 THEN
				DEFINE [parameters] Vrrm=600 Vrsm=600 Ir=5u Irsm=5u Vf=1.2 Ifav=3 Rs=.011 trr=1500n Cj=30p Eg=1.11 Xti=3
				DEFINE [datasheet] www.diotec.com/en/product/1N5406.html
				DEFINE [conrad_de] www.conrad.de%2Fde%2Fp%2Fdiotec-si-gleichrichterdiode-1n5406-do-201-600-v-3-a-162418.html
			ENDIF
			IF [type] EQUAL_TO 1N5407 THEN
				DEFINE [parameters] Vrrm=800 Vrsm=800 Ir=5u Irsm=5u Vf=1.2 Ifav=3 Rs=.011 trr=1500n Cj=30p Eg=1.11 Xti=3
				DEFINE [datasheet] www.diotec.com/en/product/1N5407.html
				DEFINE [conrad_de] www.conrad.de%2Fde%2Fp%2Fdiotec-si-gleichrichterdiode-1n5407-do-201-800-v-3-a-140608.html
			ENDIF
			IF [type] EQUAL_TO 1N5408 THEN
				DEFINE [parameters] Vrrm=1000 Vrsm=1000 Ir=5u Irsm=5u Vf=1.2 Ifav=3 Rs=.011 trr=1500n Cj=30p Eg=1.11 Xti=3
				DEFINE [datasheet] www.diotec.com/en/product/1N5408.html
				DEFINE [conrad_de] www.conrad.de%2Fde%2Fp%2Fdiotec-si-gleichrichterdiode-1n5408-do-201-1000-v-3-a-162434.html
			ENDIF
			IF [parameters] THEN
				DEFINE [vrrm] AS_WORD_RIGHT OF:Vrrm IN:[parameters]
				DEFINE [vrrm] AS_NUMBER OF:[vrrm]
				
				DEFINE [vrsm] AS_WORD_RIGHT OF:Vrsm IN:[parameters]
				DEFINE [vrsm] AS_NUMBER OF:[vrsm]
				
				DEFINE [ir] AS_WORD_RIGHT OF:Ir IN:[parameters]
				DEFINE [ir] AS_NUMBER OF:[ir]
				
				DEFINE [irsm] AS_WORD_RIGHT OF:Irsm IN:[parameters]
				DEFINE [irsm] AS_NUMBER OF:[irsm]
				
				DEFINE [vf] AS_WORD_RIGHT OF:Vf IN:[parameters]
				DEFINE [vf] AS_NUMBER OF:[vf]
				
				DEFINE [ifav] AS_WORD_RIGHT OF:Ifav IN:[parameters]
				DEFINE [ifav] AS_NUMBER OF:[ifav]
				
				DEFINE [rs] AS_WORD_RIGHT OF:Rs IN:[parameters]
				DEFINE [rs] AS_NUMBER OF:[rs]
				
				DEFINE [trr] AS_WORD_RIGHT OF:trr IN:[parameters]
				DEFINE [trr] AS_NUMBER OF:[trr]
				
				DEFINE [cj] AS_WORD_RIGHT OF:Cj IN:[parameters]
				DEFINE [cj] AS_NUMBER OF:[cj]
				
				DEFINE [eg] AS_WORD_RIGHT OF:Eg IN:[parameters]
				DEFINE [eg] AS_NUMBER OF:[eg]
				
				DEFINE [xti] AS_WORD_RIGHT OF:Xti IN:[parameters]
				DEFINE [xti] AS_NUMBER OF:[xti]
				
				DEFINE [is] AS_CALCULATION OF:[ir]/40
				DEFINE [bv] AS_CALCULATION OF:[vrsm]*1.05
				DEFINE [ibv] [ir]
				DEFINE [vpk] [vrrm]
				
				DEFINE [n] AS_CALCULATION OF:0.8*[vf]/0.025/(Math.log([ifav])-Math.log([ir]/40))
				DEFINE [iave] [ifav]
				DEFINE [cjo] AS_CALCULATION OF:2*[cj]
				DEFINE [m] 0.33
				DEFINE [tt] [trr]
				DEFINE [vp] 0.5
				DEFINE [mfg] Diotec
				DEFINE [partype] Rectifier
			
				// model - similar to the original, but adapted to work with this simulator, original see at diotec website www.diotec.com/en/product/1N5402.html
				* (c) Diotec Semiconductor AG
				* www.diotec.com
				* 2017-12-15
				//
				// ********************************************************
				// This model is for simulation purposes only. It does   *
				// not replace reviewing of the data sheet nor real life *
				// testing of the part inside the application.           *
				// *********************************************************
				// Above values are an example for the 1N54xx-series. Using the symbol
				// above symbol file allows for direct insertion of other values
				// according to these data sheet parameters:
				// Vrrm    	Repetitive peak reverse voltage
				//  Ir		Leakage current
				// Vrsm    	Surge peak reverse voltage / Reverse avalanche breakdown voltage
				// Irsm		Defined at avalanche diodes, otherwise set Irsm = Ir
				// Vf		Forward voltage
				// Ifav		Test current for Vf, usually equal to average forward rectified current
				// trr		Reverse recovery time; for Schottky, set trr=5n
				// Cj		Junction capacitance at 4V
				// Activation energy: Eg=1.11 for Si (pn) rectifier, Eg=.69 for Schottky (metal barrier) rectifier
				// Series resistance: Rs=(Vf@3*Ifav - Vf@Ifav)/(3*Ifav - Ifav) from data sheet curve
				// Sat.-current temp. exp: Xti=3 for Si (pn) rectifier, Xti=2 for Schottky (metal barrier) rectifier

				.model diode_type_[type] D (Is=[is] Bv=[bv] Ibv=[ibv] Vpk=[vpk] N=[n] Rs=[rs] Eg=[eg] Xti=[xti] Iave=[iave] Cjo=[cjo] M=[m] Tt=[tt] Vp=[vp] )// mfg=Diotec type=[partype]
				// call of that model:
				D_[individual] [A] [K] diode_type_[type]
			ELSE
				<Dialog type="warning" title=" diode not defined correctly">
					The  diode does not have a correct value. 
					The default diode model is selected instead.
					Please select a valid diode type.
				</Dialog>
				.model D_[individual]_MDL D
				D_[individual] [A] [K] D_[individual]_MDL 
			ENDIF
		ENDIF
	</Spice>
</Component>

// -- 4b: Zener diodes --
<Component>
    <Description>
        A Zener-Diode. 
		
		---- Values: ----
		you can either use an existing diode type, or set the zv parameters.
        zv is the reverse breakdown voltage (the voltage, at which the diode starts to conduct in reverse direction)
		param is the list of other parameters. Optional - If not specified, then the default diode parameters are used.
    </Description>
    <eeschema_sch>
        L anicad:zener_diode
    </eeschema_sch>
    <Default_Values>
        zv=3.3 // zener voltage at 3.3V 
		zv=12 parameters=(is=1e-13 n=1.05) // zener voltage at 12.0V and other parameters specified, see at the ngspice user manual chapter 7.2 "Diode Model".
		type=zpd2.7 // zener diode with 2.7 Volt 
		type=zpd5.1 // zener diode with 5.1 Volt 
		type=zpd5.6 // zener diode with 5.6 Volt 
		type=zpd8.2 // zener diode with 8.2 Volt 
		type=zpd10 // zener diode with 10 Volt 
		type=zpd12 // zener diode with 12 Volt 
		type=zpd15 // zener diode with 15 Volt 
		type=zpd18 // zener diode with 18 Volt 
		type=zpd20 // zener diode with 20 Volt 
		type=zpd24 // zener diode with 24 Volt 
	</Default_Values>
    <Spice>
		DEFINE [type] AS_WORD_RIGHT OF:type IN:[value]
		IF [type] THEN DEFINE [type] AS_LOWERCASE OF:[type] ENDIF

		IF [type] THEN // real models:
			IF [type] EQUAL_TO zpd2.7 THEN
				DEFINE [parameters] Vznom=2.7 Iztest=5m Vr=1.4 Ir=0.1u Rzj=75 Izmax=172m Cjo=600p
				DEFINE [conrad_de] diotec-z-diode-zpd2-7-gehaeuseart-halbleiter-do-35-zener-spannung-2-7-v-leistung-max-p-tot-500-mw-180025.html
			ENDIF
			IF [type] EQUAL_TO zpd5.1 THEN
				DEFINE [parameters] Vznom=5.1 Iztest=5m Vr=0.8 Ir=0.1u Rzj=30 Izmax=93m Cjo=280p
				DEFINE [conrad_de] diotec-z-diode-zpd5-1-gehaeuseart-halbleiter-do-35-zener-spannung-5-1-v-leistung-max-p-tot-507-mw-180092.html
			ENDIF
			IF [type] EQUAL_TO zpd5.6 THEN
				DEFINE [parameters] Vznom=5.6 Iztest=5m Vr=1 Ir=0.1u Rzj=10 Izmax=83m Cjo=260p
				DEFINE [conrad_de] diotec-z-diode-zpd5-6-gehaeuseart-halbleiter-do-35-zener-spannung-5-6-v-leistung-max-p-tot-508-mw-180106.html
			ENDIF
			IF [type] EQUAL_TO zpd8.2 THEN
				DEFINE [parameters] Vznom=8.2 Iztest=5m Vr=6 Ir=0.1u Rzj=4.5 Izmax=57m Cjo=140p
				DEFINE [conrad_de] diotec-z-diode-zpd8-2-gehaeuseart-halbleiter-do-35-zener-spannung-8-2-v-leistung-max-p-tot-512-mw-180149.html
			ENDIF
			IF [type] EQUAL_TO zpd10 THEN
				DEFINE [parameters] Vznom=10 Iztest=5m Vr=7.5 Ir=0.1u Rzj=5.2 Izmax=47m Cjo=85p
				DEFINE [conrad_de] diotec-z-diode-zpd10-gehaeuseart-halbleiter-do-35-zener-spannung-10-v-leistung-max-p-tot-514-mw-180165.html
			ENDIF
			IF [type] EQUAL_TO zpd12 THEN
				DEFINE [parameters] Vznom=12 Iztest=5m Vr=9 Ir=0.1u Rzj=7 Izmax=39m Cjo=70p
				DEFINE [conrad_de] diotec-z-diode-zpd12-gehaeuseart-halbleiter-do-35-zener-spannung-12-v-leistung-max-p-tot-516-mw-180181.html
			ENDIF
			IF [type] EQUAL_TO zpd15 THEN
				DEFINE [parameters] Vznom=15 Iztest=5m Vr=11 Ir=0.1u Rzj=11 Izmax=32m Cjo=47p
				DEFINE [conrad_de] diotec-z-diode-zpd15-gehaeuseart-halbleiter-do-35-zener-spannung-15-v-leistung-max-p-tot-518-mw-180203.html
			ENDIF
			IF [type] EQUAL_TO zpd18 THEN
				DEFINE [parameters] Vznom=18 Iztest=5m Vr=14 Ir=0.1u Rzj=18 Izmax=26m Cjo=35p
				DEFINE [conrad_de] diotec-z-diode-zpd18-gehaeuseart-halbleiter-do-35-zener-spannung-18-v-leistung-max-p-tot-520-mw-180211.html
			ENDIF
			IF [type] EQUAL_TO zpd20 THEN
				DEFINE [parameters] Vznom=20 Iztest=5m Vr=15 Ir=0.1u Rzj=20 Izmax=24m Cjo=33p
				DEFINE [conrad_de] diotec-z-diode-zpd20-gehaeuseart-halbleiter-do-35-zener-spannung-20-v-leistung-max-p-tot-521-mw-180220.html
			ENDIF
			IF [type] EQUAL_TO zpd24 THEN
				DEFINE [parameters] Vznom=24 Iztest=5m Vr=18 Ir=0.1u Rzj=28 Izmax=20m Cjo=27p
				DEFINE [conrad_de] diotec-z-diode-zpd24-gehaeuseart-halbleiter-do-35-zener-spannung-24-v-leistung-max-p-tot-523-mw-180246.html
			ENDIF
			// make sure that the diode type and its parameters are defined
			IF ![parameters] THEN
				<Dialog title="zener diode not defined">
					The zener diode diode named [name] does not have a correct value.
					If you want to use a zpd series diode, you must use one of the pre-defined types.
				</Dialog>
			ENDIF
			
				DEFINE [vznom] AS_WORD_RIGHT OF:Vznom IN:[parameters]
				DEFINE [vznom] AS_NUMBER OF:[vznom]
				
				DEFINE [iztest] AS_WORD_RIGHT OF:Iztest IN:[parameters]
				DEFINE [iztest] AS_NUMBER OF:[iztest]
				
				DEFINE [vr] AS_WORD_RIGHT OF:Vr IN:[parameters]
				DEFINE [vr] AS_NUMBER OF:[vr]
				
				DEFINE [ir] AS_WORD_RIGHT OF:Ir IN:[parameters]
				DEFINE [ir] AS_NUMBER OF:[ir]
				
				DEFINE [rzj] AS_WORD_RIGHT OF:Rzj IN:[parameters]
				DEFINE [rzj] AS_NUMBER OF:[rzj]
				
				DEFINE [izmax] AS_WORD_RIGHT OF:Izmax IN:[parameters]
				DEFINE [izmax] AS_NUMBER OF:[izmax]
				
				DEFINE [cjo] AS_WORD_RIGHT OF:Cjo IN:[parameters]
				DEFINE [cjo] AS_NUMBER OF:[cjo]
				
				DEFINE [degc] AS_WORD_RIGHT OF:degc IN:[value] // degrees in Celsius can be given in parameter degc
				IF ![degc] THEN DEFINE [degc] 25 ENDIF // default is 25 degress Celsius
				
				DEFINE [is] AS_MATH_DIV OF:[ir] AND:10
				DEFINE [bv] AS_CALCULATION OF:[vznom]*(1+([degc]-25)*0.001)
				DEFINE [ibv] [iztest]
				DEFINE [diss] AS_CALCULATION OF:[vznom]*[izmax]
			
			* (c) Diotec Semiconductor AG
			* www.diotec.com
			* 2022-01-27
			*
			*********************************************************
			* This model is for simulation purposes only. It does   *
			* not replace reviewing of the data sheet nor real life *
			* testing of the part inside the application.           *
			*********************************************************
			
			.subckt diode_subckt_[type] A  K
			
			* SPICE model Zener diodes ***ZPD27***

			* Above values are an example for the ***ZPD27***. Using the
			* above symbol file allows for direct insertion of other values
			* according to these data sheet parameters:
			*
			* Vznom		Nominal zener voltage at 25°C = (Vzmin+Vzmax)/2
			* Iztest	Test current for Vz
			* Vr		Reverse voltage (minimum value)
			* Ir		Reverse current
			* Rzj		Dynamic resistance
			* Izmax		Max zener current
			* Cjo		Junction capacitance at 0V

			Dbr  INT  K  Zbr
			Df   A    K  Zf
			Dbl  INT  A  DIObl

			* Zener breakdown characteristic
			.model  Zbr  D(Is=[is] N=2.0 Rs=[rzj] Bv=[bv] Ibv=[ibv] Eg=1.11 Xti=3 M=.33 diss=[diss])
			*
			* Forward characteristic
			.model  Zf  D(Is=100E-9 N=2.0 Rs=37m Cjo=[cjo] Eg=1.11 Xti=3 M=.33 Tt=800n)
			*
			* Internal blocking diode
			.model  DIObl  D(Ron=.1m)

			.ends
			
			X_[individual] [A] [K] diode_subckt_[type]
		
		ELSE  // ideal model:
		    DEFINE [parameters] AS_SUBTEXT AFTER:(BEFORE:)OF:[value] // without the brackets
		    IF [parameters] THEN
				DEFINE [parameters] ([parameters])                       //  with brackets again
			ENDIF
			DEFINE [volts_breakdown] AS_WORD_RIGHT OF:zv IN:[value]
			DEFINE [volts_breakdown] AS_NUMBER OF:[volts_breakdown]
			IF ![volts_breakdown] THEN
				<Dialog type="warning" title="Missing numeric value for zener diode [name]">
					Missing value for the reverse breakdown voltage of the zener diode [name] at position ([xpos] | [ypos]).
					The value given, [value], is not a valid number. Therefor the default value, 3.3V is selected automatically.
				</Dialog>
			ENDIF
			.model DZENER_[individual]_MDL D BV=[volts_breakdown] IF[parameters]THEN[parameters]ENDIF
			D_[individual] [A] [K] DZENER_[individual]_MDL
		ENDIF
	</Spice>
	<purchase>
		IF [conrad_de] THEN
		<link>
		    <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fp%2F[conrad_de]</url>
			<title>component of [type] series</title>
			<detail>diode of the [type] series at conrad electronic.</detail>
		</link>
		ENDIF
        <link>
            IF [volts_breakdown] THEN
                IF [volts_breakdown] LOWER_THAN 2 THEN

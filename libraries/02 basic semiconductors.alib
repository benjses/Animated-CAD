			DEFINE [datasheet] https://asset.conrad.com/media10/add/160267/c1/-/en/000154997DS01/datenblatt-154997-on-semiconductor-transistor-bjt-diskret-bc546abu-to-92-3-anzahl-kanaele-1-npn.pdf
		ENDIF
		 
		//</npn_transistors_list>
			
		// post processing of parameter list: 
		
		IF ![parameters] THEN 
			<Dialog type="warning" title="missing parameter list for [bjttype] transistor model [bjt_model]">
				The transistor named [name] is not  defined in the library, so misses the parameters are not known.
				It will behave like a default transistor in a simulation , not like its model [bjt_model]
				Please correct that in the component library, and enter the parameters for your desired transistor model.
				
				Or maybe you just misspelled the model's name? 
			</Dialog>

			ELSE
				DEFINE [parameters] AS_REPLACEMENT FROM:(TO:OF:[parameters]
				DEFINE [parameters] AS_REPLACEMENT FROM:)TO:OF:[parameters]
		ENDIF
			
		INCLUDE bjt_drawing
		
    </eeschema_symbol>
	<animation>
		// defines the status of the transistor as "on" or "off" or "linear".
		
		// measure actual current at the collector:
		DEFINE [currc] I[C]
		DEFINE [currc] AS_MATH_ABS OF:[currc]

		// measure actual voltages Uce and Ube:
		DEFINE [uce] AS_MATH_SUB OF:V[C] AND:V[E]
		DEFINE [uce] AS_MATH_ABS OF:[uce]
		DEFINE [ube] AS_MATH_SUB OF:V[B] AND:V[E]
		DEFINE [ube] AS_MATH_ABS OF:[ube]
		
		// calculate the resistance :
		DEFINE [rce] AS_MATH_DIV OF:[uce] AND:[currc]

		// calculate the color (red for off, green for on, yellow for linear)
		IF [rce] HIGHER_THAN 10000 THEN // "off" transistor 
			DEFINE [color] #FF0000 // red
		ELSEIF [ube] HIGHER_THAN [uce] THEN  // "on" transistor 
				DEFINE [color] #00FF00 //green					
			ELSE // transistor in linear mode 
				DEFINE [color] #CCCC00 // yellow
			ENDIF
		ENDIF	

		// ---- animation style r = ohmic value ----
		IF [anistyle] STARTS_WITH r THEN
			<Text 400 0 60 [color] 0 "Rce=[Rce] Ohm">
		ENDIF
		// ---- animation style t = traffic light ----
		IF [anistyle] STARTS_WITH t THEN
			<Ellipse -60 -110 220 220 [color] 2 1 [color] 1 0.5> // traffic light circle in the symbol
		ENDIF
		// ---- animation style s = symbols ----
		IF[anistyle] STARTS_WITH s THEN
			
			IF [color] EQUAL_TO #FF0000 THEN // red "off" transistor - draw an open switch blocking current between c and e:
				<Line 100 100 0 -50 [color] 2 1 [color] 1 0> //vertical line 1 
				<Line 100 -100 0 50 [color] 2 1 [color] 1 0> //vertical line 2
				<Line 100 -50  20 0 [color] 2 1 [color] 1 0> //horizontal line
				<Line 100 50 50 -100 [color] 2 1 [color] 1 0> //diagonal line indicating switch is open=off
			
			ELSE IF [color] EQUAL_TO #00FF00 THEN // green "on" transistor - draw a closed switch conducting current between c and e:
				<Line 100 100 0 -50 [color] 2 1 [color] 1 0> //vertical line 1 
				<Line 100 -100 0 50 [color] 2 1 [color] 1 0> //vertical line 2
				<Line 100 -50  20 0 [color] 2 1 [color] 1 0> //horizontal line
				<Line 100 50 20 -100 [color] 2 1 [color] 1 0> //diagonal line indicating switch is closed=on
				
				ELSE // neither "on" nor "off". That is linear mode - draw a yellow resistor resisting the current between c and e:
					DEFINE [color] #CCCC00 // yellow
					<Line 100 100 0 -50 [color] 2 1 [color] 1 0> //vertical line 1 
					<Line 100 -100 0 50 [color] 2 1 [color] 1 0> //vertical line 2
					<Rectangle 80 -50 40 100 [color] 2 1 [color] 1 0> // resistor indicating linear mode		
				ENDIF
			ENDIF
		ENDIF
	</animation>
    <Spice>
        INCLUDE bjt_spice
    </Spice>
	<purchase>
		<link>
		<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Ftransistoren-5104045.html</url>
		<title>IF [language] EQUAL_TO de THEN Uebersicht BJTs ELSE Overview BJTsENDIF</title>
		<detail>IF [language] EQUAL_TO de THEN Eine Auswahl an Bipolartransistoren bei Conrad Electronic. Darunter eine Beschreibung. ELSE A collection of bipolar junction transistors at conrad electronic.ENDIF</detail>
		</link>
		IF [conrad_de] THEN
		<link>
		    <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fp%2F[conrad_de]</url>
			<title>component of [model] series</title>
			<detail>a bipolar transistor of the [model] series at conrad electronic.</detail>
		</link>
		ENDIF
	</purchase>
</Component>


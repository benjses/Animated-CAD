			DEFINE [parameters]  (vto=2.3 kp=154.6 lambda=0.07 rd=2.64m  is=8.2p )
		ENDIF
		
		IF [mos_model] EQUAL_TO BSC079N10NSG THEN
			DEFINE [udsmax] 100
			DEFINE [idmax] 100
			DEFINE [mostype] nmos
			DEFINE [parameters]  (vto=4.15 kp=91.9 lambda=0.03 rd=4.56m  is=21.3p )
		ENDIF
		
		IF [mos_model] EQUAL_TO BSC082N10LSG THEN
			DEFINE [udsmax] 100
			DEFINE [idmax] 100
			DEFINE [mostype] nmos
			DEFINE [parameters]  (vto=2.9 kp=289.2 lambda=0.03 rd=5.75m  is=21.3p )
		ENDIF
		
		IF [mos_model] EQUAL_TO BSC100N10NSFG THEN
			DEFINE [udsmax] 100
			DEFINE [idmax] 90
			DEFINE [mostype] nmos
			DEFINE [parameters]  (vto=4.25 kp=56.1 lambda=0.03 rd=4.47m  is=21.3p )
		ENDIF
		
		IF [mos_model] EQUAL_TO BSC105N10LSFG THEN
			DEFINE [udsmax] 100
			DEFINE [idmax] 90
			DEFINE [mostype] nmos
			DEFINE [parameters]  (vto=2.8 kp=129.3 lambda=0.03 rd=5.54m  is=21.3p )
		ENDIF
		
		IF [mos_model] EQUAL_TO BSC118N10NSG THEN
			DEFINE [udsmax] 100
			DEFINE [idmax] 71
			DEFINE [mostype] nmos
			DEFINE [parameters]  (vto=4.15 kp=59.1 lambda=0.03 rd=7.09m  is=13.7p )
		ENDIF
		
		IF [mos_model] EQUAL_TO BSC159N10LSFG THEN
			DEFINE [udsmax] 100
			DEFINE [idmax] 63
			DEFINE [mostype] nmos
			DEFINE [parameters]  (vto=2.8 kp=83.1 lambda=0.03 rd=8.61m  is=13.7p )
		ENDIF
		
		IF [mos_model] EQUAL_TO BSC196N10NSG THEN
			DEFINE [idmax] 45
			DEFINE [udsmax] 100
			DEFINE [mostype] nmos
			DEFINE [parameters]  (vto=4.15 kp=35 lambda=0.03 rd=11.96m  is=8.1p )
		ENDIF
		
		IF [mos_model] EQUAL_TO BSC252N10NSFG THEN
			DEFINE [udsmax] 100
			DEFINE [idmax] 40
			DEFINE [mostype] nmos
			DEFINE [parameters]  (vto=4.25 kp=21.3 lambda=0.03 rd=11.72m  is=8.1p )
		ENDIF
		
		IF [mos_model] EQUAL_TO BSC265N10LSFG THEN
			DEFINE [udsmax] 100
			DEFINE [idmax] 40
			DEFINE [mostype] nmos
			DEFINE [parameters]  (vto=2.8 kp=49.2 lambda=0.03 rd=14.53m  is=8.1p )
		ENDIF
		
		IF [mos_model] EQUAL_TO BSF030NE2LQ THEN
			DEFINE [udsmax] 25
			DEFINE [idmax] 75
			DEFINE [mostype] nmos
			DEFINE [parameters]  (vto=2.33 kp=358.1 lambda=0.09 rd=1.72m  is=18.6p )
		ENDIF
		//</nmos_transistors_list>
	
		// post processing of parameter list: 
		IF ![parameters] THEN 
			<Dialog type="warning" title="missing parameter list for [mostype] transistor model [mos_model]">
				The transistor named [name] is not correctly defined in the library, it misses the parameters.
				It will behave like a default transistor in a simulation , not like its model [mos_model]
				Please correct that in the component library.
				
				Or maybe you just misspelled the model name?
			</Dialog>

			ELSE
				DEFINE [parameters] AS_REPLACEMENT FROM:(TO:OF:[parameters]
				DEFINE [parameters] AS_REPLACEMENT FROM:)TO:OF:[parameters]
		ENDIF
		
		INCLUDE mos_drawing
    </eeschema_symbol>
	<animation>
		
		// measure actual current at the Drain:
		DEFINE [currd] I[D]
		DEFINE [currd] AS_MATH_ABS OF:[currd]

		// measure actual voltages Uce and Ube:
		DEFINE [uds] AS_MATH_SUB OF:V[D] AND:V[S]
		DEFINE [uds] AS_MATH_ABS OF:[uds]
		DEFINE [ugs] AS_MATH_SUB OF:V[G] AND:V[S]
		DEFINE [ugs] AS_MATH_ABS OF:[ugs]
		
		// calculate the resistance :
		DEFINE [rds] AS_MATH_DIV OF:[uds] AND:[currd]

		// calculate the color (red for off, green for on, yellow for linear)
		IF [rds] HIGHER_THAN 10000 THEN // "off" transistor 
			DEFINE [color] #FF0000 // red
		ELSEIF [ugs] HIGHER_THAN [uds] THEN  // "on" transistor 
				DEFINE [color] #00FF00 //green					
			ELSE // transistor in linear mode 
				DEFINE [color] #CCCC00 // yellow
			ENDIF
		ENDIF	

		// ---- animation style r = ohmic value ----
		IF [anistyle] STARTS_WITH r THEN
			<Text 400 0 60 [color] 0 "Rds=[rds] Ohm">
		ENDIF
		// ---- animation style t = traffic light ----
		IF [anistyle] STARTS_WITH t THEN
			<Ellipse -50 -110 220 220 [color] 2 1 [color] 1 0.5> // traffic light circle in the symbol
		ENDIF
		// ---- animation style s = symbols ----
		IF[anistyle] STARTS_WITH s THEN
			
			IF [color] EQUAL_TO #FF0000 THEN // red "off" transistor - draw an open switch blocking current between c and e:
				<Line 200 100 0 -50 [color] 2 1 [color] 1 0> //vertical line 1 
				<Line 200 -100 0 50 [color] 2 1 [color] 1 0> //vertical line 2
				<Line 200 -50  20 0 [color] 2 1 [color] 1 0> //horizontal line
				<Line 200 50 50 -100 [color] 2 1 [color] 1 0> //diagonal line indicating switch is open=off
			
			ELSE IF [color] EQUAL_TO #00FF00 THEN // green "on" transistor - draw a closed switch conducting current between c and e:
				<Line 200 100 0 -50 [color] 2 1 [color] 1 0> //vertical line 1 
				<Line 200 -100 0 50 [color] 2 1 [color] 1 0> //vertical line 2
				<Line 200 -50  20 0 [color] 2 1 [color] 1 0> //horizontal line
				<Line 200 50 20 -100 [color] 2 1 [color] 1 0> //diagonal line indicating switch is closed=on
				
				ELSE // neither "on" nor "off". That is linear mode - draw a yellow resistor resisting the current between c and e:
					DEFINE [color] #CCCC00 // yellow
					<Line 200 100 0 -50 [color] 2 1 [color] 1 0> //vertical line 1 
					<Line 200 -100 0 50 [color] 2 1 [color] 1 0> //vertical line 2
					<Rectangle 180 -50 40 100 [color] 2 1 [color] 1 0> // resistor indicating linear mode		
				ENDIF
			ENDIF
			<Line 150  100 50 0 [color] 2 1 [color] 1 0> // connection line 1
			<Line 150 -100 50 0 [color] 2 1 [color] 1 0> // connection line 1
		ENDIF
	</animation>
    <Spice>
		INCLUDE mos_spice
    </Spice>
	 <purchase>
           <link>
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fmosfets-5104021.html</url>
            <title>IF [language] EQUAL_TO de THEN Uebersicht MOSFETs ELSE Overview MOSFETsENDIF</title>
            <detail>IF [language] EQUAL_TO de THEN Eine Auswahl an MOSFETs aller Formate bei Conrad Electronic. Darunter eine Beschreibung. ELSE A collection of MOSFETs of all formats at conrad electronic.ENDIF</detail>
        </link>
        IF [conrad_de] THEN
            <link>
                <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fp%2F[conrad_de]</url>
                <title>[model] at Conrad i</title>
                <detail>a MOSFET for type [model] at conrad electronic</detail>
            </link>
        ENDIF
    </purchase>
</Component>

// --- 2.2 pmos transistors ---

<Component>
<Description>
		INCLUDE mos_description
	</Description>
	<eeschema_sch>
		L anicad:PMOS_Transistor
	</eeschema_sch>
	<Default_Values>
		model=BSS84
		model=IRF7404
		model=FDS4559_pmos anistyle=trafficLight 
		model=FDS9934C_pmos
		model=IRF7343PBF_pmos
		model=Si4542DY_pmos
		model=IRF7309IPBF_pmos
	</Default_Values>
	<eeschema_symbol>
		DEFINE [mos_model] AS_WORD_RIGHT IN:[value] OF:model 
		DEFINE [mostype] AS_WORD_RIGHT IN:[value] OF:type 
		
		DEFINE [anistyle] AS_WORD_RIGHT OF:anistyle IN:[value]
		DEFINE [anistyle] AS_LOWERCASE OF:[anistyle]	
		IF ![anistyle] THEN 
			DEFINE [anistyle] symbol //<-default animation style
		ENDIF
		
		//<pmos_transistors_list>
				
		IF [mos_model] EQUAL_TO BSS84 THEN
			DEFINE [udsmax] 50
			DEFINE [idmax] 0.13
			DEFINE [mostype] pmos
			DEFINE [parameters] (vto=-2.1 kp=.2 rd=2.4  is=2p )
			DEFINE [conrad_de] nexperia-bss84geg-mosfet-1-p-kanal-0-36-w-sot-23-150901.html
			DEFINE [datasheet] https://asset.conrad.com/media10/add/160267/c1/-/en/000150901DS00/datenblatt-150901-nexperia-bss84geg-mosfet-1-p-kanal-036-w-sot-23.pdf
		ENDIF
		
		IF [mos_model] EQUAL_TO FDS4559_pmos THEN
			DEFINE [udsmax] 60
			DEFINE [idmax] 4.5
			DEFINE [mostype] pmos
			DEFINE [parameters] (vto=-2.5 kp=9 lambda=.01 rd=42m  is=30p )
			
		ENDIF	

		IF [mos_model] EQUAL_TO FDS9934C_pmos THEN
			DEFINE [udsmax] 20
			DEFINE [idmax] 6.5
			DEFINE [mostype] pmos
			DEFINE [parameters] (vto=-1.4 kp=40 rd=30m  is=18p )
		ENDIF
		
		IF [mos_model] EQUAL_TO IRF7343PBF_pmos THEN
			DEFINE [udsmax] 55
			DEFINE [idmax] 4
			DEFINE [mostype] pmos
			DEFINE [parameters] (vto=-1 kp=1 rd=42m  is=76p )
			
		ENDIF
				
		IF [mos_model] EQUAL_TO IRF7404 THEN
			DEFINE [udsmax] 20
			DEFINE [idmax] 6.7
			DEFINE [mostype] pmos
			DEFINE [parameters] (vto=-1 kp=30 rd=16m  is=80p )
		ENDIF
		
		IF [mos_model] EQUAL_TO Si4542DY_pmos THEN
			DEFINE [udsmax] 30
			DEFINE [idmax] 6
			DEFINE [mostype] pmos
			DEFINE [parameters] (vto=-2.5 kp=16 lambda=.01 rd=12.8m  is=64p )
		ENDIF
						
		IF [mos_model] EQUAL_TO IRF7309IPBF_pmos THEN
			DEFINE [udsmax] 30
			DEFINE [idmax] 3
			DEFINE [mostype] pmos
			DEFINE [parameters] (vto=-2.1 kp=6.5 rd=12.3m  is=45p )
		ENDIF

		//</pmos_transistors_list>
	
		// post processing of parameter list: 
		IF ![parameters] THEN 
			<Dialog type="warning" title="missing parameter list for [mostype] transistor model [mos_model]">
				The transistor named [name] is not correctly defined in the library, it misses the parameters.
				It will behave like a default transistor in a simulation , not like its model [mos_model]
				Please correct that in the component library.
				
				Or maybe you just misspelled the model name?
			</Dialog>

			ELSE
				DEFINE [parameters] AS_REPLACEMENT FROM:(TO:OF:[parameters]
				DEFINE [parameters] AS_REPLACEMENT FROM:)TO:OF:[parameters]
		ENDIF
		
		INCLUDE mos_drawing
    </eeschema_symbol>
		<animation>
		
		// measure actual current at the Drain:
		DEFINE [currd] I[D]
		DEFINE [currd] AS_MATH_ABS OF:[currd]

		// measure actual voltages Uce and Ube:
		DEFINE [uds] AS_MATH_SUB OF:V[D] AND:V[S]
		DEFINE [uds] AS_MATH_ABS OF:[uds]
		DEFINE [ugs] AS_MATH_SUB OF:V[G] AND:V[S]
		DEFINE [ugs] AS_MATH_ABS OF:[ugs]
		
		// calculate the resistance :
		DEFINE [rds] AS_MATH_DIV OF:[uds] AND:[currd]

		// calculate the color (red for off, green for on, yellow for linear)
		IF [rds] HIGHER_THAN 10000 THEN // "off" transistor 
			DEFINE [color] #FF0000 // red
		ELSEIF [ugs] HIGHER_THAN [uds] THEN  // "on" transistor 
				DEFINE [color] #00FF00 //green					
			ELSE // transistor in linear mode 
				DEFINE [color] #CCCC00 // yellow
			ENDIF
		ENDIF	

		// ---- animation style r = ohmic value ----
		IF [anistyle] STARTS_WITH r THEN
			<Text 400 0 60 [color] 0 "Rds=[rds] Ohm">
		ENDIF
		// ---- animation style t = traffic light ----
		IF [anistyle] STARTS_WITH t THEN
			<Ellipse -50 -110 220 220 [color] 2 1 [color] 1 0.5> // traffic light circle in the symbol
		ENDIF
		// ---- animation style s = symbols ----
		IF[anistyle] STARTS_WITH s THEN
			
			IF [color] EQUAL_TO #FF0000 THEN // red "off" transistor - draw an open switch blocking current between c and e:
				<Line 200 100 0 -50 [color] 2 1 [color] 1 0> //vertical line 1 
				<Line 200 -100 0 50 [color] 2 1 [color] 1 0> //vertical line 2
				<Line 200 -50  20 0 [color] 2 1 [color] 1 0> //horizontal line
				<Line 200 50 50 -100 [color] 2 1 [color] 1 0> //diagonal line indicating switch is open=off
			
			ELSE IF [color] EQUAL_TO #00FF00 THEN // green "on" transistor - draw a closed switch conducting current between c and e:
				<Line 200 100 0 -50 [color] 2 1 [color] 1 0> //vertical line 1 
				<Line 200 -100 0 50 [color] 2 1 [color] 1 0> //vertical line 2
				<Line 200 -50  20 0 [color] 2 1 [color] 1 0> //horizontal line
				<Line 200 50 20 -100 [color] 2 1 [color] 1 0> //diagonal line indicating switch is closed=on
				
				ELSE // neither "on" nor "off". That is linear mode - draw a yellow resistor resisting the current between c and e:
					DEFINE [color] #CCCC00 // yellow
					<Line 200 100 0 -50 [color] 2 1 [color] 1 0> //vertical line 1 
					<Line 200 -100 0 50 [color] 2 1 [color] 1 0> //vertical line 2
					<Rectangle 180 -50 40 100 [color] 2 1 [color] 1 0> // resistor indicating linear mode		
				ENDIF
			ENDIF
			<Line 150  100 50 0 [color] 2 1 [color] 1 0> // connection line 1
			<Line 150 -100 50 0 [color] 2 1 [color] 1 0> // connection line 1
		ENDIF
	</animation>

<Component>
    <Description>
        A DC-Motor. There are two ways to simulate that motor:
        A: Either you simply give a numeric value for this component, then it is simulated by a coil with that numeric induction value in Henry.
        B: Or you can define L=... R=... U=... where L is the Henry value, R is the internal resistance in Ohm and U is the dc voltage in Volt that is induced by this motor/generator. In this case you can define one or more of these mentioned parameters. If you define more than one parameter, then the components representing these parameters are placed in series to each other.
        C: Additionally to the previous options, you can specify the nominal current I_N of this motor. That parameter I_N is used in the animation, to determine the rotation speed.
        Example A (simply a value)
        If you set value to "100u" then the motor is simulated by a coil with hundred micro henry.
        
        Example B1 (a combination of R L V):
        If you set value to "R=10 L=20m V=5", then the motor is simulated by a combination of resistor, inductor, and voltage source in series:
        conn+                                                              conn-                          
        (+)------|Resistor=10Ohm|--|Inductor=20mH|--|VoltageSource=5V|-------(-)
        
        Example B2 (a combination of R L, but without V)
        If you set value to "R=11 L=21m ", then the motor is simulated by a combination of resistor and inductor in series, the voltage source is not part of the model:
        conn+                                        conn-                          
        (+)------|Resistor=11Ohm|--|Inductor=21mH|----(-)  
    </Description>
    <Default_Values>
        L=22mH R=10 Ohm  I_N=0.5A
    </Default_Values>
    <eeschema_sch>
        L Motor:Motor_DC
        ALIAS Motor:Motor_DC_ALT
    </eeschema_sch>
		<purchase>
			<link>
				<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fgleichstrommotoren-1101101.html</url>
				<title>IF [language] EQUAL_TO de THEN Uebersicht Gleichstrommotoren ELSE Overview DC motors ENDIF</title>
				<detail>IF [language] EQUAL_TO de THENEine Auswahl an Gleichstrommotoren bei Conrad Electronic. Darunter eine Beschreibung.ELSEA collection of DC motors at Conrad Electronic.ENDIF</detail>
			</link>
	</purchase>
    <eeschema_symbol>
        DRAW
            C 0 -60 117 0 0 10 N
            P 4 0 0 0 -50 -170 -50 -200 50 -200 50 -170 N
            P 4 0 0 0 -50 50 -50 80 50 80 50 50 N
            P 5 0 0 0 -50 -130 -50 20 0 -80 50 20 50 -130 N
            P 2 0 1 0 0 80 0 100 N
            X + 1 0 200 100 D 50 50 1 1 P
            X - 2 0 -300 100 U 50 50 1 1 P
        ENDDRAW
    </eeschema_symbol>
	<animation>
		IF  IS_NUMBER [I_N] THEN
			DEFINE [motor_speed] AS_MATH_DIV OF:I[+] AND:[I_N] // motor speed = actual current / nominal current- Usual ranges from -1 to 1.
			
			DRAW
				IF [motor_speed] HIGHER_THAN 0.5 THEN
					P 8 0 1 0  30 170  80 110  65 100  105 95  105 130  90 120  40 180  30 170 F // first positive arrow
					IF [motor_speed] HIGHER_THAN 0.8 THEN 
						P 8 0 1 0   110 90  110 30  90 30  115 00  140 30  120 30  120 80  110 80 F // second positive arrow
					ENDIF
				ELSE
					IF [motor_speed] LOWER_THAN -0.5 THEN
						P 8 0 1 0 -30 170 -80 110 -65 100 -105 95 -105 130 -90 120 -40 180 -30 170 F
						IF [motor_speed] LOWER_THAN -0.8 THEN
							P 8 0 1 0  -110 90 -110 30 -90 30 -115 00 -140 30 -120 30 -120 80 -110 80 F // second positive arrow
						ENDIF
					ENDIF
				
				ENDIF
				
			ENDDRAW
		ENDIF
	</animation>
    <Spice>
		// animation parameter: nominal current:
		DEFINE [I_N] AS_WORD_RIGHT OF:I_N IN:[value]
		IF ![I_N] THEN DEFINE [I_N] AS_WORD_RIGHT OF:In IN:[value] ENDIF // also allow "In" as nominal current
		IF ![I_N] THEN DEFINE [I_N] 1.0 ENDIF// default value I_N=1.0A 
		DEFINE [I_N] AS_NUMBER OF:[I_N]		
	
		// main parameters: henry value (and serial parasite ohm and farad values) of the motor:
        DEFINE [henry] AS_NUMBER OF:[value]
        IF [henry] THEN
            L_[name] [+] [-] [henry] 
        ELSE
            DEFINE [henry] AS_WORD_RIGHT OF:L IN:[value]
            DEFINE [henry] AS_NUMBER OF:[henry]
            
            DEFINE [ohm] AS_WORD_RIGHT OF:R IN:[value]
            DEFINE [ohm] AS_NUMBER OF:[ohm]
            
            DEFINE [volt] AS_WORD_RIGHT OF:U IN:[value]
            DEFINE [volt] AS_NUMBER OF:[volt]
            
            IF [henry] || [ohm] || [volt] THEN
     
        // ---- model ----
        .subckt motor_[individual] pos neg
            //motor coil                          
            IF[henry] THEN L_[individual] pos IF [ohm] THEN high ELSEIF [volt] THEN low ELSE neg ENDIF ENDIF [henry] ENDIF
            //induction resistance             |<---- positive connection ---->| |<--- negative connection --->|
            IF[ohm]THEN R_[individual] IF[henry]THEN high ELSE pos ENDIF IF[volt]THEN low ELSE neg ENDIF [ohm] ENDIF
            //inducing dc voltage:              |<---- positive connection --------------------------------->|
            IF[volt]THEN V_[individual] IF[ohm] THEN low ELSEIF [henry] THEN high ELSE pos ENDIF ENDIF neg DC [volt] ENDIF
        .ends
         // ---- component ----
        X_motor_[individual] [+] [-] motor_[individual]
            
            ELSE
                <Dialog title="missing Henry value for motor [name]" type="error" dimension="450x150"> 
                The dc motor is simulated as an inductor by default. But the motor named [name] at ([xpos] | [ypos]) has an invalid value, "[value]".
                This component expects an L value in Henry. 
                Please enter a number at that place.
                </Dialog>
            ENDIF
        ENDIF 
        
    </Spice>
</Component>

<Component>
    <Description>
        An AC-Motor. Simulated by a coil. You can specify the induction value in Henry.
    </Description>
		<purchase>
			<link>
				<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fdrehstrommotoren-wechselstrommotoren-1230012.html%3Ftfo_productType%3DWechselstrommotor</url>
				<title>1-Phase AC Motors</title>
				<detail>IF [language] EQUAL_TO de THEN Eine Auswahl an Einphasen-Wechselstrom-Motoren bei Conrad Electronic. Darunter eine Beschreibung. ELSE An overview of one phase AC motors at Conrad Electronic.</detail>
			</link>
			<link>
				<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fdrehstrommotoren-wechselstrommotoren-1230012.html%3Ftfo_productType%3DDrehstrommotor</url>
				<title>3-Phase AC Motors</title>
				<detail>IF [language] EQUAL_TO de THEN Eine Auswahl an Drehstrom-Motoren bei Conrad Electronic. Darunter eine Beschreibung. ELSE An overview of three phase AC motors at Conrad Electronic.</detail>
			</link>
	</purchase>
    <eeschema_sch>
        L Motor:Motor_AC
    </eeschema_sch>
    <Default_Values>
        22mH
    </Default_Values>
    <Spice>
        DEFINE [henry] AS_NUMBER OF:[value]
        IF ![henry] THEN
            <Dialog title="missing Henry value for motor [name]" type="error" dimension="450x150"> 
              The ac motor is modeled by an inductor. But the motor named [name] at ([xpos] | [ypos]) has an invalid value, "[value]".
              This component expects an L value in Henry. 
              Please enter a number at that place.
            </Dialog>
        ENDIF
        L_[name] [pin1] [pin2] [henry] 
    </Spice>
    <eeschema_symbol>
   
      (circle (center 0 -1.524) (radius 3.2512)

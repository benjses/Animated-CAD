</Component>

<Component>
    <Description>
        A servo motor. Simulated by a motor coil and a subcircuit that PWM-driven subcircuit that activates the motor.
        You need to give it a value that specifies the Henry value of the motor coil.
        
        The subcircuit that activates the motor is activated by switching the pwm signal to high for some time, or by driving a PWM signal, and deactivates again by switching to low for some time. The time can be varied by changing the resistance and capacitance of R_enable and C_enable.
        
    </Description>
    <eeschema_sch>
        L Motor:Motor_Servo
        ALIAS Motor:Motor_Servo_AirTronics Motor:Motor_Servo_Futaba_J Motor:Motor_Servo_Grapner_JR Motor:Motor_Servo_Hitec Motor:Motor_Servo_JR Motor:Motor_Servo_Robbe
    </eeschema_sch>
		<purchase>
			<link>
				<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Frc-servos-1207063.html</url>
				<title>IF[language]EQUAL_TOdeTHENUebersicht Modellbau-ServosELSEOverview RC-ServosENDIF</title>
				<detail>IF[language]EQUAL_TOdeTHENEine Uebersicht an Servomotoren und Zubehoer fuer Modellbau Anwendungen mit kleiner LeistungELSEOverview Servo motors and additional components for model building purposesENDIF</detail>
			</link>
			<link>
				<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fschrittmotoren-servomotoren-1101151.html%3Ftfo_productType%3DServomotor</url>
				<title>IF[language]EQUAL_TOdeTHENUebersicht Industrie-ServosELSEOverview industrial servosENDIF</title>
				<detail>IF[language]EQUAL_TOdeTHENEine Uebersicht an Servomotoren fuer industrielle Anwendungen mit grosser LeistungELSEOverview Servo motors for industrial applicationsENDIF</detail>
			</link>
	</purchase>
    <Default_Values>
        22mH
    </Default_Values>
    <Spice>
        // ---- parameters ----
         DEFINE [henry] AS_NUMBER OF:[value]
            IF ![henry] THEN
            <Dialog title="missing Henry value for motor [name]" type="error" dimension="450x150"> 
              The servo motor is modeled by an inductor (and a circuit to drive the motor). But the motor named [name] at ([xpos] | [ypos]) has an invalid value, "[value]".
              This component expects an L value in Henry. 
              Please enter a number at that place.
            </Dialog>
            ENDIF
        // ---- model ----
        .subckt servo_motor_[individual] pwm pos neg
            //motor coil
            L_[individual] pos mid [henry]
            // enabling of the motor
            M_enable mid enable neg neg MDL_MOS_[individual] //transistor that enables the motor
            R_enable enable pwm 1M //series resistance
          C_enable enable neg 1m  //capacitor keeps enabling open for some time after pwm signal.
            //sub-models
            .model MDL_MOS_[individual] NMOS (vto=0.2 kp=.17 rd=0  is=.04p  )
        .ends
         // ---- component ----
        X_servo_motor_[individual] [PWM] [+] [-] servo_motor_[individual]
    </Spice>
    <eeschema_symbol>
		DRAW
		A 125 0 76 1132 -1132 0 1 0 N 95 70 95 -70
		A 267 142 37 1173 -273 0 1 0 N 250 175 300 125
		C 125 0 7 0 1 0 N
		C 125 0 56 0 1 0 N
		C 235 110 5 0 1 0 N
		C 255 130 5 0 1 0 N
		C 275 150 5 0 1 0 N
		P 2 0 1 0 95 -70 80 -70 N
		P 2 0 1 0 95 -70 90 -55 N
		P 2 0 1 0 95 70 75 70 N
		P 2 0 1 0 95 70 90 55 N
		P 2 0 1 0 250 175 100 50 N
		P 2 0 1 0 300 125 165 -40 N
		P 5 0 1 10 200 140 -200 140 -200 -140 250 -140 250 60 N
		X PWM 1 -300 100 100 R 50 50 1 1 P
		X + 2 -300 0 100 R 50 50 1 1 P
		X - 3 -300 -100 100 R 50 50 1 1 P
		ENDDRAW
    </eeschema_symbol>
</Component>

			DRAW
			C 0 0 100 0 1 0 N
			C 40 -50 10 0 1 0 F
			S -60 -20 60 -30 0 1 0 F
			S -60 30 60 20 0 1 0 F
			P 2 0 1 0 0 -100 0 -30 N
			P 2 0 1 0 0 30 0 100 N
			X ~ 1 0 -200 100 U 50 50 1 1 P
			X ~ 2 0 200 100 D 50 50 1 1 P
			ENDDRAW
		ELSE
			DRAW
			C 0 0 100 0 1 0 N
			P 2 0 1 0 -70 70 70 -70 N
			P 2 0 1 0 70 70 -70 -70 N

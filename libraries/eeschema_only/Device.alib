<Component>
    <Description>
    A coupled pair of inductors. Coupled paralell:   .||.
    The parameters are:
    1: each of the two inductors will have an inductivity of 1H; unless [value] is given as number, in this case each inductor will have that value in Henry.
    2: The coupling is c=0.95 by default. You can set the coupling value to a number in the range 0<c<=1
	Example for a given value list, where primary coil L12 has 22 MilliHenry, secondary coil L34 has 10 MilliHenry and coupling coefficient is 0,8 :
		c=0.8 henry12=22m henry34=10m
    </Description>
    <eeschema_sch>
        L Device:L_Coupled
        ALIAS Device:L_Coupled_Small Device:L_Core_Ferrite_Coupled Device:L_Core_Ferrite_Coupled_Small Device:L_Core_Iron_Coupled Device:L_Core_Iron_Coupled_Small
	//	ALIAS Device:L_Coupled_1243 Device:L_Coupled_1324 Device:L_Coupled_1342 Device:L_Coupled_1423
	//	ALIAS Device:L_Coupled_Small_1243 Device:L_Coupled_Small_1324 Device:L_Coupled_Small_1342 Device:L_Coupled_Small_1423
	</eeschema_sch>
    <Default_Values>
        c=0.95 henry12=22mH henry34=10mH //c is the coupling, henry12 is the L value for the  primary coil, henry34 is the L value for the secondary coil.
    </Default_Values>
    <Spice>
        //pre-compiler
		DEFINE [henry12] AS_NUMBER OF:[value]
		IF [henry12] THEN
			DEFINE [henry34] [henry12]
			DEFINE [coeff] 0.95 
		ELSE
            DEFINE [coeff] AS_WORD_RIGHT OF:c IN:[value]
            DEFINE [coeff] AS_NUMBER OF:[coeff]
            
            DEFINE [henry12] AS_WORD_RIGHT OF:henry12 IN:[value]
            DEFINE [henry12] AS_NUMBER OF:[henry12]
             
            DEFINE [henry34] AS_WORD_RIGHT OF:henry34 IN:[value]
            DEFINE [henry34] AS_NUMBER OF:[henry34]
          ENDIF
		  
		IF [coeff] && [henry12] && [henry34] THENELSE
			<Dialog title="missing or invalid parameter in coupled inductors" type="warning" dimension="650x350">
				The coupled inductors component, named [name] at position ([xpos] | [ypos]) misses one numeric parameter.
				there should be the following ones:
				1. the inductivity of the first coil, between pins 1 and 2, called "henry12"
				2. the inductivity of the second coil,between pins 3 and 4, called "henry34"
				3. the coupling coefficient, between the two coils, called "coeff"
				But here the values are: 
				1. IF [henry12] THEN [henry12] (okay) ELSE (not given as a number) ENDIF
				2. IF [henry34] THEN [henry34] (okay) ELSE (not given as a number) ENDIF
				3. IF [coeff] THEN [coeff] (okay) ELSE (not given as a number) ENDIF
				
				Please correct the value of that component. For example, you can set the value to the following line:
				c=0.95 henry12=22m henry34=0.01
			</Dialog>
			IF !  [coeff] THEN 
				DEFINE [coeff] 0.95
			ENDIF
			IF ! [henry12] THEN 
				DEFINE [henry12] 22m
			ENDIF
			IF ! [henry34] THEN
				DEFINE [henry34] 10m
			ENDIF
		ENDIF
		IF [coeff] HIGHER_THAN 1.0 || [coeff] EQUAL_OR_LOWER_THAN 0.0 THEN
		<Dialog title "wrong value for coupling coefficient of coupled inductors" type="warning">
				The coupled inductors component, named [name] at position ([xpos] | [ypos]) 
				has the given coupling parameter [coeff]
				But the coupling should be between 0 and 1, so coeff should hold: 0<coeff<=1
				It is set to the value 0.95 instead
		</Dialog>
			DEFINE [coeff] 0.95
		ENDIF
        //model
		// pins 1 and 2 are primary side, pins 3 and 4 are secondary side.
        .subckt Coupled_[individual] 1 2 3 4
            L12 1 2 [henry12]
            L34 3 4 [henry34]
            Kpl L12 L34 [coeff]
        .ends
		// Component:  
        X_coupled_[individual] [1] [2] [3] [4] Coupled_[individual]
        //component
    </Spice>
    <purchase>
        <link>
		<title>Overview transformator coils</title>
		<detail>An overview of various transformator types at Conrad electronic</detail>
		<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fc%2Ftransformatoren-17430.html</url>
		</link>
    </purchase>
    <eeschema_symbol>
	IF [model] CONTAINS Small THEN
		DRAW
		A -60 -50 20 1 1799 0 1 0 N -40 -50 -80 -50
		A -60 50 20 -1799 -1 0 1 0 N -80 50 -40 50

        P 2 0 1 0 100 -50 150 -100 N
        P 2 0 1 0 100 50 150 100 N
        P 4 0 1 0 -150 100 -100 50 -75 125 -150 100 N
        P 4 0 1 0 -100 -50 -150 -100 -75 -125 -100 -50 N
        P 4 0 1 0 50 100 100 150 125 75 50 100 N
        P 4 0 1 0 125 -75 50 -100 100 -150 125 -75 N

<Component>
    <Description>
        A Zener-Diode. 
        [value] is the reverse breakdown voltage (the voltage, at which the diode starts to conduct in reverse direction)
    </Description>
    <eeschema_sch>
        L Device:D_Zener
        ALIAS Device:D_Zener_ALT Device:D_Zener_Small Device:D_Zener_Small_ALT
    </eeschema_sch>
    <Default_Values>
        3.3 V // zener voltage
    </Default_Values>
    <Spice>
    DEFINE [volts_breakdown] AS_NUMBER OF:[value]
    IF [volts_breakdown] THEN
        DEFINE [value] AS_NULL
    ELSE

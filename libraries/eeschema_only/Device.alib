        <url>www.reichelt.de/operationsverstaerker-1-fach-1-mhz-10--36v-dip-8-lm-741-cn-p187573.html</url>
        <title>"lm741"</title>
        <detail>"opAmp model LM741CN at Reichelt electronic"</detail>
    </purchase>
    <eeschema_sch>
	    DEFINE [datasheet] www.cdn-reichelt.de/documents/datenblatt/A200/LM741-TI.pdf
        L Device:Opamp_Dual_Generic
    </eeschema_sch>
    <eeschema_symbol>
        IF [eeschema_u_n] EQUAL_TO 3 THEN // Block Unit C=3 is VCC/GND connection block
			<SET_CONNECTION vcc_dual_generic_opamp -100 -300> 
			<SET_CONNECTION gnd_dual_generic_opamp -100 300>
			
			<Line -100 -300 0 100 #000080 2 1>
			<Line -100 300 0 -100 #000080 2 1>
			<Rectangle -200 -200 400 400 #000080 2 1 #000080 1 0>
			<Text -180 0   60 #808080 0 "dual_generic_opamp">
			<Text -180 -160 60 #FF0000 0 "VCC">
			<Text -180 160 60 #0000FF 0 "GND">
			
		ELSE //Block Units A=1 and B=2 are "normal" OpAmp-Blocks with 3 pins, that is without VCC/GND, so these are imported from VCC/GND connection block:
		
            // positive power supply:
            <.PortSym GET_CONNECTION vcc_dual_generic_opamp>
		    // negative power supply:
            <.PortSym GET_CONNECTION gnd_dual_generic_opamp>
            
            // non-inverting input:
            <.PortSym -300 -100 [pos] 0> 
            <Line -300 -100 100 0 #000080 2 1>
            <Line -180 -100 60 0 #800000 2 1>
            <Line -150 -130 0 60 #800000 2 1>
            // inverting input:
            <.PortSym -300 100 [neg] 0> 
            <Line -300 100 100 0 #000080 2 1>
            <Line -180 100 60 0 #0000FF 2 1>
            //output:
            <.PortSym 300 0 [out] 180>
            <Line 300 0 -100 0 #000080 2 1> 
            //other drawing:
            <Line -200 -200 0 400 #000080 2 1>
            <Line -200 200 400 -200 #000080 2 1>
            <Line 200 0 -400 -200 #000080 2 1>
        ENDIF

    <Spice>
    //Pre-compiler
        DEFINE [ohm] AS_NUMBER OF:[value]
        IF ![ohm] THEN 
        <Dialog type="error" title="Please enter a correct value">
            Missing value for the resistors network component [name] at position ([xpos] | [ypos]). 
            [value] is not a valid number, please correct that.
        </Dialog>ENDIF
        //model
        .subckt rnetwork_[individual] cmn 1 2 3 IF[R4]THEN4ENDIF IF[R5]THEN5ENDIF IF[R6]THEN6ENDIF IF[R7]THEN7ENDIF IF[R8]THEN8ENDIF IF[R9]THEN9ENDIF IF[R10]THEN10ENDIF IF[R11]THEN11ENDIF IF[R12]THEN12ENDIF IF[R13]THEN13ENDIF
        
        R1 1 cmn [ohm]
        R2 2 cmn [ohm]
        R3 3 cmn [ohm]
        IF[R4]THEN 4 cmn [ohm] ENDIF
        IF[R5]THEN 5 cmn [ohm] ENDIF
        IF[R6]THEN 6 cmn [ohm] ENDIF
        IF[R7]THEN 7 cmn [ohm] ENDIF
        IF[R8]THEN 8 cmn [ohm] ENDIF
        IF[R9]THEN 9 cmn [ohm] ENDIF
        IF[R10]THEN 10 cmn [ohm] ENDIF
        IF[R11]THEN 11 cmn [ohm] ENDIF
        IF[R12]THEN 12 cmn [ohm] ENDIF
        IF[R13]THEN 13 cmn [ohm] ENDIF
        .ends
        //component
        X_rnetwork_[individual] [common] [R1] [R2] [R3] IF[R4]THEN[R4]ENDIF IF[R5]THEN[R5]ENDIF IF[R6]THEN[R6]ENDIF IF[R7]THEN[R7]ENDIF IF[R8]THEN[R8]ENDIF IF[R9]THEN[R9]ENDIF IF[R10]THEN[R10]ENDIF IF[R11]THEN[R11]ENDIF IF[R12]THEN[R12]ENDIF IF[R13]THEN[R13]ENDIF rnetwork_[individual]
    </Spice>

<Component>
    <Description>
        A Battery, or multiple batteries, or a solar cell or multiple solar cells.
        Simulated as dc voltage source with the voltage given in [value] 
    </Description>
    <eeschema_sch>
        L Device:Battery
        ALIAS Device:Battery_Cell
        DEFINE [type] batt
    </eeschema_sch>
    <eeschema_sch>
        L Device:Solar_Cell
        ALIAS Device:Solar_Cells
        DEFINE [type] solar
    </eeschema_sch>
    <Default_Values>
      5.0 V //DC voltage
    </Default_Values>
    <Spice>
        DEFINE [voltage] AS_NUMBER OF:[value]
        IF [voltage] THEN
            DEFINE [value] AS_NULL
            V_[name] [+] [-] dc [voltage]
        ELSE 
            <Dialog type="error" title="Please enter a numeric value for the [model]">
                IF [language] EQUAL_TO "de" THEN 
                    Das [model] Bauteil namens [name] auf Position ([xpos]|[ypos]) hat keinen korrekten Wert:
                    Der vorgegebene Wert, "[value]" ist kein numerischer Wert.
                    Bitte geben Sie dem Bauteil einen numerischen Wert fuer die Spannung in Volt an.
                    Wenn Sie statt dessen eine Wechselspannung haben moechten, verwenden Sie bitte eine Quelle wie z.B. VSIN
                ELSE
                    The [model] component, which has the name [name] at position ([xpos]|[ypos]) does not have a correct value:
                    The given value, "[value]" is not a numeric one.
                    Please give the component a numeric value for the Voltage in V.
                    If you want to have an AC voltage instead, then please use a source such as VSIN.
                ENDIF
            </Dialog>
        ENDIF
    </Spice>
        <purchase>
        <link>
            IF [type] EQUAL_TO solar THEN
            
            ELSE //then type is equal to batt
                    <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fc%2Fakkus-batterien-280070.html</url>
                    <title>Overview</title>
                    <detail>Overview of batteries at Conrad Electronic</detail>
                 </link><link>
                IF[voltage] LOWER_THAN 2 THEN
                    <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fp%2Ftru-components-bh-311-1a-batteriehalter-1x-mignon-aa-kabel-1672589.html</url>

<Component>
    <Description>
        Resistor network of voltage dividers.
        Each resistor has the Ohmic value given as [value].
    </Description>
    <eeschema_sch>
       L Device:R_Network_Dividers_x11_SIP
    </eeschema_sch>
    <eeschema_sch>
       L Device:R_Network_Dividers_x10_SIP
    </eeschema_sch>
    <eeschema_sch>
       L Device:R_Network_Dividers_x09_SIP
    </eeschema_sch>
    <eeschema_sch>
       L Device:R_Network_Dividers_x08_SIP
    </eeschema_sch>
    <eeschema_sch>
       L Device:R_Network_Dividers_x07_SIP
    </eeschema_sch>
    <eeschema_sch>
       L Device:R_Network_Dividers_x06_SIP
    </eeschema_sch>
    <eeschema_sch>
       L Device:R_Network_Dividers_x05_SIP
    </eeschema_sch>
    <eeschema_sch>
       L Device:R_Network_Dividers_x04_SIP
    </eeschema_sch>
    <eeschema_sch>
       L Device:R_Network_Dividers_x03_SIP
    </eeschema_sch>
    <eeschema_sch>
       L Device:R_Network_Dividers_x02_SIP
    </eeschema_sch>
    <Default_Values>
        220 Ohm
    </Default_Values>
    <Spice>
        DEFINE [ohm] AS_NUMBER OF:[value]
        IF ![ohm] THEN 
        <Dialog type="error" title="Please enter a correct value">
            Missing value for the resistors network component [name] at position ([xpos] | [ypos]). 
            [value] is not a valid number, please correct that.
        </Dialog>ENDIF
    
        //model - in KicadEeschema library the Pins are called Rn, where n={1,2,3, ... ,10,11} thes do NOT mean resistors, but pins. The resistors here are called Rna and Rnb.
        .subckt rdivider_[individual] com1 com2 r1 r2 IF[R3]THENr3ENDIF IF[R4]THENr4ENDIF IF[R5]THENr5ENDIF IF[R6]THENr6ENDIF IF[R7]THENr7ENDIF IF[R8]THENr8ENDIF IF[R9]THENr9ENDIF IF[R10]THENr10ENDIF IF[R11]THENr11ENDIF
        
        R1a com1 r1 [ohm]
        R1b com2 r1 [ohm]        
        R2a com1 r2 [ohm]
        R2b com2 r2 [ohm]
        IF[R3]THEN
            R3a com1 r3 [ohm]
            R3b com2 r3 [ohm]
        ENDIF
        IF[R4]THEN
            R4a com1 r4 [ohm]
            R4b com2 r4 [ohm]
        ENDIF
        IF[R5]THEN
            R5a com1 r5 [ohm]
            R5b com2 r5 [ohm]
        ENDIF
        IF[R6]THEN
            R6a com1 r6 [ohm]
            R6b com2 r6 [ohm]
        ENDIF
        IF[R7]THEN
            R7a com1 r7 [ohm]
            R7b com2 r7 [ohm]
        ENDIF
        IF[R8]THEN
            R8a com1 r8 [ohm]
            R8b com2 r8 [ohm]
        ENDIF
        IF[R9]THEN
            R9a com1 r9 [ohm]
            R9b com2 r9 [ohm]
        ENDIF
        IF[R10]THEN
            R10a com1 r10 [ohm]
            R10b com2 r10 [ohm]
        ENDIF
        IF[R11]THEN
            R11a com1 r11 [ohm]
            R11b com2 r11 [ohm]
        ENDIF
        .ends
        //component
        X_[individual] [COM1] [COM2] [R1] [R2] IF[R3]THEN[R3]ENDIF IF[R4]THEN[R4]ENDIF IF[R5]THEN[R5]ENDIF IF[R6]THEN[R6]ENDIF IF[R7]THEN[R7]ENDIF IF[R8]THEN[R8]ENDIF IF[R9]THEN[R9]ENDIF IF[R10]THEN[R10]ENDIF IF[R11]THEN[R11]ENDIF rdivider_[individual]
    </Spice>

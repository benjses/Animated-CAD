<Component>
    <Description>
        A  Neon Lamp. In reality there are many types of lamps, with many different electrical properties.
        Here a lamp is simulated by a resistance, which might match more or less to some lamp types, but will not match well to other lamp types.
    </Description>
    <eeschema_sch>
        L Device:Lamp_Neon
    </eeschema_sch>
    <Default_Values>
        R=100 Ohm L=2.2mH // ohm  and henry value of a lamp
    </Default_Values>
    <Spice>
       DEFINE [ohms] AS_WORD_RIGHT OF:R IN:[value]
       DEFINE [ohms] AS_NUMBER OF:[ohms]
       DEFINE [henry] AS_WORD_RIGHT OF:L IN:[value]
       DEFINE [henry] AS_NUMBER OF:[henry]
       
       IF [ohms] && [henry] THEN
        .subckt DEVICE_LAMP 1 2
           R_Neon 1 2 [ohms]
           L_Neon 1 2 [henry]
        .ends
        X_Lamp_[name] [pin1] [pin2] DEVICE_LAMP
       ELSE
        <Dialog type="error" title="Missing numeric R and L value for lamp [name]">
            Missing value for the ohmic resistance R and the inductivity L of the lamp named [name] at position ([xpos] | [ypos]).
            The value given, [value], does not specify this correctly.
            Please enter a correct value for these two parameters. A good example would be the line:
            R=100 L=2.2m
         </Dialog>
       ENDIF
    </Spice>
    <animation>
        DEFINE [curr] I[+]
        DEFINE [curr] AS_MATH_ABS OF:[curr]
        IF [curr] HIGHER_THAN 50m THEN
            DEFINE [start] AS_MATH_MUL OF:[curr] AND:50
            DEFINE [start] AS_MATH_MAX OF:[start] AND:100
            DEFINE [start] AS_MATH_MIN OF:[start] AND:500
            DEFINE [start] AS_MATH_ROUND OF:[start]
            DEFINE [shine] AS_MATH_MUL OF:[start] AND:2
            <Ellipse -[start] -[start] [shine] [shine] #CCCC00 2 1 #CCCC00 1 0.5>
        ELSE
            <Ellipse -100 -100 200 200 #222222 2 1 #222222 1 0.5>
        ENDIF
    </animation>
    <purchase>
     <link>
        <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fc%2Fleuchtmittel-22519.html</url>
        <title>overview of light bulbs</title>
        <detail>overview of light bulbs at conrad electronic</detail>
     </link>
     <link>
           <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fleuchtstoffroehren-1905175.html</url>
            <title>"overview"</title>
            <detail>"overview of neon glow lamps at conrad electronic"</detail>
     </link>        
    </purchase>
    

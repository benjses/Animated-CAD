<Component>
    <Description>
        Diac: A pair of Diodes, which are positioned anti-paralell to each other.
        If a numeric value is given, then that value is the knee_current in Ampere. Otherwise default value is used.
    </Description>
    <eeschema_sch>
        L Device:DIAC
        ALIAS Device:DIAC_ALT Device:DIAC_Filled
    </eeschema_sch>
    <Spice>
    DEFINE [knee_current] AS_NUMBER OF:[value]
    .model D_[name]_MDL_DIAC D IF[knee_current] THEN IKF=[knee_current]ENDIF
    .subckt DIAC_[name] 1 2
        D1 1 2 D_[name]_MDL_DIAC
        D2 2 1 D_[name]_MDL_DIAC
    .ends
    //component
	X_DIAC_[name] [A] [K] DIAC_[name] //Connections of Device:DIAC and Device:DIAC_ALT are called A and K in Eeschema's library, which means Anode and Kathode. Even though this does not make sense for Diacs, these Pin-names are also used here for compatibility to that library.
	</Spice>
        <purchase>
            <link>
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fdiacs-0204086.html</url>
        <title>DIAC overview</title>
        <detail>DIACs at conrad electronic</detail>
        </link>
    </purchase>
    <eeschema_symbol>
    (symbol "DIAC_0_1"
      (polyline
        (pts
          (xy -1.27 -2.54)
          (xy -1.27 2.54)
          (xy 1.27 1.27)
          (xy -1.27 0)
        )
        (stroke (width 0.254) (type default))
        (fill (type outline))
      )
      (polyline
        (pts
          (xy 1.27 2.54)
          (xy 1.27 -2.54)
          (xy -1.27 -1.27)
          (xy 1.27 0)
        )
        (stroke (width 0.254) (type default))
        (fill (type outline))
      )
    )
	(symbol "DIAC_1_1"
      (pin passive line (at -3.81 0 0) (length 2.54)
        (name "K" (effects (font (size 1.27 1.27))))
        (number "1" (effects (font (size 1.27 1.27))))
      )
      (pin passive line (at 3.81 0 180) (length 2.54)
        (name "A" (effects (font (size 1.27 1.27))))
        (number "2" (effects (font (size 1.27 1.27))))
      )
    )
    </eeschema_symbol>
</Component>

<Component>
    <Description>
        D_Bridge: A bridge of four diodes, which may rectify an ac voltage/current into a dc voltage/current.
        If a numeric value is given, then that value is the knee_current in Ampere. Otherwise default value is used.

    <Spice>
     .subckt device_antenna_shield_[individual] pin shield
     //independen parameters: relatively easy to change them correctly
     .param base_time=[timestep] // for the frequencies of the noise
     .param isolation_ohms=1E9 //once between ground and antenna, once between antenna and shield
     .param capacitance_shield=1u
     .param amplitude=IF[value] IS_NUMBER THEN[value]ELSE1ENDIF //maximal voltage amplitude, in positive and negative direction
     
     //dependent parameters: change these only if you know what you do:
     .param frq1=1/base_time
     .param frq2=sqrt(3)/base_time
     .param frq3=sqrt(5)/base_time
     .param frq4=sqrt(7)/base_time
     .param vi=amplitude/4
     //model of antenna:
     R_isolation 0 1 isolation_ohms
     V1 1 2   sin(0 vi frq1)
     V2 2 3   sin(0 vi frq2)
     V3 3 4   sin(0 vi frq3)
     V4 4 pin sin(0 vi frq4)
     //model of shield:
     R_shield pin shield 1E6
     C_shield pin shield 1u
     .ends
    X_[individual] IF[A] && [Shield]THEN [A] [Shield] ELSEIF [PCB_Trace] && [FEED]THEN [PCB_Trace] [FEED] ELSE<Dialog type="error">wrong pinnames for antenna model [model]. Can not simulate that</Dialog>ENDIFENDIF device_antenna_shield_[individual]
    </Spice>
</Component>

<Component>
    <Description>
        An antenna with two connections. If a numeric value is given, then the maximal amplitude of the antenna's signal is that value in volts. If no value is given, then the maximal amplitude is 1 Volt.
        The Voltage of this two-pins-antenna is created from one pin to the other pin. No internal connection to ground.
        
        This model consists of four voltage sources, which generate a noise between the pins. Might match well to some antennas in some surrounding circuits, but there will definitely be some other cases where this model does not fit well. A model of white noise would fit better to a real antenna, however we were not able to create a working white noise model in the spice section. The user can get something roughly similar to white noise by setting the parameter "base_time" to a value similar to the timestep of the simulation (which is already set by default).
    </Description>
    <eeschema_sch>
        L Device:Antenna_Dipole
    </eeschema_sch>
    <eeschema_sch>
        L Device:Antenna_Loop
    </eeschema_sch>
    <Default_Values>
        100mV // amplitude of the antenna signal
    </Default_Values>
    <Spice>
     .subckt device_antenna_2pin_[name] pin1 pin2
     //independen parameters: relatively easy to change them correctly
     
     .param base_time=[timestep] //for the frequencies of the noise
     //maximal voltage amplitude that this antenna can deliver in positive or negative direction.
     .param amplitude=IF[value] IS_NUMBER THEN[value]ELSE1ENDIF
     
     //dependent parameters: change these only if you know what you do:
     .param frq1=1/base_time
     .param frq2=sqrt(3)/base_time
     .param frq3=sqrt(5)/base_time
     .param frq4=sqrt(7)/base_time
     .param vi=amplitude/4
     //model of antenna:
     R_coil pin1 rl 1
     L_coil rl lv 1u
     //model of shield:
     V1 lv 12   sin(0 vi frq1)
     V2 12 23   sin(0 vi frq2)
     V3 23 34   sin(0 vi frq3)
     V4 34 pin2 sin(0 vi frq4)
    .ends
    X_[name] [pin1] [pin2] device_antenna_2pin_[name]
    </Spice>
    <eeschema_symbol>
		IF [model] ENDS_WITH Loop THEN
			DRAW
			P 7 0 1 10 100 -150 100 -100 200 0 50 150 -100 0 0 -100 0 -150 N
			X ~ 1 0 -200 100 U 50 50 1 1 I
			X ~ 2 100 -200 100 U 50 50 1 1 I
			ENDDRAW
		ELSE
			DRAW
			P 8 0 1 10 100 -150 100 -100 200 -100 200 -50 -100 -50 -100 -100 0 -100 0 -150 N
			X ~ 1 0 -200 100 U 50 50 1 1 I
			X ~ 2 100 -200 100 U 50 50 1 1 I
			ENDDRAW
		ENDIF
    </eeschema_symbol>
</Component>

// Device:C and similar condensators are described in components.alib
<Component>
    <Description>
        A Diode.
        [value] can be given as a number or can be a parameter list:
          - If it is given as number, then that value is the forward knee current in Ampere.
          - If given as parameter list (e.g. value is "ikf=1.4 rs=550m") then the parameters given will be used for the diode model. To use this option,it is advised to read the ngspice user manual chapter 7.2 "Diode Model" 
          - If neither is choosed, (e.g. value is "D") then this diode has the default parameters. These default parameters are described in the ngspice user manual mentioned above.
    </Description>
    <eeschema_sch>
        L Device:D
        ALIAS Device:D_ALT Device:D_Small Device:D_Small_ALT
    </eeschema_sch>
    
    //Following schematic declarations are for Schottky-Diodes. TODO Remove them here and make Schottky-specific section.
    <eeschema_sch>
        L Device:D_Schottky
        ALIAS Device:D_Schottky_ALT Device:D_Schottky_Small Device:D_Schottky_Small_ALT
    </eeschema_sch>
    <Default_Values>
        default // no value given means standard diode according to ngspice user manual.
    </Default_Values>
    <Spice>
        DEFINE [knee_current] AS_NUMBER OF:[value]
        IF [knee_current] THEN 
            DEFINE [value] AS_NULL
        ELSEIF [value] CONTAINS = THEN
            DEFINE [param_list] AS_REPLACEMENT_REGEX FROM:\s+TO: OF:[value]
            DEFINE [param_list] AS_REPLACEMENT FROM: =TO:=OF:[param_list]
            DEFINE [param_list] AS_REPLACEMENT FROM:= TO:=OF:[param_list]
            DEFINE [value] AS_NULL
        ENDIF ENDIF
        
        .model D_[individual]_MDL D IF[knee_current]THEN IKF=[knee_current] ELSEIF[param_list]THEN[param_list]ENDIF ENDIF
        D_[individual] [A] [K] D_[individual]_MDL
	</Spice>
	<purchase>
        <link>
        IF[model]CONTAINS Schottky THEN
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fschottky-dioden-6203050.html</url>
            <title>"Schottky diodes"</title>
            <detail>"overview of Schottky diodes at conrad electronic"</detail>
        ELSE // normal diodes
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fdioden-standard-hf-leistung-6203020.html</url>
            <title>"standard diodes"</title>
            <detail>"overview of standard diodes at conrad electronic"</detail>
        ENDIF
        </link>
	</purchase>
    <eeschema_symbol>
		IF [model] CONTAINS Small THEN
			(symbol "D_Schottky_Small_0_1"
			  (polyline
				(pts
				  (xy -0.762 0)
				  (xy 0.762 0)
				)
				(stroke (width 0) (type default))
				(fill (type none))
			  )
			  (polyline
				(pts
				  (xy 0.762 -1.016)
				  (xy -0.762 0)
				  (xy 0.762 1.016)
				  (xy 0.762 -1.016)
				)
				(stroke (width 0.254) (type default))
				(fill (type none))
			  )
			  (polyline
				(pts
				  (xy -1.27 0.762)
				  (xy -1.27 1.016)
				  (xy -0.762 1.016)
				  (xy -0.762 -1.016)
				  (xy -0.254 -1.016)
				  (xy -0.254 -0.762)
				)
				(stroke (width 0.254) (type default))
				(fill (type none))
			  )
			)
			(symbol "D_Schottky_Small_1_1"
			  (pin passive line (at -2.54 0 0) (length 1.778)
				(name "K" (effects (font (size 1.27 1.27))))
				(number "1" (effects (font (size 1.27 1.27))))
			  )
			  (pin passive line (at 2.54 0 180) (length 1.778)
				(name "A" (effects (font (size 1.27 1.27))))
				(number "2" (effects (font (size 1.27 1.27))))
			  )
			)	
		ELSE // Device:Diode 
			DRAW
			P 2 0 1 0 50 0 -50 0 N
			P 4 0 1 8 50 50 50 -50 -50 0 50 50 N
			P 6 0 1 8 -75 25 -75 50 -50 50 -50 -50 -25 -50 -25 -25 N
			X K 1 -150 0 100 R 50 50 1 1 P
			X A 2 150 0 100 L 50 50 1 1 P
			ENDDRAW
		ENDIF
    </eeschema_symbol>
</Component>

<Component>
    <Description>
        Light emitting diode, short "LED".
        You can define the color of said LED, by entering a color into the value. The color has the format #RrGgBb, for example #FF0000 for red, #00FF00 for green, #0000FF for blue, #FFFF00 for yellow.
        If you do not define any color, then the default color is yellow.
        
        For example, you can define a purple LED with default simulation parameters, by simply entering the color value:
        #9230b9
        
        But advanced users can also define the diode simulation parameters, called param. To use this option,it is advised to read the ngspice user manual chapter 7.2 "Diode Model". The parameters must be in brackets "(" and ")". For example, enter the value:
        color=#00FF00 param=(bv=50 is=1e-13 n=1.05)
    </Description>
     <eeschema_sch>
        L Device:LED
        ALIAS Device:LED_Small Device:LED_ALT Device:LED_Small_ALT
    </eeschema_sch>
    <eeschema_sch>
        L Device:Laserdiode_1A3C
    </eeschema_sch>
    <eeschema_sch>
        L Device:Laserdiode_1C2A
    </eeschema_sch>
    <purchase>
        <link>
            IF[model]CONTAINS Laser THEN
                <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Flaserdioden-0212561.html</url>
                <title>"laser diodes"</title>
                <detail>"overview of laser diodes at conrad electronic"</detail>
            ELSE
                <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fleds-bedrahtet-0212029.html</url>
                <title>"LEDs"</title>
                <detail>"overview of LEDs at conrad electronic"</detail>
            ENDIF
        </link>
    </purchase>
    <Spice>
       DEFINE [color] AS_WORD_RIGHT OF:#IN:[value]
       IF [color] THEN
            DEFINE [color] #[color]
       ELSE
            DEFINE [color] #FFFF00 //default color
       ENDIF
       
       DEFINE [param] AS_SUBTEXT FROM:(TO:)OF:[value]
       .model D_[individual]_MDL_LED D IF[param]THEN[param]ENDIF
        D_[individual] [A] [K] D_[individual]_MDL_LED
    </Spice>        
    <animation>
        DEFINE [curr] I[A]
        DEFINE [start] AS_MATH_MUL OF:[curr] AND:1000
        DEFINE [start] AS_MATH_MIN OF:[start] AND:300
        DEFINE [shine] AS_MATH_MUL OF:[start] AND:2
        DEFINE [start] AS_MATH_ROUND OF:[start]
        DEFINE [shine] AS_MATH_ROUND OF:[shine]
        <Ellipse -[start] -[start] [shine] [shine] [color] 2 1 [color] 1 0.5>
    </animation>
    <eeschema_symbol>

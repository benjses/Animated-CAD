    <eeschema_symbol>
        DRAW
            C 65 0 111 0 1 10 N
            C 100 -70 11 0 1 0 F
            C 100 70 11 0 1 0 F
            P 2 0 1 0 30 -70 100 -70 N
            P 2 0 1 10 30 -50 30 -90 N
            P 2 0 1 0 30 0 100 0 N
            P 2 0 1 10 30 20 30 -20 N
            P 2 0 1 0 30 70 100 70 N
            P 2 0 1 10 30 90 30 50 N
            P 2 0 1 0 100 -70 100 -100 N
            P 2 0 1 0 100 -70 100 0 N
            P 2 0 1 0 100 100 100 70 N
            P 3 0 1 10 10 75 10 -75 10 -75 N
            P 4 0 1 0 100 -70 130 -70 130 70 100 70 N
            X D 1 100 200 100 D 50 50 1 1 P 
            X G 2 -200 0 210 R 50 50 1 1 I
            X S 3 100 -200 100 U 50 50 1 1 P
            X B 4 100 -200 100 U 50 50 1 1 P
            IF [parameters] STARTS_WITH pmos THEN //p mos symbol:
                P 4 0 1 0 100 0 50 -25 50 25 100 0 F //arrow indicating pmos
                //diode:
                P 2 0 1 0 110 -20 150 -20 N
                P 4 0 1 0 130 -20 110 20 150 20 130 -20 N
            ELSE //nmos symbol:
                P 4 0 1 0 30 0 80 25 80 -25 30 0 F //arrow indicating nmos
                //diode:
                P 2 0 1 0 110 20 150 20 N
                P 4 0 1 0 130 20 110 -20 150 -20 130 20 N
            ENDIF
            // fuse at source (only for nmos and pmos, but not for vdmos. Because for some unknown reason, you can not put a vdmos component into a subckt and simulate that in ngspice.revision31)
            IF [parameters] STARTS_WITH nmos || [parameters] STARTS_WITH pmos THEN
                IF [idmax] || [udsmax] && [value] STARTS_WITH "fuse" THEN
                    S 80 -120 120 -180 0 1 0 N
                ENDIF
            ENDIF
        ENDDRAW
    </eeschema_symbol>
    <Spice>
       DEFINE [model_spice] AS_REPLACEMENT FROM::TO:_OF:[model] //":"->"_", because otherwise the ":" in model would cause an exception in ngspice
       IF [parameters] STARTS_WITH nmos || [parameters] STARTS_WITH pmos THEN
            IF [idmax] || [udsmax] && [value] STARTS_WITH "fuse" THEN
                // -- subckt --
                .subckt sub_[model_spice] d g s b
                .model mdl_mos [parameters]
                Mos d g prefuse prefuse mdl_mos
                // fuse to simulate descruction of component when voltage or current too high:
                .param rs=IF[Rs]THEN[Rs]ELSE0.1ENDIF
                .model si1 sw ron=1E9 roff=rs vt=0.5 //ron=resistance AFTER the fuse interrupts in Ohm. roff=resistance BEFORE the fuse interrupts in Ohm
                s1 prefuse s moff 0 si1 
                IF [idmax] && [udsmax] THEN
                            //        |<-- overcurrent --->| || |<---- overvoltage ---->| || |<-- hold -->|
                    BVS_fuse moff 0 V=(abs(I(Mos)) > [idmax] || abs(V(d)-V(s)) > [udsmax] || V(moff) > 0.5) ? 1 : 0
                ELSEIF [idmax] THEN
                            //        |<-- overcurrent --->|                      || |<-- hold -->|
                    BVS_fuse moff 0 V=(abs(I(Mos)) > [idmax]                      || V(moff) > 0.5) ? 1 : 0
                ELSE
                            //                          |<---- overvoltage ---->| || |<-- hold -->|
                    BVS_fuse moff 0 V=(                 abs(V(d)-V(s)) > [udsmax] || V(moff) > 0.5) ? 1 : 0
                ENDIF ENDIF
                
                .ends
                // -- component --
                X_[individual] [D] [G] [S] [B] sub_[model_spice]
            ELSE
                .model mdl_[model_spice] [parameters]
                M_[individual] [D] [G] [S] [B] mdl_[model_spice]
            ENDIF
       ELSE
           <Dialog dimension="400x200" type="error" title="wrong or missing mosfet type '[mostype]'">
               The mosfet [name] at ([xpos]|[ypos]) has the mostype [mostype].
               But only the values 'nmos' and 'pmos' are allowed. ('vdmos' should not be used, because that probably would cause the ngspice simulation to freeze and fail.)
               Please define mostype for the mosfet model [model] correctly in the library.
           </Dialog>
       ENDIF

    </Spice>
</Component>

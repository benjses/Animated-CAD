	<Spice>
		// on and off Ohm values:
		DEFINE [r_on] 1.0 //Ohm value when switch connects
		DEFINE [r_off] 1E9 //Ohm value when switch does not connect
		
		//threshold for on/off symbol
        DEFINE [r_threshold] AS_MATH_ADD OF:[r_on] AND:[r_off]
        DEFINE [r_threshold] AS_MATH_DIV OF:[r_threshold] AND:2
		
		// pre-check: is [value] given correctly ?
		IF ![value]MATCHES\(?[0-9]+[0-9\.\(\)\- EeRrTtDd=PpNnUuMmSs]+THEN
			  <Dialog type="warning" title="Incorrect value given for switch" dimension="600x300">
	        IF [language] EQUAL_TO "de" THEN
	            Der Schalter [name] auf Position ([xpos]|[ypos]) benoetigt eine Vorgabe, in welchen Zeitraumen er
	            eingeschaltet ist und in welchen er ausgeschaltet ist. Lesen Sie dazu bitte die Beschreibung des Bauteils.
	            Eine Simulation dieser Schaltung mit dem eingegebenen Wert [value] wird vorraussichtlich fehlschlagen.
	            
	            Ein Beispiel fuer einen besser funktionierenden Wert waere:
				0 0  1.4ms 0  1.6ms 1  2.4ms 1  2.8ms 0
				Was wie folgt gelesen wird: 
				Starte bei Zeitpunkt 0 mit einem nicht-verbindenden (hochohmigen) Schalter.
				Bleibe nicht-verbindend bis 1.4ms. 
				In der Zeitspanne von 1.4ms bis 1.6ms schalte auf verbindend(niederohmig).
				Bleibe verbindend bis 2.4ms.
				In der Zeitspanne von 2.4ms bis 2.8ms schalte zurueck auf nicht-verbindend.
				(Danach bleibe im nicht-verbindenden Status.)
	        ELSE
				The switch [name] on position ([xpos]|[ypos]) needs a value which describes in which times it is switched on
				and in which times it is switched off. Please read the description of that component.
				A simulation of this circuit with the given value [value] probably will fail to run.
				
				An example for a better working value would be:
				0 0  1.4ms 0  1.6ms 1  2.4ms 1  2.8ms 0
				Which can be read as: start at time 0 with a non-connecting switch.
				stay unconnected until 1.4ms. 
				In the time span between 1.4ms to 1.6ms switch to connecting.
				Stay connected until 2.4ms.
				In the time span between 2.4ms and 2.8ms switch back to non-connecting.
				(Stay at non-connecting status)
	        ENDIF
	        </Dialog>
		ENDIF 
		
		// model:
		.subckt switch_DIP_[individual] a1 b1 IF [switches] EQUAL_OR_HIGHER_THAN 2 THEN a2 b2 ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 3 THEN a3 b3 ENDIF  IF [switches] EQUAL_OR_HIGHER_THAN 4 THEN a4 b4 ENDIF  IF [switches] EQUAL_OR_HIGHER_THAN 5 THEN a5 b5 ENDIF  IF [switches] EQUAL_OR_HIGHER_THAN 6 THEN a6 b6 ENDIF  IF [switches] EQUAL_OR_HIGHER_THAN 7 THEN a7 b7 ENDIF  IF [switches] EQUAL_OR_HIGHER_THAN 8 THEN a8 b8 ENDIF  IF [switches] EQUAL_OR_HIGHER_THAN 9 THEN a9 b9 ENDIF  IF [switches] EQUAL_OR_HIGHER_THAN 10 THEN a10 b10 ENDIF  IF [switches] EQUAL_OR_HIGHER_THAN 11 THEN a11 b11 ENDIF  IF [switches] EQUAL_OR_HIGHER_THAN 12 THEN a12 b12 ENDIF 
			Vctrl ctrl 0 PWL([value])
			R1 a1 b1 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]'
 			IF [switches] EQUAL_OR_HIGHER_THAN 2 THEN R2 a2 b2 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF
			IF [switches] EQUAL_OR_HIGHER_THAN 3 THEN R3 a3 b3 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF 
			IF [switches] EQUAL_OR_HIGHER_THAN 4 THEN R4 a4 b4 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF 
			IF [switches] EQUAL_OR_HIGHER_THAN 5 THEN R5 a5 b5 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF 
			IF [switches] EQUAL_OR_HIGHER_THAN 6 THEN R6 a6 b6 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF 
			IF [switches] EQUAL_OR_HIGHER_THAN 7 THEN R7 a7 b7 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF 
			IF [switches] EQUAL_OR_HIGHER_THAN 8 THEN R8 a8 b8 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF 
			IF [switches] EQUAL_OR_HIGHER_THAN 9 THEN R9 a9 b9 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF
			IF [switches] EQUAL_OR_HIGHER_THAN 10 THEN R10 a10 b10 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF
			IF [switches] EQUAL_OR_HIGHER_THAN 11 THEN R11 a11 b11 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF 
			IF [switches] EQUAL_OR_HIGHER_THAN 12 THEN R12 a12 b12 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]' ENDIF
		.ends
		// component:
		X_[individual] [A1] [B1] IF [switches] EQUAL_OR_HIGHER_THAN 2 THEN [A2] [B2] ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 3 THEN [A3] [B3] ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 4 THEN [A4] [B4] ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 5 THEN [A5] [B5] ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 6 THEN [A6] [B6] ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 7 THEN [A7] [B7] ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 8 THEN [A8] [B8] ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 9 THEN [A9] [B9] ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 10 THEN [A10] [B10] ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 11 THEN [A11] [B11] ENDIF IF [switches] EQUAL_OR_HIGHER_THAN 12 THEN [A12] [B12] ENDIF switch_DIP_[individual]
	</Spice>
</Component>
		
<Component>
    <Description>
         Rotary switch, 4-bit encoding
         This switch can be controlled over the simulated time by setting the eeschema value to a text like the following:
         0 0 0.9ms 0 1 1.1ms 1 1.9ms 2 2.1ms 2 2.9ms 3 3.1ms 3 3.9ms
         which can be read as: 
         position 0 from time 0 to time 0.9ms, 
         position 1 from time 1.1ms to time 1.9ms,
         position 2 from time 2.1ms to time 2.9ms,
         position 3 from time 3.1ms to time 3.9ms (and ever after),
         and the times between that are switching times.
    </Description>
    <eeschema_sch>
        L Switch:SW_Coded
    </eeschema_sch>
    <eeschema_symbol>
        DRAW
            C -25 25 150 0 1 0 N
            S 300 300 -250 -250 0 1 10 f
            P 11 0 1 0 -35 -75 -35 105 -55 85 -75 85 -25 135 25 85 5 85 -15 105 -15 -75 -35 -75 -35 -75 N
            X CM 1 500 250 200 L 50 50 1 1 P
            X D0 2 500 100 200 L 50 50 1 1 P
            X D1 3 500 0 200 L 50 50 1 1 P
            X D2 4 500 -100 200 L 50 50 1 1 P
            X D3 5 500 -200 200 L 50 50 1 1 P
        ENDDRAW
    </eeschema_symbol>
    <Spice>
        .subckt switch_rotary_4bit d0 d1 d2 d3 cm
            Vctrl ctrl 0 PWL([value])
            R0 cm d0 r='V(ctrl) > -0.01 && V(ctrl) < 0.01 ? 1.0 : 1E9'
            R1 cm d1 r='V(ctrl) >  0.99 && V(ctrl) < 1.01 ? 1.0 : 1E9'
            R2 cm d2 r='V(ctrl) >  1.99 && V(ctrl) < 2.01 ? 1.0 : 1E9'
            R3 cm d3 r='V(ctrl) >  2.99 && V(ctrl) < 3.01 ? 1.0 : 1E9'
        .ends
        X_[individual] [D0] [D1] [D2] [D3] [CM] switch_rotary_4bit
    </Spice>

	</eeschema_sch>
	<animation>
            DEFINE [curr1] I[A1]
            DEFINE [curr1] AS_MATH_ABS OF:[curr1]
            DEFINE [volt1] AS_MATH_SUB OF:V[A1] AND:V[B1]
            DEFINE [volt1] AS_MATH_ABS OF:[volt1]
            DEFINE [ohms1] AS_MATH_DIV OF:[volt1] AND:[curr1]
            DRAW
                IF [ohms1] EQUAL_OR_LOWER_THAN [r_threshold] THEN
                    P 2 0 0 0 -60 0 60 0 N 
                    //<Line -60 0 120 0 #FFFF00 2 1>
                ELSE
                  P 2 0 0 0 -60 5 53 56 N 
                  // <Line -60 0 110 -40 #880000 2 1>
                ENDIF
            ENDDRAW
	</animation>
	<eeschema_symbol>
		DRAW
			// frame:
			IF [switches] EQUAL_TO 1 THEN 
                S -150 100 150 -100 0 1 10 f
            ENDIF
			IF [switches] EQUAL_TO 2 THEN 
                S -150 200 150 -100 0 1 10 f
			ENDIF
			IF [switches] EQUAL_TO 3 THEN 
                S -150 300 150 -100 0 1 10 f
			ENDIF
			IF [switches] EQUAL_TO 4 THEN 
                S -150 300 150 -200 0 1 10 f
			ENDIF
			IF [switches] EQUAL_TO 5 THEN 
               S -150 300 150 -300 0 1 10 f 
			ENDIF
			IF [switches] EQUAL_TO 6 THEN 
                S -150 400 150 -300 0 1 10 f
			ENDIF
			IF [switches] EQUAL_TO 7 THEN 
                S -150 500 150 -300 0 1 10 f
			ENDIF
			IF [switches] EQUAL_TO 8 THEN 
                S -150 500 150 -400 0 1 10 f
			ENDIF
			IF [switches] EQUAL_TO 9 THEN 
                S -150 500 150 -500 0 1 10 f
			ENDIF
			IF [switches] EQUAL_TO 10 THEN 
                S -150 600 150 -500 0 1 10 f
			ENDIF
			IF [switches] EQUAL_TO 11 THEN 
                S -150 700 150 -500 0 1 10 f
			ENDIF
			IF [switches] EQUAL_TO 12 THEN 
               S -150 700 150 -600 0 1 10 f 
			ENDIF
			//SWITCHES:
			// switch 1:
			C -80 0 20 0 0 0 N
			C 80 0 20 0 0 0 N
			IF [animated] THEN ELSE
                P 2 0 0 0 -60 5 93 46 N 
			ENDIF
			
			X A1 1 -300 0 200 R 50 50 1 1 P
			X B1 2 300 0 200 L 50 50 1 1 P
			// switch 2 at Y=100: 
			IF [switches] EQUAL_OR_HIGHER_THAN 2 THEN
				C -80 100 20 0 0 0 N
				C 80 100 20 0 0 0 N
				P 2 0 0 0 -60 105 93 146 N 
				X A2 3 -300 100 200 R 50 50 1 1 P
				X B2 4 300 100 200 L 50 50 1 1 P
			ENDIF
			// switch 3 at Y=200:
			IF [switches] EQUAL_OR_HIGHER_THAN 3 THEN
				C -80 200 20 0 0 0 N
				C 80 200 20 0 0 0 N
				P 2 0 0 0 -60 205 93 246 N
				X A3 5 -300 200 200 R 50 50 1 1 P
				X B3 6 300 200 200 L 50 50 1 1 P
			ENDIF
			// switch 4 at Y=-100:
			IF [switches] EQUAL_OR_HIGHER_THAN 4 THEN
				C -80 -100 20 0 0 0 N 
				C 80 -100 20 0 0 0 N
				P 2 0 0 0 -60 -94 93 -53 N
				X A4 7 -300 -100 200 R 50 50 1 1 P
				X B4 8 300 -100 200 L 50 50 1 1 P
			ENDIF
			// switch 5 at Y=-200:
			IF [switches] EQUAL_OR_HIGHER_THAN 5 THEN
				C 80 -200 20 0 0 0 N
				C -80 -200 20 0 0 0 N
				P 2 0 0 0 -60 -194 93 -153 N 
				X A5 9 -300 -200 200 R 50 50 1 1 P
				X B5 10 300 -200 200 L 50 50 1 1 P
			ENDIF
			// switch 6 at Y=300:
			IF [switches] EQUAL_OR_HIGHER_THAN 6 THEN
				C 80 300 20 0 0 0 N
				C -80 300 20 0 0 0 N
				P 2 0 0 0 -60 305 93 346 N 
				X A6 11 -300 300 200 R 50 50 1 1 P
				X B6 12 300 300 200 L 50 50 1 1 P
			ENDIF
			// switch 7 at Y=400:
			IF [switches] EQUAL_OR_HIGHER_THAN 7 THEN
				C -80 400 20 0 0 0 N
				C 80 400 20 0 0 0 N
				 P 2 0 0 0 -60 405 93 446 N 
				X A7 13 -300 400 200 R 50 50 1 1 P
				X B7 14 300 400 200 L 50 50 1 1 P
			ENDIF
			// switch 8 at Y=-300:
			IF [switches] EQUAL_OR_HIGHER_THAN 8 THEN
				C -80 -300 20 0 0 0 N
				C 80 -300 20 0 0 0 N
				 P 2 0 0 0 -60 -294 93 -253 N 
				X A8 15 -300 -300 200 R 50 50 1 1 P
				X B8 16 300 -300 200 L 50 50 1 1 P
			ENDIF
			// switch 9 at Y=-400:
			IF [switches] EQUAL_OR_HIGHER_THAN 9 THEN
				C -80 -400 20 0 0 0 N
				C 80 -400 20 0 0 0 N
				 P 2 0 0 0 -60 -394 93 -353 N 
				X A9 17 -300 -400 200 R 50 50 1 1 P
				X B9 18 300 -400 200 L 50 50 1 1 P
			ENDIF			
			// switch 10 at Y=500:
			IF [switches] EQUAL_OR_HIGHER_THAN 10 THEN
				C -80 500 20 0 0 0 N
				C 80 500 20 0 0 0 N
				 P 2 0 0 0 -60 505 93 546 N 
				X A10 19 -300 500 200 R 50 50 1 1 P
				X B10 20 300 500 200 L 50 50 1 1 P
			ENDIF
			// switch 11 at Y=600:
			IF [switches] EQUAL_OR_HIGHER_THAN 11 THEN
				C -80 600 20 0 0 0 N
				C 80 600 20 0 0 0 N
				 P 2 0 0 0 -60 605 93 646 N 
				X A11 21 -300 600 200 R 50 50 1 1 P
				X B11 22 300 600 200 L 50 50 1 1 P
			ENDIF
			// switch 12 at Y=-500:
			IF [switches] EQUAL_OR_HIGHER_THAN 12 THEN
				C -80 -500 20 0 0 0 N
				C 80 -500 20 0 0 0 N
				 P 2 0 0 0 -60 -494 93 -453 N
				X A12 17 -300 -500 200 R 50 50 1 1 P
				X B12 18 300 -500 200 L 50 50 1 1 P
			ENDIF	
		ENDDRAW
	</eeschema_symbol>

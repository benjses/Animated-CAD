          (xy 2.667 -0.254)
          (xy 2.667 -2.286)
          (xy 2.667 -2.286)
        )
        (stroke (width 0.3556) (type default) (color 0 0 0 0))
        (fill (type none))
      )
      (polyline
        (pts
          (xy -5.08 -2.54)
          (xy -3.175 -2.54)
          (xy -3.175 2.54)
          (xy -5.08 2.54)
        )
        (stroke (width 0) (type default) (color 0 0 0 0))
        (fill (type none))
      )
      (polyline
        (pts
          (xy -3.175 -0.635)
          (xy -3.81 0.635)
          (xy -2.54 0.635)
          (xy -3.175 -0.635)
        )
        (stroke (width 0.254) (type default) (color 0 0 0 0))
        (fill (type none))
      )
      (polyline
        (pts
          (xy 3.683 -2.413)
          (xy 3.429 -1.905)
          (xy 3.175 -2.159)
          (xy 3.683 -2.413)
        )
        (stroke (width 0) (type default) (color 0 0 0 0))
        (fill (type none))
      )
      (polyline

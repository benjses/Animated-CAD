<Component>
	<Description>
		74HC00 2-input NAND gate.
		This component has an external power source block (Unit 5 or unit E).
		You can set the power block to supply this component by 
		giving the power block the same value as you give to the component.
	</Description>
	<eeschema_sch>
		L 74xx:74HC00
		ALIAS 74xx:74LS00 74xx:74LS01 74xx:7400 74xx:74HCT00
		F0 [name]
		F1 [value] 
		F2 [footprint] 
		F3 [datasheet] 
	</eeschema_sch>
	<eeschema_symbol>
		IF [eeschema_u_n] EQUAL_TO 5 THEN // Block Unit E =5 is VCC/GND connection block
			<SET_CONNECTION [value]_vcc 0 -500> 
			<SET_CONNECTION [value]_gnd 0 500> 

			<.PortSym 0 -500 [pin_vcc] 0><Line 0 -500 0 200 #000080 2 1>
			<.PortSym 0 500 [pin_gnd] 0><Line 0 500 0 -200  #000080 2 1>
			<Rectangle -200 -300 400 600 #000080 2 1 #000080 1 0>


			<Text -150 -40 60 #888888 0 [value]>
			<Text -150  40 60 #888888 0 "Source">
			<Text -60 -230 60 #888888 0 "VCC">
			<Text -60  230 60 #888888 0 "GND">
		ELSE 
			// get distant connections from above:
			<.PortSym GET_CONNECTION [value]_vcc>
			<.PortSym GET_CONNECTION [value]_gnd>
			
			//normal drawing:
			// Common part for 2-input logic elements:
			<Rectangle -200 -120 400 240 #000080 2 1 #000080 1 0>
			<.PortSym -300 -100 [pinA] 0><Line -300 -100 100 0 #000080 2 1>
			<.PortSym -300 100 [pinB] 0><Line -300 100 100 0 #000080 2 1>
			<.PortSym 300 0 [pout] 0><Line 300 0 -100 0 #000080 2 1>
			// Individual part:
			<Text -150 -60 60 #000080 0 "NAND">
			<Text -150 10 50 #888888 0 "74xx00">
        ENDIF
	</eeschema_symbol>
	<Spice>
        IF [eeschema_u_n] EQUAL_TO 5 THEN 
			R_[individual] [pin_vcc] [pin_gnd] 1e6
		ELSE
			// Model - Declaration:
			.subckt 74HC00 inA inB vpos vneg out
			.model mdl_MOSP PMOS KP=1.0E-5 VTO=-1.0 LAMBDA=0.05 W=5U L=1U
			.model mdl_MOSN NMOS KP=2.5E-5 VTO=1.0  LAMBDA=0.05 W=5U L=1U
			
			//Model - NAND:
			//name drain gate source bulk type
			mospHA out   inA  vpos   vpos mdl_MOSP
			mospHB out   inB  vpos   vpos mdl_MOSP
			mosnLA nab   inA  vneg   vneg mdl_MOSN
			mosnLB out   inB  nab    nab  mdl_MOSN
			
			.ends
			// component
			X_[name] [pinA] [pinB] [value]_vcc [value]_gnd [pout] 74HC00
        ENDIF
	</Spice>
</Component>


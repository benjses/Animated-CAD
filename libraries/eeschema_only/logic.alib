<Component>
	<Description>
		74HC04 Hex Inverter (a normal NOT gate)
		This component has an external power source block (Unit 7 or unit G).
		You can set the power block to supply this component by 
		giving the power block the same value as you give to the component.
	</Description>
	<eeschema_sch>
		L 74xx:74HC04
		DEFINE [datasheet] https://asset.conrad.com/media10/add/160267/c1/-/en/000144614DS02/datenblatt-144614-nexperia-74hct04d652-logik-ic-inverter-inverter-74hct-so-14.pdf
	</eeschema_sch>
	<eeschema_sch>
		L 74xx:74AHC04
		F0 [name]
		F1 [value]
		F2 [footprint]
		F3 [datasheet]
	</eeschema_sch>
	<purchase>
		<link>
			<url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fp%2Fnexperia-74hct04d-652-logik-ic-inverter-inverter-74hct-so-14-144614.html</url>
			<title>74HCT Inverter</title>
			<detail>An inverter of type Nexperia 74HCT04D at Conrad electronic</detail>
		</link>
</purchase>
	
	<eeschema_symbol>
		IF [eeschema_u_n] EQUAL_TO 7 THEN // [eeschema_u_n] is the Block type number in the U line of eeschema-sch-files. Here, 7 is the block type G, which is the source block. 
			// create distant connections for other blocks, see below:
			<SET_CONNECTION [value]_vcc 0 -500> 
			<SET_CONNECTION [value]_gnd 0 500> 
			
			//normal drawing:
			<.PortSym 0 -500 [pin_vcc] 0><Line 0 -500 0 200 #000080 2 1>
			<.PortSym 0 500 [pin_gnd] 0><Line 0 500 0 -200  #000080 2 1>
			<Rectangle -200 -300 400 600 #000080 2 1 #000080 1 0>

			<Text 0 0 60 #888888 0 [value]>
			
			<Text 0 -230 60 #888888 0 "VCC">
			<Text 0  230 60 #888888 0 "GND">
		ELSE // blocks other than G. These are the actual inverters
			
			// get distant connections from above:
			<.PortSym GET_CONNECTION [value]_vcc>
			<.PortSym GET_CONNECTION [value]_gnd>
			//normal drawing:
			// Common part for 1-input logic elements:
			<Rectangle -200 -120 400 240 #000080 2 1 #000080 1 0>
			<.PortSym -300 0 [pin] 0><Line -300 0 100 0 #000080 2 1>
			<.PortSym 300 0 [pout] 0><Line 300 0 -60 0 #000080 2 1>
			// Individual part:
			IF [rotation] EQUAL_TO 1 || [rotation] EQUAL_TO 3 THEN
                <Text -50 0 60 #000080 0 "=1">
                <Text 0 0 40 #888888 0 "[value]">
                <Text 40 0 40 #888888 0 "Type [eeschema_u_n]">
			ELSE
                <Text 0 -50  60 #000080 0 "=1">
                <Text 0 0 40 #888888 0 "[value]>
                <Text 0 40 40 #888888 0 "Type [eeschema_u_n]">
            ENDIF
            <Ellipse 200 -20 40 40 #000080 2 1 2 1 0>
		ENDIF 
	</eeschema_symbol>
	<Spice>
			IF [eeschema_u_n] EQUAL_TO 7 THEN 
				R_[individual] [pin_vcc] [pin_gnd] 1e6
			ELSE
				//Model
				.subckt mdl_74HC04 in vpos vneg out
				.model mdl_MOSP PMOS KP=1.0E-5 VTO=-1.0 LAMBDA=0.05 W=5U L=1U
				.model mdl_MOSN NMOS KP=2.5E-5 VTO=1.0  LAMBDA=0.05 W=5U L=1U
				rpos vpos out 1e8
				rneg out vneg 1e8
				m_inv_p out in vpos vpos mdl_MOSP 
				m_inv_n out in vneg vneg mdl_MOSN 
				.ends
				// component
				X_[name] [pin] [value]_vcc [value]_gnd [pout] mdl_74HC04
			ENDIF 
	</Spice>
</Component>


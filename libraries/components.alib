<Component>
<Description>
A MOSFET. creation according to ngspice Users Manual Version "30 plus" chapter 11.2.4 "MOS Level 6"
[type]   = Polarity of Mosfet type. If "nfet" then N-Channel, if "pfet" then P-Channel.
[V_to]   = zero-bias threshold voltage
[Kp]     = transconductance in A / V² (not used for runnability)
[Gamma]  = bulk threshold in V^(1/2)
[Phi]    = surface potential
[Lambda] = channel-length modulation parameter in 1/V
[R_d]    = drain ohmic resistance
[R_s]    = source ohmic resistance
[R_g]    = gate ohmic resistance  (not used: TODO include rg and test)
[I_s]    = bulk junction saturation current
[N]      = bulk junction emission coeff (not used)
[W]      = width of the channel
[L]      = length of the channel
[L_d]    = lateral diffusion length (not used)
[T_ox]   = thickness of oxide layer
[C_gso]  = overlap capacitance per meter of channel width between gate and source in F/m
[C_gdo]  = overlap capacitance per meter of channel width between gate and drain in F/m
[C_gbo]  = overlap capacitance per meter of channel width between gate and bulk in F/m
[C_bd]   = zero bias junction capacity between bulk and drain
[C_bs]   = zero bias junction capacity between bulk and source
[P_b]    = bulk junction potential
[M_j]    = bulk junction bottom grading coefficient
[F_c]    = bulk junktion forward-bias depletion capacitance coefficient
[C_jsw]  = zero-bias bulk juction periphery/sidewall capacitance per meter of juction perimeter in F/m
[M_jsw]  = bulk juction periphery/sidewall grading coefficient
[T_t]    = bulk transit time (not used: Todo include tt and test)
[N_sub]  = substrate bulk doping density in 1/cm³ (not used for runnability)
[N_ss]   = surface state density in 1/cm²
[Tp_g]   = gate material type: "0" for alumina, "-1" for same as bulk, "1" for opposite to bulk
[U_o]    = surface mobility in (cm²) / Vs
[R_sh]   = drain and source diffusion sheet resistance in Ohm per square
[N_rd]   = nuber of equivalent drain squares
[N_rs]   = number of equivalent source squares
[C_j]    = zero-bias bulk juction bottom capacitance per square meter of juction area in F/m²
[J_s]    = bulk juction saturation current per square meter of juction area in A/m²
[A_d]    = drain diffusion area in m²
[A_s]    = source diffusion area in m²
[P_d]    = drain junction perimeter
[P_s]    = source junction perimeter
[K_f]    = flicker noise coefficient (not used for runnability)
[A_f]    = flicker nosie exponent    (not used for runnability)
[F_fe]   = flicker noise frequency exponent (not used)
[Temp]   = simulation temperature in °C (not used)
[T_nom]  = parameter measurement temperature in °C
</Description>
<qucs_sch>
_MOSFET [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [type] [type_v] [V_to] [V_to_v]
[Kp] [Kp_v] [Gamma] [Gamma_v] [Phi] [Phi_v] [Lambda] [Lambda_v] [R_d] [R_d_v] [R_s] [R_s_v] [R_g] [R_g_v]
[I_s] [I_s_v] [N] [N_v] [W] [W_v] [L] [L_v] [L_d] [L_d_v] [T_ox] [T_ox_v] [C_gso] [C_gso_v]
[C_gdo] [C_gdo_v] [C_gbo] [C_gbo_v] [C_bd] [C_bd_v] [C_bs] [C_bs_v] [P_b] [P_b_v] [M_j] [M_j_v] [F_c] [F_c_v]
[C_jsw] [C_jsw_v] [M_jsw] [M_jsw_v] [T_t] [T_t_v] [N_sub] [N_sub_v] [N_ss] [N_ss_v] [Tp_g] [Tp_g_v] [U_o] [U_o_v] [R_sh] [R_sh_v]
[N_rd] [N_rd_v] [N_rs] [N_rs_v] [C_j] [C_j_v] [J_s] [J_s_v] [A_d] [A_d_v] [A_s] [A_s_v] [P_d] [P_d_v] [P_s] [P_s_v] [K_f] [K_f_v]
[A_f] [A_f_v] [F_fe] [F_fe_v] [Temp] [Temp_v] [T_nom] [T_nom_v] 
</qucs_sch>
<Spice>
.model M_MDL_[name] IF [type] EQUAL_TO "nfet" THEN nmos ENDIF IF [type] EQUAL_TO "pfet" THEN pmos ENDIF
+ level=6
//+ vto=[V_to] gamma=[Gamma] phi=[Phi] lambda=[Lambda] rd=[R_d] rs=[R_s] cbd=[C_bd] cbs=[C_bs]
//+ is=[I_s] pb=[P_b] cgso=[C_gso] cgdo=[C_gdo] cgbo=[C_gbo] rsh=[R_sh] cj=[C_j] mj=[M_j] fc=[F_c] cjsw=[C_jsw]
//+ mjsw=[M_jsw] js=[J_s] tox=[T_ox] nss=[N_ss] tpg=[Tp_g] uo=[U_o] tnom=[T_nom]

M_[name] [d] [g] [s] [s] M_MDL_[name]
+ l=[L] w=[W] ad=[A_d] as=[A_s] pd=[P_d] ps=[P_s] nrd=[N_rd] nrs=[N_rs]
</Spice>

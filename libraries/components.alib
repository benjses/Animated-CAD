<Component>
	<Description>
		This resistor model is deprecated, please use the one in the library "01 basic components" instead.
		An ideal Resistor. Ignores temperature effects.
		[name] is the name of the component
		[value] is resistance in Ohm
		IF [tcf] THEN [tcf] is an ignored value (temperature in degC)
        ENDIFIF [tcf1] THEN [tcf1] is another ignored value (temperature coeff 1) 
		ENDIFIF [tcf2] THEN [tcf2] is another ignored value (temperature coeff 2) 
		ENDIFIF [nomT] THEN [nomT] is another ignored value (nominal temperature) 
		ENDIFIF [smbl] THEN [smbl] is the symbol type. ("european" or "US" symbol) 
		ENDIFIF [pin1] THEN [pin1] is the first connection node. The one from which technical current comes from. 
		ENDIFIF [pin2] THEN [pin2] is the second connection node. The one to which technical current flows to. 
		ENDIFIF [footprint] THEN [footprint] is a footprint on a layout board. 
		ENDIFIF [datasheet] THEN [datasheet] is a link to the datasheet.ENDIF
	</Description>
	<qucs_sch>
		R [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [value] [value_v] [tcf] [tcf_v] [tcf1] [tcf1_v] [tcf2] [tcf2_v] [nomT] [nomT_v] [smbl] [smbl_v]
	</qucs_sch>
	<eeschema_sch>
		L Device:R
		ALIAS Device:R_Small Device:R_US  Device:R_Small_US
	</eeschema_sch>
	<eeschema_sch>
		L Device:R_Variable
		ALIAS Device:R_Variable_US
	</eeschema_sch>
	<eeschema_sch>
        L Device:Heater
    </eeschema_sch>
	<Default_Values>
        100 // Resistor value with 100 Ohm
		1.5k // Resistor value with 1500 Ohm 
		1,5k // Resistor value with 1500 Ohm 
		2.2e4 // Resistor value with 2.2x10^4= 22000 Ohm = 22 Kilo Ohm 
		1M  // Resistor value with 1 <b>Mega</b>Ohm = 1 Million Ohm
		1m  // Resistor value with 1 <b>Milli</b>Ohm 
		//+= 1/1000 Ohm = 0,001 Ohm
    </Default_Values>
	<Spice>
        DEFINE [ohm] AS_NUMBER OF:[value]
        IF [ohm] THEN
            DEFINE [value] AS_NULL
        ELSE
            <Dialog title="missing ohm value for [name]" type="error" dimension="450x100"> 
                The resistor named [name] at ([xpos] | [ypos]) has an invalid value, "[value]".
                Please enter a number at that place.
            </Dialog>
        ENDIF
        R_[name] [pin1] [pin2] [ohm]
	</Spice>
	<qucs_symbol>
		IF [smbl] EQUAL_TO "US" THEN
			<Line -18 0 3 -9 #000080 2 1>
			<Line -15 -9 6 18 #000080 2 1>
			<Line -9 9 6 -18 #000080 2 1>
			<Line -3 -9 6 18 #000080 2 1>
			<Line 3 9 6 -18 #000080 2 1>
			<Line 9 -9 6 18 #000080 2 1>
			<Line 15 9 3 -9 #000080 2 1>
		ELSE
			<Rectangle -18 -9 36 18 #000080 2 1 #000080 1 0>
		ENDIF
		<Line -30 0 12 0 #000080 2 1>
		<Line 30 0 -12 0 #000080 2 1>
		<.PortSym -30 0 [pin1] 0>
		<.PortSym 30 0 [pin2] 0>
	</qucs_symbol>
	<purchase>
        <link>
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fo%2Fmosfets-5104021.htmlhttps%3A%2F%2Fwww.conrad.de%2Fde%2Fc%2Fwiderstaende-17441.html</url>
            <title>IF[language] EQUAL_TO "de" THEN Uebersicht WiderstaendeELSEOverview of resistorsENDIF</title>
			<detail>IF[language] EQUAL_TO "de" THEN Auswahl an Widerstaenden verschiedener Bauformen bei Conrad Electronic ELSECollection of resistors of different types at Conrad ElectronicENDIF</detail>
        </link>
        <link>
            <url>https://cdn.retailads.net/tc.php?t=151241C1001130856T&deeplink=https%3A%2F%2Fwww.conrad.de%2Fde%2Fc%2Fpotentiometer-17440.html</url>

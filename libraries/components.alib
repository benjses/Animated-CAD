IF [type] EQUAL_TO "nfet" THEN
	<Line -8 0 4 -4 #000080 2 1>
	<Line -8 0 4 4 #000080 2 1>
	<Polygon3 5 5 15 5 10 -5 #000080 2 1 #000080 2 1> 
	<Line 5 -5 10 0 #000080 2 1>
ENDIF
IF [type] EQUAL_TO "pfet" THEN
	<Line -2 0 -4 -4 #000080 2 1>
	<Line -2 0 -4 4 #000080 2 1>
	<Polygon3 5 -5 15 -5 10 5 #000080 2 1 #000080 2 1>
	<Line 5 5 10 0 #000080 2 1>
ENDIF

<.PortSym -30 0 [g] 0>
<Text -25 0 12 #0000FF 0 "G" > >
<.PortSym 0 -30 [d] 270>
<Text -8 -25 12 #0000FF 0 "D" >
<.PortSym 0 30 [s] 90>
<Text -8 25 12 #0000FF 0 "S">
</qucs_symbol>
</Component>

<Component>
<Description>
A bipolar junction transistor.
Component created according to ngspice user manual version "30 plus" chapter 8 "BJTs" and
"Principles of Semiconductor Devices" chapter 5.6.3 "Spice model" see also https://ecee.colorado.edu/~bart/book/book/chapter5/pdf/ch5_6_3.pdf
[I_s]   = Transport saturation current in A
[N_f]   = Forward current emission coefficient
[N_r]   = Reverse current emission coefficient 
[I_kf]  = Corner for forward beta current roll-off in A 
[I_kr]  = Corner for reverse beta high current roll-off in A 
[V_af]  = Forward Early voltage in V 
[V_ar]  = Reverse Early voltage in V  
[I_se]  = B-E leakage saturation current in A
[N_e]   = B-E leakage emission coefficient
[I_sc]  = B-C leakage saturation current in A
[N_c]   = B-C leakage emission coefficient
[B_f]   = Ideal maximum forward beta
[B_r]   = Ideal maximum reverse beta
[R_bm]  = Minimum base resistance at high currents in Ohm
[I_rb]  = Current where base resistance halfway to its min value in A
[R_c]   = Collector resistance in Ohm
[R_e]   = Emitter resistance in Ohm
[R_b]   = Zero bias base resistance in Ohm
[C_je]  = B-E zero-bias depletion capacitance
[V_je]  = B-E built-in potential
[M_je]  = B-E junction exponetial factor
[C_jc]  = B-C zero-bias depletion capacitance in F
[V_jc]  = B-C built-in potential in V
[M_jc]  = B-C junction exponential factor
[X_cjc] = Fraction of B-C depletion capacitance connected to internal base node
[C_js]  = Zero-bias collector-substrate capacitance in F
[V_js]  = Substrate junction built-in potential
[M_js]  = Substrate junction exponential factor
[F_c]   = Coefficient for forward-bias depletion capacitance formula
[T_f]   = Ideal forward transit time in s
[X_T_f] = Coefficient for bias dependence of T_f
[V_T_f] = Voltage describing VBC dependence of T_f in V
[I_T_f] = High-current parameter for effect on TF in A
[T_r]   = (unused)
[Temp]  = (unused)
[K_f]   = Flicker-noise coefficient 
[A_f]   = Flicker-noise exponent
[F_fe]  = (unused)
[K_b]   = (unused)
[A_b]   = (unused)
[F_b]   = (unused)
[P_tf]  = (unused)
[X_tb]  = Forward and reverse beta temperature exponent
[X_ti]  = Temperature exponent for effext on I_s
[E_g]   = Energy gap for temperature effect on I_s in eV
[T_nom] = Parameter measurement temperature in degrees Celsius
[Area]  = (unused) 
</Description>
<qucs_sch>
_BJT [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [type] [type_v] [I_s] [I_s_v] [N_f] [N_f_v]
[N_r] [N_r_v] [I_kf] [I_kf_v] [I_kr] [I_kr_v] [V_af] [V_af_v] [V_ar] [V_ar_v] [I_se] [I_se_v] [N_e] [N_e_v]
[I_sc] [I_sc_v] [N_c] [N_c_v] [B_f] [B_f_v] [B_r] [B_r_v] [R_bm] [R_bm_v] [I_rb] [I_rb_v] [R_c] [R_c_v] [R_e] [R_e_v]
[R_b] [R_b_v] [C_je] [C_je_v] [V_je] [V_je_v] [M_je] [M_je_v] [C_jc] [C_jc_v] [V_jc] [V_jc_v] [M_jc] [M_jc_v] 
[X_cjc] [X_cjc_v] [C_js] [C_js_v] [V_js] [V_js_v] [M_js] [M_js_v] [F_c] [F_c_v] [T_f] [T_f_v] [X_T_f] [X_T_f_v] [V_T_f]
[V_T_f_v] [I_T_f] [I_T_f_v] [T_r] [T_r_v] [Temp] [Temp_v] [K_f] [K_f_v] [A_f] [A_f_v] [F_fe] [F_fe_v] [K_b] [K_b_v]
[A_b] [A_b_v] [F_b] [F_b_v] [P_tf] [P_tf_v] [X_tb] [X_tb_v] [X_ti] [X_ti_v] [E_g] [E_g_v] [T_nom] [T_nom_v]
[Area] [Area_v]
</qucs_sch>
<Spice>
.model Q_MDL_[name] [type]
+ (is=[I_s] nf=[N_f] nr=[N_r] ikf=[I_kf] ikr=[I_kr] vaf=[V_af] var=[V_ar] ise=[I_se] ne=[N_e] isc=[I_sc] nc=[N_c] 
+ bf=[B_f] br=[B_r] rbm=[R_bm] irb=[I_rb] rc=[R_c] re=[R_e] rb=[R_b] cje=[C_je] vje=[V_je] mje=[M_je]
+ cjc=[C_jc] vjc=[V_jc] mjc=[M_jc] xcjc=[X_cjc] cjs=[C_js] vjs=[V_js] mjs=[M_js] fc=[F_c] 
+ tf=[T_f] xtf=[X_T_f] vtf=[V_T_f] itf=[I_T_f] kf=[K_f] af=[A_f] xtb=[X_tb] xti=[X_ti] eg=[E_g] tnom=[T_nom]
+ )

Q_[name] [C] [B] [E] Q_MDL_[name] 
</Spice>
<qucs_symbol>
<Line -30 0 20 0 #000080 2 1>
<Line -10 -15 0 30 #000080 2 1>
<Line 0 -30 0 15  #000080 2 1>
<Line 0 -15 -10 10 #000080 2 1>
<Line -10 5 10 10 #000080 2 1>
<Line 0 15 0 15 #000080 2 1>
<.PortSym -30 0 [B] 0>
<.PortSym 0 -30 [C] 270>
<.PortSym 0 30 [E] 90>
</qucs_symbol>
</Component>

<Component>
	<Description>
		Diode from Spice-library. Contains the default ngspice parameters,
		see ngspice Users Manual Version "30 plus" chapter 7 "Diodes".
	</Description>
	<qucs_sch>
		DIODE_SPICE [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [dl] [dl_v] [dl2] [dl2_v] [dl3] [dl3_v] [dl4] [dl4_v] [dl5] [dl5_v]
	</qucs_sch>
	<qucs_symbol>
		<Line -10 -10 0 20 #000080 2 1>
		<Line 10 0 -20 10 #000080 2 1>
		<Line 10 0 -20 -10 #000080 2 1>
		<Line 10 -10 0 20 #000080 2 1>
		<Line -30 0 20 0 #000080 2 1>
		<Line 30 0 -20 0 #000080 2 1>
		<.PortSym -30 0 [A] 0>
		<.PortSym 30 0 [K] 0>
	</qucs_symbol>
	<eeschema_sch>
		L pspice:DIODE
	</eeschema_sch>
	<eeschema_symbol>
		// ATTENTION: The default Symbol from KiCad Eeschema version 5.1.2 is wrong: 
		// The Kathode[K] and Anode[A] are switched
		// Because of this, the following own Diode Symbol for Eeschema is created:
		<.PortSym -200 0 [A] 0>
		<.PortSym 200 0 [K] 0>
		<Line -200 0 100 0 #0000F0 2 1>
		<Line 200 0 -100 0 #0000F0 2 1>
		<Line 100 -100 0 200 #0000F0 2 1>
		<Line -100 -100 0 200 #0000F0 2 1>
		<Line -100 -100 200 100 #0000F0 2 1>
		<Line -100 100 200 -100 #0000F0 2 1>
	</eeschema_symbol>
	<Spice>
	.model DIODE_[name]_SPICE D
	IF [dl] THEN+ [dl]ENDIF
	IF [dl2] THEN+ [dl2]ENDIF
	IF [dl3] THEN+ [dl3]ENDIF
	IF [dl4] THEN+ [dl4]ENDIF
	IF [dl5] THEN+ [dl5]ENDIF
	//IF [value] THENIF [value] EQUAL_TO "DIODE" THENELSE+ [value]ENDIF
	D_[name] [A] [K] DIODE_[name]_SPICE
	</Spice>
</Component>

		)
		(polyline
		  (pts
			(xy 2.54 5.08)
			(xy 2.54 -5.08)
		  )
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type none))
		)
		(rectangle (start 1.27 3.81) (end 3.81 -3.81)
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type outline))
		)
		(circle (center 6.35 2.54) (radius 0.8)
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type outline))
		)
		// optional additional measuring pins for the size of B field and H field:
		IF [bfactor] IS_NUMBER THEN
			(text "B" (at -3.81 10.16 0)
				(effects (font (size 1.27 1.27)))
			)
			(pin output line (at -1.27 11.43 270) (length 5.08)
			(name "bmeas" (effects (font (size 1.27 1.27))))
				(number "5" (effects (font (size 1.27 1.27))))
			)
		ENDIF
		IF [hfactor] IS_NUMBER THEN
			(text "H" (at 3.81 10.16 0)
			  (effects (font (size 1.27 1.27)))
			)
			
			(pin output line (at 1.27 11.43 270) (length 5.08)
			  (name "hmeas" (effects (font (size 1.27 1.27))))
			  (number "6" (effects (font (size 1.27 1.27))))
			)
		ENDIF
		
</symbol_trafo_1phase> 
 

// ---- End of Part 2 - Transformers ----
// ---- Start of Part 2a - Transformer parts ----
<Component>
	<Description>
		A coupling between electrical and magnetical circuit. 
		That is a coil around a piece magnetic core.
		Usually used together with  the core model below.
		Necessary parameters are: num_turns
		Optional parameters: 
		- ohm is the serial coil resistance, default value is 0.01 Ohm. If set below zero, then no resistance.
		- henry is the coil inductivity, default value is -1 Henry. That is below zero, therefor by no henry by default. 
		- nom_volt is the voltage at which the animation of the induced voltage is displayed at maximal size.
		- factor_v_ind is the factor given out at an additional measuring pin, giving out the induced voltage. Zero by default, any other number enables that pin.
	</Description>
	<eeschema_sch>
		L magnetic:coupling
	</eeschema_sch>
	<Default_Values>
		num_turns=500 // 500 windings (and a default series resistance of 0.01 Ohm )
		num_turns=500 ohm=0.1 //500 windings with a coil resistance of 0.1 Ohm
		num_turns=500 ohm=0.1 henry=22m //500 windings with a coil of 0.1 Ohm and 22 milliHenry
		num_turns=500 nom_volt=400 // adds an animation drawing the induced voltage, size of drawing relative to 400 Volt.
		num_turns=500 factor_v_ind=1 // enables an output pin for the induced voltage by electro-magnetic coupling
		num_turns=500 ohm=0.1 henry=22m nom_volt=230 factor_v_ind=1 //all parameters
		
	</Default_Values>
	<eeschema_symbol>
		INCLUDE smbl_coupling
	</eeschema_symbol>
	<Spice>
		DEFINE [num_turns] AS_WORD_RIGHT OF:num_turns IN:[value]
		DEFINE [num_turns] AS_NUMBER OF:[num_turns]
		
		DEFINE [ohm] AS_WORD_RIGHT OF:ohm IN:[value]
		DEFINE [ohm] AS_NUMBER OF:[ohm]
		IF ! [ohm] IS_NUMBER THEN DEFINE [ohm] 0.01 ENDIF
	
		DEFINE [henry] AS_WORD_RIGHT OF:henry IN:[value]
		DEFINE [henry] AS_NUMBER OF:[henry] 
		IF ![henry] IS_NUMBER THEN DEFINE [henry] -1 ENDIF
		
		DEFINE [nom_volt] AS_WORD_RIGHT OF:nom_volt IN:[value]
		DEFINE [nom_volt] AS_NUMBER OF:[nom_volt]
		IF [nom_volt] EQUAL_TO 0 THEN DEFINE [nom_volt] AS_NULL ENDIF
	
		// coil model based on cm_lcouple
		.subckt sub_lcouple_[individual] coil_in coil_out mag_up mag_dn  IF [factor_v_ind] LOWER_OR_HIGHER_THAN 0 THEN induced ENDIF
			
			// 1 Preparation: measurement devices
			Vmeas_magflow mag_up  mag_mup  DC 0
			Vmeas_current coil_in coil_min DC 0
			
			// 2 model itself
			.model mdl_lcouple_[individual] lcouple (num_turns=[num_turns])  
			a_[individual] (coil_min mid) (mag_mup mag_dn) mdl_lcouple_[individual] // coil based on lcouple model in ngspice
			// 
			
			// electric series resistance (for stability)
			IF [ohm] IS_NUMBER && [ohm] HIGHER_THAN 0 THEN
				IF [henry] IS_NUMBER &&  [henry] HIGHER_THAN 0 THEN
				    r_s node_rl coil_out [ohm] // series resistance of the coil
					L_s node_rl mid [henry]
				ELSE
					r_s mid coil_out [ohm] // series resistance of the coil
				ENDIF
			ELSE
				IF [henry] IS_NUMBER &&  [henry] HIGHER_THAN 0 THEN
					L_s mid coil_out [henry]
				ELSE
					V_s mid coil_out DC 0 // direct connection without resistance (zero Volt source is direct connection)
				ENDIF
			ENDIF
			// variables for animation section
			IF [nom_volt] IS_NUMBER || [factor_v_ind] LOWER_OR_HIGHER_THAN 0 THEN
				B_diff n_phiturn 0 V=I(Vmeas_magflow)*[num_turns]*1E6 //1E6 factor to equal out the 1uF below.
				C_diff n_phiturn n_induced 1uF  //1uF=1/E6 F to keep the RC time constant low.
				R_diff n_induced 0 1
				
				IF [nom_volt] IS_NUMBER THEN
					.save v(n_induced) // differential voltage equivalent of dPhi/dt*num turns
				ENDIF
				IF [factor_v_ind] LOWER_OR_HIGHER_THAN 0 THEN
					B_induced_voltage induced 0 V=[factor_v_ind]*v(n_induced)
				ENDIF
				
				
				.save v(mid) // the other node of the cm_couple, needed to animate the induced voltage 
			ENDIF
		.ends
		// component:
		x_lcouple_[individual] [coil_in] [coil_out] [mag_up] [mag_dn] IF [factor_v_ind] LOWER_OR_HIGHER_THAN 0 THEN [induced] ENDIF sub_lcouple_[individual]
	</Spice>
	<animation>
		IF [nom_volt] IS_NUMBER THEN
			// get actual induced voltage:
			//DEFINE [v_act1] V[coil_in] 
			//DEFINE [v_act2] AS_ACTUAL OF:x_lcouple_[individual].mid
			//DEFINE [v_acti] AS_MATH_SUB OF:[v_act1] AND:[v_act2] // induced voltage 
			DEFINE [v_acti] AS_ACTUAL OF:x_lcouple_[individual].n_induced
			DEFINE [v_acti] AS_DECIMAL_FORMAT OF:[v_acti] FORM:#.#
			// calculate coordinates:
			
			DEFINE [height] AS_MATH_MUL OF:[v_acti] AND:150
			DEFINE [height] AS_MATH_DIV OF:[height] AND:[nom_volt]
			IF ![height] THEN DEFINE [height] 0 ENDIF
			IF [height] HIGHER_THAN 150 THEN DEFINE [height] 150 ENDIF //maximal limit
			IF [height] LOWER_THAN -150 THEN DEFINE [height] -150 ENDIF // minimal limit
			
			DEFINE [starty] AS_MATH_DIV OF:[height] AND:-2
			// round coordinates to integer values
			DEFINE [height] AS_MATH_ROUND OF:[height]
			DEFINE [starty] AS_MATH_ROUND OF:[starty]
			DEFINE [minusy] AS_MATH_MUL OF:[starty] AND:-1 
		
		
		
			IF [starty] IS_NUMBER THEN
				// draw:
				<Text -250 0 50 #000080 0 "U=[v_acti] V">
				<Ellipse -200 [starty] 100 [height] #000080 1 1 #000080 2 0> //rotating volatage circle
				<Line -150 [starty] 0 [height] #000080 2 1>                  //and its line
				// plus symbol:
				<Line -250 [starty]  40 0  #FF0000 2 1> 
				<Line -230 [starty]  0  20 #FF0000 2 1>
				<Line -230 [starty]  0 -20 #FF0000 2 1>
				// minus symbol:
				<Line -250 [minusy] 40 0 #0000FF 2 1>
				

			ENDIF
			
		ENDIF
	</animation>
</Component>  


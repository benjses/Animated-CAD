 <standex_dip> 
    //    L Relay:DIPxx-1Axx-11x //https:standexelectronics.com/wp-content/uploads/datasheet_reed_relay_DIP.pdf  
    //    ALIAS Relay:DIPxx-1Axx-12x Relay:DIPxx-1Axx-13x Relay:DIPxx-1Cxx-51x Relay:DIPxx-2Axx-21x
    
            //                           [nr_switches] v    v[switch_type] (A->NO B->NC C->CO)
            //              DIP|<--[volt_n]------->|-|<->|[<---->|| switch model |-|pinout||option|
        IF[modeltype]MATCHESDIP((05)|(12)|(15)|(24))-[1-2][a-cA-C]((72)|(75)|(90))-[0-9]{2}[a-zA-Z]*THENELSE
            <Dialog type="error">You have chosen the component at ([xpos]|[ypos]) to be a relay of the series  [model].
            Please set the value to one of the available ones, in order to specify, which kind of this series 
            you want to select:
            
            DIPnn-qFmm-ppO
            
            where:
            nn is the nominal voltage in two digits: 05 12 15 or 24
            q is the number of switches in one digit: 1 or 2
            F is the contact form in one letter: A B or C (A=normally Open , B=Normally Closed , C=Changeover)
            mm is the switch model in two digits: 72 75 or 90
            pp is the pin out in two digits: 10 11 12 13 19 21 or 51
            O at the end is the option, and is optional. can be A B C L D E F , but is ignored
            
            For example, DIP05-1A72-10 is a valid type. But the type given, [modeltype] is not.
            You can find the datasheet with this part description at [datasheet]
            </Dialog>
        ENDIF
        
        DEFINE [coil_direction] TopNeg_PosBottom //top negative -bottom positive (when not rotated or mirrored)
        DEFINE [volt_n] AS_SUBSTRING FROM:3 TO:5 OF:[modeltype]
        DEFINE [nr_switches] AS_SUBSTRING FROM:6 TO:7 OF:[modeltype]
        
        DEFINE [switch_type] AS_SUBSTRING FROM:7 TO:8 OF:[modeltype]
        IF [switch_type]EQUAL_TO A || [switch_type] EQUAL_TO a THEN DEFINE [switch_type] NO ENDIF
        IF [switch_type]EQUAL_TO B || [switch_type] EQUAL_TO b THEN DEFINE [switch_type] NC ENDIF
        IF [switch_type]EQUAL_TO C || [switch_type] EQUAL_TO c THEN DEFINE [switch_type] CO ENDIF
        
        //DEFINE [ohm_coil] and [volt_set] and [volt_reset] depending on [volt_n]:
        IF[modeltype]MATCHESDIP[0-9]{2}-1[a-bA-B][0-9]{2}-[0-9]{2}[a-zA-Z]*THEN 
            IF[volt_n] EQUAL_TO 05 THEN 
                IF[modeltype]MATCHESDIP[0-9]{2}-[1-2][aA]75-[0-9]{2}[a-zA-Z]*THEN 
                    DEFINE [ohm_coil] 200
                ELSE
                    DEFINE [ohm_coil] 500
                ENDIF
                DEFINE [volt_set] 3.5
                DEFINE [volt_reset] 0.75
            ELSEIF [volt_n] EQUAL_TO 12 THEN 
                DEFINE [ohm_coil] 1000
                DEFINE [volt_set] 8.4
                DEFINE [volt_reset] 1.8
            ELSEIF [volt_n] EQUAL_TO 15 THEN 
                DEFINE [ohm_coil] 2000
                DEFINE [volt_set] 10.5
                DEFINE [volt_reset] 2.2
            ELSEIF [volt_n] EQUAL_TO 24 THEN
                DEFINE [ohm_coil] 2000
                DEFINE [volt_set] 16.8
                DEFINE [volt_reset] 3.6
            ELSE <Dialog type="error">ohm_coil and [volt_set] and [volt_reset] for component [name] [value] not defined</Dialog>//TODO make message more specific!
            ENDIF ENDIF ENDIF ENDIF 
        ELSEIF[modeltype]MATCHESDIP[0-9]{2}-[1-2][cC][0-9]{2}-[0-9]{2}[a-zA-Z]*THEN 
            IF[volt_n] EQUAL_TO 05 THEN
                DEFINE [ohm_coil] 200
                DEFINE [volt_set] 3.5
                DEFINE [volt_reset] 0.75
            ELSEIF[volt_n] EQUAL_TO 12 THEN
                DEFINE [ohm_coil] 500
                DEFINE [volt_set] 8.4
                DEFINE [volt_reset] 1.8
            ELSEIF[volt_n] EQUAL_TO 15 THEN
                DEFINE [ohm_coil] 2000
                DEFINE [volt_set] 10.5
                DEFINE [volt_reset] 2.2
            ELSEIF[volt_n] EQUAL_TO 24 THEN
                DEFINE [ohm_coil] 2000
                DEFINE [volt_set] 16.8
                DEFINE [volt_reset] 3.6
            ELSE <Dialog type="error">ohm_coil and [volt_set] and [volt_reset] for component [name] [value] not defined</Dialog>//TODO make message more specific!
            ENDIF ENDIF ENDIF ENDIF 
        ENDIFENDIF 
    </standex_dip>

    <AZ850>
     //   L Relay:AZ850-x 
     //   L Relay:AZ850P1-x 
        IF[modeltype]MATCHESAZ850(P1)?-((3)|(5)|(6)|(9)|(12)|(24))THEN
            DEFINE [coil_direction] BottomNeg_PosTop
            DEFINE [switch_type] CO
            DEFINE [nr_switches] 2
            IF[modeltype]CONTAINS P1 THEN
                DEFINE [volt_n]            AS_SUBSTRING FROM:8 OF:[modeltype]
                DEFINE [volt_reset]        [volt_n]*-0.75 //reset needs current in inverse direction. equivalent to [volt_set] below
                IF [volt_n]HIGHER_THAN 12 THEN
                    DEFINE [volt_destroy_coil] [volt_n]*2.4 // 57.6V/24V=2.4
                    DEFINE [ohm_coil] (6.67*[volt_n]*[volt_n])
                ELSE
                    DEFINE [volt_destroy_coil] [volt_n]*2.9  //2.9 = 8.7V/3V = 14.5V/5V = 17.4V/6V = 26.1V/9V = 34.8V/12V
                    DEFINE [ohm_coil] (10*[volt_n]*[volt_n])
                ENDIF
            ELSE
                DEFINE [volt_n] AS_SUBSTRING FROM:6 OF:[modeltype]
                DEFINE [volt_reset] [volt_n]*0.3 //not specified in datasheet, assumed
                IF [volt_n]HIGHER_THAN 12 THEN
                    DEFINE [volt_destroy_coil] [volt_n]*2 // 48V/24V=2
                    DEFINE [ohm_coil] (7.14*[volt_n]*[volt_n])
                ELSE
                    DEFINE [volt_destroy_coil] [volt_n]*2.5  //2.5 = 7.5V/3V = 12.5V/5V = 15V/6V = 22.5V/9V = 30V/12V
                ENDIF
                
            ENDIF
            DEFINE [volt_set] [volt_n]*0.75 // 2.3V/3V=0.77 3.8V/5V=6.8V/9V=0.76 4.5V/6V=9V/12V=18V/24V=0.75
        ELSE
            <Dialog type="error">You have chosen [name] to be a relay of the AZ850 series .
                Please set its type to one of the available ones, in order to specify which kind of this series 
                you want to select:
            
                AZ850-x or AZ850P1-x
            
                where:
                AZ850- are the single side stable relays,
                AZ850P1- are the bistable (latching ) relays, and
                x is the nominal VDC voltage, one of the values: 3 5 6 9 12 24
            
                For example, AZ850-5 or AZ850P1-24 are valid values. But the type given, [modeltype] is not.
                You can find the datasheet with this part description at [datasheet].
                
                (If you want to use the relay with two coils, AZ850P2-x, you need to select that component in the schematic editor.)
            </Dialog>
        ENDIF
    </AZ850>

// ---- End of Part 1 - Relays ----
// ---- Start of Part 2 - Transformers ----
 
<Component>
	<Description>
		IF [language] EQUAL_TO de
		THEN Ein Transformator.
				Mit einem einfachen Modell des Magnetkerns, das einfach nur aus einer Kopplungskonstante besteht.
				Der Trafo besteht aus einer Primärspule, einer Sekundärspule und einer magnetischen Kopplung ("Kern") zwischen diesen Spulen.
				-- Parameter --
				L1 und L2 sind die Spulenwerte in Henry auf der Primär- und Sekundär-Seite.
				cpl ist die Kopplungskonstante zwischen den beiden Spulen. Ein Wert zwischen 0=keine Kopplung und 1=vollständige Kopplung. Üblicherweise ein Wert knapp unter 1. Oder sogar exakt 1 für ideale Modelle. Voreingestellt ist 1. 	
				R1 und R2 sind die Widerstände in den beiden Spulen in Ohm. Üblicherweise ein kleiner Wert. Voreingestellt ist jeweils 0.01=10milliOhm.
				
				Riso ist der Isolationswiderstand zwischen Primär- und Sekundär-Seite. Üblicherweise ein grosser Wert. Voreingestellt ist 1e12=1TeraOhm.
				
				(Jeder genannte interne Widerstand kann auf-1 gesetzt werden um ihn zu entfernen. 
				Entfernen heisst hier, dass R1 und R2 durch eine Verbindung mit null Ohm und Riso durch eine offene Klemme mit unendlich Ohm ersetzt werden.
				Davon wird aber abgeraten, da diese Widerstände für die numerische Berechnung der Ströme und Spannungen benötigt werden und daher Simulation in diesem Fall fehlschlagen könnte, ausser wenn Sie eine geeignete simulationsfähige externe Beschaltung einfügen.)
		ELSE A transformer. 
				With a simple model of the magnetic core, which consists simply of a coupling constant value. 
				The transformer consists of a primary coil, a secondary coil and a magnetic coupling ("core") between these coils.
				-- Parameters  --
				L1 and L2 are the coils' values in Henry. 
				cpl is the coupling constant between the both coils. A value between 0=no coupling and 1=full coupling. Usually a value a bit below 1. Or even exactly 1 for ideal models. Default value is 1.
				
				R1 and R2 are the Resistances of the both coils in Ohm. Usually a small value, default value is 0.01=10milliOhms each.	
				Riso is the isolation resistance between primary and secondary side in Ohm. Usually a large value, default value is 1e12=1TeraOhm.
				
				(Each mentioned internal resistor may be set to a negative value such as -1 in order to remove it. Remove means here that R1 and R2 are replaced by a zero Ohm connection line, and Riso is replaced by an infinite ohm open gap. But this is not recommended, because they are needed for the numerical calcuation of currents and voltages, and the simulation might fail in this case, unless you add an external circuitry suitable for simulation.)
		ENDIF
	</Description>
	 <eeschema_sch>
        L anicad:Transformer_simple
    </eeschema_sch>
	<Default_Values>
		L1=10H L2=1H //only the necessary parameters
		L1=10H L2=1H R1=100m R2=10m cpl=0.95 Riso=1E12 // all parameters
		L1=10H L2=1H R1=-1 R2=-1 Riso=-1 // removed internal resistors (simulation might fail here)
	</Default_Values>
	<eeschema_symbol>
		INCLUDE symbol_trafo_1phase
	</eeschema_symbol>
    <Spice>
		// -- parameter set A --> coupling model :
		DEFINE [henry1] AS_WORD_RIGHT OF:L1 IN:[value] // Primary inductance in Henry
		DEFINE [henry1] AS_NUMBER OF:[henry1]
		DEFINE [henry2] AS_WORD_RIGHT OF:L2 IN:[value]  // Secondary inductance in Henry
		DEFINE [henry2] AS_NUMBER OF:[henry2]

		IF [henry1] IS_NUMBER && [henry1] HIGHER_THAN 0 && [henry2] IS_NUMBER && [henry2] HIGHER_THAN 0 THENELSE
			<Dialog type="error" title="missing value for transformer coil">
				IF [language] EQUAL_TO de THEN
					Der Transformator hat keinen korrekten Wert für L1 und/oder L2.
					Bitte geben Sie ihm einen positiven numerischen Wert in Henry.
				ELSE
					The transformer misses a correct value for L1 and/or L2.
					Please give it a  positive numeric value in Henry. 
				ENDIF
			</Dialog>
		ENDIF
	
		DEFINE [cpl] AS_WORD_RIGHT OF:cpl IN:[value]  // Coupling coefficient. Value between 0 (no coupling) and 1 (full coupling).
		DEFINE [cpl] AS_NUMBER OF:[cpl]
		IF [cpl] IS_NUMBER THENELSE DEFINE [cpl] 1 ENDIF
		IF [cpl] LOWER_THAN 0 || [cpl] HIGHER_THAN 1 THEN
		<Dialog type="error" title="wrong value for transformer coupling">
				IF [language] EQUAL_TO de THEN
					Der Transformator hat keinen korrekten Wert für die Kopplungskonstante cpl.
					Bitte geben Sie ihm einen Wert zwischen 0 und 1, zum Beispiel cpl=0.9
				ELSE
					The transformer misses a correct value for the coupling constant cpl
					Please give it a value between 0 and 1, for example cpl=0.9
				ENDIF
			</Dialog>
		ENDIF
		
		DEFINE [ohm1] AS_WORD_RIGHT OF:R1 IN:[value]  // Resistance of primary winding in Ohm
		DEFINE [ohm1] AS_NUMBER OF:[ohm1]
		IF ![ohm1] THEN DEFINE [ohm1] 0.01 ENDIF // default value
		
		DEFINE [ohm2] AS_WORD_RIGHT OF:R2 IN:[value]  // Resistance of secondary winding in Ohm
		DEFINE [ohm2] AS_NUMBER OF:[ohm2]
		IF ![ohm2] THEN DEFINE [ohm2] 0.01 ENDIF // default value
		
		DEFINE [ohm_iso] AS_WORD_RIGHT OF:Riso IN:[value] // isolation resistance between primary and secondary side
		DEFINE [ohm_iso] AS_NUMBER OF:[ohm_iso]
		IF ! [ohm_iso] THEN DEFINE [ohm_iso] 1E12 ENDIF // default value
		DEFINE [ohm_iso_a] AS_MATH_MUL OF:[ohm_iso] AND:2 // there are two isolation resistances RisoA and RisoB. They are parallel, therefor the value must be multiplied by two.
		DEFINE [ohm_iso_b] [ohm_iso_a] // same
				
		// subcircuit:
		.subckt transformer_simple_[individual] priA priB sekA sekB
			
			// Primary side
			L1 priA priMid [henry1] // Primary coil inductance
			R1 priMid priB [ohm1]   // Primary parasitic resistance

			// Secondary side
			L2 sekA sekMid [henry2] // Secondary coil inductance
			R2 sekMid sekB [ohm2]   // Secondary parasitic resistance

			// Coupling between the inductors
			K1 L1 L2 [cpl] 
			
			// finite isolation resistance, mostly for Stability of the simulation, but also for realism:
			IF [ohm_iso_a] IS_NUMBER && [ohm_iso_a] HIGHER_THAN 0 THEN
				RisoA priA sekA [ohm_iso_a]
			ENDIF
			IF [ohm_iso_b] IS_NUMBER && [ohm_iso_b] HIGHER_THAN 0 THEN
				RisoB priB sekB [ohm_iso_b] 
			ENDIF
		.ends

		// instance of subcircuit:
		X_trafo_[individual] [priA] [priB] [sekA] [sekB] transformer_simple_[individual]
	</Spice>
</Component>

<Component>
	<Description>
		IF [language] EQUAL_TO de
		THEN Ein Transformator.
				Mit einem Hysteresemodell für den Kern.
				Besteht aus einer Primärspule, einer Sekundärspule und einer magnetischen Kopplung ("Kern") zwischen diesen Spulen.
				
				-- Parameter --
				n1 und n2 sind die Anzahl der Spulen-Windungen auf der Primär- und Sekundär-Seite.
				area ist die Grösse der Schnittfläche des Kerns in Quadratmeter.
				length ist die Länge des Kerns in Meter.
				
				core ist das Material des Kerns. Das ist ein optionaler parameter - voreingestellt ist esteel.
				Die zulässigen Werte für core sind: iron esteel sfer hfer metglas mumetal air indi :
				esteel steht für Elektrostahl, das üblichste Material für Transformatorkerne. Auch Elektroblech genannt. 
				iron steht für Eisen welches früher oft in Trafos verwendet wurde. Hat etwas schlechtere Werte als esteel. 
				sfer steht für Standard-Ferrit bzw. Soft-Ferrit oder chemisch MnZn
				hfer steht für Hart-Ferrit oder chemisch BaFe	
				metglas steht für metallisches Glas, eine amorphe Legierung
				mumetal steht für Mu-Metall
				air steht für Luft- was eine sehr schlechte Wahl für einen Trafo wäre, weil kaum magnetisierbar.
				indi steht für individuell, hier müssen Sie ihre eigenen Parameter eingeben - Siehe Beispiel und ngspice user manual.	
			
				R1 und R2 sind die Widerstände in den beiden Spulen in Ohm. Üblicherweise ein kleiner Wert. Voreingestellt ist jeweils 0.01=10mΩ.
				Riso ist der Isolationswiderstand zwischen Primär- und Sekundär-Seite. Üblicherweise ein grosser Wert. Voreingestellt ist 1e12=1TeraOhm				
					(Jeder genannte interne Widerstand kann auf-1 gesetzt werden um ihn zu entfernen. 
				Entfernen heisst hier, dass R1 und R2 durch eine Verbindung mit null Ohm und Riso durch eine offene Klemme mit unendlich Ohm ersetzt werden.
				Davon wird aber abgeraten, da diese Widerstände für die numerische Berechnung der Ströme und Spannungen benötigt werden und daher Simulation in diesem Fall fehlschlagen könnte, ausser wenn Sie eine geeignete simulationsfähige externe Beschaltung einfügen.)
				
				Dieses Modell basiert auf dem "Magnetic Core" kurz cm_core im ngSpice Handbuch. Hier ist mode=2 für Hysteresemodus gesetzt.
		ELSE A transformer. 
				With a hyteresis model for the magnetic core 
				Consists of a primary coil, a secondary coil and a magnetic coupling ("core") between these coils.
				
				-- Parameters --
				n1 and n2 are the number of coil turns on the primary and Secondary side.
				area is the size of the core's area in square-meters.
				length is the length of the core in meters.
				
				core is the material of the core, it  is an optional parameter- Default value is esteel.
				The allowed values for core are: esteel iron sfer hfer metglas mumetal air indi
				esteel stands for electrical steel, which is the most common material for transformers.
				iron stands for iron, which was used in old trafos. Has slightly worse values than esteel.
				sfer stands for standard ferrite or soft ferrite, chemically MnZn
				hfer stands for hard ferrite, chemically BaFe
				metglas stands for metallic glass, an amorphous material.
				mumetal stands for mu-metal.
				air stands for air- which is a really bad choice for a trafo, since barely magnetizeable.
				indi stands for individually, here you need to enter your own parameters - see example and ngspice user manual.
				)
				
				R1 and R2 are the Resistances of the both coils in Ohm. Usually a small value, default value is 0.01=10mΩ each.	
				Riso is the isolation resistance between primary and secondary side in Ohm. Usually a large value, default value is 1e12=1TeraOhm.
				(Each mentioned internal resistor may be set to a negative value such as -1 in order to remove it. Remove means here that R1 and R2 are replaced by a zero Ohm connection line, and Riso is replaced by an infinite ohm open gap. But this is not recommended, because they are needed for the numerical calcuation of currents and voltages, and the simulation might fail in this case, unless you add an external circuitry suitable for simulation.)
				
				This Model is based on the "Magnetic Core" short cm_core in the ngspice user manual. Here is selected mode=2 for hysteresis mode.
		ENDIF		
	</Description>
	 <eeschema_sch>
        L anicad:Transformer_hysteresis
    </eeschema_sch>
	<Default_Values>
		N1=310 N2=155 // necessary parameters, only numbers of coil winding turns
		N1=310 N2=155 area=0.01 length=0.01 core=iron R1=0.1 R2=0.05 Riso=10G // all parameters 
		N1=310 N2=155 core=indi in_low=-7.0 in_high=7.0 out_lower_limit=-2.1 out_upper_limit=2.1 hyst=0.2 // individual hysteresis curve according to cm_core in the ngspice user manual.
	</Default_Values>
	<eeschema_symbol>
		INCLUDE symbol_trafo_1phase
	</eeschema_symbol>
    <Spice>
		INCLUDE core_hyst_parameters
	
		// define windings n1 and n2
		DEFINE [n1] AS_WORD_RIGHT OF:N1 IN:[value] // number of primary coil windings
		DEFINE [n1] AS_NUMBER OF:[n1]
		DEFINE [n1] AS_MATH_ROUND OF:[n1]
		DEFINE [n2]	AS_WORD_RIGHT OF:N2 IN:[value] // number of secondary coil windings
		DEFINE [n2] AS_NUMBER OF:[n2]
		DEFINE [n2] AS_MATH_ROUND OF:[n2]
		IF [n1] IS_NUMBER && [n2] IS_NUMBER && [n1] HIGHER_THAN 0 && [n2] HIGHER_THAN 0 THENELSE 
			<Dialog type="error" title="missing or wrong number of turns for transformer">
			  IF [language] EQUAL_TO de THEN Der Transformator mit Hysteresemodell benötigt Werte für die Windungszahlen n1 und n2.
				Bitte geben Sie ihm dafür positive ganze Zahlen, z.B. n1=310 n2=155
			  ELSE The transformer with hysteresis model needs values for the numbers of turns n1 and n2.
				Please give it positive integer numbers for example n1=310 n2=155
			  ENDIF
			</Dialog>
		ENDIF
		
		DEFINE [area] AS_WORD_RIGHT OF:area IN:[value] // area of the magnetic core
		DEFINE [area] AS_NUMBER OF:[area]
		IF ![area] IS_NUMBER THEN DEFINE [area] 0.1 ENDIF
		DEFINE [length] AS_WORD_RIGHT OF:length IN:[value] // length of the magnetic core
		DEFINE [length] AS_NUMBER OF:[length]
		IF ![length] IS_NUMBER THEN DEFINE [length] 0.1 ENDIF
		
		DEFINE [ohm1] AS_WORD_RIGHT OF:R1 IN:[value]  // Resistance of primary winding in Ohm
		DEFINE [ohm1] AS_NUMBER OF:[ohm1]
		IF ![ohm1] THEN DEFINE [ohm1] 0.01 ENDIF // default value
		
		DEFINE [ohm2] AS_WORD_RIGHT OF:R2 IN:[value]  // Resistance of secondary winding in Ohm
		DEFINE [ohm2] AS_NUMBER OF:[ohm2]
		IF ![ohm2] THEN DEFINE [ohm2] 0.01 ENDIF // default value
		
		DEFINE [ohm_iso] AS_WORD_RIGHT OF:Riso IN:[value] // isolation resistance between primary and secondary side
		DEFINE [ohm_iso] AS_NUMBER OF:[ohm_iso]
		IF ! [ohm_iso] THEN DEFINE [ohm_iso] 1E12 ENDIF // default value
		DEFINE [ohm_iso_a] AS_MATH_MUL OF:[ohm_iso] AND:2 // there are two isolation resistances RisoA and RisoB. They are parallel, therefor the value must be multiplied by two.
		DEFINE [ohm_iso_b] [ohm_iso_a] // same
			
		.subckt transformer_b_[individual] priA priB sekA sekB 
			// primary side: (see lcouple model in chapter 8.2.18 "inductive coupling")
			a1 (priA priMid) (mmf_pri 0) primary
			.model primary lcouple (num_turns=[n1])
			
			IF [ohm1] IS_NUMBER && [ohm1] HIGHER_THAN 0 THEN R1 priMid priB [ohm1]  // Primary parasitic resistance
			ELSE VR1 priMid priB DC 0 ENDIF // zero volt dc source is a direct connection instead of the resistor
			// secondary side:
			a2 (sekA sekMid) (mmf_sec 0) secondary
			.model secondary lcouple (num_turns=[n2])
			
			IF [ohm2] IS_NUMBER && [ohm2] HIGHER_THAN 0 THEN R2 sekMid sekB [ohm2] // Secondary parasitic resistance
			ELSE VR2 sekMid sekB DC 0 ENDIF
			// magnetic core as coupling between the two sides: (see core model in chapter 8.2.19 "magnetic core")
			a3 (mmf_pri mmf_sec) magnetic_core 
			.model magnetic_core core  ( 
				+ mode=2
				+ in_low=[in_low] in_high=[in_high] // H values in A/m
				+ out_lower_limit=[out_lower_limit] out_upper_limit=[out_upper_limit] // B-values in Tesla
				+ hyst=[hyst] // hysteresis in Tesla
				+ area=[area] length=[length]
				+ H_array=[-1000 1000] B_array=[-1 1] // values only added because needed for simulation to avoid error message for missing parameter. They have no meaning when mode=2.
			+ ) // end of magnetic core
			
			// finite isolation resistance, mostly for Stability of the simulation:
			IF [ohm_iso_a] IS_NUMBER && [ohm_iso_a] HIGHER_THAN 0 THEN
				RisoA priA sekA [ohm_iso_a]
			ENDIF
			IF [ohm_iso_b] IS_NUMBER && [ohm_iso_b] HIGHER_THAN 0 THEN
				RisoB priB sekB [ohm_iso_b] 
			ENDIF

		.ends
		// Instantiate the transformer subcircuit:
		X_trafo_[individual] [priA] [priB] [sekA] [sekB] transformer_b_[individual]
	</Spice>
</Component>
 
<core_hyst_parameters> // parameters for cm_core mode=2 models
	// define core material:
	DEFINE [core] AS_WORD_RIGHT OF:core IN:[value] // the material of the magnetic core
	DEFINE [core] AS_LOWERCASE OF:[core]
	IF ![core] THEN DEFINE [core] esteel ENDIF // default core material = electrical steel(en) = Elektrostahl(de) 
	
	IF [core] EQUAL_TO esteel THEN
			// default core material is electrical steel short eSteel, in german Elektrostahl oder Elektroblech :				
			// FeSi (chemical formula, steel with silicone addition for less power losses than standard iron)
			// see at www.en.wikipedia.org/wiki/Electrical_steel
			// siehe  www.de.wikipedia.org/wiki/Elektroblech
			// this material is used by default unless other material is specified, because it is the most used material for transformers.
			// but there are many types of esteel in reality, with different parameters, therefor this is just an approximation:
		DEFINE [in_low] -6.0 
		DEFINE [in_high] 6.0 
		DEFINE [out_lower_limit] -1.7 
		DEFINE [out_upper_limit] 1.7 
		DEFINE [hyst] 0.5
	ELSE IF [core] EQUAL_TO iron THEN  // en: Soft iron, see at www.en.wikipedia.org/wiki/Magnetic_core#Soft_iron 
								  // de: Weicheisen, siehe www.de.wikipedia.org/wiki/Weicheisen
		DEFINE [in_low]  -7.0
		DEFINE [in_high] 7.0
		DEFINE [out_lower_limit] -2.1
		DEFINE [out_upper_limit] 2.1
		DEFINE [hyst] 0.2
		
	ELSE IF [core] EQUAL_TO sfer THEN // standard ferrite or soft ferrite, MnZn (chem.) 
		DEFINE [in_low] -3.0
		DEFINE [in_high] 3.0
		DEFINE [out_lower_limit] -0.45
		DEFINE [out_upper_limit] 0.45
		DEFINE [hyst] 0.7
		
	ELSE IF [core] EQUAL_TO hfer THEN // hard ferrite, permanent magnet, BaFe (chem.)
		DEFINE [in_low] -20.0 
		DEFINE [in_high] 20.0
		DEFINE [out_lower_limit] -0.4
		DEFINE [out_upper_limit] 0.4
		DEFINE [hyst] 3.5
	
	ELSE IF [core] EQUAL_TO metglas THEN // amorphe legierung = metallisches Glas (z.B. MetGlas)
										// (de) siehe www.de.wikipedia.org/wiki/Metallisches_Glas
		DEFINE [in_low] -5.0
		DEFINE [in_high] 5.0
		DEFINE [out_lower_limit] -1.2
		DEFINE [out_upper_limit] 1.2 
		DEFINE [hyst] 0.15
	ELSE IF [core] EQUAL_TO mumetal THEN // Mumetall:
			// weichmagnetische Legierung mit sehr hoher Permeabilität, siehe  www.de.wikipedia.org/wiki/Mu-Metall
			// soft ferromagnetic alloy with very high permeability,  see at www.en.wikipedia.org/wiki/Mu-metal
		DEFINE [in_low] -2.0
		DEFINE [in_high] 2.0
		DEFINE [out_lower_limit] -0.8 
		DEFINE [out_upper_limit] 0.8 
		DEFINE [hyst] 0.05
	
	ELSE IF [core] EQUAL_TO air THEN // Air (en) / Luft (de)
			// a really bad choice for a magnetic core. But it can be simulated, so why not?
			// TODO: a linear model would be more realistic than a s-shaped hyseresis model.
		DEFINE [in_low] -1.0 
		DEFINE [in_high] 1.0 
		DEFINE [out_lower_limit] -1e-6 
		DEFINE [out_upper_limit] 1e-6 
		DEFINE [hyst] 0.01
	ELSE IF [core] EQUAL_TO indi THEN // own individual parameters
		DEFINE [in_low] AS_WORD_RIGHT OF:in_low IN:[value]
		DEFINE [in_high]  AS_WORD_RIGHT OF:in_high IN:[value] 
		DEFINE [out_lower_limit]  AS_WORD_RIGHT OF:out_lower_limit IN:[value]
		DEFINE [out_upper_limit]  AS_WORD_RIGHT OF:out_upper_limit IN:[value]
		DEFINE [hyst] 0.01
	ELSE 	
		// Nothing to do here, the parameters are not defined in this case and the
		// check below will make a dialog.
	ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF

	// check for allowed values for core material
	IF [in_low] IS_NUMBER && [in_high] IS_NUMBER && [out_lower_limit] IS_NUMBER && [out_upper_limit] IS_NUMBER && [hyst] IS_NUMBER   
	THENELSE
		<Dialog title="core material not defined correctly" type="warning">
			IF [language] EQUAL_TO de THEN Das material eines Transformatorenkerns hat einen ungültigen Wert:[core]
				Bitte geben Sie dem Trafo einen gültigen Wert für den core Parameter. Die gültigen Werte stehen in der Beschreibung des Bauteils.
			ELSE The material for a transfomer's core is set to an invalid value: [core]
				Please give an allowed value for that transformer's core parameter. The valid values are in the description of that component.
			ENDIF
		</Dialog>
	ENDIF
</core_hyst_parameters> 
		
<core_hmmodel_parameters> // parameters for cores with a combined h_and_m model. (based on a pwl as in mode=1 but with a combination of h and m to create a hysteresis)
	// Parameters are:
	// 1 [tau] , 2 [h_array], 3 [b_array], 4 [share_h_to_b], and 5 [share_m_to_b]  	
	// tau is the time in which the magnetic core gets magnetized in seconds. Typically some milli or micro seconds.
	// h_array and b_array define the input and output of the h-b-curve as pwl function. (Without hysteresis yet - that's added by the following parameters)
	// permanent_h defines the coercitive field strength Hc of the material, and therefor the "width" of the hysteresis.
	// share_h_to_b and share_m_to_b are the shares at which the H-Field and magnetisation values are combined to calculate the B-field value. Sum should be 1, such as 0.8 and 0.2

	// define core material:
	DEFINE [core] AS_WORD_RIGHT OF:core IN:[value] // the material of the magnetic core
	DEFINE [core] AS_LOWERCASE OF:[core]
	IF ![core] THEN DEFINE [core] esteel ENDIF // default core material = electrical steel(en) = Elektrostahl(de) 
	
	// define parameters according to core material:
	
	IF [core] EQUAL_TO esteel THEN
		// FeSi (chemical formula, steel with silicone addition for less power losses than standard iron)
		// see at www.en.wikipedia.org/wiki/Electrical_steel
		// siehe  www.de.wikipedia.org/wiki/Elektroblech
		// this material is used by default unless other material is specified, because it is the most used material for transformers.
		// but there are many types of esteel in reality, with different parameters, therefor this is just an approximation:
		DEFINE [tau] 0.2ms  
		DEFINE [permanent_h] 1 // permanent magnetisation M is ampereturns per meter ...
		DEFINE [share_m_to_b] 0.5 // ... times 0.5, which equals to 100 A1/m 
		DEFINE [b_max] 2.05 
		DEFINE [h_max] 800
		DEFINE [harr_phys] [-800.000 -752.940 -705.880 -658.820 -611.760 -564.710 -517.650 -470.590 -423.530 -376.470 -329.410 -282.350 -235.290 -188.240 -141.180 -94.1200 -47.0600 0.0 47.0600 94.1200 141.180 188.240 235.290 282.350 329.410 376.470 423.530 470.590 517.650 564.710 611.760 658.820 705.880 752.940 800.0]
		DEFINE [barr_phys] [-2.04991 -2.04989 -2.04985 -2.04974 -2.04946 -2.04872 -2.04701 -2.04311 -2.03502 -2.02052 -1.99617 -1.95630 -1.89229 -1.79220 -1.64078 -1.42178 -1.11946 0.0 1.11946 1.42178 1.64078 1.79220 1.89229 1.95630 1.99617 2.02052 2.03502 2.04311 2.04701 2.04872 2.04946 2.04974 2.04985 2.04989 2.04991]
	
	ELSE IF [core] EQUAL_TO iron THEN
		// en: Soft iron, see at www.en.wikipedia.org/wiki/Magnetic_core#Soft_iron 
		// de: Weicheisen, siehe www.de.wikipedia.org/wiki/Weicheisen
		DEFINE [tau] 2ms
		DEFINE [permanent_h] 100
		DEFINE [share_m_to_b] 0.5
		DEFINE [b_max] 1.6 // saturation at 1.6T (But dont write T here, the compiler would think that's Tera=10^12)
		DEFINE [h_max] 800 // saturation is reached at 800 A/m
		DEFINE [harr_phys] [-800.0   -752.94  -705.88  -658.82  -611.76  -564.70  -517.65  -470.59  -423.53  -376.47  -329.41  -282.35  -235.29  -188.24  -141.18  -94.12   -47.06   0.0 47.06   94.12   141.18  188.24  235.29  282.35  329.41  376.47  423.53  470.59  517.65  564.70  611.76  658.82  705.88  752.94  800.0]
		DEFINE [barr_phys] [-1.59985 -1.59974 -1.59953 -1.59915 -1.59847 -1.59725 -1.59505 -1.59110 -1.58401 -1.57133 -1.54873 -1.50884 -1.43950 -1.32214 -1.13215 -0.84580 -0.45747 0.0 0.45747 0.84580 1.13215 1.32214 1.43950 1.50884 1.54873 1.57133 1.58401 1.59110 1.59505 1.59725 1.59847 1.59915 1.59953 1.59974 1.59985]

	ELSE IF [core] EQUAL_TO sfer THEN // standard ferrite or soft ferrite, MnZn (chem.) 
		DEFINE [tau] 10us
		DEFINE [permanent_h] 300 // x0.5=150 A1/m
		DEFINE [share_m_to_b] 0.5
		DEFINE [b_max] 0.4 // Saturation at 0.4 Tesla
		DEFINE [h_max] 300 // A/m
		DEFINE [harr_phys] [-800.0   -752.94  -705.88  -658.82  -611.76  -564.71  -517.65  -470.59  -423.53  -376.47  -329.41  -282.35  -235.29  -188.24  -141.18  -94.12   -47.06   0.0 47.06   94.12   141.18  188.24  235.29  282.35  329.41  376.47  423.53  470.59  517.65  564.71  611.76  658.82  705.88  752.94  800.0]
		DEFINE [barr_phys] [-0.39999 -0.39999 -0.39999 -0.39999 -0.39999 -0.39998 -0.39997 -0.39992 -0.39979 -0.39942 -0.39848 -0.39624 -0.39133 -0.38123 -0.36137 -0.32425 -0.26062 0.0 0.26062 0.32425 0.36137 0.38123 0.39133 0.39624 0.39848 0.39942 0.39979 0.39992 0.39997 0.39998 0.39999 0.39999 0.39999 0.39999 0.39999]		
	
	ELSE IF [core] EQUAL_TO hfer THEN // hard ferrite, permanent magnet, BaFe (chem.)
		DEFINE [tau] 5m
		DEFINE [permanent_h] 6000 //x0.5=3000 A1/m
		DEFINE [share_m_to_b] 0.5
		DEFINE [b_max] 0.4
		DEFINE [h_max] 11000
		DEFINE [harr_phys] [-11000 -10000 -7500 -5000 -2500 0 2500 5000 7500 10000 11000]
		DEFINE [barr_phys] [-0.4   -0.4   -0.38 -0.32 -0.15 0 0.15 0.32 0.38 0.4   0.4 ] 
	ELSE IF [core] EQUAL_TO metglas THEN // amorphe legierung = metallisches Glas (z.B. MetGlas)
									// (de) siehe www.de.wikipedia.org/wiki/Metallisches_Glas
		DEFINE [tau] 50u //s
		DEFINE [permanent_h] 60 // x0.5=30 A1/m
		DEFINE [share_m_to_b] 0.5 
		DEFINE [b_max] 1.56 // T
		DEFINE [h_max] 800 // A/m
		DEFINE [harr_phys] [-800.0   -752.94  -705.88  -658.82  -611.76  -564.71  -517.65  -470.59  -423.53  -376.47  -329.41  -282.35  -235.29  -188.24  -141.18  -94.12   -47.06   0.0 47.06   94.12   141.18  188.24  235.29  282.35  329.41  376.47  423.53  470.59  517.65  564.71  611.76  658.82  705.88  752.94  800.0]
		DEFINE [barr_phys] [-1.55999 -1.55997 -1.55992 -1.55979 -1.55944 -1.55862 -1.55670 -1.55232 -1.54236 -1.52277 -1.48818 -1.43106 -1.34152 -1.20721 -1.01584 -0.75858 -0.43278 0.0 0.43278 0.75858 1.01584 1.20721 1.34152 1.43106 1.48818 1.52277 1.54236 1.55232 1.55670 1.55862 1.55944 1.55979 1.55992 1.55997 1.55999]
		
	ELSE IF [core] EQUAL_TO mumetal THEN // Mumetall:
			// weichmagnetische Legierung mit sehr hoher Permeabilität, siehe  www.de.wikipedia.org/wiki/Mu-Metall
			// soft ferromagnetic alloy with very high permeability,  see at www.en.wikipedia.org/wiki/Mu-metal
			// parameters defined in www.sciencedirect.com/science/article/pii/S0168900220313012#tbl1
		DEFINE [tau] 100u
		DEFINE [permanent_h] 2.0 // x 0.5=1 A/m  as described in section 2. Material magnetic properties
		DEFINE [b_max] 0.8
		DEFINE [h_max] 160
		DEFINE [harr_phys] [-160.0  -150.59  -141.18  -131.76  -122.35  -112.94  -103.53  -94.12   -84.71   -75.29   -65.88   -56.47   -47.06   -37.65   -28.24   -18.82   -9.41     0.0  9.41    18.82    28.24    37.65  47.06    56.47 65.88   75.29   84.71    94.12  103.53  112.94  122.35  131.76  141.18  150.59  160.0]
		DEFINE [barr_phys] [-0.79994 -0.79992 -0.79988 -0.79979 -0.79959 -0.79918 -0.79841 -0.79702 -0.79442 -0.78950 -0.78088 -0.76656 -0.74389 -0.70968 -0.65968 -0.58845 -0.48841 0.0  0.48841 0.58845 0.65968 0.70968 0.74389 0.76656 0.78088 0.78950 0.79442 0.79702 0.79841 0.79918 0.79959 0.79979 0.79988 0.79992 0.79994]	
	ELSE IF [core] EQUAL_TO air THEN // Air (en) / Luft (de)
			// a really bad choice for a magnetic core. But it can be simulated, so why not?
			// TODO: a linear model would be more realistic than a s-shaped hyseresis model.
		
	ELSE IF [core] EQUAL_TO indi THEN // own individual parameters
		// parameters defined in the overwriting section below , nothing to do here.
	ELSE 	
		// Nothing to do here, the parameters are not defined in this case and the
		// check below will make a dialog.
	ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF ENDIF
	
	// allow overwriting of some parameters:
	IF [value] CONTAINS tau THEN    DEFINE [tau] AS_WORD_RIGHT OF:tau IN:[value] ENDIF
	IF [value] CONTAINS b_max THEN DEFINE [b_max] AS_WORD_RIGHT OF:b_max IN:[value] ENDIF
	IF [value] CONTAINS h_max THEN DEFINE [h_max] AS_WORD_RIGHT OF:h_max IN:[value] ENDIF
	IF [value] CONTAINS harr_phys THEN DEFINE [harr_phys] AS_SUBTEXT AFTER:harr_physFROM:[TO:]OF:[value] ENDIF
	IF [value] CONTAINS barr_phys THEN DEFINE [barr_phys] AS_SUBTEXT AFTER:barr_physFROM:[TO:]OF:[value] ENDIF
	IF [value] CONTAINS fraction  THEN DEFINE [fraction] AS_WORD_RIGHT OF:fraction IN:[value]  ENDIF
	IF [value] CONTAINS share_m_to_b THEN DEFINE [share_m_to_b] AS_WORD_RIGHT OF:share_m_to_b IN:[value] ENDIF
	IF [value] CONTAINS share_h_to_b THEN DEFINE [share_h_to_b] AS_WORD_RIGHT OF:share_h_to_b IN:[value] ENDIF
	
	IF [value] CONTAINS permanent_h THEN 
		DEFINE [word_temp] AS_WORD_RIGHT OF:permanent_h IN:[value]
		IF [word_temp] THEN
			IF[word_temp] STARTS_WITH material
				THEN // do nothing here, because the material parameter is  already defined above
				ELSE DEFINE [permanent_h] AS_WORD_RIGHT OF:permanent_h IN:[value] // normal value
			ENDIF
			DEFINE [word_temp] AS_NULL
		ENDIF
	ENDIF
	
	
	// processing of the values:
	DEFINE [tau] AS_NUMBER OF:[tau]
	DEFINE [b_max] AS_NUMBER OF:[b_max]
	DEFINE [h_max] AS_NUMBER OF:[h_max]
	DEFINE [permanent_h] AS_NUMBER OF:[permanent_h]

	IF [tau] IS_NUMBER && [b_max] IS_NUMBER && [h_max] IS_NUMBER && [permanent_h] IS_NUMBER THENELSE
		<Dialog type="error" title="undefined parameter for magnetic core">
			The magnetic core misses a necessary parameter:
				tau=[tau]
				b_max=[b_max]
				h_max=[h_max]
				permanent_h=[permanent_h]
			At least one of these parameters is not defined as a correct number.
			Please check the given value!
		</Dialog>
	ENDIF		

	// other parameters with a default value:
	IF ![share_h_to_b] IS_NUMBER THEN
		IF [share_m_to_b] IS_NUMBER THEN DEFINE [share_h_to_b] AS_MATH_SUB OF:1 AND:[share_m_to_b]
		ELSE DEFINE [share_h_to_b] 0.8 // default factor 0.8=80%
		ENDIF
	ENDIF
	IF ![share_m_to_b] IS_NUMBER THEN
		DEFINE [share_m_to_b] AS_MATH_SUB OF:1 AND:[share_h_to_b]  // default 1-0.8=0.2=20%
	ENDIF

	// check for allowed values for core material:
	IF [tau] IS_NUMBER && [permanent_h] IS_NUMBER    
	THENELSE
		<Dialog title="core material not defined correctly" type="warning">
			IF [language] EQUAL_TO de THEN Das material eines Transformatorenkerns hat einen ungültigen Wert:[core]
				Bitte geben Sie dem Trafo einen gültigen Wert für den core Parameter. Die gültigen Werte stehen in der Beschreibung des Bauteils.
			ELSE The material for a transfomer's core is set to an invalid value: [core]
				Please give an allowed value for that transformer's core parameter. The valid values are in the description of that component.
			ENDIF
		</Dialog>
	ENDIF
</core_hmmodel_parameters>


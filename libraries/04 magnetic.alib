		  (name "mag_dn" (effects (font (size 1.27 1.27))))
		  (number "4" (effects (font (size 1.27 1.27))))
		)
		// optional additional measuring pin for induced voltage
		 IF [factor_v_ind] LOWER_OR_HIGHER_THAN 0 THEN 
			(pin bidirectional line (at 7.62 0 180) (length 2.54)
			  (name "induced" (effects (font (size 1.27 1.27))))

		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type outline))
		)
		(polyline
		  (pts
			(xy -2.54 5.08)
			(xy -2.54 -5.08)
		  )
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type none))
		)
		(circle (center -6.35 2.54) (radius 0.8)
			  (stroke (width 0) (type default) (color 0 0 0 0))
			  (fill (type outline))
		)
		// secondary coil:
		(pin passive line (at 10.16 5.08 180) (length 7.62)
		  (name "sekA" (effects (font (size 1.27 1.27))))
		  (number "4" (effects (font (size 1.27 1.27))))
		)
		(pin passive line (at 10.16 -5.08 180) (length 7.62)
		  (name "sekB" (effects (font (size 1.27 1.27))))

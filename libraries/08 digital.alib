<Component>
	<Description>
		Three-input NAND gate.
		The input threshold is the midpoint of the configured supply levels:
		Vth = (vpos + vneg) / 2.
		An input voltage strictly above Vth is interpreted as HIGH; an input at or below Vth is LOW.
		The output is driven to vpos for HIGH and vneg for LOW.
		Enter optional supply levels in the value field, for example: vpos=5.0 vneg=0.0.
		If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
		These are ideal, zero-delay logic gates with electrical voltage levels, not transistor-level models.
	</Description>
	<eeschema_sch>
		L anicad:NAND3
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0
		vpos=3.3 vneg=0.0
		vpos=5.0 vneg=-5.0
	</Default_Values>
	<Spice>
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN
			DEFINE [vpos] AS_NUMBER OF:[vpos]
		ELSE
			DEFINE [vpos] 5.0
		ENDIF
		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN
			DEFINE [vneg] AS_NUMBER OF:[vneg]
		ELSE
			DEFINE [vneg] 0.0
		ENDIF
		B_[individual] [Y] 0 V=(!((V(A) > (([vpos]+[vneg])/2)) && (V(B) > (([vpos]+[vneg])/2)) && (V(C) > (([vpos]+[vneg])/2)))) ? [vpos] : [vneg]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -6.35 6.35) (end 6.35 -6.35)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin input line (at -10.16 5.08 0) (length 2.54)
			(name "A" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(pin input line (at -10.16 0.00 0) (length 2.54)
			(name "B" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(pin input line (at -10.16 -5.08 0) (length 2.54)
			(name "C" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(pin output line (at 10.16 0 180) (length 2.54)
			(name "Y" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "NAND3" (at 0 0 0) (effects (font (size 1.27 1.27))))
	</eeschema_symbol>

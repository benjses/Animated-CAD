// ---- Multiplexers ----
<Component>
	<Description>
		Two-input multiplexer. Select input S chooses A when S is LOW and B when S is HIGH.
		Each input is interpreted as HIGH when its voltage is strictly above the threshold
		Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
		The output is driven to vpos for HIGH and vneg for LOW.
		Enter optional supply levels in the value field, for example: vpos=5.0 vneg=0.0.
		If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
		This is an ideal, zero-delay digital component, not a transistor-level model.
	</Description>
	<eeschema_sch>
		L anicad:MUX2
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // default voltages: HIGH=5 Volt, LOW=0 Volt, so Vth=2.5 Volt
		vpos=3.3 vneg=0.0 // HIGH=3.3 Volt, LOW=0 Volt, so Vth=1.65 Volt
		vpos=5.0 vneg=-5.0 // HIGH=5 Volt, LOW=-5 Volt, so Vth=0 Volt
		vpos=5.0 vneg=0.0 ron=5.0 roff=50k // modified output resistances between supply rails and output
	</Default_Values>
	<Spice>
		// ---- supply and threshold parameters ----
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF
		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF
		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0
		// ---- output resistance parameters ----
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF
		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF
		// ---- model ----
		.subckt mdl_mux2_[individual] inA inB inS out
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]
			// Logic state: 1=HIGH, 0=LOW
			B_logic logic 0 V=((V(inS) > [vth]) ? ((V(inB) > [vth]) ? 1 : 0) : ((V(inA) > [vth]) ? 1 : 0))
			// Output switches connect Y to the positive or negative supply.
			.model mdl_swpos_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swneg_[individual] sw ron=[roff] roff=[ron] vt=0.5
			S_pos pwr_pos out logic 0 mdl_swpos_[individual]
			S_neg pwr_neg out logic 0 mdl_swneg_[individual]
		.ends
		// ---- component ----
		X_[individual] [A] [B] [S] [Y] mdl_mux2_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -8.89 6.35) (end 8.89 -6.35)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		// horizontal line creates a minus - symbol
		(polyline (pts	(xy -0.51 -5.08)(xy 0.51 -5.08)
			  )
			  (stroke (width 0) (type default))
			  (fill (type none))
			)
		// two lines create a plus + symbol
		(polyline
			(pts	(xy -0.51 5.08)(xy 0.51 5.08))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(polyline (pts	(xy 0 4.57)(xy 0 5.59)
			  )
			  (stroke (width 0) (type default))
			  (fill (type none))
		)
		(pin input line (at -10.16 3.81 0) (length 1.27)
			(name "A" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "A" (at -7.62 3.81 0) (effects (font (size 1.5 1.5))))
		
		(pin input line (at -10.16 1.27 0) (length 1.27)
			(name "B" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "B" (at -7.62 1.27 0) (effects (font (size 1.5 1.5))))
		
		(pin input line (at -10.16 -3.81 0) (length 1.27)
			(name "S" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "S" (at -7.62 -3.81 0) (effects (font (size 1.5 1.5))))

		(pin output line (at 10.16 0 180) (length 1.27)
			(name "Y" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "MUX2" (at 0 0 0) (effects (font (size 2.54 2.54))))
	</eeschema_symbol>
	<animation>
		DEFINE [vout] V[Y]
		DEFINE [vout] AS_NUMBER OF: [vout]
		IF [vout] THEN
			DEFINE [s_0] V[S]
			IF [s_0] THEN
				IF [s_0] HIGHER_THAN [vth] THEN
					DEFINE [s_0] 1
					DEFINE [yco] -50 //mils 
				ELSE 
					DEFINE [s_0] 0
					DEFINE [yco] -150 //mils=3.81mm A
				ENDIF
			ENDIF
			
			// draw connection to output
			IF [vout] HIGHER_THAN [vth] THEN
				DEFINE [color] #FF0000 
				<Line 250 0 -200 -200 #FF0000 2 1 #FF0000 1 0> // red line to positive output
				<Line 0 -220 0 40 #FF0000 2 1 #FF0000 1 0> // red plus symbol
				<Line -20 -200 40 0 #FF0000 2 1 #FF0000 1 0> // red plus symbol
				<Ellipse -30 -230 60 60 #FF0000 2 1 #FF0000 1 0> // red circle around plus symbol
			ELSE
				DEFINE [color] #0000FF
				<Line 250 0 -200 200 #0000FF 2 1 #0000FF 1 0> // blue line to negative output
				<Line -20 200 40 0 #0000FF 2 1 #0000FF 1 0> // blue minus symbol
				<Ellipse -30 170 60 60 #0000FF 2 1 #0000FF 1 0> // blue circle around minus symbol
			ENDIF
			// draw input channel in high or low color:
			IF [yco] && [color] THEN 
				<Line -250 [yco] 150 0 [color] 2 1>
			ENDIF
			
		ENDIF
	</animation>
</Component>
<Component>
	<Description>
		Four-input multiplexer. Select inputs S1 and S0 choose A (00), B (01), C (10), or D (11).
		Each input is interpreted as HIGH when its voltage is strictly above the threshold
		Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
		The output is driven to vpos for HIGH and vneg for LOW.
		Enter optional supply levels in the value field, for example: vpos=5.0 vneg=0.0.
		If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
		This is an ideal, zero-delay digital component, not a transistor-level model.
	</Description>
	<eeschema_sch>
		L anicad:MUX4
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // default voltages: HIGH=5 Volt, LOW=0 Volt, so Vth=2.5 Volt
		vpos=3.3 vneg=0.0 // HIGH=3.3 Volt, LOW=0 Volt, so Vth=1.65 Volt
		vpos=5.0 vneg=-5.0 // HIGH=5 Volt, LOW=-5 Volt, so Vth=0 Volt
		vpos=5.0 vneg=0.0 ron=5.0 roff=50k // modified output resistances between supply rails and output
	</Default_Values>
	<Spice>
		// ---- supply and threshold parameters ----
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF
		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF
		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0
		// ---- output resistance parameters ----
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF
		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF
		// ---- model ----
		.subckt mdl_mux4_[individual] inA inB inC inD inS0 inS1 out
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]
			// Logic state: 1=HIGH, 0=LOW
			B_logic logic 0 V=((V(inS1) > [vth]) ? (((V(inS0) > [vth]) ? ((V(inD) > [vth]) ? 1 : 0) : ((V(inC) > [vth]) ? 1 : 0))) : ((V(inS0) > [vth]) ? ((V(inB) > [vth]) ? 1 : 0) : ((V(inA) > [vth]) ? 1 : 0)))
			// Output switches connect Y to the positive or negative supply.
			.model mdl_swpos_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swneg_[individual] sw ron=[roff] roff=[ron] vt=0.5
			S_pos pwr_pos out logic 0 mdl_swpos_[individual]
			S_neg pwr_neg out logic 0 mdl_swneg_[individual]
		.ends
		// ---- component ----
		X_[individual] [A] [B] [C] [D] [S0] [S1] [Y] mdl_mux4_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -8.89 7.62) (end 8.89 -7.62)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		// horizontal line creates a minus - symbol
		(polyline (pts (xy -0.51 -6.35)(xy 0.51 -6.35))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		// two lines create a plus + symbol
		(polyline (pts (xy -0.51 6.35)(xy 0.51 6.35))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(polyline (pts (xy 0 5.84)(xy 0 6.86))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin input line (at -10.16 6.35 0) (length 1.27)
			(name "A" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "A" (at -7.62 6.35 0) (effects (font (size 1.5 1.5))))
		
		(pin input line (at -10.16 3.81 0) (length 1.27)
			(name "B" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "B" (at -7.62 3.81 0) (effects (font (size 1.5 1.5))))

		(pin input line (at -10.16 1.27 0) (length 1.27)
			(name "C" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "C" (at -7.62 1.27 0) (effects (font (size 1.5 1.5))))

		(pin input line (at -10.16 -1.27 0) (length 1.27)
			(name "D" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "D" (at -7.62 -1.27 0) (effects (font (size 1.5 1.5))))

		(pin input line (at -10.16 -3.81 0) (length 1.27)
			(name "S0" (effects (font (size 1.27 1.27))))
			(number "5" (effects (font (size 1.27 1.27))))
		)
		(text "S0" (at -7.62 -3.81 0) (effects (font (size 1.5 1.5))))

		(pin input line (at -10.16 -6.35 0) (length 1.27)
			(name "S1" (effects (font (size 1.27 1.27))))
			(number "6" (effects (font (size 1.27 1.27))))
		)
		(text "S1" (at -7.62 -6.35 0) (effects (font (size 1.5 1.5))))

		(pin output line (at 10.16 0 180) (length 1.27)
			(name "Y" (effects (font (size 1.27 1.27))))
			(number "7" (effects (font (size 1.27 1.27))))
		)
		(text "Y" (at 7.62 0 0) (effects (font (size 1.5 1.5))))

		(text "MUX4" (at 0 0 0) (effects (font (size 2.54 2.54))))
	</eeschema_symbol>
	<animation>
		DEFINE [vout] V[Y]
		DEFINE [vout] AS_NUMBER OF: [vout]
		IF [vout] THEN
			DEFINE [s_0] V[S0]
			DEFINE [s_1] V[S1]
			IF [s_0] && [s_1] THEN 
				IF [s_0] HIGHER_THAN [vth] THEN DEFINE [s_0] 1
				ELSE  					        DEFINE [s_0] 0
				ENDIF
				IF [s_1] HIGHER_THAN [vth] THEN DEFINE [s_1] 1
				ELSE  					        DEFINE [s_1] 0
				ENDIF
				DEFINE [s_01] [s_0][s_1] // status value
			ELSE
				DEFINE [s_01] AS_NULL
			ENDIF
			
			// get the y coordinate of the input channel (in old kicad 5 mils. Attention: the y axis is inversed between new kicad 6 and old kicad 5 coordinate system.)
			IF [s_01] THEN
				IF     [s_01] EQUAL_TO 00 THEN DEFINE [yco] -250 //mils= +6.35mm=A
				ELSEIF [s_01] EQUAL_TO 01 THEN DEFINE [yco] -150 //mils= +3.81mm B
				ELSEIF [s_01] EQUAL_TO 10 THEN DEFINE [yco] -50  //mils= +1.27mm C
				ELSEIF [s_01] EQUAL_TO 11 THEN DEFINE [yco] 50   //mils= -1.27mm D
				ENDIF ENDIF ENDIF ENDIF 
			ELSE
				DEFINE [yco] AS_NULL
			ENDIF
			
			
			// draw output switch: 
			IF [vout] HIGHER_THAN [vth] THEN
				DEFINE [color] #FF0000 // red
				<Line 350 0 -250 -250 #FF0000 2 1 #FF0000 1 0> // red line to positive output
				<Line 0 -270 0 40 #FF0000 2 1 #FF0000 1 0> // red plus symbol
				<Line -20 -250 40 0 #FF0000 2 1 #FF0000 1 0> // red plus symbol
				<Ellipse -30 -280 60 60 #FF0000 2 1 #FF0000 1 0> // red circle around plus symbol
			ELSE
				DEFINE [color] #0000FF // blue
				<Line 350 0 -250 250 #0000FF 2 1 #0000FF 1 0> // blue line to negative output
				<Line -20 250 40 0 #0000FF 2 1 #0000FF 1 0> // blue minus symbol
				<Ellipse -30 220 60 60 #0000FF 2 1 #0000FF 1 0> // blue circle around minus symbol
			ENDIF
			
			// draw input channel in high or low color:
			IF [yco] && [color] THEN 
				<Line -250 [yco] 150 0 [color] 2 1>
			ENDIF
			
		ENDIF
	</animation>
</Component>

// ---- Demultiplexers ----
<Component>
	<Description>
		One-to-two demultiplexer. Select input S routes data input D to output Y0 when S is LOW
		and to output Y1 when S is HIGH. The unselected output is driven to LOW.
		Each input is interpreted as HIGH when its voltage is strictly above the threshold
		Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
		The outputs are driven to vpos for HIGH and vneg for LOW.
		Enter optional supply levels in the value field, for example: vpos=5.0 vneg=0.0.
		If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
		This is an ideal, zero-delay digital component, not a transistor-level model.
	</Description>
	<eeschema_sch>
		L anicad:DEMUX2
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // default voltages: HIGH=5 Volt, LOW=0 Volt, so Vth=2.5 Volt
		vpos=3.3 vneg=0.0 // HIGH=3.3 Volt, LOW=0 Volt, so Vth=1.65 Volt
		vpos=5.0 vneg=-5.0 // HIGH=5 Volt, LOW=-5 Volt, so Vth=0 Volt
		vpos=5.0 vneg=0.0 ron=5.0 roff=50k // modified output resistances between supply rails and outputs
	</Default_Values>
	<Spice>
		// ---- supply and threshold parameters ----
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF
		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF
		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0
		// ---- output resistance parameters ----
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF
		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF
		// ---- model ----
		.subckt mdl_demux2_[individual] inD inS outY0 outY1
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]
			// Logic states: 1=HIGH, 0=LOW
			B_logic0 logic0 0 V=((V(inD) > [vth]) && (V(inS) <= [vth]) ? 1 : 0)
			B_logic1 logic1 0 V=((V(inD) > [vth]) && (V(inS) > [vth]) ? 1 : 0)
			// Output switches connect each output to the positive or negative supply.
			.model mdl_swpos0_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swneg0_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swpos1_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swneg1_[individual] sw ron=[roff] roff=[ron] vt=0.5
			S_pos0 pwr_pos outY0 logic0 0 mdl_swpos0_[individual]
			S_neg0 pwr_neg outY0 logic0 0 mdl_swneg0_[individual]
			S_pos1 pwr_pos outY1 logic1 0 mdl_swpos1_[individual]
			S_neg1 pwr_neg outY1 logic1 0 mdl_swneg1_[individual]
		.ends
		// ---- component: pin order D, S, Y0, Y1 matches the subcircuit interface ----
		X_[individual] [D] [S] [Y0] [Y1] mdl_demux2_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -8.89 6.35) (end 8.89 -6.35)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		// horizontal line creates a minus - symbol
		(polyline (pts (xy -0.51 -5.08)(xy 0.51 -5.08))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		// two lines create a plus + symbol
		(polyline (pts (xy -0.51 5.08)(xy 0.51 5.08))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(polyline (pts (xy 0 4.57)(xy 0 5.59))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin input line (at -10.16 2.54 0) (length 1.27)
			(name "D" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "D" (at -7.62 2.54 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -10.16 -2.54 0) (length 1.27)
			(name "S" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "S" (at -7.62 -2.54 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 10.16 2.54 180) (length 1.27)
			(name "Y0" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "Y0" (at 7.62 2.54 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 10.16 -2.54 180) (length 1.27)
			(name "Y1" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "Y1" (at 7.62 -2.54 0) (effects (font (size 1.5 1.5))))
		(text "DEMUX2" (at 0 0 0) (effects (font (size 2.0 2.0))))
	</eeschema_symbol>
	<animation>
		// Output Y0: KiCad 6 +2.54 mm corresponds to -100 mils in KiCad 5 animation coordinates for y axis.
		DEFINE [vout0] V[Y0]
		DEFINE [vout0] AS_NUMBER OF: [vout0]
		DEFINE [vout1] V[Y1]
		DEFINE [vout1] AS_NUMBER OF: [vout1]
		DEFINE [vs] V[S]
		DEFINE [vs] AS_NUMBER OF: [vs]
		DEFINE [vd] V[D]
		DEFINE [vd] AS_NUMBER OF: [vd]
		
		IF [vs] && [vd] THEN 
			IF [vs] HIGHER_THAN [vth] THEN DEFINE [ydiff] 200 // mils = -2.54mm = diff from D=-100mil to Y1=+100 mil 
			ELSE                           DEFINE [ydiff] 0  // D and Y0 are on same height, diff=0
			ENDIF
			IF [vd] HIGHER_THAN [vth] THEN
				DEFINE [color] #FF0000 // red for +
				<Line 0 -220 0 40 #FF0000 2 1 #FF0000 1 0> // red plus symbol
				<Line -20 -200 40 0 #FF0000 2 1 #FF0000 1 0> // red plus symbol
				<Ellipse -30 -230 60 60 #FF0000 2 1 #FF0000 1 0> // red circle around plus symbol
			ELSE
				DEFINE [color] #0000FF // blue for -
				<Line -20 200 40 0 #0000FF 2 1 #0000FF 1 0> // blue minus symbol
				<Ellipse -30 170 60 60 #0000FF 2 1 #0000FF 1 0> // blue circle around minus symbol
			ENDIF
			
			// draw line from D to Y0 or Y1
			<Line -200 -100 400 [ydiff] [color] 2 1 [color] 1 0> 
		ELSE
			DEFINE [vs] AS_NULL
			DEFINE [vd] AS_NULL
		ENDIF
	</animation>
</Component>


// ---- Decoders ----
<Component>
	<Description>
		Two-to-four decoder with active-HIGH outputs. Inputs A1 and A0 select one of
		four outputs: 00 selects Y0, 01 selects Y1, 10 selects Y2, and 11 selects Y3.
		Enable input EN must be HIGH for decoding. When EN is LOW, all outputs are LOW.
		Each input is interpreted as HIGH when its voltage is strictly above the threshold
		Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
		The outputs are driven to vpos for HIGH and vneg for LOW.
		Enter optional supply levels in the value field, for example: vpos=5.0 vneg=0.0.
		If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
		This is an ideal, zero-delay digital component, not a transistor-level model.
	</Description>
	<eeschema_sch>
		L anicad:DECODER2
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // default voltages: HIGH=5 Volt, LOW=0 Volt, so Vth=2.5 Volt
		vpos=3.3 vneg=0.0 // HIGH=3.3 Volt, LOW=0 Volt, so Vth=1.65 Volt
		vpos=5.0 vneg=-5.0 // HIGH=5 Volt, LOW=-5 Volt, so Vth=0 Volt
		vpos=5.0 vneg=0.0 ron=5.0 roff=50k // modified output resistances between supply rails and outputs
	</Default_Values>
	<Spice>
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF
		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF
		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF
		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF
		.subckt mdl_decoder2_[individual] inA1 inA0 inEN outY0 outY1 outY2 outY3
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]
			B_logic0 logic0 0 V=((V(inEN) > [vth]) && (V(inA1) <= [vth]) && (V(inA0) <= [vth]) ? 1 : 0)
			B_logic1 logic1 0 V=((V(inEN) > [vth]) && (V(inA1) <= [vth]) && (V(inA0) > [vth]) ? 1 : 0)
			B_logic2 logic2 0 V=((V(inEN) > [vth]) && (V(inA1) > [vth]) && (V(inA0) <= [vth]) ? 1 : 0)
			B_logic3 logic3 0 V=((V(inEN) > [vth]) && (V(inA1) > [vth]) && (V(inA0) > [vth]) ? 1 : 0)
			.model mdl_swpos0_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swneg0_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swpos1_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swneg1_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swpos2_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swneg2_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swpos3_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swneg3_[individual] sw ron=[roff] roff=[ron] vt=0.5
			S_pos0 pwr_pos outY0 logic0 0 mdl_swpos0_[individual]
			S_neg0 pwr_neg outY0 logic0 0 mdl_swneg0_[individual]
			S_pos1 pwr_pos outY1 logic1 0 mdl_swpos1_[individual]
			S_neg1 pwr_neg outY1 logic1 0 mdl_swneg1_[individual]
			S_pos2 pwr_pos outY2 logic2 0 mdl_swpos2_[individual]
			S_neg2 pwr_neg outY2 logic2 0 mdl_swneg2_[individual]
			S_pos3 pwr_pos outY3 logic3 0 mdl_swpos3_[individual]
			S_neg3 pwr_neg outY3 logic3 0 mdl_swneg3_[individual]
		.ends
		// Pin order A1, A0, EN, Y0, Y1, Y2, Y3 matches the subcircuit interface.
		X_[individual] [A1] [A0] [EN] [Y0] [Y1] [Y2] [Y3] mdl_decoder2_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -10.16 7.62) (end 10.16 -7.62)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(polyline (pts (xy -0.51 -6.35)(xy 0.51 -6.35))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(polyline (pts (xy -0.51 6.35)(xy 0.51 6.35))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(polyline (pts (xy 0 5.84)(xy 0 6.86))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin input line (at -11.43 3.81 0) (length 1.27)
			(name "A1" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "A1" (at -8.89 3.81 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -11.43 1.27 0) (length 1.27)
			(name "A0" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "A0" (at -8.89 1.27 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -11.43 -3.81 0) (length 1.27)
			(name "EN" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "EN" (at -8.89 -3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 3.81 180) (length 1.27)
			(name "Y0" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "Y0" (at 8.89 3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 1.27 180) (length 1.27)
			(name "Y1" (effects (font (size 1.27 1.27))))
			(number "5" (effects (font (size 1.27 1.27))))
		)
		(text "Y1" (at 8.89 1.27 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 -1.27 180) (length 1.27)
			(name "Y2" (effects (font (size 1.27 1.27))))
			(number "6" (effects (font (size 1.27 1.27))))
		)
		(text "Y2" (at 8.89 -1.27 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 -3.81 180) (length 1.27)
			(name "Y3" (effects (font (size 1.27 1.27))))
			(number "7" (effects (font (size 1.27 1.27))))
		)
		(text "Y3" (at 8.89 -3.81 0) (effects (font (size 1.5 1.5))))
		(text "DECODER2" (at 0 0 0) (effects (font (size 2.0 2.0))))
	</eeschema_symbol>
	<animation>
		// KiCad 6 output positions +3.81, +1.27, -1.27, -3.81 mm map to -150, -50, +50, +150 mils.
		DEFINE [a1] V[A1]
		DEFINE [a1] AS_NUMBER OF: [a1]
		DEFINE [a0] V[A0]
		DEFINE [a0] AS_NUMBER OF: [a0]
		DEFINE [en] V[EN]
		DEFINE [en] AS_NUMBER OF: [en]
		IF [a1] && [a0] && [en] THEN
			IF [en] HIGHER_THAN [vth] THEN
				IF [a1] HIGHER_THAN [vth] THEN DEFINE [bit1] 1
				ELSE DEFINE [bit1] 0
				ENDIF
				IF [a0] HIGHER_THAN [vth] THEN DEFINE [bit0] 1
				ELSE DEFINE [bit0] 0
				ENDIF
				IF [bit1] EQUAL_TO 0 THEN
					IF [bit0] EQUAL_TO 0 THEN DEFINE [yco] -150
					ELSE DEFINE [yco] -50
					ENDIF
				ELSE
					IF [bit0] EQUAL_TO 0 THEN DEFINE [yco] 50
					ELSE DEFINE [yco] 150
					ENDIF
				ENDIF
				// Highlight the selected output path; the selected output is HIGH (red).
				<Line 0 0 300 [yco] #FF0000 2 1 #FF0000 1 0>
			ENDIF
		ENDIF
	</animation>
</Component>
// ---- Priority Encoders ----
<Component>
	<Description>
		An encoder with active-HIGH outputs and active-HIGH VALID output. Inputs D0 to D3 are encoded into A1 and A0. 
		It is a priority-encoder: If more than one input is HIGH,
		the input with the highest number has priority: D3 over D2, D2 over D1,
		and D1 over D0. The output codes are D0=00, D1=01, D2=10, and D3=11.
		VALID is HIGH whenever at least one input is HIGH; otherwise VALID is LOW.
		Each input is interpreted as HIGH when its voltage is strictly above the threshold
		Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
		The outputs are driven to vpos for HIGH and vneg for LOW.
		Enter optional supply levels in the value field, for example: vpos=5.0 vneg=0.0.
		If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
		This is an ideal, zero-delay digital component, not a transistor-level model.
	</Description>
	<eeschema_sch>
		L anicad:ENCODER2
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // default voltages: HIGH=5 Volt, LOW=0 Volt, so Vth=2.5 Volt
		vpos=3.3 vneg=0.0 // HIGH=3.3 Volt, LOW=0 Volt, so Vth=1.65 Volt
		vpos=5.0 vneg=-5.0 // HIGH=5 Volt, LOW=-5 Volt, so Vth=0 Volt
		vpos=5.0 vneg=0.0 ron=5.0 roff=50k // modified output resistances between supply rails and outputs
	</Default_Values>
	<Spice>
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF
		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF
		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF
		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF
		.subckt mdl_encoder2_[individual] inD0 inD1 inD2 inD3 outA1 outA0 outVALID
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]
			// Priority: D3 > D2 > D1 > D0.
			B_logicA1 logicA1 0 V=((V(inD3) > [vth]) || (V(inD2) > [vth]) ? 1 : 0)
			B_logicA0 logicA0 0 V=((V(inD3) > [vth]) || ((V(inD2) <= [vth]) && (V(inD1) > [vth])) ? 1 : 0)
			B_logicVALID logicVALID 0 V=((V(inD0) > [vth]) || (V(inD1) > [vth]) || (V(inD2) > [vth]) || (V(inD3) > [vth]) ? 1 : 0)
			.model mdl_swposA1_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegA1_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposA0_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegA0_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposVALID_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegVALID_[individual] sw ron=[roff] roff=[ron] vt=0.5
			S_posA1 pwr_pos outA1 logicA1 0 mdl_swposA1_[individual]
			S_negA1 pwr_neg outA1 logicA1 0 mdl_swnegA1_[individual]
			S_posA0 pwr_pos outA0 logicA0 0 mdl_swposA0_[individual]
			S_negA0 pwr_neg outA0 logicA0 0 mdl_swnegA0_[individual]
			S_posVALID pwr_pos outVALID logicVALID 0 mdl_swposVALID_[individual]
			S_negVALID pwr_neg outVALID logicVALID 0 mdl_swnegVALID_[individual]
		.ends
		// Pin order D0, D1, D2, D3, A1, A0, VALID matches the subcircuit interface.
		X_[individual] [D0] [D1] [D2] [D3] [A1] [A0] [VALID] mdl_encoder2_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -10.16 7.62) (end 10.16 -6.35)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin input line (at -11.43 6.35 0) (length 1.27)
			(name "D0" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "D0" (at -8.89 6.35 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -11.43 2.54 0) (length 1.27)
			(name "D1" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "D1" (at -8.89 2.54 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -11.43 -1.27 0) (length 1.27)
			(name "D2" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "D2" (at -8.89 -1.27 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -11.43 -5.08 0) (length 1.27)
			(name "D3" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "D3" (at -8.89 -5.08 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 3.81 180) (length 1.27)
			(name "A1" (effects (font (size 1.27 1.27))))
			(number "5" (effects (font (size 1.27 1.27))))
		)
		(text "A1" (at 8.89 3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 0 180) (length 1.27)
			(name "A0" (effects (font (size 1.27 1.27))))
			(number "6" (effects (font (size 1.27 1.27))))
		)
		(text "A0" (at 8.89 0 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 -3.81 180) (length 1.27)
			(name "VALID" (effects (font (size 1.27 1.27))))
			(number "7" (effects (font (size 1.27 1.27))))
		)
		(text "VALID" (at 7.62 -3.81 0) (effects (font (size 1.3 1.3))))
		(text "ENCODER2" (at 0 0 0) (effects (font (size 2.0 2.0))))
	</eeschema_symbol>
	<animation>
		DEFINE [d0] V[D0]
		DEFINE [d0] AS_NUMBER OF: [d0]
		DEFINE [d1] V[D1]
		DEFINE [d1] AS_NUMBER OF: [d1]
		DEFINE [d2] V[D2]
		DEFINE [d2] AS_NUMBER OF: [d2]
		DEFINE [d3] V[D3]
		DEFINE [d3] AS_NUMBER OF: [d3]
		IF [d0] && [d1] && [d2] && [d3] THEN
			DEFINE [a1] 0
			DEFINE [a0] 0
			DEFINE [valid] 0
			IF [d3] HIGHER_THAN [vth] THEN
				DEFINE [a1] 1
				DEFINE [a0] 1
				DEFINE [valid] 1
			ELSE
				IF [d2] HIGHER_THAN [vth] THEN
					DEFINE [a1] 1
					DEFINE [valid] 1
				ELSE
					IF [d1] HIGHER_THAN [vth] THEN
						DEFINE [a0] 1
						DEFINE [valid] 1
					ELSE
						IF [d0] HIGHER_THAN [vth] THEN
							DEFINE [valid] 1
						ENDIF
					ENDIF
				ENDIF
			ENDIF
			// Output paths: red=HIGH, blue=LOW. Coordinates follow symbol pins.
			IF [a1] EQUAL_TO 1 THEN
				<Line 0 0 300 -150 #FF0000 2 1 #FF0000 1 0>
			ELSE
				<Line 0 0 300 -150 #0000FF 2 1 #0000FF 1 0>
			ENDIF
			IF [a0] EQUAL_TO 1 THEN
				<Line 0 0 300 0 #FF0000 2 1 #FF0000 1 0>
			ELSE
				<Line 0 0 300 0 #0000FF 2 1 #0000FF 1 0>
			ENDIF
			IF [valid] EQUAL_TO 1 THEN
				<Line 0 0 300 150 #FF0000 2 1 #FF0000 1 0>
			ELSE
				<Line 0 0 300 150 #0000FF 2 1 #0000FF 1 0>
			ENDIF
		ENDIF
	</animation>
</Component>


// ---- Adders ----
<Component>
	<Description>
		Half adder. Adds the two binary inputs A and B.
		SUM is HIGH when exactly one input is HIGH (A XOR B).
		CARRY is HIGH when both inputs are HIGH (A AND B).
		Each input is interpreted as HIGH when its voltage is strictly above the threshold
		Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
		The outputs are driven to vpos for HIGH and vneg for LOW.
		Enter optional supply levels in the value field, for example: vpos=5.0 vneg=0.0.
		If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
		This is an ideal, zero-delay digital component, not a transistor-level model.
	</Description>
	<eeschema_sch>
		L anicad:HALFADDER
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // default voltages: HIGH=5 Volt, LOW=0 Volt, so Vth=2.5 Volt
		vpos=3.3 vneg=0.0 // HIGH=3.3 Volt, LOW=0 Volt, so Vth=1.65 Volt
		vpos=5.0 vneg=-5.0 // HIGH=5 Volt, LOW=-5 Volt, so Vth=0 Volt
		vpos=5.0 vneg=0.0 ron=5.0 roff=50k // modified output resistances between supply rails and outputs
	</Default_Values>
	<Spice>
		// ---- supply and threshold parameters ----
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF
		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF
		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0
		// ---- output resistance parameters ----
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF
		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF
		// ---- model ----
		.subckt mdl_halfadder_[individual] inA inB outSUM outCARRY
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]
			B_logicSUM logicSUM 0 V=((V(inA) > [vth]) != (V(inB) > [vth]) ? 1 : 0)
			B_logicCARRY logicCARRY 0 V=((V(inA) > [vth]) && (V(inB) > [vth]) ? 1 : 0)
			.model mdl_swposSUM_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegSUM_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposCARRY_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegCARRY_[individual] sw ron=[roff] roff=[ron] vt=0.5
			S_posSUM pwr_pos outSUM logicSUM 0 mdl_swposSUM_[individual]
			S_negSUM pwr_neg outSUM logicSUM 0 mdl_swnegSUM_[individual]
			S_posCARRY pwr_pos outCARRY logicCARRY 0 mdl_swposCARRY_[individual]
			S_negCARRY pwr_neg outCARRY logicCARRY 0 mdl_swnegCARRY_[individual]
		.ends
		// Pin order A, B, SUM, CARRY matches the subcircuit interface.
		X_[individual] [A] [B] [SUM] [CARRY] mdl_halfadder_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -8.89 6.35) (end 8.89 -6.35)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin input line (at -10.16 2.54 0) (length 1.27)
			(name "A" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "A" (at -7.62 2.54 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -10.16 -2.54 0) (length 1.27)
			(name "B" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "B" (at -7.62 -2.54 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 10.16 2.54 180) (length 1.27)
			(name "SUM" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "SUM" (at 7.62 2.54 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 10.16 -2.54 180) (length 1.27)
			(name "CARRY" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "CARRY" (at 6.35 -2.54 0) (effects (font (size 1.3 1.3))))
		(text "HALFADDER" (at 0 0 0) (effects (font (size 2.0 2.0))))
	</eeschema_symbol>
</Component>

<Component>
	<Description>
		Full adder. Adds the binary inputs A and B and the carry input CARRY_IN.
		SUM is the least significant result bit; CARRY_OUT is the carry to the next bit.
		SUM = A XOR B XOR CARRY_IN.
		CARRY_OUT = (A AND B) OR (CARRY_IN AND (A XOR B)).
		Each input is interpreted as HIGH when its voltage is strictly above the threshold
		Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
		The outputs are driven to vpos for HIGH and vneg for LOW.
		Enter optional supply levels in the value field, for example: vpos=5.0 vneg=0.0.
		If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
		This is an ideal, zero-delay digital component, not a transistor-level model.
	</Description>
	<eeschema_sch>
		L anicad:FULLADDER
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // default voltages: HIGH=5 Volt, LOW=0 Volt, so Vth=2.5 Volt
		vpos=3.3 vneg=0.0 // HIGH=3.3 Volt, LOW=0 Volt, so Vth=1.65 Volt
		vpos=5.0 vneg=-5.0 // HIGH=5 Volt, LOW=-5 Volt, so Vth=0 Volt
		vpos=5.0 vneg=0.0 ron=5.0 roff=50k // modified output resistances between supply rails and outputs
	</Default_Values>
	<Spice>
		// ---- supply and threshold parameters ----
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF
		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF
		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0
		// ---- output resistance parameters ----
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF
		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF
		// ---- model ----
		.subckt mdl_fulladder_[individual] inA inB inCARRYIN outSUM outCARRYOUT
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]
			// Full-adder equations: SUM = A XOR B XOR CIN; COUT = AB + CIN(A XOR B).
			B_logicSUM logicSUM 0 V=((V(inA) > [vth]) != (V(inB) > [vth]) != (V(inCARRYIN) > [vth]) ? 1 : 0)
			B_logicCARRY logicCARRY 0 V=(((V(inA) > [vth]) && (V(inB) > [vth])) || ((V(inCARRYIN) > [vth]) && ((V(inA) > [vth]) != (V(inB) > [vth]))) ? 1 : 0)
			.model mdl_swposSUM_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegSUM_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposCARRYOUT_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegCARRYOUT_[individual] sw ron=[roff] roff=[ron] vt=0.5
			S_posSUM pwr_pos outSUM logicSUM 0 mdl_swposSUM_[individual]
			S_negSUM pwr_neg outSUM logicSUM 0 mdl_swnegSUM_[individual]
			S_posCARRYOUT pwr_pos outCARRYOUT logicCARRY 0 mdl_swposCARRYOUT_[individual]
			S_negCARRYOUT pwr_neg outCARRYOUT logicCARRY 0 mdl_swnegCARRYOUT_[individual]
		.ends
		// Pin order A, B, CARRY_IN, SUM, CARRY_OUT matches the subcircuit interface.
		X_[individual] [A] [B] [CARRY_IN] [SUM] [CARRY_OUT] mdl_fulladder_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -8.89 7.62) (end 8.89 -7.62)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin input line (at -10.16 3.81 0) (length 1.27)
			(name "A" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "A" (at -7.62 3.81 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -10.16 0 0) (length 1.27)
			(name "B" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "B" (at -7.62 0 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -10.16 -3.81 0) (length 1.27)
			(name "CARRY_IN" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "CIN" (at -7.62 -3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 10.16 2.54 180) (length 1.27)
			(name "SUM" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "SUM" (at 7.62 2.54 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 10.16 -2.54 180) (length 1.27)
			(name "CARRY_OUT" (effects (font (size 1.27 1.27))))
			(number "5" (effects (font (size 1.27 1.27))))
		)
		(text "COUT" (at 7.62 -2.54 0) (effects (font (size 1.5 1.5))))
		(text "FULLADDER" (at 0 0 0) (effects (font (size 2.0 2.0))))
	</eeschema_symbol>
</Component>
<Component>
	<Description>
		Four-bit ripple-carry adder. Adds the two 4-bit binary inputs A3..A0 and B3..B0,
		plus the optional carry input CARRY_IN.
		SUM0..SUM3 are the four result bits; CARRY_OUT is the carry beyond the most significant bit.
		Each input is interpreted as HIGH when its voltage is strictly above the threshold
		Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
		The outputs are driven to vpos for HIGH and vneg for LOW.
		Enter optional supply levels in the value field, for example: vpos=5.0 vneg=0.0.
		If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
		This is an ideal, zero-delay digital component, not a transistor-level model.
	</Description>
	<eeschema_sch>
		L anicad:ADDER4
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // default voltages: HIGH=5 Volt, LOW=0 Volt, so Vth=2.5 Volt
		vpos=3.3 vneg=0.0 // HIGH=3.3 Volt, LOW = 0 Volt  , so Vth = 1.65 Volt
		vpos=5.0 vneg=-5.0 // HIGH=5 Volt, LOW = -5 Volt , so Vth = 0 Volt
		vpos=5.0 vneg=0.0 ron=5.0 roff=50k // modified output resistances between supply rails and outputs
	</Default_Values>
	<Spice>
		// ---- supply and threshold parameters ----
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF
		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF
		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0
		// ---- output resistance parameters ----
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF
		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF
		// ---- model ----
		.subckt mdl_adder4_[individual] inA0 inA1 inA2 inA3 inB0 inB1 inB2 inB3 inCARRYIN outSUM0 outSUM1 outSUM2 outSUM3 outCARRYOUT
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]
			// Ripple-carry equations, from least significant bit to most significant bit.
			B_prop0 prop0 0 V=((V(inA0) > [vth]) != (V(inB0) > [vth]) ? 1 : 0)
			B_gen0 gen0 0 V=((V(inA0) > [vth]) && (V(inB0) > [vth]) ? 1 : 0)
			B_carry1 carry1 0 V=(V(gen0) || (V(prop0) && (V(inCARRYIN) > [vth])) ? 1 : 0)
			B_sum0 logicSUM0 0 V=(V(prop0) != (V(inCARRYIN) > 0.5) ? 1 : 0)
			B_prop1 prop1 0 V=((V(inA1) > [vth]) != (V(inB1) > [vth]) ? 1 : 0)
			B_gen1 gen1 0 V=((V(inA1) > [vth]) && (V(inB1) > [vth]) ? 1 : 0)
			B_carry2 carry2 0 V=(V(gen1) || (V(prop1) && V(carry1)) ? 1 : 0)
			B_sum1 logicSUM1 0 V=(V(prop1) != V(carry1) ? 1 : 0)
			B_prop2 prop2 0 V=((V(inA2) > [vth]) != (V(inB2) > [vth]) ? 1 : 0)
			B_gen2 gen2 0 V=((V(inA2) > [vth]) && (V(inB2) > [vth]) ? 1 : 0)
			B_carry3 carry3 0 V=(V(gen2) || (V(prop2) && V(carry2)) ? 1 : 0)
			B_sum2 logicSUM2 0 V=(V(prop2) != V(carry2) ? 1 : 0)
			B_prop3 prop3 0 V=((V(inA3) > [vth]) != (V(inB3) > [vth]) ? 1 : 0)
			B_gen3 gen3 0 V=((V(inA3) > [vth]) && (V(inB3) > [vth]) ? 1 : 0)
			B_carry4 carry4 0 V=(V(gen3) || (V(prop3) && V(carry3)) ? 1 : 0)
			B_sum3 logicSUM3 0 V=(V(prop3) != V(carry3) ? 1 : 0)
			// Output switches.
			.model mdl_swposSUM0_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegSUM0_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposSUM1_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegSUM1_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposSUM2_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegSUM2_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposSUM3_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegSUM3_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposCARRYOUT_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegCARRYOUT_[individual] sw ron=[roff] roff=[ron] vt=0.5
			S_posSUM0 pwr_pos outSUM0 logicSUM0 0 mdl_swposSUM0_[individual]
			S_negSUM0 pwr_neg outSUM0 logicSUM0 0 mdl_swnegSUM0_[individual]
			S_posSUM1 pwr_pos outSUM1 logicSUM1 0 mdl_swposSUM1_[individual]
			S_negSUM1 pwr_neg outSUM1 logicSUM1 0 mdl_swnegSUM1_[individual]
			S_posSUM2 pwr_pos outSUM2 logicSUM2 0 mdl_swposSUM2_[individual]
			S_negSUM2 pwr_neg outSUM2 logicSUM2 0 mdl_swnegSUM2_[individual]
			S_posSUM3 pwr_pos outSUM3 logicSUM3 0 mdl_swposSUM3_[individual]
			S_negSUM3 pwr_neg outSUM3 logicSUM3 0 mdl_swnegSUM3_[individual]
			S_posCARRYOUT pwr_pos outCARRYOUT carry4 0 mdl_swposCARRYOUT_[individual]
			S_negCARRYOUT pwr_neg outCARRYOUT carry4 0 mdl_swnegCARRYOUT_[individual]
		.ends
		// Pin order A0..A3, B0..B3, CARRY_IN, SUM0..SUM3, CARRY_OUT.
		X_[individual] [A0] [A1] [A2] [A3] [B0] [B1] [B2] [B3] [CARRY_IN] [SUM0] [SUM1] [SUM2] [SUM3] [CARRY_OUT] mdl_adder4_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -12.7 12.7) (end 12.7 -12.7)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		// Inputs: A0..A3, B0..B3, and carry-in.
		(pin input line (at -13.97 10.16 0) (length 1.27)
			(name "A0" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "A0" (at -11.43 10.16 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -13.97 7.62 0) (length 1.27)
			(name "A1" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "A1" (at -11.43 7.62 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -13.97 5.08 0) (length 1.27)
			(name "A2" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "A2" (at -11.43 5.08 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -13.97 2.54 0) (length 1.27)
			(name "A3" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "A3" (at -11.43 2.54 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -13.97 0 0) (length 1.27)
			(name "B0" (effects (font (size 1.27 1.27))))
			(number "5" (effects (font (size 1.27 1.27))))
		)
		(text "B0" (at -11.43 0 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -13.97 -2.54 0) (length 1.27)
			(name "B1" (effects (font (size 1.27 1.27))))
			(number "6" (effects (font (size 1.27 1.27))))
		)
		(text "B1" (at -11.43 -2.54 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -13.97 -5.08 0) (length 1.27)
			(name "B2" (effects (font (size 1.27 1.27))))
			(number "7" (effects (font (size 1.27 1.27))))
		)
		(text "B2" (at -11.43 -5.08 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -13.97 -7.62 0) (length 1.27)
			(name "B3" (effects (font (size 1.27 1.27))))
			(number "8" (effects (font (size 1.27 1.27))))
		)
		(text "B3" (at -11.43 -7.62 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -13.97 -10.16 0) (length 1.27)
			(name "CARRY_IN" (effects (font (size 1.27 1.27))))
			(number "9" (effects (font (size 1.27 1.27))))
		)
		(text "CIN" (at -11.43 -10.16 0) (effects (font (size 1.5 1.5))))
		// Outputs: SUM0..SUM3 and carry-out.
		(pin output line (at 13.97 7.62 180) (length 1.27)
			(name "SUM0" (effects (font (size 1.27 1.27))))
			(number "10" (effects (font (size 1.27 1.27))))
		)
		(text "SUM0" (at 10.16 7.62 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 13.97 3.81 180) (length 1.27)
			(name "SUM1" (effects (font (size 1.27 1.27))))
			(number "11" (effects (font (size 1.27 1.27))))
		)
		(text "SUM1" (at 10.16 3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 13.97 0 180) (length 1.27)
			(name "SUM2" (effects (font (size 1.27 1.27))))
			(number "12" (effects (font (size 1.27 1.27))))
		)
		(text "SUM2" (at 10.16 0 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 13.97 -3.81 180) (length 1.27)
			(name "SUM3" (effects (font (size 1.27 1.27))))
			(number "13" (effects (font (size 1.27 1.27))))
		)
		(text "SUM3" (at 10.16 -3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 13.97 -7.62 180) (length 1.27)
			(name "CARRY_OUT" (effects (font (size 1.27 1.27))))
			(number "14" (effects (font (size 1.27 1.27))))
		)
		(text "COUT" (at 10.16 -7.62 0) (effects (font (size 1.5 1.5))))
		(text "ADDER4" (at 0 8.89 0) (effects (font (size 2.54 2.54))))
	</eeschema_symbol>
	<animation>
		// Calculate decimal values of the two 4-bit inputs.
		DEFINE [A] 0
		IF V[A0] HIGHER_THAN [vth] THEN DEFINE [A] AS_MATH_ADD OF:[A] AND:1 ENDIF
		IF V[A1] HIGHER_THAN [vth] THEN DEFINE [A] AS_MATH_ADD OF:[A] AND:2 ENDIF
		IF V[A2] HIGHER_THAN [vth] THEN DEFINE [A] AS_MATH_ADD OF:[A] AND:4 ENDIF
		IF V[A3] HIGHER_THAN [vth] THEN DEFINE [A] AS_MATH_ADD OF:[A] AND:8 ENDIF
		DEFINE [A] AS_MATH_ROUND OF:[A]

		DEFINE [B] 0
		IF V[B0] HIGHER_THAN [vth] THEN DEFINE [B] AS_MATH_ADD OF:[B] AND:1 ENDIF
		IF V[B1] HIGHER_THAN [vth] THEN DEFINE [B] AS_MATH_ADD OF:[B] AND:2 ENDIF
		IF V[B2] HIGHER_THAN [vth] THEN DEFINE [B] AS_MATH_ADD OF:[B] AND:4 ENDIF
		IF V[B3] HIGHER_THAN [vth] THEN DEFINE [B] AS_MATH_ADD OF:[B] AND:8 ENDIF
		DEFINE [B] AS_MATH_ROUND OF:[B]

		// Calculate the four-bit sum. Carry-out is displayed separately.
		DEFINE [SUM] 0
		IF V[SUM0] HIGHER_THAN [vth] THEN DEFINE [SUM] AS_MATH_ADD OF:[SUM] AND:1 ENDIF
		IF V[SUM1] HIGHER_THAN [vth] THEN DEFINE [SUM] AS_MATH_ADD OF:[SUM] AND:2 ENDIF
		IF V[SUM2] HIGHER_THAN [vth] THEN DEFINE [SUM] AS_MATH_ADD OF:[SUM] AND:4 ENDIF
		IF V[SUM3] HIGHER_THAN [vth] THEN DEFINE [SUM] AS_MATH_ADD OF:[SUM] AND:8 ENDIF
		DEFINE [SUM] AS_MATH_ROUND OF:[SUM]

		// Display input and output values.
		<Text -200 -100 60 #00F000 0 "A=[A]">
		<Text -200 100 60 #00F000 0 "B=[B]">
		<Text 0 0 60 #00F000 0 "SUM=[SUM]">

		IF V[CARRY_IN] HIGHER_THAN [vth] THEN <Text -200 400 60 #00F000 0 "C=1">
		ELSE 			                      <Text -200 400 60 #00F000 0 "C=0">
		ENDIF
		
		IF V[CARRY_OUT] HIGHER_THAN [vth] THEN <Text 100 300 60 #00F000 0 "COUT=1">
		ELSE 			                       <Text 100 300 60 #00F000 0 "COUT=0">
		ENDIF
	</animation>
</Component>

// ---- Sequential logic ----
<Component>
	<Description>
		IF [language] EQUAL_TO de THEN 
		    NOR-basiertes SR-Latch mit Set- und Reset-Eingaengen im Active-High-Modus.
            Wenn S=1 und R=0 ist, wird das Latch gesetzt (Q=1, Q_NOT=0).
            Wenn S=0 und R=1 ist, wird das Latch zurückgesetzt (Q=0, Q_NOT=1).
			Wenn S = 0 und R = 0 ist, wird der vorherige Zustand beibehalten.
            Wenn S = 1 und R = 1 ist, sind bei einem Standard-NOR-Latch beide Ausgaenge auf LOW.
            Dieser gleichzeitige Set-/Reset-Zustand ist normalerweise ungueltig. Nachdem beide Eingaenge
            wieder auf LOW zurückgegangen sind, ist der resultierende Zustand durch das Standard-Latch-Modell nicht definiert.
			Ein optionaler dom-Parameter kann einen dominanten Eingang definieren:
            dom=s macht „Set“ dominant; dom=r macht „Reset“ dominant.
            Jeder Eingang wird als HIGH interpretiert, wenn seine Spannung deutlich ueber
            Vth = (vpos + vneg) / 2 liegt; andernfalls wird er als LOW interpretiert.
            Die Ausgänge werden bei HIGH auf vpos und bei LOW auf vneg angesteuert.
			Geben Sie optionale Parameter in das Wertefeld ein, zum Beispiel:
            vpos=5,0 vneg=0,0 dom=s
            Wenn sie weggelassen werden, betraegt der Standardwert fuer vpos 5,0 V und für vneg 0,0 V.
            Dies ist eine ideale Logikkomponente ohne Verzoegerung, kein Modell auf Transistorebene.
		ELSE
			NOR-based SR latch with active-HIGH Set and Reset inputs.
			When S=1 and R=0, the latch is set (Q=1, Q_NOT=0).
			When S=0 and R=1, the latch is reset (Q=0, Q_NOT=1).
			When S=0 and R=0, the previous state is retained.
			When S=1 and R=1, both outputs are LOW in the standard NOR latch.
			This simultaneous Set/Reset condition is normally invalid. After both inputs
			return LOW, the resulting state is not defined by the standard latch model.
			An optional dom parameter can define a dominant input:
			dom=s makes Set dominant; dom=r makes Reset dominant.
			Each input is interpreted as HIGH when its voltage is strictly above
			Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
			The outputs are driven to vpos for HIGH and vneg for LOW.
			Enter optional parameters in the value field, for example:
			vpos=5.0 vneg=0.0 dom=s
			If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
			This is an ideal, zero-delay logic component, not a transistor-level model.
		ENDIF
	</Description>
	<eeschema_sch>
		L anicad:SRLATCH
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // power supply values
		vpos=5.0 vneg=0.0 dom=s // dom=s states the set input to be the dominant input. 
		vpos=5.0 vneg=0.0 dom=r // dom=r states the reset input to be the dominant input. 
	</Default_Values>
	<Spice>
		// ---- supply, threshold and optional dominance parameters ----
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF

		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF

		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0

		DEFINE [dom] AS_WORD_RIGHT OF:dom IN:[value]
		DEFINE [dom_s] 0
		DEFINE [dom_r] 0
		IF [dom] EQUAL_TO s THEN DEFINE [dom_s] 1 ENDIF
		IF [dom] EQUAL_TO r THEN DEFINE [dom_r] 1 ENDIF

		// ---- output resistance parameters ----
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF

		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF

		// ---- NOR latch model ----
		.subckt mdl_srlatch_[individual] inS inR outQ outQNOT
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]

			// Active-HIGH Set and Reset; cross-coupled NOR feedback.
			// The internal logic nodes have a finite response time (R*C = 1 us).
			// Weak bias resistors select Q=LOW, Q_NOT=HIGH as the startup state.
			// They only resolve the otherwise undefined power-up state.
			B_logicQ logicQ 0 I=(V(logicQ) - (([dom_s] > 0.5 && (V(inS) > [vth]) && (V(inR) > [vth])) ? 1 : ((V(inR) > [vth]) || (V(logicQNOT) > 0.5) ? 0 : 1)))/1k
			B_logicQNOT logicQNOT 0 I=(V(logicQNOT) - (([dom_r] > 0.5 && (V(inS) > [vth]) && (V(inR) > [vth])) ? 1 : ((V(inS) > [vth]) || (V(logicQ) > 0.5) ? 0 : 1)))/1k
			C_logicQ logicQ 0 1n IC=0
			C_logicQNOT logicQNOT 0 1n IC=1
			R_initQ logicQ 0 1G
			R_initQNOT pwr_pos logicQNOT 1G
			.model mdl_swposQ_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegQ_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposQNOT_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegQNOT_[individual] sw ron=[roff] roff=[ron] vt=0.5

			S_posQ pwr_pos outQ logicQ 0 mdl_swposQ_[individual]
			S_negQ pwr_neg outQ logicQ 0 mdl_swnegQ_[individual]
			S_posQNOT pwr_pos outQNOT logicQNOT 0 mdl_swposQNOT_[individual]
			S_negQNOT pwr_neg outQNOT logicQNOT 0 mdl_swnegQNOT_[individual]
		.ends

		// Pin order S, R, Q, nQ.
		X_[individual] [S] [R] [Q] [nQ] mdl_srlatch_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -10.16 7.62) (end 10.16 -7.62)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin input line (at -11.43 3.81 0) (length 1.27)
			(name "S" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "S" (at -8.89 3.81 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -11.43 -3.81 0) (length 1.27)
			(name "R" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "R" (at -8.89 -3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 3.81 180) (length 1.27)
			(name "Q" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "Q" (at 8.89 3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 -3.81 180) (length 1.27)
			(name "nQ" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "nQ" (at 8.89 -3.81 0) (effects (font (size 1.5 1.5))))
		(text "SR LATCH" (at 0 0 0) (effects (font (size 2.0 2.0))))
	</eeschema_symbol>
	<animation>
		// Show output states: red=HIGH, blue=LOW.
		IF V[Q] HIGHER_THAN [vth] THEN
			<Line 0 0 250 -100 #FF0000 2 1 #FF0000 1 0>
		ELSE
			<Line 0 0 250 -100 #0000FF 2 1 #0000FF 1 0>
		ENDIF
		IF V[nQ] HIGHER_THAN [vth] THEN
			<Line 0 0 250 100 #FF0000 2 1 #FF0000 1 0>
		ELSE
			<Line 0 0 250 100 #0000FF 2 1 #0000FF 1 0>
		ENDIF
	</animation>
</Component>

// ---- D latch ----
<Component>
	<Description>
		IF [language] EQUAL_TO de THEN
			D-Latch mit Enable-Eingang. Solange EN=1 ist, folgt der Ausgang Q dem Dateneingang D.
			Wenn EN=0 wird, behaelt das Latch den zuletzt uebernommenen Zustand bei.
			Q_NOT ist der invertierte Ausgang von Q.
			Ein Eingang wird als HIGH interpretiert, wenn seine Spannung strikt ueber
			Vth = (vpos + vneg) / 2 liegt; andernfalls wird er als LOW interpretiert.
			Die Ausgaenge werden bei HIGH auf vpos und bei LOW auf vneg angesteuert.
			Optionale Versorgungsspannungen koennen im Wertefeld angegeben werden, z. B.:
			vpos=5.0 vneg=0.0
			Ohne Angabe gelten vpos=5.0 V und vneg=0.0 V.
			Dies ist ein ideales Logikmodell mit endlicher interner Reaktionszeit, kein Transistormodell.
		ELSE
			D latch with an Enable input. While EN=1, output Q follows data input D.
			When EN=0, the latch retains the last state captured.
			Q_NOT is the inverted output of Q.
			An input is interpreted as HIGH when its voltage is strictly above
			Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
			The outputs are driven to vpos for HIGH and vneg for LOW.
			Optional supply levels can be entered in the value field, for example:
			vpos=5.0 vneg=0.0
			If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
			This is an ideal logic model with a finite internal response time, not a transistor-level model.
		ENDIF
	</Description>
	<eeschema_sch>
		L anicad:DLATCH
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // power supply values
	</Default_Values>
	<Spice>
		// ---- supply and threshold parameters ----
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF

		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF

		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0

		// ---- output resistance parameters ----
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF

		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF

		// ---- D latch model ----
		.subckt mdl_dlatch_[individual] inD inEN outQ outQNOT
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]

			// Internal logic nodes have a finite response time (R*C = 1 us).
			// Weak bias resistors establish the initial state Q=LOW, Q_NOT=HIGH.
			B_logicQ logicQ 0 I=(V(logicQ) - ((V(inEN) > [vth]) ? (V(inD) > [vth] ? 1 : 0) : (V(logicQNOT) > 0.5 ? 0 : 1)))/1k
			B_logicQNOT logicQNOT 0 I=(V(logicQNOT) - ((V(inEN) > [vth]) ? (V(inD) > [vth] ? 0 : 1) : (V(logicQ) > 0.5 ? 0 : 1)))/1k
			C_logicQ logicQ 0 1n IC=0
			C_logicQNOT logicQNOT 0 1n IC=1
			R_initQ logicQ 0 1G
			R_initQNOT pwr_pos logicQNOT 1G

			.model mdl_swposQ_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegQ_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposQNOT_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegQNOT_[individual] sw ron=[roff] roff=[ron] vt=0.5

			S_posQ pwr_pos outQ logicQ 0 mdl_swposQ_[individual]
			S_negQ pwr_neg outQ logicQ 0 mdl_swnegQ_[individual]
			S_posQNOT pwr_pos outQNOT logicQNOT 0 mdl_swposQNOT_[individual]
			S_negQNOT pwr_neg outQNOT logicQNOT 0 mdl_swnegQNOT_[individual]
		.ends

		// Pin order D, EN, Q, nQ.
		X_[individual] [D] [EN] [Q] [nQ] mdl_dlatch_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -10.16 7.62) (end 10.16 -7.62)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin input line (at -11.43 3.81 0) (length 1.27)
			(name "D" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "D" (at -8.89 3.81 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -11.43 -3.81 0) (length 1.27)
			(name "EN" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "EN" (at -8.89 -3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 3.81 180) (length 1.27)
			(name "Q" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "Q" (at 8.89 3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 -3.81 180) (length 1.27)
			(name "nQ" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "nQ" (at 8.89 -3.81 0) (effects (font (size 1.5 1.5))))
		(text "D LATCH" (at 0 0 0) (effects (font (size 2.0 2.0))))
	</eeschema_symbol>
	<animation>
		// Show output states: red=HIGH, blue=LOW.
		IF V[Q] HIGHER_THAN [vth] THEN
			<Line 0 0 250 -100 #FF0000 2 1 #FF0000 1 0>
		ELSE
			<Line 0 0 250 -100 #0000FF 2 1 #0000FF 1 0>
		ENDIF
		IF V[nQ] HIGHER_THAN [vth] THEN
			<Line 0 0 250 100 #FF0000 2 1 #FF0000 1 0>
		ELSE
			<Line 0 0 250 100 #0000FF 2 1 #0000FF 1 0>
		ENDIF
	</animation>
</Component>

// ---- Positive-edge-triggered D flip-flop ----
<Component>
	<Description>
		IF [language] EQUAL_TO de THEN
			Positiv flankengesteuertes D-Flipflop. Bei einer steigenden Taktflanke (CLK von LOW nach HIGH)
			wird der aktuelle Zustand am Dateneingang D uebernommen und an Q ausgegeben.
			Zwischen den Taktflanken bleibt der gespeicherte Zustand erhalten. Q_NOT ist der invertierte Ausgang.
			Ein Eingang wird als HIGH interpretiert, wenn seine Spannung strikt ueber
			Vth = (vpos + vneg) / 2 liegt; andernfalls wird er als LOW interpretiert.
			Die Ausgaenge werden bei HIGH auf vpos und bei LOW auf vneg angesteuert.
			Optionale Versorgungsspannungen koennen im Wertefeld angegeben werden, z. B.:
			vpos=5.0 vneg=0.0
			Ohne Angabe gelten vpos=5.0 V und vneg=0.0 V.
			Dies ist ein ideales Logikmodell mit endlicher interner Reaktionszeit, kein Transistormodell.
		ELSE
			Positive-edge-triggered D flip-flop. On a rising clock edge (CLK from LOW to HIGH),
			the current state at data input D is captured and appears at Q.
			The stored state is retained between clock edges. Q_NOT is the inverted output.
			An input is interpreted as HIGH when its voltage is strictly above
			Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
			The outputs are driven to vpos for HIGH and vneg for LOW.
			Optional supply levels can be entered in the value field, for example:
			vpos=5.0 vneg=0.0
			If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
			This is an ideal logic model with a finite internal response time, not a transistor-level model.
		ENDIF
	</Description>
	<eeschema_sch>
		L anicad:DFF
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // power supply values
	</Default_Values>
	<Spice>
		// ---- supply and threshold parameters ----
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF

		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF

		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0

		// ---- output resistance parameters ----
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF

		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF

		// ---- master-slave D flip-flop model ----
		.subckt mdl_dff_[individual] inD inCLK outQ outQNOT
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]

			// Master latch is transparent while CLK is LOW.
			// Slave latch is transparent while CLK is HIGH.
			// Each internal state node has a finite response time (R*C = 1 us).
			// Weak bias resistors establish the initial state Q=LOW, Q_NOT=HIGH.
			B_masterQ masterQ 0 I=(V(masterQ) - ((V(inCLK) > [vth]) ? (V(masterQNOT) > 0.5 ? 0 : 1) : (V(inD) > [vth] ? 1 : 0)))/1k
			B_masterQNOT masterQNOT 0 I=(V(masterQNOT) - ((V(inCLK) > [vth]) ? (V(masterQ) > 0.5 ? 0 : 1) : (V(inD) > [vth] ? 0 : 1)))/1k
			C_masterQ masterQ 0 1n IC=0
			C_masterQNOT masterQNOT 0 1n IC=1
			R_initMasterQ masterQ 0 1G
			R_initMasterQNOT pwr_pos masterQNOT 1G

			B_slaveQ slaveQ 0 I=(V(slaveQ) - ((V(inCLK) > [vth]) ? (V(masterQ) > 0.5 ? 1 : 0) : (V(slaveQNOT) > 0.5 ? 0 : 1)))/1k
			B_slaveQNOT slaveQNOT 0 I=(V(slaveQNOT) - ((V(inCLK) > [vth]) ? (V(masterQ) > 0.5 ? 0 : 1) : (V(slaveQ) > 0.5 ? 0 : 1)))/1k
			C_slaveQ slaveQ 0 1n IC=0
			C_slaveQNOT slaveQNOT 0 1n IC=1
			R_initSlaveQ slaveQ 0 1G
			R_initSlaveQNOT pwr_pos slaveQNOT 1G

			.model mdl_swposQ_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegQ_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposQNOT_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegQNOT_[individual] sw ron=[roff] roff=[ron] vt=0.5

			S_posQ pwr_pos outQ slaveQ 0 mdl_swposQ_[individual]
			S_negQ pwr_neg outQ slaveQ 0 mdl_swnegQ_[individual]
			S_posQNOT pwr_pos outQNOT slaveQNOT 0 mdl_swposQNOT_[individual]
			S_negQNOT pwr_neg outQNOT slaveQNOT 0 mdl_swnegQNOT_[individual]
		.ends

		// Pin order D, CLK, Q, nQ.
		X_[individual] [D] [CLK] [Q] [nQ] mdl_dff_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -10.16 7.62) (end 10.16 -7.62)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin input line (at -11.43 3.81 0) (length 1.27)
			(name "D" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "D" (at -8.89 3.81 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -11.43 -3.81 0) (length 1.27)
			(name "CLK" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "CLK" (at -5.08 -3.81 0) (effects (font (size 1.5 1.5))))
		(polyline (pts (xy -10.16 -5.08) (xy -8.89 -3.81) (xy -10.16 -2.54))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		
		(pin output line (at 11.43 3.81 180) (length 1.27)
			(name "Q" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "Q" (at 8.89 3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 -3.81 180) (length 1.27)
			(name "nQ" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "nQ" (at 8.89 -3.81 0) (effects (font (size 1.5 1.5))))
		(text "D-ff" (at 0 5 0) (effects (font (size 2.5 2.5))))
		
	</eeschema_symbol>
	<animation>
		// Show output states: red=HIGH, blue=LOW.
		IF V[Q] HIGHER_THAN [vth] THEN
			<Line 0 0 250 -100 #FF0000 2 1 #FF0000 1 0>
		ELSE
			<Line 0 0 250 -100 #0000FF 2 1 #0000FF 1 0>
		ENDIF
		IF V[nQ] HIGHER_THAN [vth] THEN
			<Line 0 0 250 100 #FF0000 2 1 #FF0000 1 0>
		ELSE
			<Line 0 0 250 100 #0000FF 2 1 #0000FF 1 0>
		ENDIF
	</animation>
</Component>

// ---- Positive-edge-triggered JK flip-flop ----
<Component>
	<Description>
		IF [language] EQUAL_TO de THEN
			Positiv flankengesteuertes JK-Flipflop mit den Eingangen J und K.
			Bei einer steigenden Taktflanke wird der Folgezustand uebernommen:
			J=0, K=0: Zustand bleibt erhalten; J=0, K=1: Q wird LOW;
			J=1, K=0: Q wird HIGH; J=1, K=1: Q wechselt seinen Zustand (Toggle).
			Zwischen den Taktflanken bleibt der gespeicherte Zustand erhalten.
			Q_NOT ist der invertierte Ausgang.
			Ein Eingang wird als HIGH interpretiert, wenn seine Spannung strikt ueber
			Vth = (vpos + vneg) / 2 liegt; andernfalls wird er als LOW interpretiert.
			Die Ausgaenge werden bei HIGH auf vpos und bei LOW auf vneg angesteuert.
			Optionale Versorgungsspannungen koennen im Wertefeld angegeben werden, z. B.:
			vpos=5.0 vneg=0.0
			Ohne Angabe gelten vpos=5.0 V und vneg=0.0 V.
			Dies ist ein ideales Logikmodell mit endlicher interner Reaktionszeit, kein Transistormodell.
		ELSE
			Positive-edge-triggered JK flip-flop with J and K inputs.
			At a rising clock edge, the next state is captured:
			J=0, K=0: state is retained; J=0, K=1: Q is reset LOW;
			J=1, K=0: Q is set HIGH; J=1, K=1: Q toggles.
			The stored state is retained between clock edges.
			Q_NOT is the inverted output.
			An input is interpreted as HIGH when its voltage is strictly above
			Vth = (vpos + vneg) / 2; otherwise it is interpreted as LOW.
			The outputs are driven to vpos for HIGH and vneg for LOW.
			Optional supply levels can be entered in the value field, for example:
			vpos=5.0 vneg=0.0
			If omitted, vpos defaults to 5.0 V and vneg defaults to 0.0 V.
			This is an ideal logic model with a finite internal response time, not a transistor-level model.
		ENDIF
	</Description>
	<eeschema_sch>
		L anicad:JKFF
	</eeschema_sch>
	<Default_Values>
		vpos=5.0 vneg=0.0 // power supply values
	</Default_Values>
	<Spice>
		// ---- supply and threshold parameters ----
		DEFINE [vpos] AS_WORD_RIGHT OF:vpos IN:[value]
		IF [vpos] THEN DEFINE [vpos] AS_NUMBER OF:[vpos] ENDIF
		IF ![vpos] THEN DEFINE [vpos] 5.0 ENDIF

		DEFINE [vneg] AS_WORD_RIGHT OF:vneg IN:[value]
		IF [vneg] THEN DEFINE [vneg] AS_NUMBER OF:[vneg] ENDIF
		IF ![vneg] THEN DEFINE [vneg] 0.0 ENDIF

		DEFINE [vth] AS_MATH_ADD OF:[vpos] AND:[vneg]
		DEFINE [vth] AS_MATH_DIV OF:[vth] AND:2.0

		// ---- output resistance parameters ----
		DEFINE [ron] AS_WORD_RIGHT OF:ron IN:[value]
		IF [ron] THEN DEFINE [ron] AS_NUMBER OF:[ron] ENDIF
		IF ![ron] THEN DEFINE [ron] 1.0 ENDIF

		DEFINE [roff] AS_WORD_RIGHT OF:roff IN:[value]
		IF [roff] THEN DEFINE [roff] AS_NUMBER OF:[roff] ENDIF
		IF ![roff] THEN DEFINE [roff] 1E9 ENDIF

		// ---- master-slave JK flip-flop model ----
		.subckt mdl_jkff_[individual] inJ inK inCLK outQ outQNOT
			Vpos pwr_pos 0 [vpos]
			Vneg pwr_neg 0 [vneg]

			// Master latch is transparent while CLK is LOW.
			// It evaluates the JK next-state function using the held slave output.
			// Slave latch is transparent while CLK is HIGH.
			// Each internal state node has a finite response time (R*C = 1 us).
			// Weak bias resistors establish the initial state Q=LOW, Q_NOT=HIGH.
			B_masterQ masterQ 0       I=(V(masterQ) - ((V(inCLK) > [vth])    ? (V(masterQ) > 0.5 ? 1 : 0)     : (((V(inJ) > [vth]) && (V(slaveQ) <= 0.5)) || ((V(inK) <= [vth]) && (V(slaveQ) > 0.5)) ? 1 : 0)))/1k
			B_masterQNOT masterQNOT 0 I=(V(masterQNOT) - ((V(inCLK) > [vth]) ? (V(masterQNOT) > 0.5 ? 1 : 0) : (((V(inJ) <= [vth]) && (V(slaveQ) <= 0.5)) || ((V(inK) > [vth]) && (V(slaveQ) > 0.5)) ? 1 : 0)))/1k
			C_masterQ masterQ 0 1n IC=0
			C_masterQNOT masterQNOT 0 1n IC=1
			R_initMasterQ masterQ 0 1G
			R_initMasterQNOT pwr_pos masterQNOT 1G

			B_slaveQ slaveQ 0 I=(V(slaveQ) - ((V(inCLK) > [vth]) ? (V(masterQ) > 0.5 ? 1 : 0) : (V(slaveQNOT) > 0.5 ? 0 : 1)))/1k
			B_slaveQNOT slaveQNOT 0 I=(V(slaveQNOT) - ((V(inCLK) > [vth]) ? (V(masterQ) > 0.5 ? 0 : 1) : (V(slaveQ) > 0.5 ? 0 : 1)))/1k
			C_slaveQ slaveQ 0 1n IC=0
			C_slaveQNOT slaveQNOT 0 1n IC=1
			R_initSlaveQ slaveQ 0 1G
			R_initSlaveQNOT pwr_pos slaveQNOT 1G

			.model mdl_swposQ_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegQ_[individual] sw ron=[roff] roff=[ron] vt=0.5
			.model mdl_swposQNOT_[individual] sw ron=[ron] roff=[roff] vt=0.5
			.model mdl_swnegQNOT_[individual] sw ron=[roff] roff=[ron] vt=0.5

			S_posQ pwr_pos outQ slaveQ 0 mdl_swposQ_[individual]
			S_negQ pwr_neg outQ slaveQ 0 mdl_swnegQ_[individual]
			S_posQNOT pwr_pos outQNOT slaveQNOT 0 mdl_swposQNOT_[individual]
			S_negQNOT pwr_neg outQNOT slaveQNOT 0 mdl_swnegQNOT_[individual]
		.ends

		// Pin order J, K, CLK, Q, nQ.
		X_[individual] [J] [K] [CLK] [Q] [nQ] mdl_jkff_[individual]
	</Spice>
	<eeschema_symbol>
		(rectangle (start -10.16 7.62) (end 10.16 -7.62)
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(text "JK-FF" (at 0 5.08 0) (effects (font (size 2.54 2.54))))
		(pin input line (at -11.43 5.08 0) (length 1.27)
			(name "J" (effects (font (size 1.27 1.27))))
			(number "1" (effects (font (size 1.27 1.27))))
		)
		(text "J" (at -8.89 5.08 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -11.43 0 0) (length 1.27)
			(name "K" (effects (font (size 1.27 1.27))))
			(number "2" (effects (font (size 1.27 1.27))))
		)
		(text "K" (at -8.89 0 0) (effects (font (size 1.5 1.5))))
		(pin input line (at -11.43 -5.08 0) (length 1.27)
			(name "CLK" (effects (font (size 1.27 1.27))))
			(number "3" (effects (font (size 1.27 1.27))))
		)
		(text "CLK" (at -5.08 -5.08 0) (effects (font (size 1.5 1.5))))
		(polyline (pts (xy -10.16 -6.35) (xy -8.89 -5.08) (xy -10.16 -3.81))
			(stroke (width 0) (type default))
			(fill (type none))
		)
		(pin output line (at 11.43 3.81 180) (length 1.27)
			(name "Q" (effects (font (size 1.27 1.27))))
			(number "4" (effects (font (size 1.27 1.27))))
		)
		(text "Q" (at 8.89 3.81 0) (effects (font (size 1.5 1.5))))
		(pin output line (at 11.43 -3.81 180) (length 1.27)
			(name "nQ" (effects (font (size 1.27 1.27))))
			(number "5" (effects (font (size 1.27 1.27))))
		)
		(text "nQ" (at 8.89 -3.81 0) (effects (font (size 1.5 1.5))))
		
	</eeschema_symbol>
	<animation>
		// Show output states: red=HIGH, blue=LOW.
		IF V[Q] HIGHER_THAN [vth] THEN
			<Line 0 0 250 -100 #FF0000 2 1 #FF0000 1 0>
		ELSE
			<Line 0 0 250 -100 #0000FF 2 1 #0000FF 1 0>
		ENDIF
		IF V[nQ] HIGHER_THAN [vth] THEN
			<Line 0 0 250 100 #FF0000 2 1 #FF0000 1 0>
		ELSE
			<Line 0 0 250 100 #0000FF 2 1 #0000FF 1 0>
		ENDIF
	</animation>
</Component>

// ---- 7-segment LED display ----
<Component>
	<Description>
		IF [language] EQUAL_TO de THEN
			Einstellige 7-Segment-LED-Anzeige mit zusaetzlichem Dezimalpunkt.
			Die acht LEDs koennen einzeln ueber die Anschluesse A bis G und DP angesteuert werden.
			Der gemeinsame Anschluss heisst COM. Mit com=c wird eine gemeinsame Kathode gewaehlt,
			mit com=a eine gemeinsame Anode. Ohne Angabe gilt com=c.
			Die Anzeige verwendet rote LEDs mit einem Nennstrom von 10 mA.
			Fuer die Helligkeitsdarstellung wird der Betrag des jeweiligen LED-Stroms verwendet.
		ELSE
			Single-digit seven-segment LED display with an additional decimal point.
			The eight LEDs can be controlled individually through pins A to G and DP.
			The common connection is named COM. Set com=c for common cathode or com=a
			for common anode. The default is com=c.
			The display uses red LEDs with a nominal current of 10 mA.
			The brightness animation is based on the absolute value of each LED current.
		ENDIF
	</Description>
	<eeschema_sch>
		L anicad:7SEG
	</eeschema_sch>
	<Default_Values>
		com=c // common cathode
		com=a // common anode
	</Default_Values>
	<Spice>
		// ---- common connection configuration ----
		DEFINE [com] AS_WORD_RIGHT OF:com IN:[value]
		DEFINE [com] AS_LOWERCASE OF:[com]
		IF ![com] THEN DEFINE [com] c ENDIF

		// ---- red LED model ----
		// Typical red LED parameters; nominal current is 10 mA.
		.model mdl_7seg_led_[individual] D (is=1e-18 n=2 rs=10)

		// ---- eight LEDs ----
		.subckt mdl_7seg_[individual] inA inB inC inD inE inF inG inDP inCOM
			IF [com] EQUAL_TO a THEN
				// Common anode: COM is connected to the anodes.
				D_A inCOM inA mdl_7seg_led_[individual]
				D_B inCOM inB mdl_7seg_led_[individual]
				D_C inCOM inC mdl_7seg_led_[individual]
				D_D inCOM inD mdl_7seg_led_[individual]
				D_E inCOM inE mdl_7seg_led_[individual]
				D_F inCOM inF mdl_7seg_led_[individual]
				D_G inCOM inG mdl_7seg_led_[individual]
				D_DP inCOM inDP mdl_7seg_led_[individual]
			ELSE
				// Common cathode: COM is connected to the cathodes.
				D_A inA inCOM mdl_7seg_led_[individual]
				D_B inB inCOM mdl_7seg_led_[individual]
				D_C inC inCOM mdl_7seg_led_[individual]
				D_D inD inCOM mdl_7seg_led_[individual]
				D_E inE inCOM mdl_7seg_led_[individual]
				D_F inF inCOM mdl_7seg_led_[individual]
				D_G inG inCOM mdl_7seg_led_[individual]
				D_DP inDP inCOM mdl_7seg_led_[individual]
			ENDIF
		.ends

		// Pin order A, B, C, D, E, F, G, DP, COM.
		X_[individual] [A] [B] [C] [D] [E] [F] [G] [DP] [COM] mdl_7seg_[individual]
	</Spice>
	<animation>
		// Segment opacity is proportional to LED current:
		// 10 mA corresponds to full opacity. Absolute current supports both COM modes.
		DEFINE [curr_sec_a] I[A]
		DEFINE [curr_sec_a] AS_MATH_ABS OF:[curr_sec_a]
		DEFINE [opacity_sec_a] AS_MATH_MUL OF:[curr_sec_a] AND:100
		DEFINE [opacity_sec_a] AS_MATH_MIN OF:[opacity_sec_a] AND:1.0

		DEFINE [curr_sec_b] I[B]
		DEFINE [curr_sec_b] AS_MATH_ABS OF:[curr_sec_b]
		DEFINE [opacity_sec_b] AS_MATH_MUL OF:[curr_sec_b] AND:100
		DEFINE [opacity_sec_b] AS_MATH_MIN OF:[opacity_sec_b] AND:1.0

		DEFINE [curr_sec_c] I[C]
		DEFINE [curr_sec_c] AS_MATH_ABS OF:[curr_sec_c]
		DEFINE [opacity_sec_c] AS_MATH_MUL OF:[curr_sec_c] AND:100
		DEFINE [opacity_sec_c] AS_MATH_MIN OF:[opacity_sec_c] AND:1.0

		DEFINE [curr_sec_d] I[D]
		DEFINE [curr_sec_d] AS_MATH_ABS OF:[curr_sec_d]
		DEFINE [opacity_sec_d] AS_MATH_MUL OF:[curr_sec_d] AND:100
		DEFINE [opacity_sec_d] AS_MATH_MIN OF:[opacity_sec_d] AND:1.0

		DEFINE [curr_sec_e] I[E]
		DEFINE [curr_sec_e] AS_MATH_ABS OF:[curr_sec_e]
		DEFINE [opacity_sec_e] AS_MATH_MUL OF:[curr_sec_e] AND:100
		DEFINE [opacity_sec_e] AS_MATH_MIN OF:[opacity_sec_e] AND:1.0

		DEFINE [curr_sec_f] I[F]
		DEFINE [curr_sec_f] AS_MATH_ABS OF:[curr_sec_f]
		DEFINE [opacity_sec_f] AS_MATH_MUL OF:[curr_sec_f] AND:100
		DEFINE [opacity_sec_f] AS_MATH_MIN OF:[opacity_sec_f] AND:1.0

		DEFINE [curr_sec_g] I[G]
		DEFINE [curr_sec_g] AS_MATH_ABS OF:[curr_sec_g]
		DEFINE [opacity_sec_g] AS_MATH_MUL OF:[curr_sec_g] AND:100
		DEFINE [opacity_sec_g] AS_MATH_MIN OF:[opacity_sec_g] AND:1.0

		DEFINE [curr_sec_dp] I[DP]
		DEFINE [curr_sec_dp] AS_MATH_ABS OF:[curr_sec_dp]
		DEFINE [opacity_sec_dp] AS_MATH_MUL OF:[curr_sec_dp] AND:100
		DEFINE [opacity_sec_dp] AS_MATH_MIN OF:[opacity_sec_dp] AND:1.0

		// The rectangles are positioned over the corresponding display segments.
		<Rectangle -150 250 300 50 #808080 1 1 #808080 1 [opacity_sec_a]>
		<Rectangle 150 25 50 225 #808080 1 1 #808080 1 [opacity_sec_b]>
		<Rectangle 150 -250 50 225 #808080 1 1 #808080 1 [opacity_sec_c]>
		<Rectangle -150 -300 300 50 #808080 1 1 #808080 1 [opacity_sec_d]>
		<Rectangle -200 -250 50 225 #808080 1 1 #808080 1 [opacity_sec_e]>
		<Rectangle -200 25 50 225 #808080 1 1 #808080 1 [opacity_sec_f]>
		<Rectangle -150 -25 300 50 #808080 1 1 #808080 1 [opacity_sec_g]>
		<Rectangle 225 -325 50 50 #808080 1 1 #808080 1 [opacity_sec_dp]>
	</animation>
	<eeschema_symbol>
		// Default XML-style symbol format, matching the animation geometry.
		<Rectangle -250 -350 550 700 #808080 1 1 #000000 1 0>
		// Seven grey segments and decimal point.
		<Rectangle -150 250 300 50 #808080 1 1 #808080 1 1>
		<Rectangle 150 25 50 225 #808080 1 1 #808080 1 1>
		<Rectangle 150 -250 50 225 #808080 1 1 #808080 1 1>
		<Rectangle -150 -300 300 50 #808080 1 1 #808080 1 1>
		<Rectangle -200 -250 50 225 #808080 1 1 #808080 1 1>
		<Rectangle -200 25 50 225 #808080 1 1 #808080 1 1>
		<Rectangle -150 -25 300 50 #808080 1 1 #808080 1 1>
		<Rectangle 225 -325 50 50 #808080 1 1 #808080 1 1>

		// Segment pins.
		<.PortSym 0 -450 [A]>
		<.PortSym 350 -200 [B]>
		<.PortSym 350 200 [C]>
		<.PortSym 150 450 [D]>
		<.PortSym -350 200 [E]>
		<.PortSym -350 -200 [F]>
		<.PortSym -350 0 [G]>
		<.PortSym 350 325 [DP]>
		<.PortSym -150 450 [COM]>
	</eeschema_symbol>
</Component>

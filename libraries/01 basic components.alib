		// model:
		.subckt switch_DIP_[individual] a1 b1 
			Vctrl ctrl 0 [share] IF[t_repeat]THEN r=[t_repeat]ENDIF IF[t_delay]THEN td=[t_delay]ENDIF
			R1 a1 b1 r='V(ctrl) > 0.5 ?  [r_on] : [r_off]'
		.ends
		// component:
		X_[individual] [A1] [B1]  switch_DIP_[individual]
	</Spice>
</Component>
	

<Component>
	<Description>
        A changeover switch that changes between A and nA.
		A is in normal logic, behaves like the normal switch above, and nA is in inversed logic.
		Here a switch is simulated by two time dependent resistors, where one connects and the other one blocks.
		The connecting resistor has r_on ohms (r_on is 0.1 by default)
		The blocking resistor has r_off ohms (r_off is 1E12=1 000 000 000 000 by default)
		IF[s_type] STARTS_WITH pulse THEN
		---- pulse switch: ----
		a pulsed switch turns on and off regularly. Its parameters are:
			t_off defines the duration in seconds of the non-connecting status.
			t_on defines the duration in seconds of the connecting status.
		ENDIF IF[s_type] STARTS_WITH pwl THEN
		---- piece-wise linear (pwl) switch ----
		A piece-wise linear switch is turned on and off at times that are defined by a list of switch times.
		You can give as many switch times as you want. Each switch time is defined by a pair of two numbers:
		The first number is the point of time, given in seconds. The second number is either 1=on or 0=off.
		For example, the following value consists of three such pairs, which are saying: at 0ms start at off, until 1.5ms stay off, by 1.6ms switch on.
		(the last statement will make the switch turn on in the middle of 1.5ms and 1.6ms, which is at 1.55ms):
		
		type=pwl times=(0ms 0 1.5ms 0 1.6ms 1)
		
		for readability, the brackets ( and ) may be omitted, and values may be separated by commas or semicolons. 
		For example, the following line does the same:
		
		type=pwl times=0ms off, 1.5ms off; 1.6ms on
		
		The times list must be the last argument of the value: if you want to define r_on r_off t_delay or t_repeat , you must
		type them BEFORE the times list. This is due to the undefined length of that list, it just goes until the end of the value text.

		Expert users are advised to read the ngspice user manual chapter 4.1.4 "Piece-Wise Linear" Voltage sources
		for further details, since this switch is controlled in the numeric simulation by a PWL Vsource. 
		ENDIF
    </Description>
	<Default_Values>
		on // a switch that connects to A (and therefor blocks nA)
		off // a switch that blocks A (and therefor connects nA)
		s_type=pulse t_on=2ms t_off=1ms t_delay=3ms // a switch that repeatedly is turned on and off. starts at t_delay and is on for t_on and is off for t_off. So the period is t_on+toff. 
		s_type=pulse t_on=2ms t_off=1ms r_on=0.5 r_off=100k // a switch that turns on and off, and where on and off resistance ohm values are specified
		s_type=pwl times=0ms off; 1ms off; 1.1ms on; 3ms on; 3.1ms off // a switch that starts at off state, stays off until 1ms, switches on at 1.1ms, stays on until 3ms and switches off at 3.1ms (and then stays off).
		s_type=pwl t_repeat=5ms t_delay=0.2ms times=0ms off; 1ms off; 1.1ms on; 3ms on; 3.1ms off  // a switch that does as the previous one, but repeats this switching all 5ms
   </Default_Values>
	<eeschema_sch>
        L anicad:switch_AB
    </eeschema_sch>
	<eeschema_symbol>
		// ---- on and off Ohm values ----
		DEFINE [r_on] AS_WORD_RIGHT OF:r_on IN:[value]
		DEFINE [r_on] AS_NUMBER OF:[r_on]
		IF ![r_on] THEN DEFINE [r_on] 0.1 ENDIF
		
		DEFINE [r_off] AS_WORD_RIGHT OF:r_off IN:[value]
		DEFINE [r_off] AS_NUMBER OF:[r_off]
		IF ![r_off] THEN DEFINE [r_off] 1E12 ENDIF
		
		//threshold for on/off symbol
        DEFINE [r_threshold] AS_MATH_ADD OF:[r_on] AND:[r_off]
        DEFINE [r_threshold] AS_MATH_DIV OF:[r_threshold] AND:2

	
		// ---- switch types ----
		// -- simple case, just on or off permanently: --
		IF [value] EQUAL_TO on || [value] EQUAL_TO ON || [value] EQUAL_TO On THEN
			DEFINE [permanent] on
			DEFINE [share] DC 1
		
		ELSE IF [value] EQUAL_TO off || [value] EQUAL_TO OFF || [value] EQUAL_TO Off THEN
				DEFINE [permanent] off
				DEFINE [share] DC 0
			ELSE
				DEFINE [permanent] AS_NULL
			ENDIF
		ENDIF
		// ---- a bit more complex case, switching changes over time ----
		IF ! [permanent] THEN
			DEFINE [s_type] AS_WORD_RIGHT OF:s_type  IN:[value]
			IF [s_type] STARTS_WITH pulse THEN
					
				DEFINE [t_off] AS_WORD_RIGHT OF:t_off IN:[value]
				DEFINE [t_off] AS_NUMBER OF:[t_off]
				
				DEFINE [t_on] AS_WORD_RIGHT OF:t_on IN:[value]
				DEFINE [t_on] AS_NUMBER OF:[t_on]
				
				DEFINE [t_period] AS_WORD_RIGHT OF:t_period IN:[value]
				DEFINE [t_period] AS_NUMBER OF:[t_period]
				IF ![t_period] THEN
					DEFINE [t_period] AS_MATH_ADD OF:[t_on] AND:[t_off]
				ENDIF
				
				DEFINE [t_delay] AS_WORD_RIGHT OF:t_delay IN:[value]
				DEFINE [t_delay] AS_NUMBER OF:[t_delay]
				IF ![t_delay] THEN DEFINE [t_delay] 0 ENDIF
				
				DEFINE [share] PULSE (0 1 [t_delay] 0 0 [t_on] [t_period])
			ENDIF
			IF [s_type] STARTS_WITH pwl THEN
				DEFINE [times] AS_SUBTEXT AFTER:timesBEFORE:)OF:[value]
				DEFINE [times] AS_LOWERCASE OF:[times]
				DEFINE [times] AS_REPLACEMENT FROM:=TO: OF:[times]
				DEFINE [times] AS_REPLACEMENT FROM:(TO: OF:[times]
				DEFINE [times] AS_REPLACEMENT FROM:)TO: OF:[times]
				DEFINE [times] AS_REPLACEMENT FROM:,TO: OF:[times]
				DEFINE [times] AS_REPLACEMENT FROM:;TO: OF:[times]
				DEFINE [times] AS_REPLACEMENT FROM:offTO: 0 OF:[times]
				DEFINE [times] AS_REPLACEMENT FROM:onTO: 1 OF:[times]
				DEFINE [times] AS_REPLACEMENT FROM:s_typeTO: OF:[times]
				DEFINE [times] AS_REPLACEMENT FROM:pwlTO: OF:[times]
				
				DEFINE [t_delay] AS_WORD_RIGHT OF:t_delay IN:[value]
				DEFINE [t_delay] AS_NUMBER OF:[t_delay]
				
				DEFINE [t_repeat] AS_WORD_RIGHT OF:t_repeat IN:[value]
				DEFINE [t_repeat] AS_NUMBER OF:[t_repeat]
				
				IF [times] THEN
					DEFINE [share] PWL ([times]) 
				ELSE
					<Dialog type="error">
						The times list in the switch are not correctly defined.
						
						Please correct these values.
					</Dialog>
				ENDIF
			ENDIF
		ENDIF
		
		(rectangle (start -3.81 5.08) (end 3.81 -1.27)
		  (stroke (width 0) (type default))
		  (fill (type background))
		)
		//C -80 0 20 0 0 0 N
		(circle (center -2.032 0) (radius 0.508)
		  (stroke (width 0) (type default))
		  (fill (type none))
		)	
		//C 80 0 20 0 0 0 N
		(circle (center 2.032 0) (radius 0.508)
		  (stroke (width 0) (type default))
		  (fill (type none))
		)	
		IF [permanent] THEN
			IF [permanent] EQUAL_TO off THEN
				//P 2 0 0 0 -60 5 93 46 N
				(polyline
				  (pts
					(xy 2.54 0)
					(xy -2.54 1.27)
				  )
				  (stroke (width 0) (type default))
				  (fill (type none))
				)				
			ENDIF
			IF [permanent] EQUAL_TO on THEN
				(polyline
				  (pts
					(xy 2.54 0)
					(xy -2.54 0.635)
				  )
				  (stroke (width 0) (type default))
				  (fill (type none))
				)
			ENDIF
		ELSE
			//<Line startx starty dx dy color pendwidth penstyle >
			//P 2 0 1 0 -60  5 60 30 N
			(polyline
			  (pts
				(xy 2.54 0)
				(xy -2.54 0.889)
			  )
			  (stroke (width 0) (type default))
			  (fill (type none))
			)
		ENDIF
		
		//X A1 1 -300 0 200 R 50 50 1 1 P
		(pin input line (at -7.62 0 0) (length 5.08)
		  (name "A1" (effects (font (size 1.27 1.27))))
		  (number "1" (effects (font (size 1.27 1.27))))
		)	
		//X B1 2 300 0 200 L 50 50 1 1 P    
		(pin input line (at 7.62 0 180) (length 5.08)
		  (name "B1" (effects (font (size 1.27 1.27))))
		  (number "2" (effects (font (size 1.27 1.27))))
		)
		// inverting pin "nA"
		(polyline
		  (pts
			(xy -2.032 2.54)
			(xy -2.032 3.81)
		  )
		  (stroke (width 0) (type default))
		  (fill (type none))
		)
		(pin input line (at -7.62 3.81 0) (length 5.588)
		  (name "nA" (effects (font (size 1.27 1.27))))
		  (number "3" (effects (font (size 1.27 1.27))))
		)
		(circle (center -2.032 1.905) (radius 0.508)
		  (stroke (width 0) (type default))
		  (fill (type none))
		)


	</eeschema_symbol>
	<animation>
        DEFINE [volt] AS_MATH_SUB OF:V[A1] AND:V[B1]
        DEFINE [amp] I[A1]
		DEFINE [ohm] AS_MATH_DIV OF:[volt] AND:[amp]
		DEFINE [ohm] AS_MATH_ABS OF:[ohm]
		
		IF [ohm] THEN
			IF [ohm] HIGHER_THAN [r_threshold] THEN 
				<Rectangle -150 -50 200 100 #880000 2 1 #000080 1 0.8>// draw a red rectangle, covering the non-animated "background" switch
				P 2 0 0 0 60 5 -93 50 N	// draw an open, non-conducting switch
				<Rectangle -150 -150 300 100 #008800 2 1 #000080 1 0.8>// other rectangle for nA
				<Rectangle 150 -50 -100 100 #008800 2 1 #000080 1 0.8>// other rectangle for nA
			ENDIF
			IF [ohm] LOWER_THAN [r_threshold] THEN
				<Rectangle -150 -50 300 100 #008800 2 1 #000080 1 0.8>// draw a green rectangle, showing that it is connected 
				P 2 0 0 0 60 0 -95 22 N// draw a closed, conducting switch
				<Rectangle -150 -150 300 100 #880000 2 1 #000080 1 0.8>// other rectangle for nA
				
			ENDIF
			C -80 0 20 0 0 0 N
			C 80 0 20 0 0 0 N

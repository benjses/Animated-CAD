<Component>
    <Description>
        A Lamp. In reality there are many types of lamps, with many different electrical properties.
        Here a lamp is simulated by a resistance, which might match more or less to some lamp types, but will not match well to other lamp types.
		But if you specify a Henry value as well, then this model also considers the inductivity of the lamp's wire.
		
		If you specify the nominal power Pn, then the animation will make the lamp shine. The lamp's shining intensity is
		relative to the share of actual power to nominal power. The nominal power may also be defined by giving nominal current In and nominal voltage Un.
	</Description>
    <eeschema_sch>
        L Device:Lamp
    </eeschema_sch>
    <Default_Values>
		Un=6V Pn=0.3W // A lamp defined by nominal voltage and nominal power. 
		Un=6V In=50mA // A lamp defined by nominal voltage and nominal current.
        R=100 Ohm L=2.2mH // ohm and henry value of a lamp's wire
		R=100 Ohm L=2.2mH Pn=2W // ohm and henry value of a lamp's wire. Nominal power is needed for animation of lamp. 
	</Default_Values>
    <Spice>
	   DEFINE [ohms] AS_WORD_RIGHT OF:R IN:[value]
       DEFINE [ohms] AS_NUMBER OF:[ohms]
       DEFINE [henry] AS_WORD_RIGHT OF:L IN:[value]
       DEFINE [henry] AS_NUMBER OF:[henry]
       DEFINE [watt_nominal] AS_WORD_RIGHT OF:Pn IN:[value]
	   DEFINE [watt_nominal] AS_NUMBER OF:[watt_nominal]
	   DEFINE [volt_nominal] AS_WORD_RIGHT OF:Un  IN:[value]
	   DEFINE [volt_nominal] AS_NUMBER OF:[volt_nominal]
	   DEFINE [amps_nominal] AS_WORD_RIGHT OF:In IN:[value]
	   DEFINE [amps_nominal] AS_NUMBER OF:[amps_nominal]
	   
	   IF ![amps_nominal] THEN
			IF[volt_nominal] && [watt_nominal] THEN
				DEFINE [amps_nominal] AS_MATH_DIV OF:[watt_nominal] AND:[volt_nominal]
			ELSE IF [ohms] AND [volt_nominal] THEN
					DEFINE [amps_nominal] AS_MATH_DIV OF:[volt_nominal] AND:[ohms]
				 ENDIF
			ENDIF
	   ENDIF
	   
	   IF ![volt_nominal] THEN
			IF [watt_nominal] && [amps_nominal] THEN
				DEFINE [volt_nominal] AS_MATH_DIV OF:[watt_nominal] AND:[amps_nominal]
			ENDIF
		ENDIF
	   
	   IF ![ohms] THEN
			IF [volt_nominal] && [amps_nominal] THEN
				DEFINE [ohms] AS_MATH_DIV OF:[volt_nominal] AND:[amps_nominal]
			ENDIF
	   ENDIF
	   
	   IF ![watt_nominal] THEN
		IF [volt_nominal] && [amps_nominal] THEN
			DEFINE [watt_nominal] AS_MATH_MUL OF:[volt_nominal] AND:[amps_nominal]
		ENDIF
	   ENDIF

		IF [ohms] && [henry] THEN
        .subckt DEVICE_LAMP_[individual] 1 2
           R_Lamp 1 mid [ohms]
           L_Lamp mid 2 [henry]
        .ends
        X_Lamp_[individual] [pin1] [pin2] DEVICE_LAMP_[individual]
		ELSE 
		   IF [ohms] THEN
				R_[individual] [pin1] [pin2] [ohms]
		   
		   ELSE
			<Dialog type="error" title="Missing numeric R and L value for lamp [name]">
				Missing value for the ohmic resistance R and the inductivity L of the lamp named [name] at position ([xpos] | [ypos]).
				The value given, [value], does not specify this correctly.
				Please enter a correct value for these two parameters. A good example would be the line:
				R=100 L=2.2m
			 </Dialog>
		   ENDIF
		ENDIF
    </Spice>
    <animation>
        DEFINE [curr] I[pin1]
        DEFINE [curr] AS_MATH_ABS OF:[curr]
		DEFINE [curr_share] AS_MATH_DIV OF:[curr] AND: [amps_nominal]  

        IF [curr_share] HIGHER_THAN 0.1 THEN  // lamp is on, shining with various size
            DEFINE [start] AS_MATH_MUL OF:[curr_share] AND:500 // factor  for shining size 
            DEFINE [start] AS_MATH_MAX OF:[start] AND:100      // minimum for shining size
            DEFINE [start] AS_MATH_MIN OF:[start] AND:500      // maximum for shining size 
            DEFINE [start] AS_MATH_ROUND OF:[start]            // shining coordinate need int value.
            DEFINE [shine] AS_MATH_MUL OF:[start] AND:2        // shining size from negative to positive coordinates.
            <Ellipse -[start] -[start] [shine] [shine] #CCCC00 2 1 #CCCC00 1 0.5> // draw yellow filled circle of various size shows shining
        ELSE
            <Ellipse -100 -100 200 200 #222222 2 1 #222222 1 0.5> // lamp is off, not shining but drawn grey.
        ENDIF
    </animation>

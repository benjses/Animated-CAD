// component library for "flags" that do NOT imitate electrical devices, but connection helpers.
// A practical use of such "flags" is to name nodes, or to connect them via their names. Or to make voltages without large source symbols.


<Component>
	<Description>
	IF [language] EQUAL_TO de THEN
		Eine Wert-Flagge. Sie benennt die verbundene Node genauso wie den eingegebenen Wert.
		Damit sind alle Nodes mit einer Flagge dieses Wertes mit einander verbunden!
		Der Wert darf keine Leerzeichen oder andere Whitespace-Zeichen haben.
		Ausserdem wird von allen nicht-Standard-Zeichen im Wert abgeraten (der SPICE-Simulator könnte sie missinterpretieren)
		Unterstriche statt Leerzeichen sind aber zulässig: "ein_Wert" ist okay.
	ELSE
		A value flag. It names the node as the given value.
		This way, all nodes with a flag of that value are connected to each other!
		Value may not contain spaces or other whitespace characters. 
		Also non-standard-characters are not recommended (SPICE simulator might misinterpret them.)
		But underlines instead of spaces are accepted : "some_value" is okay. 
	ENDIF
	</Description>
	<eeschema_sch>
		L flag:value
	</eeschema_sch>
	<Default_Values>
		some_name // names the connected node "some_name" and all nodes with that name are connected to each other.
		other_name //names the connected node "other_name" and all nodes with that name are connected to each other.
	</Default_Values>
	<eeschema_symbol>
		IF[name]MATCHES[A-Za-z0-9_]+THENELSE
			<Dialog type="warning" title="wrong name for name-flag">
				The name-flag should not be named "[name]".
				Please read the description of that component.
			</Dialog>
		ENDIF
		
		//pin:
		(pin output line (at 0 -0 90) (length 2.54)
		  (name "pin" (effects (font (size 1.27 1.27))))
		  (number "1" (effects (font (size 1.27 1.27))))
		)
		// text:
		(text "[value]" (at 0 4 0)
		  (effects (font (size 2 2)))
		)
		// underline below text:
		(polyline
		  (pts
			(xy -2.54 2.54 )
			(xy 2.54 2.54)
		  )
		  (stroke (width 0) (type default) (color 0 0 0 0))
		  (fill (type none))
		)
	</eeschema_symbol>
	
	<Spice>
		[pin] connect [value]
	</Spice>	
	
	
</Component>

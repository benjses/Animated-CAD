    </eeschema_sch>

//DRAW
//S -400 200 400 -200 0 1 0 f
//X L1_in 1 -500 150 100 R 50 50 1 1 I
//X L2_in 2 -500 50 100 R 50 50 1 1 I
//X L3_in 3 -500 -50 100 R 50 50 1 1 I
//X L1_out 4 500 150 100 L 50 50 1 1 O
//X L2_out 5 500 50 100 L 50 50 1 1 O
//X L3_out 6 500 -50 100 L 50 50 1 1 O
//X rk1 7 -100 -300 100 U 50 50 1 1 I
//X rk2 8 0 -300 100 U 50 50 1 1 I
//X rk3 9 100 -300 100 U 50 50 1 1 I
//ENDDRAW

<Spice> //nicht simulationsfaehig.
.subckt tiefpassfilter_blackbox_[eeschema_timestamp] l1_in l2_in l3_in l1_out l2_out l3_out rk1 rk2 rk3
    R1 l1_in l1_out 100
    R2 l2_in l2_out 100
    R3 l3_in l3_out 100
    
    R1rk l1_in rk1 100
    R2rk l2_in rk2 100
    R3rk l3_in rk3 100

.ends

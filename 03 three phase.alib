	</eeschema_symbol>
	<Default_Values>
		henry_pri=0.5m henry_sek=1.5m // a simple transformer, where the three primary coils have 0.5 mH each, and the three secondary coils have 1.5 mH each.
			//+ therefor it is a transformer with a ratio of 0.5 : 1.5 = 1:3 , the output will be ca. 3 times the input (plusminus a little difference for small cross coupling)
		henry_pri=0.5m henry_sek=1.5m cc_prisek=0.85 // same as previous example, but with main coupling constant from the three primary to the secondary coils reduced to 0.85 (default value is 0.98)=98%.
		henry_pri=0.5m henry_sek=1.5m cc_prisek=0.85 cc_pri=0.4 cc_sek=0.35 // same as previous example, but with additional coupling constants for the coupling between the three lines u v and w on the primary and sekondary side. (default value is 0.01=1%)
		henry_pri=0.5m henry_sek=1.5m i_nom_pri=2.0 // transformer with nominal current (in Ampere) on primary side, i_nom_pri is used for animation of magnetic flow B inside the trafo.  
	</Default_Values>
	<Spice>
		// -- 0. preparation - collect parameters --
		// 0.1 - primary coil
		// primary inductance in Henry - needed
		DEFINE [henry_pri] AS_WORD_RIGHT OF:henry_pri IN:[value]
		DEFINE [henry_pri] AS_NUMBER OF:[henry_pri]
		// primary resistance in Ohms - optional , set to 0.01 Ohm=10mOhm by default
		DEFINE [ohm_pri] AS_WORD_RIGHT OF:ohm_pri IN:[value]
		DEFINE [ohm_pri] AS_NUMBER OF:[ohm_pri]
		IF ![ohm_pri] THEN
			DEFINE [ohm_pri] 0.01
		ENDIF
		// 0.2 - secondary coils
		// 0.2 secondary inductance in Henry - needed
		DEFINE [henry_sek] AS_WORD_RIGHT OF:henry_sek IN:[value]
		DEFINE [henry_sek] AS_NUMBER OF:[henry_sek]
		// secondary resistance in Ohms - optional , set to 0.01 Ohm=10mOhm by default
		DEFINE [ohm_sek] AS_WORD_RIGHT OF:ohm_sek IN:[value]
		DEFINE [ohm_sek] AS_NUMBER OF:[ohm_sek]
		IF ![ohm_sek] THEN
			DEFINE [ohm_sek] 0.01
		ENDIF
		
		// 0.3 - coupling from primary to secondary 
		// coupling constant from primary to secondary coil. That is the wanted coupling, which makes the trafo work.
		DEFINE [cc_prisek] AS_WORD_RIGHT OF:cc_prisek IN:[value]
		DEFINE [cc_prisek] AS_NUMBER OF:[cc_prisek]
		IF ![cc_prisek] THEN 
			DEFINE [cc_prisek] 0.98 // default value = 98% 
		ENDIF
		
		// 0.4 - coupling on primary side between the three lines
		// coupling constant on primary side between each of the three lines. That coupling is often not wanted, but exists in real trafos
		DEFINE [cc_pri] AS_WORD_RIGHT OF:cc_pri IN:[value]
		DEFINE [cc_pri] AS_NUMBER OF:[cc_pri]
		IF ![cc_pri] THEN 
			DEFINE [cc_pri] 0.31
		ENDIF
		
		// 0.5 - coupling on secondary side between the three lines
		// coupling constant on sekondary side between each of the three lines. That coupling is often not wanted, but exists in real trafos
		DEFINE [cc_sek] AS_WORD_RIGHT OF:cc_sek IN:[value]
		DEFINE [cc_sek] AS_NUMBER OF:[cc_sek]
		IF ![cc_sek] THEN 
			DEFINE [cc_sek] 0.32
		ENDIF
		
		// 0.6 - nominal values / animation values 
		DEFINE [i_nom_pri] AS_WORD_RIGHT OF:i_nom_pri IN:[value]
		DEFINE [i_nom_pri] AS_NUMBER OF:[i_nom_pri]
		
		// 0.7 post check that the henry values are given as correct numerical parameters
		
		// 0.8 post check that all cc values are between 0 and 1: all three c-values (cc_prisek cc_pri and cc_sek) must hold 0 < c < 1		
		// TODO!
		
		
		
		// ----- model: ----
		//      model of trafo         |<------------------ connections of that model ---------------------------------->|
		.subckt mdl_trafo_[individual] pri_ua pri_ub pri_va pri_vb pri_wa pri_wb sek_ua sek_ub sek_va sek_vb sek_wa sek_wb
			// -- 1. primary coil --
			// 1.1 primary U coil:
			Ru_pri pri_ua pri_umid [ohm_pri]   // parasite series resistance of primary U coil
			Lu_pri pri_umid pri_ub [henry_pri] // coil inductance for primary U coil
			// 1.2 primary V coil:
			Rv_pri pri_va pri_vmid [ohm_pri]   // parasite series resistance of primary v coil
			Lv_pri pri_vmid pri_vb [henry_pri] // coil inductance for primary v coil
			// 1.3 primary W coil:
			Rw_pri pri_wa pri_wmid [ohm_pri]   // parasite series resistance of primary w coil
			Lw_pri pri_wmid pri_wb [henry_pri] // coil inductance for primary w coil

			// -- 2. secondary coil --
			// 2.1 secondary U coil:
			Ru_sek sek_ua sek_umid [ohm_sek]   // parasite series resistance of secondary U coil
			Lu_sek sek_umid sek_ub [henry_sek] // coil inductance for secondary U coil
			// 2.2 secondary V coil:
			Rv_sek sek_va sek_vmid [ohm_sek]   // parasite series resistance of secondary v coil
			Lv_sek sek_vmid sek_vb [henry_sek] // coil inductance for secondary v coil
			// 2.3 secondary W coil:
			Rw_sek sek_wa sek_wmid [ohm_sek]   // parasite series resistance of secondary w coil
			Lw_sek sek_wmid sek_wb [henry_sek] // coil inductance for secondary w coil

			// -- 3. coil coupling --
			// direct coupling from primary to secondary coil: 
			K_prisek_u Lu_pri Lu_sek [cc_prisek]
			K_prisek_v Lv_pri Lv_sek [cc_prisek]
			K_prisek_w Lw_pri Lw_sek [cc_prisek]
			
			// cross coupling on primary side
			K_pri_uv Lu_pri Lv_pri [cc_pri]
			K_pri_vw Lv_pri Lw_pri [cc_pri]
			K_pri_wu Lw_pri Lu_pri [cc_pri]
			
			// cross coupling on sekondary side
			K_sek_uv Lu_sek Lv_sek [cc_sek]
			K_sek_vw Lv_sek Lw_sek [cc_sek]
			K_sek_wu Lw_sek Lu_sek [cc_sek]
			
		.ends
		// ---- component ----
		// name of trafo     |<----------- connections  of the component (not of the model) ------------------------------->| |<--model of trafo-->|
		X_trafo_[individual] [priUa] [priUb] [priVa] [priVb] [priWa] [priWb]  [sekUa] [sekUb] [sekVa] [sekVb] [sekWa] [sekWb] mdl_trafo_[individual] 
	</Spice>
</Component>


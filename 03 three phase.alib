<Spice>
DEFINE [r_connect] 0.1
DEFINE [r_isolate] 1E9
.subckt Umschalter_[eeschema_timestamp] out1 out2 out3 off1 off2 off3 on1 on2 on3
    Vctrl ctrl 0 PWL([value])
    R1on  on1  out1 r='V(ctrl) > 0.5 ?  [r_connect] : [r_isolate]'
    R1off off1 out1 r='V(ctrl) > 0.5 ?  [r_isolate] : [r_connect]'
    R2on  on2  out2 r='V(ctrl) > 0.5 ?  [r_connect] : [r_isolate]'
    R2off off2 out2 r='V(ctrl) > 0.5 ?  [r_isolate] : [r_connect]'
    R3on  on3  out3 r='V(ctrl) > 0.5 ?  [r_connect] : [r_isolate]'
    R3off off3 out3 r='V(ctrl) > 0.5 ?  [r_isolate] : [r_connect]'
.ends
X_Umschalter_[eeschema_timestamp] [pin1out] [pin2out] [pin3out] [pin1off] [pin2off] [pin3off] [pin1on] [pin2on] [pin3on] Umschalter_[eeschema_timestamp]
</Spice>
</Component>

<Component>
    <Description>
        Versuch, den eSaver Tiefpassfilter zu simulieren.
    </Description>
    <eeschema_sch>
        L esaver:Tiefpassfilter_Trafo_midKpl
    </eeschema_sch>
    <Spice>
        // ---- Parameter: ----
        DEFINE [henryA] 10m  // Induktivitaeten der drei Hauptspulen
        DEFINE [henryY] 100m // Induktivitaeten der drei Sternspulen
        DEFINE [cplAY]  0.99 // Koppelfaktor zwischen der Hauptspule und Sternspule eines Leiters
        DEFINE [cplLL]  0.97 // Koppelfaktor zwischen den Spulen verschiedener Leiter (1,2,3)
        
        // ---- Modell: ----
        .subckt eSaver_tiefpass in1 in2 in3 out1 out2 out3 y1 y2 y3
            // -- Hauptspulen --
            L1A in1 out1 [henryA] 
            L2A in2 out2 [henryA]
            L3A in3 out3 [henryA]
            // -- Sternspulen --
            L1Y out1 y1 [henryY]
            L2Y out2 y2 [henryY]
            L3Y out3 y3 [henryY]           
            // -- Kopplungen zwischen Hauptspulen und Sternspulen eines Leiters --
            K1AY L1A L1Y [cplAY]
            K2AY L2A L2Y [cplAY]
            K3AY L3A L3Y [cplAY]
            // -- Kopplungen zwischen Hauptspulen verschiedener Leiter --
            KA1A2 L1A L2A [cplLL]
            KA2A3 L2A L3A [cplLL]
            KA3A1 L3A L1A [cplLL]
            // -- Kopplungen zwischen Sternspulen verschiedener Leiter --
            KY1Y2 L1Y L2Y [cplLL]
            KY2Y3 L2Y L3Y [cplLL]
            KY3Y1 L3Y L1Y [cplLL]
            // -- Kopplungen zwischen Hs und Ss verschiedener Leiter --
            KA1Y2 L1A L2Y [cplLL]
            KA2Y3 L2A L3Y [cplLL]
            KA3Y1 L3A L1Y [cplLL]
        .ends
        // ---- Instanz: ----
        X_eSaver_tiefpass_[individual] [pin1in] [pin2in] [pin3in] [pin1out] [pin2out] [pin3out] [pin1y] [pin2y] [pin3y]
        
    </Spice>
</Component>   
    


			)
			(pin power_out line (at 0 7.62 270) (length 2.54)
			  (name "V2pos" (effects (font (size 1.27 1.27))))
			  (number "2" (effects (font (size 1.27 1.27))))
			)
			(pin power_out line (at 6.35 7.62 270) (length 2.54)
			  (name "V3pos" (effects (font (size 1.27 1.27))))
			  (number "3" (effects (font (size 1.27 1.27))))
			)
			(pin power_out line (at -6.35 -7.62 90) (length 2.54)
			  (name "V1neg" (effects (font (size 1.27 1.27))))
			  (number "4" (effects (font (size 1.27 1.27))))
			)
			(pin power_out line (at 0 -7.62 90) (length 2.54)
			  (name "V2neg" (effects (font (size 1.27 1.27))))
			  (number "5" (effects (font (size 1.27 1.27))))
			)
			(pin power_out line (at 6.35 -7.62 90) (length 2.54)
			  (name "V3neg" (effects (font (size 1.27 1.27))))
			  (number "6" (effects (font (size 1.27 1.27))))
			)
		  )
		)
	</eeschema_symbol>
	<Spice>
		// parameters:
		DEFINE [offset] AS_WORD_RIGHT OF:offset IN:[value]
		DEFINE [offset] AS_NUMBER OF:[offset]
		IF ![offset] THEN DEFINE [offset] 0  ENDIF
		
		DEFINE [amplitude] AS_WORD_RIGHT OF:amplitude IN:[value]
		DEFINE [amplitude] AS_NUMBER OF:[amplitude]
		IF ![amplitude] THEN DEFINE [amplitude] 325.27 ENDIF // 230V x sqrt(2)=ca 325.27 V
		
		DEFINE [frequency] AS_WORD_RIGHT OF:frequency IN:[value]
		DEFINE [frequency] AS_NUMBER OF:[frequency]
		IF ![frequency] THEN DEFINE [frequency] 50 ENDIF //default 50Hz
		DEFINE [period] AS_MATH_DIV OF:1 AND:[frequency]
		
		DEFINE [delay1] 0
		DEFINE [delay2] AS_MATH_DIV OF:[period] AND:3 // default 6,67ms=20ms/3 (the "s" for seconds is not for the simulator. It needs a number. The "m" for milli divides the number by 1000)
		DEFINE [delay3] AS_MATH_MUL OF:[delay2] AND:2 // default 13.33m=20ms x 2/3 (again NO "s")
		
		DEFINE [theta] 0
		DEFINE [phase1] 0 
		DEFINE [phase2] 0 //phase in degrees. Set to zero, because phase is already considered in the delay
		DEFINE [phase3] 0 //phase in degrees. Set to zero, because phase is already considered in the delay
		// model: 
		.subckt threePhase_source_[individual] v1pos v2pos v3pos v1neg v2neg v3neg
		V1 v1pos v1neg SIN([offset] [amplitude] [frequency] [delay1] [theta] [phase1])
		V2 v2pos v2neg SIN([offset] [amplitude] [frequency] [delay2] [theta] [phase2])
		V3 v3pos v3neg SIN([offset] [amplitude] [frequency] [delay3] [theta] [phase3])
		.ends
		// component:
		X_threePhase_source_[individual] [V1pos] [V2pos] [V3pos] [V1neg] [V2neg] [V3neg] threePhase_source_[individual]
	</Spice>
</Component>


<Component>
	<Description>
		IF [language] EQUAL_TO de THEN 
			Ein Dreiphasen-Transformator ("trafo") - universelles modell.
			
			Er hat eine primärseite ("pri") und eine Sekundärseite ("sek")
			Jede Seite hat drei Stränge, sie werden u v und w genannt.
			
			Die Verbindungen jeder Spule sind anschliessbare pins, sodass der Benutzer die auf jede Art verbinden kann (deswegen ist es das universelle Trafo-Modell).
			Daraus ergeben sich 12 pins, denn jede Spule hat zwei pins und es gibt sechs Spulen - drei auf der Primärseite und drei auf der Sekundärseite.
		
			-- Benötigte Parameter sind: --			
			henry_pri : der henry Wert von jeder der drei primärseitigen Spulen
			henry_sek : der henry Wert von jeder der drei sekundärseitigen Spulen
			
			-- Optionale Parameter sind: --
			ohm_pri : der Widerstand in ohm von jeder der drei primärseiten Spulen - voreingestellter Wert ist 0.01 Ohm
			ohm_sek : der Widerstand in ohm von jeder der drei sekundäerseitigen Spulen - voreingestellter Wert ist 0.01 Ohm
			cc_prisek : die Kopplungskonstante von Primärspule zu Sekundärspule auf jeder der drei Stränge - voreingestellter Wert 0.98=98%
			cc_pri : die Kopplung zwischen den Strängen auf der Primärseite - voreingestellter Wert 0.31=31%
			cc_sek : die Kopplung zwischen den Strängen auf der Sekundärseite - voreingestellter Wert 0.32=32%
			i_nom_pri : der Nominalstrom durch jede der drei Primärspulen. - ohne voreingestellten Wert. Wenn ein Wert in Ampere gegeben ist, dann werden Bauteilanimation in Relation zu diesem Nominalwert bestimmt (ohne diesen Wert werden die Bauteilanimationen nicht dargestellt.)
		
			Alle Kopplungskonstanten muessen groesser als 0 und kleiner als 1 sein.
		ELSE A three phase transformer ("trafo") - universal model. 
			
			It has a primary side ("pri") and a sekondary side ("sek").
			Each side has three lines, called u v and w.
			
			The connections of each coil are connectable pins so that the user can connect them in any way possible (that is why this is the universal model for trafos).
			
			--Needed parameters are:--
			henry_pri : the henry value of each of the three primary coils
			henry_sek : the henry value of each of the three secondary coils
			
			--Optional parameters are:--
			ohm_pri : the resistance in ohm of each of the primary coils - default value 0.01 Ohm
			ohm_sek : the resistance in ohm of each of the secondary coils - default value 0.01 Ohm
			cc_prisek : the coupling from primary to secondary coil on each of the three lines - delfault 0.98=98%
			cc_pri : the coupling across the lines on primary side - default 0.31=31%
			cc_sek : the coupling across the lines on sekondary side - default 0.32=32%
			i_nom_pri : the nominal current through each of the primary coils - no default value. If a numeric ampere value is specified, then component animations will show the magnetic flow on the coils in relation to this nominal value. (When the value is not specified, the component animations will not show it.)			
		
			all coupling constants must be larger than zero and smaller than one.
		ENDIF		
	</Description>
	<animation>
		// display the current
		IF [i_nom_pri] THEN // but only if a nominal current exists upon which the current share can be calculated
			// calculate line 1, called U
			DEFINE [curr_u] I[priUa] // current at line u is the Intensity value at the pin "priUa" (that is the pin on primary side, line U, first connection) 
			DEFINE [curr_u] AS_MATH_ABS OF:[curr_u] // absolute value - negative values to positive ones
			DEFINE [shine_u] AS_MATH_DIV OF:[curr_u] AND: [i_nom_pri]  // intensity of shining, opacity
			DEFINE [shine_u] AS_MATH_MIN OF:[shine_u] AND:1    // max 100%
			DEFINE [shine_u] AS_MATH_MAX OF:[shine_u] AND:0.05 // min 5%

			// calculate line 2 called V
			DEFINE [curr_v] I[priVa] // current at line v = current trough pin "priVa"
			DEFINE [curr_v] AS_MATH_ABS OF:[curr_v] // only positive values
			DEFINE [shine_v] AS_MATH_DIV OF:[curr_v] AND: [i_nom_pri]  // intensity of shining, opacity
			DEFINE [shine_v] AS_MATH_MIN OF:[shine_v] AND:1    // max 100%
			DEFINE [shine_v] AS_MATH_MAX OF:[shine_v] AND:0.05 // min 5%

			// calculate line 3 called W
			DEFINE [curr_w] I[priWa] // current at line w = current trough pin "priWa".
			DEFINE [curr_w] AS_MATH_ABS OF:[curr_w] // positive values
			DEFINE [shine_w] AS_MATH_DIV OF:[curr_w] AND: [i_nom_pri]  // intensity of shining, opacity
			DEFINE [shine_w] AS_MATH_MIN OF:[shine_w] AND:1    // max 100%
			DEFINE [shine_w] AS_MATH_MAX OF:[shine_w] AND:0.05 // min 5%

			// draw magnetic field from U:
			<Rectangle -370 -330 700 20 [color_u] 2 1 [color_u] 1  [shine_u]> // horizontal u top
			<Rectangle -370 -310 20  280 [color_u] 2 1 [color_u] 1 [shine_u]> // primary u top middle
			<Rectangle  310 -310 20  280 [color_u] 2 1 [color_u] 1 [shine_u]> // sekondary u top middle
			<Rectangle -370 -30 700 10 [color_u] 2 1 [color_u] 1  [shine_u]> // horizontal u middle
			<Rectangle -370 -20 10  290 [color_u] 2 1 [color_u] 1 [shine_u]> // primary u middle-bottom
			<Rectangle  310 -20 10  290 [color_u] 2 1 [color_u] 1 [shine_u]> // sekondary u middle-bottom
			<Rectangle -370 270 690 10 [color_u] 2 1 [color_u] 1  [shine_u]> // horizontal u bottom

			// drav magnetic field from V:
			<Rectangle -350 -310 690 10 [color_v] 2 1 [color_v] 1  [shine_v]> // horizontal v top
			<Rectangle -350 -300 10  290 [color_v] 2 1 [color_v] 1 [shine_v]> // primary v top middle
			<Rectangle  330 -300 10  290 [color_v] 2 1 [color_v] 1 [shine_v]> // sekondary v top middle
			<Rectangle -350 -10 700 20 [color_v] 2 1 [color_v] 1  [shine_v]> // horizontal v middle
			<Rectangle -350   0 10  290 [color_v] 2 1 [color_v] 1 [shine_v]> // primary v middle-bottom
			<Rectangle  330   0 10  290 [color_v] 2 1 [color_v] 1 [shine_v]> // sekondary v middle-bottom
			<Rectangle -350 290 690 10 [color_v] 2 1 [color_v] 1  [shine_v]> // horizontal v bottom
			
			// draw magnetic field from W:
			<Rectangle -330 -290 690 10 [color_w] 2 1 [color_w] 1  [shine_w]> // horizontal w top
			<Rectangle -330 -280 10  290 [color_w] 2 1 [color_w] 1 [shine_w]> // primary w top middle
			<Rectangle  350 -280 10  290 [color_w] 2 1 [color_w] 1 [shine_w]> // sekondary w top middle
			<Rectangle -330  10 700 10 [color_w] 2 1 [color_w] 1  [shine_w]> // horizontal w middle
			<Rectangle -330 20 20  290 [color_w] 2 1 [color_w] 1 [shine_w]> // primary w middle-bottom
			<Rectangle  350 20 20  290 [color_w] 2 1 [color_w] 1 [shine_w]> // sekondary w middle-bottom
			<Rectangle -330 310 700 20 [color_w] 2 1 [color_w] 1  [shine_w]> // horizontal w bottom
		ENDIF
	</animation>
	<eeschema_sch>
		L threePhase:Trafo_universal
	</eeschema_sch>

        X connL1_in 1 -850 650 100 D 50 50 1 1 W
        X connL2_in 2 -300 650 100 D 50 50 1 1 W
        X connL3_in 3 250 650 100 D 50 50 1 1 W
        X connL1_out 4 -300 -1100 100 U 50 50 1 1 w
        X connL2_out 5 250 -1100 100 U 50 50 1 1 w
        X connL3_out 6 800 -1100 100 U 50 50 1 1 W
        ENDDRAW
    </eeschema_symbol>   
    <Spice>
        DEFINE [henry] AS_NUMBER OF:[value]
        DEFINE [ohm_inout] 1e6 //parasite paralell resistance beteween input and output
        DEFINE [ohm_lin] 1     //parasite series resistance of input coils
        DEFINE [ohm_lout] 0.5  //parasite series resistance of output coils
        DEFINE [k_inout] 0.98  //coupling factor constant between input and output inductors
        IF [henry] THEN
            // model:
              .subckt tiefpassfilter_[eeschema_timestamp] l1_in l2_in l3_in l1_out l2_out l3_out
                //input coils
                L1in l1_in l1_midin [henry]
                R1in l1_midin midin [ohm_lin]
                L2in l2_in l2_midin [henry]
                R2in l2_midin midin [ohm_lin]
                L3in l3_in l3_midin [henry]
                R3in l3_midin midin [ohm_lin]

                //output coils 
 //               L1out l1_out l1_midout [henry]
 //               R1out l1_midout midout [ohm_lout]
 //               L2out l2_out l2_midout [henry]
 //               R2out l2_midout midout [ohm_lout]
 //               L3out l3_out l3_midout [henry]
 //               R3out l3_midout midout [ohm_lout]
                
                // parasite resistors:
                R1 l1_in l1_out [ohm_inout]
                R2 l2_in l2_out [ohm_inout]
                R3 l3_in l3_out [ohm_inout]
                
                //Coupling between input and output:
 //               K1 L1_in L1_out [k_inout]
 //               K2 L2_in L2_out [k_inout]
 //               K3 L3_in L3_out [k_inout]
            .ends
            
               // ---- component ----
        X_tiefpassfilter_[eeschema_timestamp] [L1_in] [L2_in] [L3_in] [L1_out] [L2_out] [L3_out] tiefpassfilter_[eeschema_timestamp]
        ELSE
            <Dialog title="missing Henry value for coil [name]" type="error" dimension="450x150"> 
                The coil is modeled by an inductor. But the component named [name] at ([xpos] | [ypos]) has an invalid value, "[value]".
                This component expects an L value in Henry. 
                Please enter a number at that place.
            </Dialog>
        ENDIF
    </Spice>
</Component>


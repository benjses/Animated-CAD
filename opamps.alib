<Component>
  <Description>
  	Operation Amplifier (OpAmp) Model  AD822 with 5 standard-pins.
	Spice and qucs_symbol sections copied and modified from open source library of qucs version 0.0.14:
	Original Authors of these sections: Vadim Kuznetsov <ra3xdh@gmail.com> and Timofey Moiseev <voig1396@gmail.com>
	These sections were licensed under same GPL versions as the whole following component. 
	(Or vice versa, in order to have compatible licensing, the whole following sections of this component are hereby licensed same as the original qucs sections)
	Modifications for compatibility made by Benedikt Sessler <b.sessler@gmx.de>
 
  </Description>
  <Spice>
	.SUBCKT SpiceOpamp_AD822 gnd 1 2 99 50 25
	*
	* INPUT STAGE & POLE AT 5 MHZ
	*
	R3 5 99 2456
	R4 6 99 2456
	CIN 1 2 5E-12
	C2 5 6 6.48E-12
	I1 4 50 108E-6
	IOS 1 2 1E-12
	EOS 7 1 POLY(1) (12,98) 100E-6 1
	J1 5 2 4 JX
	J2 6 7 4 JX
	GB1 50 2 POLY(3) (2,4) (2,5) (2,50) 0 1E-12 1E-12 1E-12
	GB2 50 7 POLY(3) (7,4) (7,5) (7,50) 0 1E-12 1E-12 1E-12
	*
	* GAIN STAGE & POLE AT 13.4 HZ
	*
	EREF 98 0 (30,0) 1
	R5 9 98 2.313E6
	C3 9 25 32E-12
	G1 98 9 (6,5) 4.07E-4
	V1 8 98 0
	V2 98 10 -1
	D1 9 10 DX
	D2 8 9 DX
	*
	* COMMON-MODE GAIN NETWORK WITH ZERO AT 1 KHZ
	*
	R21 11 12 1E6
	R22 12 98 100
	C14 11 12 159E-12
	E13 11 98 POLY(2) (2,98) (1,98) 0 0.5 0.5
	*
	* POLE AT 10 MHZ
	*
	R23 18 98 1E6
	C15 18 98 15.9E-15
	G15 98 18 (9,98) 1E-6
	*
	* OUTPUT STAGE
	*
	ES 26 51 POLY(1) (18,98) 1.72 1
	RS 26 22 500
	V3 23 51 1.03951
	V4 21 23 1.36
	C16 20 25 2E-12
	C17 24 25 2E-12
	RG1 20 97 1E8
	RG2 24 97 1E8
	Q1 20 20 97 PNP
	Q2 20 21 22 NPN
	Q3 24 23 22 PNP
	Q4 24 24 51 NPN
	Q5 25 20 97 PNP 20
	Q6 25 24 51 NPN 20
	VP 96 97 0
	VN 51 52 0
	EP 96 0 POLY(1) (99,0) 0.01 1
	EN 52 0 POLY(1) (50,0) -0.015 1
	R25 30 99 63.5E3
	R26 30 50 63.5E3
	FSY1 99 0 VP 1
	FSY2 0 50 VN 1
	*
	* MODELS USED
	*
	.MODEL JX NJF(BETA=7.67E-4 VTO=-2.000 IS=1E-12)
	.MODEL NPN NPN(BF=120 VAF=150 VAR=15 RB=2E3 RE=4 RC=200)
	.MODEL PNP PNP(BF=120 VAF=150 VAR=15 RB=2E3 RE=4 RC=900)
	.MODEL DX D(IS=1E-15)
	.ENDS AD822
	// Call the component:
	X_[name] 0 [pos] [neg] [src_pos] [src_neg] [out] SpiceOpamp_AD822
  </Spice>
   <qucs_sch>
  	Lib [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [Libname] [Libname_v] ad822 ad822_v 
  </qucs_sch>
  <qucs_symbol>
    <Line -20 -40 0 80 #000080 2 1>
    <Line -20 -40 60 40 #000080 2 1>
    <Line -20 40 60 -40 #000080 2 1>
    <Line 40 0 20 0 #000080 2 1>
    <Line -40 -20 20 0 #000080 2 1>
    <Line -40 20 20 0 #000080 2 1>
    <Line -15 20 10 0 #000000 2 1>
    <Line -10 -25 0 10 #ff0000 0 1>
    <Line -15 -20 10 0 #ff0000 0 1>
    <Line 10 -20 0 -20 #000080 2 1>
    <Line 10 20 0 20 #000080 2 1>
    <.PortSym -40 -20 [pos] 0>
    <.PortSym -40 20 [neg] 0>
    <.PortSym 10 -40 [src_pos] 270>
    <.PortSym 10 40 [src_neg] 90>
    <.PortSym 60 0 [out] 180>
    <//.ID 50 34 OP>
  </qucs_symbol>

<Component>
	<Description>
		Idealized Operation Amplifier (OpAmp) with 3 standard-pins. Needs XSPICE extension.
		Default settings: limits at -12V and +12V, gain at 300 000, this can be changed in spice section
		
		The Spice-Text for this component is copied and adapted from 
		ngspice user manual version 30 plus, chapter 27 "Example cirquits".
		This component is Licensed the same way as stated in that user manual.
		(That means that it is in public domain, since chapter 27 is too.)
		
		ATTENTION: This is an idealized model, not a realistic one: The simulation of this component 
		is done by a mathematical model, not an electrical model. This means:
		1: voltage amplification works better with this idealized model than with most real OpAmps
		2: currents are calculated wrong: The idealized model contains a controlled source, where in reality 
		only passive elements exist. The source "creates" a current at the output, which is coming from "nowhere".
		->So please use this model only for educational, idealised descriptions of OpAmp-Cirquits.
	</Description>
	<Spice>		
		// ---- Model ----
		.subckt opamp_3pin plus minus out
		r1 plus minus 400k
		a1 %vd (plus minus) outint lim
		.model lim limit (out_lower_limit=-12 out_upper_limit=12 fraction=true limit_range = 0.2 gain=300e3)
		r3 outint out 50.0
		r2 out 0 1e12
		.ends opamp_3pin
		// ---- Component ----
		X_[name] [pos] [neg] [out] opamp_3pin
	</Spice>
	<eeschema_sch>
		L idealized:opamp_3pin
		F 0 "[name]"
	</eeschema_sch>
	<eeschema_symbol>
	    <Line -200 -200 0 400 #000080 2 1>
	    <Line -200 200 400 -200 #000080 2 1>
	    <Line 200 0 -400 -200 #000080 2 1>
	    // non-inverting input:
	    <.PortSym -300 -100 [pos] 0> 
	    <Line -300 -100 100 0 #000080 2 1>
	    <Line -180 -100 60 0 #800000 2 1>
	    <Line -150 -130 0 60 #800000 2 1>
	    // inverting input:
	    <.PortSym -300 100 [neg] 0> 
	    <Line -300 100 100 0 #000080 2 1>
	    <Line -180 100 60 0 #0000FF 2 1>
	    //output
	    <.PortSym 300 0 [out] 180>
	    <Line 300 0 -100 0 #000080 2 1> 
  	</eeschema_symbol>
  	 <qucs_sch>
  		Lib [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [Libname] [Libname_v] opamp_3pin opamp_3pin_v
  	</qucs_sch>
	<qucs_symbol>
		<Line -20 -40 0 80 #000080 2 1>
		<Line -20 -40 60 40 #000080 2 1>
		<Line -20 40 60 -40 #000080 2 1>
		<Line 40 0 20 0 #000080 2 1>
		<Line -40 -20 20 0 #000080 2 1>
		<Line -40 20 20 0 #000080 2 1>
		<Line -15 20 10 0 #000000 2 1>
		<Line -10 -25 0 10 #ff0000 0 1>
		<Line -15 -20 10 0 #ff0000 0 1>
		<.PortSym -40 -20 [pos] 0> 
		<.PortSym -40 20 [neg] 0> 
		<.PortSym 60 0 [out] 180>
	</qucs_symbol>
</Component>

<Component>
	<Description>
		Idealized Operation Amplifier (OpAmp) with 5 standard-pins. Needs XSPICE extension.
		Default settings:
			gain at 300 000=300e3;
			minimal and maximal voltage at +-1Megavolt, but also limited by src_pos and src_neg
			output resistance is 50 Ohm 
		
		The Spice-Text for this component is copied and adapted from 
		ngspice user manual version 30 plus, chapter 27 "Example cirquits".
		This component is Licensed the same way as stated in that user manual.
		(That means that it is in public domain, since chapter 27 is too)
		
		ATTENTION: This is an idealized model, not a realistic one: The simulation of this component 
		is done by a mathematical model, not an electrical model. This means:
		1: voltage amplification works better with this idealized model than with most real OpAmps
		2: currents are calculated wrong: The idealized model contains a controlled source, where in reality 
		only passive elements exist. The source "creates" a current at the output, which is coming from "nowhere".
		->So please use this model only for educational, idealised descriptions of OpAmp-Cirquits.
	</Description>
	<Spice>		
		// ---- Model ----
		.subckt opamp_5pin plus minus src_pos src_neg out
		r1 plus minus 400k
		a1 %vd (plus minus) outvd lim
		.model lim limit (out_lower_limit=1e6 out_upper_limit=1e6 fraction=true limit_range=0.2 gain=300e3)
		.model switch_y sw ron=1 roff=1e9 // switch type y("yes") is ON when input diff>=0
		.model switch_n sw ron=1e9 roff=1 // switch type n ("no") is ON when input diff<0
		spos1 outpos outvd   outvd src_pos switch_n
		spos2 outpos src_pos outvd src_pos switch_y
		sneg1 outneg outpos  outpos src_neg switch_y  
		sneg2 outneg src_neg outpos src_neg switch_n
		rout outneg out 50
		r2 out 0 1e12
		.ends opamp_5pin
		// ---- Component ----
		X_[name] [pos] [neg] [src_pos] [src_neg] [out] opamp_5pin
	</Spice>
	<eeschema_sch>
		L idealized:opamp_5pin
		F 0 "[name]"
	</eeschema_sch>
	<eeschema_symbol>
	    <Line -200 -200 0 400 #000080 2 1>
	    <Line -200 200 400 -200 #000080 2 1>
	    <Line 200 0 -400 -200 #000080 2 1>
	    // non-inverting input:
	    <.PortSym -300 -100 [pos] 0> 
	    <Line -300 -100 100 0 #000080 2 1>
	    <Line -180 -100 60 0 #800000 2 1>
	    <Line -150 -130 0 60 #800000 2 1>
	    // inverting input:
	    <.PortSym -300 100 [neg] 0> 
	    <Line -300 100 100 0 #000080 2 1>
	    <Line -180 100 60 0 #0000FF 2 1>
	    // positive power supply:
	    <.PortSym -100 -300 [src_pos] 270>
	    <Line -100 -300 0 150 #000080 2 1>
	    // negative power supply:
	    <.PortSym -100 300 [src_neg] 90>  
	    <Line -100 300 0 -150 #000080 2 1>
	    //output
	    <.PortSym 300 0 [out] 180>
	    <Line 300 0 -100 0 #000080 2 1> 
  	</eeschema_symbol>
  	 <qucs_sch>
  		Lib [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [Libname] [Libname_v] opamp_5pin opamp_5pin_v
  	</qucs_sch>
	<qucs_symbol>
	 	<Line -20 -40 0 80 #000080 2 1>
	    <Line -20 -40 60 40 #000080 2 1>
	    <Line -20 40 60 -40 #000080 2 1>
	    <Line 40 0 20 0 #000080 2 1>
	    <Line -40 -20 20 0 #000080 2 1>
	    <Line -40 20 20 0 #000080 2 1>
	    <Line -15 20 10 0 #000000 2 1>
	    <Line -10 -25 0 10 #ff0000 0 1>
	    <Line -15 -20 10 0 #ff0000 0 1>
	    <Line 10 -20 0 -20 #000080 2 1>
	    <Line 10 20 0 20 #000080 2 1>
	    <.PortSym -40 -20 [pos] 0> // 1
	    <.PortSym -40 20 [neg] 0> // 2
	    <.PortSym 10 -40 [src_pos] 270> // 3
	    <.PortSym 10 40 [src_neg] 90> // 4
	    <.PortSym 60 0 [out] 180> //5
	</qucs_symbol>
</Component>


<Component>
	<Description>
		Operation Amplifier models TL082 and TL084.
	</Description>
	<eeschema_sch>
		L Amplifier_Operational:TL082
		F 0 "[name]"
		F 1 "[type]"
		F 2 "[package]"
		F 3 "[datasheet]"
		DEFINE [powerblock] 3
	</eeschema_sch>
	<eeschema_sch>
		L Amplifier_Operational:TL084
		F 0 "[name]"
		F 1 "[type]"
		F 2 "[package]"
		F 3 "[datasheet]"
		DEFINE [powerblock] 5
	</eeschema_sch>
	<eeschema_symbol>
		DRAW
		IF [powerblock] EQUAL_TO [eeschema_u_n] || [powerblock] EQUAL_TO [unit] THEN
			S -200 -200 0 200 0 1 10 N
			T 0 -100 -0 60 1 0 [value]
		   
			X Vneg 11 -100 -300 100 U 50 50 5 1 W
			SET_CONNECTION [value]_vneg -100 -300
			T 0 -100 -150 60 1 0 vneg
		   
			X Vpos 4 -100 300 100 D 50 50 5 1 W   
			SET_CONNECTION [value]_vpos -100 300
			T 0 -100 150 60 1 0 vpos
		ELSE
			P 4 1 1 10 -200 200 200 0 -200 -200 -200 200 n
			X out 1 300 0 100 L 50 50 1 1 O
			X inNeg 2 -300 -100 100 R 50 50 1 1 I
			P 2 0 1 0 -140 -100 -180 -100 N
		   
			X inPos 3 -300 100 100 R 50 50 1 1 I
			P 2 0 1 0 -140 100 -180 100 N
			P 2 0 1 0 -160  80 -160 120 N
		   
			X GET_CONNECTION [value]_vpos
		   X GET_CONNECTION [value]_vneg
		ENDIF
		ENDDRAW
   </eeschema_symbol>
  	<qucs_sch>
  	Lib [name] [active] [xpos] [ypos] [xtext] [ytext] [mirrorx] [rotate] [Libname] [Libname_v] uA741 uA741_v
  </qucs_sch>
  <qucs_symbol>
    <Line -20 -40 0 80 #000080 2 1>
    <Line -20 -40 60 40 #000080 2 1>
    <Line -20 40 60 -40 #000080 2 1>
    <Line 40 0 20 0 #000080 2 1>
    <Line -40 -20 20 0 #000080 2 1>
    <Line -40 20 20 0 #000080 2 1>
    <Line -15 20 10 0 #000000 2 1>
    <Line -10 -25 0 10 #ff0000 0 1>
    <Line -15 -20 10 0 #ff0000 0 1>
    <Line 10 -20 0 -20 #000080 2 1>
    <Line 10 20 0 20 #000080 2 1>
    <.PortSym -40 -20 [pos] 0> // 1
    <.PortSym -40 20 [neg] 0> // 2
    <.PortSym 10 -40 [src_pos] 270> // 3
    <.PortSym 10 40 [src_neg] 90> // 4
    <.PortSym 60 0 [out] 180> //5
  </qucs_symbol>
  <Spice>
    IF [powerblock] EQUAL_TO [eeschema_u_n] || [powerblock] EQUAL_TO [unit] THEN
        R_powerblock_[individual] [Vpos] [Vneg] 1E9
	ELSE
		// model:
		* TL082 or TL084 OP-AMP "MACROMODEL" SUBCIRCUIT
		* CREATED USING PARTS RELEASE 4.01 ON 06/16/89 AT 13:08
		* (REV N/A)      SUPPLY VOLTAGE: +/-15V
		* CONNECTIONS:   NON-INVERTING INPUT
		*                | INVERTING INPUT
		*                | | POSITIVE POWER SUPPLY
		*                | | | NEGATIVE POWER SUPPLY
		*                | | | | OUTPUT
		*                | | | | |
		.SUBCKT TL08xMDL 1 2 3 4 5
		*
		  C1   11 12 3.498E-12
		  C2    6  7 15.00E-12
		  DC    5 53 DX
		  DE   54  5 DX
		  DLP  90 91 DX
		  DLN  92 90 DX
		  DP    4  3 DX
		  EGND 99  0 POLY(2) (3,0) (4,0) 0 .5 .5
		  FB    7 99 POLY(5) VB VC VE VLP VLN 0 4.715E6 -5E6 5E6 5E6 -5E6
		  GA    6  0 11 12 282.8E-6
		  GCM   0  6 10 99 8.942E-9
		  ISS   3 10 DC 195.0E-6
		  HLIM 90  0 VLIM 1K
		  J1   11  2 10 JX
		  J2   12  1 10 JX
		  R2    6  9 100.0E3
		  RD1   4 11 3.536E3
		  RD2   4 12 3.536E3
		  RO1   8  5 150
		  RO2   7 99 150
		  RP    3  4 2.143E3
		  RSS  10 99 1.026E6
		  VB    9  0 DC 0
		  VC    3 53 DC 2.200
		  VE   54  4 DC 2.200
		  VLIM  7  8 DC 0
		  VLP  91  0 DC 25
		  VLN   0 92 DC 25
		.MODEL DX D(IS=800.0E-18)
		.MODEL JX PJF(IS=15.00E-12 BETA=270.1E-6 VTO=-1)
		.ENDS

		// calling that model in a component:
		X_TL08x_[individual] [inPos] [inNeg] [value]_vpos [value]_vneg [out] TL08xMDL
    ENDIF
  </Spice>
</Component>


<Component>
	<Description>
		Operation Amplifier models TL082 and TL084.
	</Description>
	<eeschema_sch>
		L opAmps:TL08x
		F 0 "[name]"
		F 1 "[type]"
		F 2 "[package]"
		F 3 "[datasheet]"
	</eeschema_sch>
	<eeschema_symbol>
	
    (rectangle (start -5.08 6.35) (end 5.08 -6.35)
      (stroke (width 0) (type default) (color 0 0 0 0))
      (fill (type none))
    )
  
    (pin input line (at -7.62 2.54 0) (length 2.54)
      (name "inPos" (effects (font (size 1.27 1.27))))
      (number "1" (effects (font (size 1.27 1.27))))
    )
    (pin input line (at -7.62 -2.54 0) (length 2.54)
      (name "inNeg" (effects (font (size 1.27 1.27))))
      (number "2" (effects (font (size 1.27 1.27))))
    )
    (pin power_in line (at 0 8.89 270) (length 2.54)
      (name "Vpos" (effects (font (size 1.27 1.27))))
      (number "3" (effects (font (size 1.27 1.27))))
    )
    (pin power_in line (at 0 -8.89 90) (length 2.54)
      (name "Vneg" (effects (font (size 1.27 1.27))))
      (number "4" (effects (font (size 1.27 1.27))))
    )
    (pin output line (at 7.62 0 180) (length 2.54)
      (name "out" (effects (font (size 1.27 1.27))))
      (number "5" (effects (font (size 1.27 1.27))))
    )

	  
   </eeschema_symbol>
  <Spice>
